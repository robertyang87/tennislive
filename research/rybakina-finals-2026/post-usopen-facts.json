  "timeline": [
    {
      "id": "formal_finals_qualification",
      "date": "2026-09-14",
      "kind": "qualification_announcement",
      "status": "confirmed",
      "facts_zh": [
        "WTA正式宣布她成为2026年WTA年终总决赛首位单打入围球员。",
        "她以2025年年终冠军身份，连续第四年入围。",
        "官宣日同为她正式登上世界第一的周一。"
      ],
      "sources": [
        "qualification"
      ],
      "safe_narration_zh": "9月14日，WTA正式确认：莱巴金娜成为本届年终首位单打入围者。",
      "limits": [
        "这是正式官宣日期。没有据此证明她最早在数学上锁定资格的精确时刻。",
        "9月9日锁定登顶、9月12日美网夺冠、9月14日排名生效及入围官宣，不要混成同一天。"
      ]
    },
    {
      "id": "bjkc_withdrawal",
      "date": "2026-09-18",
      "kind": "team_event_withdrawal",
      "status": "confirmed",
      "facts_zh": [
        "官方队伍名单注明她9月18日因医疗原因退出金杯总决赛。"
      ],
      "sources": [
        "bjkc_withdrawal"
      ],
      "safe_narration_zh": "美网之后，9月18日，她因医疗原因退出金杯总决赛。",
      "limits": [
        "官方此页只写medical reasons，不据此补写跟腱炎、撕裂等诊断。",
        "团体赛退赛不记作一场巡回赛单打失利，不增加Race积分。"
      ]
    },
    {
      "id": "beijing_second_round_loss",
      "date": "2026-10-03",
      "kind": "completed_match",
      "status": "confirmed",
      "tournament": "China Open / 北京中网",
      "wta_tournament_id": 1020,
      "match_id": "LS032",
      "round": "Second round",
      "player_opening_match_after_bye": true,
      "opponent": "Alina Charaeva",
      "opponent_rank_article": 118,
      "result_player_perspective": "L 6-3 4-6 3-6",
      "duration_article": "2h11m",
      "sources": [
        "beijing_loss",
        "player_matches",
        "beijing_matches"
      ],
      "facts_zh": [
        "首轮轮空后的中网第二轮，她先赢一盘，被查拉耶娃逆转。",
        "这是她成为世界第一后的首场正式比赛。",
        "赛后WTA文字报道引用她提到比赛尾声脚部不适，需要休息。"
      ],
      "safe_narration_zh": "10月3日，中网第二轮，她先赢一盘，却以6比3、4比6、3比6负于查拉耶娃。世界第一身份的首秀，以失利结束。",
      "limits": [
        "个人叙事称第二轮，避免用64强代替实际轮次。",
        "脚部不适是赛后自述，不把伤病写成此役失利的唯一原因。",
        "报道中的Rybakina引语是文字出处；尚未获得本人该段讲话的原始录音。"
      ],
      "match_timestamp_utc": "2026-10-03T12:24:16.1+00:00",
      "race_points_player_api": 10
    },
    {
      "id": "wuhan_withdrawal",
      "date": "2026-10-04",
      "kind": "pre_tournament_withdrawal",
      "status": "confirmed",
      "tournament": "Wuhan Open",
      "sources": [
        "wuhan_withdrawal"
      ],
      "facts_zh": [
        "WTA报道称赛事官方社交宣布她因伤退出武汉。",
        "WTA转述她Instagram story：将休息和恢复，感谢支持。",
        "WTA称过去数月有持续的lower leg and foot injury，曾导致辛辛那提八强退赛。"
      ],
      "safe_narration_zh": "一天后，她因伤退出武汉，把时间留给休息和恢复。",
      "safe_injury_terms_zh": [
        "因伤退出武汉",
        "脚部伤情",
        "下肢与脚部伤情（引用WTA的范围）"
      ],
      "limits": [
        "没有武汉出场，不记一场失利，不写武汉第二轮退赛。",
        "不能据此说重伤、跟腱撕裂、已彻底痊愈或伤病将持续多久。",
        "本人Instagram story原始素材未取到；WTA文字稿是已确认的官方转述。"
      ]
    },
