    },
    {
      "file": "voice_09.words.json",
      "audio_file": "voice_09.mp3",
      "request_id": "b6ed6c850367b8715719584d8bfab5a2b5adb84702b75f6572a45244bd78902a",
      "projection_target": "segments[9]",
      "request_text": "半个月后的温网，决胜盘最后的抢十，他曾以八比五领先，还拿到一个赛点，最终却在第一轮出局。",
      "matches_actual_projection_or_native_outro": true,
      "actual_audio_sha256": "d44743ab81748028f5f2e6728eb552ccf51d97d36242a888a065e290d3f8f25b",
      "actual_word_sha256": "d9874dd437cbf5f7116621f9d2739ec8be7f86432a71799192f9d5d5fc387c4d"
    },
    {
