      "audio_file": "voice_10.mp3",
      "request_id": "86aea89485d44329c31e403718c56a899aa22f7715a13808d6b50ecb91980f5b",
      "projection_target": "segments[10]",
      "request_text": "八月，加拿大大师赛。他六场比赛一盘未失，两盘击败中岛布兰登，成功卫冕。",
      "matches_actual_projection_or_native_outro": true,
      "actual_audio_sha256": "b7b3bd17618e1df9379ccf56234defefdcaab6d7eb6726cbc4605857466a0d0a",
      "actual_word_sha256": "eef59795e6c2ea6e2692a3f0caf9ce5b7223de8e787c9a6d91d86b2e0ed378df"
    },
    {
