      "projection_target": "segments[12]",
      "request_text": "美网，他第一次击败阿尔卡拉斯，又逆转蒂亚福，第一次打进大满贯决赛。",
      "matches_actual_projection_or_native_outro": true,
      "actual_audio_sha256": "734d23f73e8c8287e2147b3f1e6491b527317cc88f2e813574015fdb110e619d",
