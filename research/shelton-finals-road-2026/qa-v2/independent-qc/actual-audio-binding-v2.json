      "projection_target": "segments[1]",
      "request_text": "先从澳网说起。打进8强之后，他三盘输给辛纳。",
      "matches_actual_projection_or_native_outro": true,
      "actual_audio_sha256": "079ddb5ed69054e4f588015dca7341f4b8a911a2f45284bb32ae9bebe40dff5d",
