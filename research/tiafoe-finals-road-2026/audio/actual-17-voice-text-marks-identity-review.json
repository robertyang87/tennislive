  "entries": [
    {
      "request_id": "011f028630afe64268f95700206cb17ca7895a5e3cd4ba85076d59bef7446425",
      "text": "蒂亚福首进年终，谢尔顿替他锁定门票。",
      "audio_sha256": "6771b30a831fad18d4fea35aca614b794a93a64e084785e0e8eeb17d9da5ff4f",
      "marks_sha256": "ccadf5c1b982ceab0215a943c07f486163d2a269360b2904e52dae237f8b5be5",
      "actual_ffprobe_duration": 3.888,
      "last_word_end": 3.066041,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "蒂亚福",
        "谢尔顿"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "04419f0633ec0d84ce5575a5afc3dca5795af0e31a9b74f675861eb2a29fbab7",
      "text": "十一月六日，谢尔顿在巴黎击败保罗。蒂亚福终于锁定资格，第一次走进都灵。",
      "audio_sha256": "cb6988858d41ebdb21e6615de316a701f521981f60432b10a25d2d3509e55b3f",
      "marks_sha256": "7c7c9076f5920f63ee937e859b5266f187930ae15c0062d098acc355e5ff2c0c",
      "actual_ffprobe_duration": 7.536,
      "last_word_end": 6.709916,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "保罗",
        "巴黎",
        "蒂亚福",
        "谢尔顿",
        "都灵"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "19eff4eb21b02ac8658b221c28482648040190a6115603cc42c5b6cd2647421e",
      "text": "二月阿卡普尔科，他打到决赛，两盘输给科博利，收获亚军。",
      "audio_sha256": "5bb9c7d7b3f93a616559a17446c2c53ead5ec0e986b1bb2c3142e5045132c113",
      "marks_sha256": "2825303a379f8beefef4809804f4bc9fe305fb21cde73705ac60671386c7dfd9",
      "actual_ffprobe_duration": 5.4,
      "last_word_end": 4.587291,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "科博利"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "234529500afa108af9137adc902e6f0c5a6a360072f95efe33e82f799b7854c0",
      "text": "先回到澳网。第三轮对德米纳尔，他三盘落败。",
      "audio_sha256": "858890ec56b4681e0b18c627f547d706e8b85c074120658113dd01b3790aeb15",
      "marks_sha256": "58eca1d0ee6f5bd122208e2bd547964d0be75cd0796ec300e7efc23652034535",
      "actual_ffprobe_duration": 5.184,
      "last_word_end": 4.339625,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "德米纳尔"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "395511ec71419a95a9cd1329718e7f2cc21f167a159baa4ad2ef1c9bcff2095b",
      "text": "带着哈雷冠军来到温网，他在第三轮五盘输给布勃利克。",
      "audio_sha256": "cc0c72a3522b302b8d5b954da4d19f947c673f7aca7a41731abfb31f8bbab333",
      "marks_sha256": "9cd6de386e88e0faf33ac296afb29af9a83a44cdc478a3f8307b89eb38345e64",
      "actual_ffprobe_duration": 5.472,
      "last_word_end": 4.622624,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "布勃利克"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "3bcfc834c43f403ab3289c2ef2a378286fdc01bc336e84a3321b32b9c6ee3482",
      "text": "截至十一月七日，蒂亚福三千三百九十分，排名赛季积分榜第八。高亮的八位球员，都已锁定年终资格。",
      "audio_sha256": "8155a193b8a65df8a50226131db3dbe4167cc23df119ed05b64ec1d9a23fe1b6",
      "marks_sha256": "155ba9212630e03699137badd333ef0515d6f2ed9c9a6e5a21a0e09597198877",
      "actual_ffprobe_duration": 9.312,
      "last_word_end": 8.478791,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "蒂亚福"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "5146ee03f7b259278d02a2950b0118f950ad25bab343bd5c1a6b8232a3b5a215",
      "text": "对菲斯，他扳回第二盘，决胜盘却一局未得。第二次打进大师赛决赛，还是收获亚军。",
      "audio_sha256": "c771d771e2b89caf26bbb35cac1483ab0c84f4f8566b77e246ecb253f710ff42",
      "marks_sha256": "aea8be58958069c0ce70543b49d52146092bd545d6b6cf79a3ee28c2674ad85e",
      "actual_ffprobe_duration": 8.136,
      "last_word_end": 7.323124,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "菲斯"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "5cc5cf5a105d06851fb76b7b0de7cc45b499064cc50254eb8be57d4918d8654c",
      "text": "第一次到都灵，你看好蒂亚福拿到几场胜利？",
      "audio_sha256": "e5611efd9403156f6112eae31f0615ca759474940f7f77b08367be099dccae62",
      "marks_sha256": "e3f60834221be9684e13782009d19eb536c234067572db569e252d268a23d92a",
      "actual_ffprobe_duration": 4.2,
      "last_word_end": 3.372666,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "蒂亚福",
        "都灵"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "681297c07b5220e06dcad0192c646e45c72a0c8688e2b9266e8c7d80b4e0ce09",
      "text": "八月，在蒙特利尔因伤退赛。右手接受手术后，他又在辛辛那提闯进决赛。",
      "audio_sha256": "f25122f7f1aac9c463dad4258ff96b5460181bab906082b764943f9170397e58",
      "marks_sha256": "037d7aab93eba139861dfe3dbd92785e0e1f9e45259876226b15a7331154a620",
      "actual_ffprobe_duration": 7.392,
      "last_word_end": 6.556624,
      "all_characters_covered": true,
      "names_and_places_single_token": [],
      "potential_split_token": []
    },
    {
      "request_id": "696424f375c867606e0df45d9c49f8047d66ce2507c917d6b09573a23d6c8552",
      "text": "美网四分之一决赛，先丢两盘，第三盘又一度零比三。他最后连赢三盘，逆转米切尔森。",
      "audio_sha256": "2fd620394f441a010bb9e3bc1413fbe91d3daeb7a201601a57c31b0cff5383e2",
      "marks_sha256": "048bdf94a1bc613477bf7a75c19e77754ffe7f67bd341bf16ae66465933d7253",
      "actual_ffprobe_duration": 8.424,
      "last_word_end": 7.594333,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "米切尔森"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "718184054c0df648bee537137bd82fcd03b675cba06d6613a58c36287d85b66c",
      "text": "法网第四轮，打了五小时二十六分。他曾盘分二比一领先，第四盘也领先四比一，最后却被阿尔纳尔迪逆转。",
      "audio_sha256": "edd8668baea1a5e46051a86756e097b48567e95f2336b17c70c21d78e94ccc38",
      "marks_sha256": "fdcfefda94880ee32959816b36861a23e3f2cd8979d622e1bd869f81c2ddba43",
      "actual_ffprobe_duration": 9.528,
      "last_word_end": 8.702833,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "阿尔纳尔迪"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "8992cf72e2058537831826f53e65f3703e9fccf3808dfd573ac9a20fec1d2fb5",
      "text": "美网半决赛，谢尔顿挡住了蒂亚福。到了十一月，又是谢尔顿，替他锁定了第一张都灵门票。",
      "audio_sha256": "91c0829f1469c4a0dc0cba2b64382277f144f0d39787584fa307226f62e20b29",
      "marks_sha256": "247171169427e3796ce0e3add2cc5b39313062817820de7b2867c891e45cdb8b",
      "actual_ffprobe_duration": 8.04,
      "last_word_end": 7.228791,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "蒂亚福",
        "谢尔顿",
        "都灵"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "91bab9a345587047e22f5235eae23b08ac83ca86634e54da0b2d8d7b7618b9bb",
      "text": "十一月四日，巴黎第二轮输给阿利斯，这个结果先让菲斯锁定了年终资格。",
      "audio_sha256": "b7364c0e34f387117532fd0db995036bd5e93ad6e50d84b984fed7467eb2c1fd",
      "marks_sha256": "831bcf61d8204442f6af57631ba53f7af5546f5c01d42132567e7d0fb9633d03",
      "actual_ffprobe_duration": 6.144,
      "last_word_end": 5.318416,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "巴黎",
        "菲斯",
        "阿利斯"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "b80ad40cf03e2a1bf0849f74b5dd89f9591e3dfac6354816bf5cd093c739d31d",
      "text": "关注网球时插，时插归我，好球归你。",
      "audio_sha256": "55c3bcce5b8c41534d0dc89bc3d2a50e9a8c4896fbea489b4141db07f1b9b246",
      "marks_sha256": "ffd92401e4e51d044cd0ba811dd56c27dfa59f0de4734ee872348e09ba3401b8",
      "actual_ffprobe_duration": 4.104,
      "last_word_end": 3.266499,
      "all_characters_covered": true,
      "names_and_places_single_token": [],
      "potential_split_token": []
    },
    {
      "request_id": "dc8f172892ce6aa910dc3d12ef2df374107095b21f60d78a001cabdee6316efe",
      "text": "六月哈雷，先在四分之一决赛救回三个赛点。决赛两盘击败弗里茨，拿下生涯首个五百赛冠军。",
      "audio_sha256": "a7798c50c2de1a7ad38124ec2a796506e8582dfba22c48d5ba806b77959f636a",
      "marks_sha256": "9a3b6770d6284e1336bf8756c8456b464ba8f8fe511bc3b8aac338a316d5143c",
      "actual_ffprobe_duration": 8.568,
      "last_word_end": 7.747666,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "弗里茨"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "ddeed61a3ee97426812159249f0ba88e279b9f70a8febbe6ed55ee7f8040e4e3",
      "text": "半决赛对谢尔顿，先赢一盘，随后连丢三盘。第三次美网4强，他还是没能更进一步。",
      "audio_sha256": "03c6075fe341b20a4ec1478a3dff526d9706d2271f484f3ba6be655bfc5311f6",
      "marks_sha256": "f6ef54d9a28b39b30d5e9d0bb2915cc42581602e135036bf3ff92a59dca06490",
      "actual_ffprobe_duration": 8.304,
      "last_word_end": 7.464624,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "谢尔顿"
      ],
      "potential_split_token": []
    },
    {
      "request_id": "f546a7bf96a5534f785edacb8704dae8df6827bb76381765f65b3c7ef14c62a7",
      "text": "上海、维也纳，再到巴黎，他遭遇了三连败。",
      "audio_sha256": "125167a8c67bdd6593632113fedbdede874a04ff3974aa026ebc80accd72623f",
      "marks_sha256": "28724e6ec63f47240ed3e56f3f7aafcdc579b6d20520b904ab59039ef17f7474",
      "actual_ffprobe_duration": 4.584,
      "last_word_end": 3.761791,
      "all_characters_covered": true,
      "names_and_places_single_token": [
        "上海",
        "巴黎",
        "维也纳"
      ],
      "potential_split_token": []
    }
  ],
