    {
      "index": 12,
      "key": "vienna-interview",
      "source_sha256": "5acad9199e5042bdedf408d107c2cac98bb9a8984dd1ecaeae39598cb17f9acd",
      "selected_window": [
        69.82,
        93.6
      ],
      "audio_tail": "silence",
      "actual_ass_cues": [
        {
          "start": 125.01,
          "end": 127.91,
          "text": "So I'm just really happy that at the end,\\N我很高兴"
        },
        {
          "start": 127.91,
          "end": 130.19,
          "text": "I found my way and just played great.\\N最终找到了办法 也打得很好"
        },
        {
          "start": 130.19,
          "end": 132.75,
          "text": "And obviously it's been a really emotional\\N这一周让我感慨万千"
        },
        {
          "start": 132.75,
          "end": 134.43,
          "text": "and an amazing week for me\\N也非常美妙"
        },
        {
          "start": 134.43,
          "end": 136.01,
          "text": "that I learned a lot, you know,\\N我也学到了很多"
        },
        {
          "start": 136.01,
          "end": 140.39,
          "text": "to keep going forward step by step,\\N继续一步一步向前走"
        },
        {
          "start": 140.39,
          "end": 141.47,
          "text": "playing on indoor courts,\\N在室内场上比赛"
        },
        {
          "start": 141.47,
          "end": 144.91,
          "text": "trying to gain more confidence playing on this surface.\\N努力在这种场地上积累信心"
        },
        {
          "start": 144.91,
          "end": 146.32999999999998,
          "text": "So I'm just really happy\\N所以我很高兴"
        },
        {
          "start": 146.32999999999998,
          "end": 148.51,
          "text": "and looking forward for the rest of the season.\\N也期待赛季接下来的比赛"
        }
      ],
      "native_packet_sha256": "c4f16ef69969403f4f2056ce35a980de26dc52f013c397a34ae30cbf7ccf8f51"
    },
