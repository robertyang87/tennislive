[
  {
    "id": "opening",
    "narration": "今年四站大满贯，菲斯只赢了一场比赛。可今年的年终名单里，第一次出现了他的名字。",
    "speech_seconds": 7.608,
    "seconds": 8.008
  },
  {
    "id": "recovery",
    "narration": "去年法网后，背伤让他只又打了两场巡回赛单打。今年又缺席澳网，直到二月才开始新赛季。",
    "speech_seconds": 8.664,
    "seconds": 9.064
  },
  {
    "id": "doha",
    "narration": "复出第三站，多哈。他一路打到决赛，却以二比六、一比六输给阿尔卡拉斯。",
    "speech_seconds": 7.584,
    "seconds": 7.984
  },
  {
    "id": "sunshine",
    "narration": "印第安维尔斯打进8强。接着是迈阿密，对保罗那场四分之一决赛，他救回四个赛点，三盘抢七翻了回来。",
    "speech_seconds": 9.312,
    "seconds": 9.712
  },
  {
    "id": "barcelona",
    "narration": "迈阿密止步4强之后，他在巴塞罗那两盘击败卢布列夫。复出后的第一座奖杯，到手了。",
    "speech_seconds": 8.664,
    "seconds": 9.064
  },
  {
    "id": "madrid",
    "narration": "马德里，他又进了大师赛4强。复出之后，已经连续在大赛中走到后半程。",
    "speech_seconds": 7.104,
    "seconds": 7.504
  },
  {
    "id": "rg_withdrawal",
    "narration": "可伤病再次打断了他。罗马首战伤退，随后因为髋伤退出法网。两个大满贯，他都没能出场。",
    "speech_seconds": 9.576,
    "seconds": 9.976
  },
  {
    "id": "wimbledon",
    "narration": "温网先赢一轮，第二轮输给贝雷蒂尼。这一胜，也是他今年全部的大满贯胜场。",
    "speech_seconds": 7.632,
    "seconds": 8.032
  },
  {
    "id": "cincinnati",
    "narration": "辛辛那提决赛，他与蒂亚福各拿一盘。决胜盘，菲斯送出六比零，拿到生涯第一座大师赛冠军。",
    "speech_seconds": 8.856,
    "seconds": 9.256
  },
  {
    "id": "us_open",
    "narration": "美网，却又在首轮被西西帕斯挡住。辛辛那提的冠军，并没有让大满贯的难题自动消失。",
    "speech_seconds": 8.448,
    "seconds": 8.848
  },
  {
    "id": "autumn",
    "narration": "秋天，东京打进8强、上海第三轮，布鲁塞尔又进4强。一站一站，把积分往上加。",
    "speech_seconds": 8.472,
    "seconds": 8.872
  },
  {
    "id": "basel",
    "narration": "巴塞尔，面对弗里茨，第二盘零比二时，菲斯再次伤退。年终门票还没拿到，他又没能打完比赛。",
    "speech_seconds": 8.904,
    "seconds": 9.304
  },
  {
    "id": "qualification",
    "narration": "十一月四日，转折来自另一场比赛。阿利斯击败蒂亚福，菲斯的年终资格提前锁定。",
    "speech_seconds": 7.272,
    "seconds": 7.672
  },
  {
    "id": "race_table",
    "narration": "截至十一月五日，菲斯三千六百二十五分，排在赛季积分榜第七。高亮的六个人，都已拿到年终门票。",
    "speech_seconds": 9.12,
    "seconds": 9.52
  },
  {
    "id": "paris",
    "narration": "资格到手之后，他又两盘击败马哈奇，继续巴黎的征程。法国男网时隔十年，终于又有人入围年终。",
    "speech_seconds": 9.072,
    "seconds": 9.472
  },
  {
    "id": "question",
    "narration": "大满贯只有一胜，却拼出了第一张年终门票。第一次到都灵，你看好菲斯拿下几场胜利？",
    "speech_seconds": 7.992,
    "seconds": 8.392
  }
]
