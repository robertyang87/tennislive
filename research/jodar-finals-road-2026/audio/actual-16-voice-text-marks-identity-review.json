        ]
      }
    },
    {
      "id": "question",
      "request_id": "a1f378dc260615a08cd1a36528aa08f8ae03c4dc877a1879001063cd2daa7db9",
      "text": "这一次在都灵，你最想看霍达尔碰上谁？",
      "audio_sha256": "73204a12cfc96f012b6fcff5d0ee07cb3e281bd91c437429e6ef0adbb641e2ad",
      "marks_sha256": "489d27e2af26a0fc4eb1b82c02dc8617fccf57268521634e6d85adcde2901367",
      "actual_decode_duration": 4.008,
      "last_word_end": 3.183957,
      "all_actual_mark_characters_match_request": true,
      "names_places_single_token": [
        "都灵",
        "霍达尔"
      ],
      "multi_token_name_place_flags": [],
      "multi_token_rawmark_context": {}
    },
    {
      "id": "marrakech_intro",
      "request_id": "aa71b10ff84a23f6da13fe08add7efdac82e31fe508b78174dae6b3c0670f62e",
      "text": "四月的马拉喀什，两盘击败特伦杰利蒂，拿下生涯首座巡回赛冠军。这是他第一次参加巡回赛级别的红土赛事。",
      "audio_sha256": "3b785d2027af12870e33269e0ecb752751b6b1058b02517789fb338956959b53",
      "marks_sha256": "aa1d8a91882b53aa195d301051e45184c7f583442e6b6ab699a2e1c67c0a7de2",
      "actual_decode_duration": 9.984,
      "last_word_end": 9.139166,
      "all_actual_mark_characters_match_request": true,
      "names_places_single_token": [
        "特伦杰利蒂",
        "马拉喀什"
      ],
      "multi_token_name_place_flags": [],
      "multi_token_rawmark_context": {}
    },
    {
      "id": "cover",
      "request_id": "abda36e1d498b2a8a9a2e389b156c722a69332e9280da191244b3d1a3364dbe0",
      "text": "从大学球场到都灵，霍达尔首进年终。",
      "audio_sha256": "99129c9b911f84ad37b941c341a86b0fd1b48dfc162107c839c423614357a9a1",
      "marks_sha256": "d240cf18397dbe097c9d0436610f87236c3cbaa4a3310f061d3b5b23ee72fc1c",
      "actual_decode_duration": 3.792,
      "last_word_end": 2.959916,
      "all_actual_mark_characters_match_request": true,
      "names_places_single_token": [
        "都灵",
        "霍达尔"
      ],
      "multi_token_name_place_flags": [],
      "multi_token_rawmark_context": {}
    },
    {
      "id": "race_table",
      "request_id": "b02da06897f2f4ba8e8e530828f72768e3f80c25eb1fa773418fbb043f7296d0",
      "text": "截至十一月七日，三千二百三十四分，赛季积分榜第九。辛纳已退赛，霍达尔位列本届总决赛八位正选之中。",
      "audio_sha256": "b28591b4162552736dacff84df322c5616020aeebc34544ee34714c539f3df4c",
      "marks_sha256": "e48101538050ed5f2d0ed6e6dbb2e510135877e917eb5b97704090449984c950",
      "actual_decode_duration": 10.032,
      "last_word_end": 9.198083,
      "all_actual_mark_characters_match_request": true,
      "names_places_single_token": [
        "辛纳",
        "霍达尔"
      ],
      "multi_token_name_place_flags": [],
      "multi_token_rawmark_context": {}
    },
    {
      "id": "native_outro",
      "request_id": "b80ad40cf03e2a1bf0849f74b5dd89f9591e3dfac6354816bf5cd093c739d31d",
      "text": "关注网球时插，时插归我，好球归你。",
      "audio_sha256": "55c3bcce5b8c41534d0dc89bc3d2a50e9a8c4896fbea489b4141db07f1b9b246",
      "marks_sha256": "ffd92401e4e51d044cd0ba811dd56c27dfa59f0de4734ee872348e09ba3401b8",
      "actual_decode_duration": 4.104,
      "last_word_end": 3.266499,
      "all_actual_mark_characters_match_request": true,
      "names_places_single_token": [],
      "multi_token_name_place_flags": [],
      "multi_token_rawmark_context": {}
    },
    {
      "id": "shanghai_intro",
      "request_id": "bc63c2423148b4bd2f2664196ba39bae61c30ce44a443a56e7ad3cd149d3152d",
      "text": "对福基纳，他先赢一盘，第二盘又领先一个破发。最终被逆转，距离大师赛首冠还差一步。",
      "audio_sha256": "6b0ed817d7721c5c274b5c0e5280be7111ad1158f702abc1ffb4915f372c18b8",
      "marks_sha256": "b2d7123ef0bee386b71d6e09982463302967b68424cf81b1f534d1f897b46375",
      "actual_decode_duration": 8.064,
      "last_word_end": 7.252333,
      "all_actual_mark_characters_match_request": true,
      "names_places_single_token": [
        "福基纳"
      ],
      "multi_token_name_place_flags": [],
      "multi_token_rawmark_context": {}
    },
    {
      "id": "shanghai_run",
      "request_id": "edf9f73ef50d3ce64f5234bedb092e6957cf8fa59d330b92735e6dc63e67dd88",
      "text": "上海，前四场全部逆转过关。半决赛两盘击败梅德韦德夫，第一次走进大师赛决赛。",
      "audio_sha256": "c13a4fe4e9d9e7957ab3d07e25e6265a5befac351adc22970861781211ed5fca",
      "marks_sha256": "a4eba733f02ffcf9f797c80cacca1f53c838079bfbf6b0f2c50a14f6ffa073d7",
      "actual_decode_duration": 7.944,
      "last_word_end": 7.099082,
      "all_actual_mark_characters_match_request": true,
      "names_places_single_token": [
        "上海",
        "梅德韦德夫"
      ],
      "multi_token_name_place_flags": [],
      "multi_token_rawmark_context": {}
    },
    {
      "id": "opening",
      "request_id": "eea9d8338b369cbb6b8263e07a2408a0b267c86a4971947bd486555566fb8e52",
      "text": "去年十一月，霍达尔还是弗吉尼亚大学的学生球员。今年十一月，他拿到了都灵最后一张门票。",
      "audio_sha256": "dcd8363a6cf9a47f7971afecc4e785b0db76e2c9862796ea649526e097d2f633",
      "marks_sha256": "6775d234ceaab9c164620b1ceb2eeb006fa42d67f5b6117eec8199223e3c2e93",
