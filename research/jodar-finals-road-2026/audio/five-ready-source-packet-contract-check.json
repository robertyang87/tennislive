  "required_cues": [
    {
      "segment": 1,
      "start": 10.319999999999993,
      "end": 17.840000000000003,
      "en": "[On-court result announcement]",
      "zh": "【场上宣布比赛结果】"
    },
    {
      "segment": 2,
      "start": 14.439999999999998,
      "end": 18.82000000000005,
      "en": "A home champion in the capital.",
      "zh": "主场冠军，就在这座首都。"
    },
    {
      "segment": 2,
      "start": 18.82000000000005,
      "end": 22.08000000000004,
      "en": "And for the American,",
      "zh": "对这位美国球员来说，"
    },
    {
      "segment": 2,
      "start": 22.08000000000004,
      "end": 25.640000000000043,
      "en": "it is his biggest title since 2022.",
      "zh": "这是他自2022年以来最大的一冠。"
    },
    {
      "segment": 2,
      "start": 28.180000000000007,
      "end": 32.26000000000005,
      "en": "as he takes down the young Spaniard Rafael Jodar,",
      "zh": "他击败了西班牙小将霍达尔，"
    },
    {
      "segment": 2,
      "start": 32.26000000000005,
      "end": 34.420000000000016,
      "en": "who pushed him hard in those two sets.",
      "zh": "两盘都给他制造了不小的麻烦。"
    },
    {
      "segment": 3,
      "start": 7.400000000000006,
      "end": 8.760000000000005,
      "en": "That'll do it.",
      "zh": "比赛结束了。"
    },
    {
      "segment": 3,
      "start": 8.819999999999993,
      "end": 11.959999999999994,
      "en": "That is the win of his career.",
      "zh": "这是他生涯最重要的一场胜利。"
    },
    {
      "segment": 3,
      "start": 12.659999999999997,
      "end": 18.689999999999998,
      "en": "Yunchaokete has knocked out the 12th seed,",
      "zh": "布云朝克特淘汰了12号种子，"
    },
    {
      "segment": 3,
      "start": 19.230000000000004,
      "end": 22.089,
      "en": "and it has been emphatic today.",
      "zh": "而且他今天赢得相当强势。"
    },
    {
      "segment": 3,
      "start": 22.629000000000005,
      "end": 24.909999999999997,
      "en": "[Score] 6-2, 6-1, 6-1.",
      "zh": "6比2、6比1、6比1。"
    },
    {
      "segment": 4,
      "start": 2.5,
      "end": 3.7799999999999727,
      "en": "Game, set, match.",
      "zh": "比赛结束。"
    },
    {
      "segment": 4,
      "start": 4.099999999999966,
      "end": 7.339999999999975,
      "en": "Alejandro Davidovich Fokina",
      "zh": "福基纳，"
    },
    {
      "segment": 4,
      "start": 7.339999999999975,
      "end": 13.939999999999998,
      "en": "claims a maiden Masters 1000 title in Shanghai.",
      "zh": "在上海夺得生涯首座大师赛冠军！"
    }
