    {
      "segment": 0,
      "start": 0.9799999999999613,
      "end": 4.7999999999999545,
      "en": "Fery's second break in the third set.",
      "zh": "费里在第三盘第二次破发。"
    },
    {
      "segment": 0,
      "start": 4.7999999999999545,
      "end": 10.21999999999997,
      "en": "Scoreline looking very, very positive for the Brit.",
      "zh": "比分对这位英国选手非常有利。"
    },
    {
      "segment": 0,
      "start": 26.579999999999984,
      "end": 31.799999999999955,
      "en": "And on debut, Arthur Fery is through to the second round.",
      "zh": "澳网首秀，费里闯进第二轮。"
    },
    {
      "segment": 0,
      "start": 31.799999999999955,
      "end": 35.5,
      "en": "It's a huge win. Straight sets.",
      "zh": "一场大胜，直落三盘。"
    },
    {
      "segment": 1,
      "start": 2.4399999999999977,
      "end": 6.319999999999993,
      "en": "Acapulco belongs to Flavio.",
      "zh": "阿卡普尔科，属于弗拉维奥。"
    },
    {
      "segment": 1,
      "start": 6.319999999999993,
      "end": 8.839999999999975,
      "en": "Cobolli the champion.",
      "zh": "科博利，冠军！"
    },
    {
      "segment": 1,
      "start": 10.599999999999994,
      "end": 13.259999999999991,
      "en": "A second ATP 500 title.",
      "zh": "第二座五百分赛冠军。"
    },
    {
      "segment": 2,
      "start": 3.2799999999999727,
      "end": 12.479999999999961,
      "en": "Ben Shelton is the 2026 BMW Open by Bitpanda champion here in Munich.",
      "zh": "谢尔顿是二〇二六年慕尼黑冠军！"
    },
    {
      "segment": 2,
      "start": 12.479999999999961,
      "end": 15.420000000000016,
      "en": "Runner-up 12 months ago.",
      "zh": "十二个月前，他是亚军。"
    },
    {
      "segment": 5,
      "start": 2.8999999999999773,
      "end": 6.920000000000016,
      "en": "Oh, what days these are for Arthur Fery!",
      "zh": "费里迎来了多么美好的日子！"
    },
    {
      "segment": 5,
      "start": 10.699999999999989,
      "end": 15.699999999999989,
      "en": "The British wild card in the semi-finals of Wimbledon.",
      "zh": "这位英国外卡选手，闯进温网半决赛。"
    },
    {
      "segment": 6,
      "start": 2.1599999999999966,
      "end": 8.719999999999999,
      "en": "It is Arthur Fils into the final here in Cincinnati.",
      "zh": "菲斯打进辛辛那提决赛。"
    },
    {
      "segment": 7,
      "start": 4.5,
      "end": 9.099999999999909,
      "en": "One of the performances of Alexander Blockx's career.",
      "zh": "布洛克斯职业生涯的代表作之一。"
    },
    {
      "segment": 7,
      "start": 9.67999999999995,
      "end": 12.919999999999959,
      "en": "One of the performances in the U.S. Open so far.",
      "zh": "也是本届美网至今的代表作之一。"
    }
  ],
