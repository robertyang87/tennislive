    },
    {
      "id": "bundle:30784c09a7f5aeca8142b7ce60e8f6d565046bb3c83bb48c42648274a92dcc77",
      "request_id": "30784c09a7f5aeca8142b7ce60e8f6d565046bb3c83bb48c42648274a92dcc77",
      "request": {
        "backend": "edge",
        "cache_key": "8b803b5c4ba259c2c18166209872dcdd",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "北京时间十月二十八号晚上，巴塞尔男单首轮。拿外卡参赛的德约，对上安贝尔。首盘一比一，德约被逼到破发点。常回合的底线对抗，这一分，安贝尔抢了下来。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "48d76845df1ef9a75808f94005db3a730c268a2e29ee0a01f7f68d69e6002912",
