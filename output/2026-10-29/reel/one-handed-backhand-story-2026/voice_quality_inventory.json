        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "单反，为什么越来越少？",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "d3cf80c25423b3d2179f109bda6ed7cd9623d5aa3db24127be5c1174c6619d05",
