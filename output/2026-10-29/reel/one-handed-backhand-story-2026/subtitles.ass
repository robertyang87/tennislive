Dialogue: 0,0:00:00.05,0:00:01.77,TL,,0,0,0,,大满贯男单半决赛
Dialogue: 0,0:00:01.77,0:00:05.09,TL,,0,0,0,,{\fs78}149{\fs68}年来 首次没有单反
Dialogue: 0,0:00:15.29,0:00:16.95,TL,,0,0,0,,这一记单反直线
Dialogue: 0,0:00:16.95,0:00:19.93,TL,,0,0,0,,让瓦林卡拿下{\fs78}2015{\fs68}年法网
Dialogue: 0,0:00:19.93,0:00:21.13,TL,,0,0,0,,{\fs78}10{\fs68}月{\fs78}27{\fs68}日
Dialogue: 0,0:00:21.13,0:00:24.17,TL,,0,0,0,,{\fs78}41{\fs68}岁的他在巴塞尔退役了
Dialogue: 0,0:00:24.59,0:00:27.46,TL,,0,0,0,,可就在今年 四大满贯男单半决赛
Dialogue: 0,0:00:27.46,0:00:30.09,TL,,0,0,0,,{\fs78}16{\fs68}个席位 没有一个单反
Dialogue: 0,0:00:30.09,0:00:30.88,TL,,0,0,0,,据统计
Dialogue: 0,0:00:30.88,0:00:33.11,TL,,0,0,0,,这是{\fs78}1877{\fs68}年第一届温网以来的
Dialogue: 0,0:00:33.11,0:00:34.33,TL,,0,0,0,,第一次
Dialogue: 0,0:00:35.59,0:00:38.90,TL,,0,0,0,,{\fs78}1973{\fs68}年 {\fs78}ATP{\fs68} 公布第一份排名
Dialogue: 0,0:00:38.90,0:00:40.92,TL,,0,0,0,,前{\fs78}10{\fs68}名里{\fs78}9{\fs68}个人打单反
Dialogue: 0,0:00:40.92,0:00:43.58,TL,,0,0,0,,唯一的例外 是康纳斯
Dialogue: 0,0:00:45.09,0:00:48.26,TL,,0,0,0,,单反好看 一只手把整个身体甩出去
Dialogue: 0,0:00:48.26,0:00:50.17,TL,,0,0,0,,打得平 打得狠
Dialogue: 0,0:00:50.17,0:00:51.85,TL,,0,0,0,,瓦林卡就靠这一拍
Dialogue: 0,0:00:51.85,0:00:54.25,TL,,0,0,0,,抢下了{\fs78}3{\fs68}座大满贯
Dialogue: 0,0:00:54.69,0:00:56.89,TL,,0,0,0,,{\fs78}50{\fs68}年后 {\fs78}2024{\fs68}年{\fs78}2{\fs68}月
Dialogue: 0,0:00:56.89,0:00:58.92,TL,,0,0,0,,西西帕斯跌出前{\fs78}10{\fs68}
Dialogue: 0,0:00:58.92,0:00:59.97,TL,,0,0,0,,{\fs78}ATP{\fs68} 前{\fs78}10{\fs68}
Dialogue: 0,0:00:59.97,0:01:02.34,TL,,0,0,0,,第一次一个单反都没有
Dialogue: 0,0:01:03.69,0:01:06.42,TL,,0,0,0,,单反 为什么越来越少？
Dialogue: 0,0:01:07.29,0:01:09.10,TL,,0,0,0,,第一 怕高球
Dialogue: 0,0:01:09.10,0:01:11.28,TL,,0,0,0,,弹到肩膀那么高的上旋球
Dialogue: 0,0:01:11.28,0:01:13.15,TL,,0,0,0,,一只手很难发力
Dialogue: 0,0:01:13.15,0:01:14.49,TL,,0,0,0,,纳达尔对费德勒
Dialogue: 0,0:01:14.49,0:01:15.72,TL,,0,0,0,,用的就是这一招
Dialogue: 0,0:01:15.72,0:01:18.40,TL,,0,0,0,,一拍一拍压向他的反手
Dialogue: 0,0:01:21.49,0:01:23.17,TL,,0,0,0,,第二 来不及
Dialogue: 0,0:01:23.17,0:01:26.13,TL,,0,0,0,,谢尔顿这一发 时速{\fs78}208{\fs68}公里
Dialogue: 0,0:01:26.13,0:01:28.02,TL,,0,0,0,,西西帕斯单手伸出去
Dialogue: 0,0:01:28.02,0:01:30.01,TL,,0,0,0,,只能把球挡回来
Dialogue: 0,0:01:31.19,0:01:33.78,TL,,0,0,0,,第三 从小学的就是双反
Dialogue: 0,0:01:33.78,0:01:34.77,TL,,0,0,0,,费德勒说
Dialogue: 0,0:01:34.77,0:01:37.34,TL,,0,0,0,,现在大多数教练自己就是双反
Dialogue: 0,0:01:37.34,0:01:40.11,TL,,0,0,0,,而且教孩子双反 要容易得多
Dialogue: 0,0:01:40.11,0:01:41.53,TL,,0,0,0,,他自己的一个孩子
Dialogue: 0,0:01:41.53,0:01:43.47,TL,,0,0,0,,正在从双反改成单反
Dialogue: 0,0:01:43.47,0:01:45.99,TL,,0,0,0,,正在体会这有多难
Dialogue: 0,0:01:46.79,0:01:48.61,TL,,0,0,0,,最后的单反
Dialogue: 0,0:01:49.59,0:01:52.21,TL,,0,0,0,,男子大满贯最后一个单反冠军
Dialogue: 0,0:01:52.21,0:01:54.64,TL,,0,0,0,,是{\fs78}2020{\fs68}年美网的蒂姆
Dialogue: 0,0:01:54.64,0:01:56.31,TL,,0,0,0,,决赛他先丢两盘
Dialogue: 0,0:01:56.31,0:01:58.37,TL,,0,0,0,,逆转了兹维列夫
Dialogue: 0,0:01:59.09,0:02:00.02,TL,,0,0,0,,今年美网
Dialogue: 0,0:02:00.02,0:02:03.21,TL,,0,0,0,,西西帕斯是签表里剩到最后的单反
Dialogue: 0,0:02:03.21,0:02:04.65,TL,,0,0,0,,第四轮对谢尔顿
Dialogue: 0,0:02:04.65,0:02:06.61,TL,,0,0,0,,他一个破发点都没拿到
Dialogue: 0,0:02:06.61,0:02:08.73,TL,,0,0,0,,直落{\fs78}3{\fs68}盘出局
Dialogue: 0,0:02:15.42,0:02:17.16,TL,,0,0,88,,{\an2}{\fnInter 24pt SemiBold\b0\fs44\bord2.5\fsp0.6}Double match point.{\fnNoto Sans CJK SC\b1\fs68\bord4\fsp0}\N双赛点
Dialogue: 0,0:02:21.69,0:02:24.04,TL,,0,0,0,,费德勒说 单反不会消失
Dialogue: 0,0:02:24.04,0:02:25.47,TL,,0,0,0,,它还会回来
Dialogue: 0,0:02:25.47,0:02:27.44,TL,,0,0,0,,瓦林卡走了 你身边
Dialogue: 0,0:02:27.44,0:02:29.56,TL,,0,0,0,,还有人打单反吗？
