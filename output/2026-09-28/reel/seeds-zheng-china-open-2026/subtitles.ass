Dialogue: 0,0:00:02.68,0:00:05.57,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}28{\fs68}号 中网女单抽签
Dialogue: 0,0:00:05.57,0:00:07.52,TL,,0,0,0,,签表上有{\fs78}32{\fs68}个名字
Dialogue: 0,0:00:07.52,0:00:09.66,TL,,0,0,0,,前面多了一个号码
Dialogue: 0,0:00:10.38,0:00:11.91,TL,,0,0,0,,那是种子号
Dialogue: 0,0:00:11.91,0:00:14.87,TL,,0,0,0,,奥运冠军郑钦文 这一次没有
Dialogue: 0,0:00:14.87,0:00:16.83,TL,,0,0,0,,种子是什么 怎么排
Dialogue: 0,0:00:16.83,0:00:19.69,TL,,0,0,0,,怎么放 又闹出过哪些事？
Dialogue: 0,0:00:20.88,0:00:24.26,TL,,0,0,0,,种子 英文叫 {\fs78}seed{\fs68} 本来是播种
Dialogue: 0,0:00:24.88,0:00:28.01,TL,,0,0,0,,把最好的种子撒开 别挤在一块
Dialogue: 0,0:00:28.01,0:00:29.79,TL,,0,0,0,,{\fs78}19{\fs68}世纪{\fs78}90{\fs68}年代
Dialogue: 0,0:00:29.79,0:00:32.83,TL,,0,0,0,,美国网坛把这个词借进了签表
Dialogue: 0,0:00:32.83,0:00:35.30,TL,,0,0,0,,温网{\fs78}1924{\fs68}年开始排种子
Dialogue: 0,0:00:35.30,0:00:38.67,TL,,0,0,0,,{\fs78}1927{\fs68}年改按实力 {\fs78}8{\fs68}个种子
Dialogue: 0,0:00:39.78,0:00:41.84,TL,,0,0,0,,谁能当种子？
Dialogue: 0,0:00:42.78,0:00:44.03,TL,,0,0,0,,看排名
Dialogue: 0,0:00:44.03,0:00:47.49,TL,,0,0,0,,赛前一周的世界排名 从高往低数
Dialogue: 0,0:00:47.49,0:00:51.22,TL,,0,0,0,,{\fs78}96{\fs68}签和{\fs78}128{\fs68}签 排{\fs78}32{\fs68}个种子
Dialogue: 0,0:00:51.22,0:00:53.28,TL,,0,0,0,,{\fs78}56{\fs68}签 {\fs78}16{\fs68}个
Dialogue: 0,0:00:53.28,0:00:54.71,TL,,0,0,0,,外卡可以当种子
Dialogue: 0,0:00:54.71,0:00:56.79,TL,,0,0,0,,资格赛上来的不行
Dialogue: 0,0:00:57.48,0:00:58.93,TL,,0,0,0,,看中网的签表
Dialogue: 0,0:00:58.93,0:01:00.84,TL,,0,0,0,,一号莱巴金娜在最上面
Dialogue: 0,0:01:00.84,0:01:02.96,TL,,0,0,0,,{\fs78}2{\fs68}号萨巴伦卡在最下面
Dialogue: 0,0:01:02.96,0:01:05.44,TL,,0,0,0,,两人只可能在决赛相遇
Dialogue: 0,0:01:05.44,0:01:08.09,TL,,0,0,0,,{\fs78}3{\fs68}号高芙 {\fs78}4{\fs68}号安德烈耶娃
Dialogue: 0,0:01:08.09,0:01:11.32,TL,,0,0,0,,抽签落进另外两个四分之一区
Dialogue: 0,0:01:12.28,0:01:14.04,TL,,0,0,0,,没有种子的人呢？
Dialogue: 0,0:01:14.04,0:01:16.41,TL,,0,0,0,,抽到哪儿 全凭运气
Dialogue: 0,0:01:16.41,0:01:18.11,TL,,0,0,0,,中网这样的{\fs78}96{\fs68}签
Dialogue: 0,0:01:18.11,0:01:20.86,TL,,0,0,0,,{\fs78}32{\fs68}个种子第一轮全部轮空
Dialogue: 0,0:01:20.86,0:01:23.53,TL,,0,0,0,,非种子 要先多打一场
Dialogue: 0,0:01:25.18,0:01:28.22,TL,,0,0,0,,一个种子号 闹出过不少事
Dialogue: 0,0:01:28.88,0:01:32.10,TL,,0,0,0,,早年温网不完全按排名排种子
Dialogue: 0,0:01:32.10,0:01:33.24,TL,,0,0,0,,{\fs78}2000{\fs68}年
Dialogue: 0,0:01:33.24,0:01:35.64,TL,,0,0,0,,两位西班牙名将没拿到种子
Dialogue: 0,0:01:35.64,0:01:36.82,TL,,0,0,0,,退赛抗议
Dialogue: 0,0:01:36.82,0:01:39.65,TL,,0,0,0,,第二年 种子扩到{\fs78}32{\fs68}个
Dialogue: 0,0:01:39.65,0:01:42.42,TL,,0,0,0,,{\fs78}2018{\fs68}年 小威廉姆斯产后复出
Dialogue: 0,0:01:42.42,0:01:46.45,TL,,0,0,0,,世界第{\fs78}183{\fs68} 温网破格给了她{\fs78}25{\fs68}号
Dialogue: 0,0:01:46.45,0:01:47.87,TL,,0,0,0,,直到{\fs78}2021{\fs68}年
Dialogue: 0,0:01:47.87,0:01:50.40,TL,,0,0,0,,温网才只按排名排
Dialogue: 0,0:01:51.28,0:01:53.68,TL,,0,0,0,,没种子 也能夺冠
Dialogue: 0,0:01:53.68,0:01:55.01,TL,,0,0,0,,{\fs78}2009{\fs68}年美网
Dialogue: 0,0:01:55.01,0:01:56.78,TL,,0,0,0,,克里斯特尔斯产后复出
Dialogue: 0,0:01:56.78,0:01:58.22,TL,,0,0,0,,才打第三站比赛
Dialogue: 0,0:01:58.22,0:01:59.98,TL,,0,0,0,,连世界排名都没有
Dialogue: 0,0:01:59.98,0:02:02.39,TL,,0,0,0,,拿外卡一路打进决赛
Dialogue: 0,0:02:05.48,0:02:07.49,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:02:07.49,0:02:10.17,TL,,0,0,0,,美网第一个非种子女单冠军
Dialogue: 0,0:02:10.17,0:02:12.96,TL,,0,0,0,,她的女儿 就在看台上
Dialogue: 0,0:02:15.48,0:02:16.91,TL,,0,0,0,,{\fs78}2023{\fs68}年温网
Dialogue: 0,0:02:16.91,0:02:20.37,TL,,0,0,0,,世界第{\fs78}42{\fs68}的万卓索娃 没有种子
Dialogue: 0,0:02:20.37,0:02:22.71,TL,,0,0,0,,决赛赢了{\fs78}6{\fs68}号种子贾巴尔
Dialogue: 0,0:02:22.71,0:02:25.60,TL,,0,0,0,,温网第一个非种子女单冠军
Dialogue: 0,0:02:26.78,0:02:28.57,TL,,0,0,0,,今年美网的郑钦文也是
Dialogue: 0,0:02:28.57,0:02:30.03,TL,,0,0,0,,从资格赛打起
Dialogue: 0,0:02:30.03,0:02:33.03,TL,,0,0,0,,淘汰{\fs78}22{\fs68}号凯斯 {\fs78}8{\fs68}号斯瓦泰克
Dialogue: 0,0:02:33.03,0:02:35.25,TL,,0,0,0,,打进{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛
Dialogue: 0,0:02:38.18,0:02:40.86,TL,,0,0,0,,这一次在中网 她是外卡
Dialogue: 0,0:02:40.86,0:02:41.95,TL,,0,0,0,,赢下首轮
Dialogue: 0,0:02:41.95,0:02:44.81,TL,,0,0,0,,第二轮是{\fs78}15{\fs68}号种子卡林斯卡娅
Dialogue: 0,0:02:44.81,0:02:47.36,TL,,0,0,0,,第三轮是{\fs78}18{\fs68}号布兹科娃
Dialogue: 0,0:02:47.36,0:02:48.50,TL,,0,0,0,,{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛
Dialogue: 0,0:02:48.50,0:02:51.76,TL,,0,0,0,,签位上是头号种子莱巴金娜
Dialogue: 0,0:02:52.58,0:02:55.60,TL,,0,0,0,,种子号 算的是过去一年的排名
Dialogue: 0,0:02:55.60,0:02:57.78,TL,,0,0,0,,它能让最强的人晚点相遇
Dialogue: 0,0:02:57.78,0:03:00.03,TL,,0,0,0,,却管不了谁走到最后
Dialogue: 0,0:03:00.03,0:03:03.83,TL,,0,0,0,,你觉得 这一次中网的种子号准吗？
