Dialogue: 0,0:00:01.25,0:00:02.56,TL,,0,0,0,,菲律宾网球史上
Dialogue: 0,0:00:02.56,0:00:05.55,TL,,0,0,0,,从没人拿过一个{\fs78}WTA{\fs68}冠军
Dialogue: 0,0:00:05.55,0:00:06.78,TL,,0,0,0,,{\fs78}8{\fs68}月华盛顿
Dialogue: 0,0:00:06.78,0:00:08.57,TL,,0,0,0,,首轮她先丢一盘
Dialogue: 0,0:00:10.75,0:00:12.20,TL,,0,0,0,,一盘一破在手
Dialogue: 0,0:00:12.20,0:00:13.51,TL,,0,0,0,,她只再赢一局
Dialogue: 0,0:00:13.51,0:00:15.32,TL,,0,0,0,,还是被她拿了回来
Dialogue: 0,0:00:15.32,0:00:17.80,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:17.80,0:00:19.68,TL,,0,0,0,,涉险闯过首轮
Dialogue: 0,0:00:22.35,0:00:25.77,TL,,0,0,0,,第二轮 对手是卫冕冠军费尔南德斯
Dialogue: 0,0:00:25.77,0:00:27.36,TL,,0,0,0,,抢七拖到{\fs78}7{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:27.36,0:00:28.88,TL,,0,0,0,,她只丢了一分
Dialogue: 0,0:00:32.35,0:00:35.12,TL,,0,0,0,,看台上 菲律宾国旗举了起来
Dialogue: 0,0:00:35.12,0:00:35.88,TL,,0,0,0,,这一周
Dialogue: 0,0:00:35.88,0:00:39.09,TL,,0,0,0,,她已经送走了郑钦文和费尔南德斯
Dialogue: 0,0:00:41.85,0:00:45.09,TL,,0,0,0,,对手是{\fs78}4{\fs68}届大满贯冠军大坂直美
Dialogue: 0,0:00:45.09,0:00:47.80,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68} 她赢了
Dialogue: 0,0:00:49.45,0:00:52.21,TL,,0,0,0,,{\fs78}21{\fs68}岁 她双手捂住了脸
Dialogue: 0,0:00:53.85,0:00:56.80,TL,,0,0,0,,决赛 对手是世界第{\fs78}3{\fs68}佩古拉
Dialogue: 0,0:00:56.80,0:00:57.96,TL,,0,0,0,,第二盘{\fs78}1{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:57.96,0:00:59.83,TL,,0,0,0,,雨下了下来 比赛停了
Dialogue: 0,0:00:59.83,0:01:02.50,TL,,0,0,0,,那一刻她落后一盘 这场决赛
Dialogue: 0,0:01:02.50,0:01:03.98,TL,,0,0,0,,停了一整夜
Dialogue: 0,0:01:07.35,0:01:09.55,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}40{\fs68} {\fs78}3{\fs68}个冠军点
Dialogue: 0,0:01:09.55,0:01:11.39,TL,,0,0,0,,佩古拉救掉第一个
Dialogue: 0,0:01:11.39,0:01:14.14,TL,,0,0,0,,第二个 伊埃拉没再给她机会
Dialogue: 0,0:01:17.11,0:01:18.03,TL,,0,0,0,,{\fs78}21{\fs68}岁
Dialogue: 0,0:01:18.03,0:01:20.83,TL,,0,0,0,,菲律宾历史上第一个 {\fs78}WTA{\fs68} 冠军
Dialogue: 0,0:01:23.01,0:01:24.39,TL,,0,0,0,,这场胜利之后
Dialogue: 0,0:01:24.39,0:01:26.17,TL,,0,0,0,,菲律宾网球的下一步
Dialogue: 0,0:01:26.17,0:01:27.50,TL,,0,0,0,,会是什么？
