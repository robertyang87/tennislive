Dialogue: 0,0:00:01.30,0:00:03.93,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月一号早上七点一刻
Dialogue: 0,0:00:03.93,0:00:07.34,TL,,0,0,0,,华盛顿 {\fs78}WTA500{\fs68} 女单八强
Dialogue: 0,0:00:09.30,0:00:10.83,TL,,0,0,0,,{\fs78}21{\fs68}岁的伊埃拉
Dialogue: 0,0:00:10.83,0:00:13.37,TL,,0,0,0,,对二号种子斯维托丽娜
Dialogue: 0,0:00:13.37,0:00:15.01,TL,,0,0,0,,第一局打了五次平分
Dialogue: 0,0:00:15.01,0:00:16.69,TL,,0,0,0,,斯维托丽娜{\fs78}4{\fs68}个局点
Dialogue: 0,0:00:16.69,0:00:18.22,TL,,0,0,0,,四次被追平
Dialogue: 0,0:00:18.22,0:00:19.38,TL,,0,0,0,,{\fs78}15{\fs68}分之后
Dialogue: 0,0:00:19.38,0:00:21.18,TL,,0,0,0,,破发的是她
Dialogue: 0,0:00:24.10,0:00:26.18,TL,,0,0,0,,可这一局只是个开头
Dialogue: 0,0:00:26.18,0:00:28.78,TL,,0,0,0,,下一局轮到她发球 {\fs78}0{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:28.78,0:00:30.30,TL,,0,0,0,,立刻被破回来
Dialogue: 0,0:00:30.30,0:00:32.86,TL,,0,0,0,,第一盘{\fs78}9{\fs68}局 {\fs78}6{\fs68}局易主
Dialogue: 0,0:00:38.10,0:00:41.40,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68} 轮到她发球 {\fs78}0{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:41.40,0:00:42.52,TL,,0,0,0,,{\fs78}3{\fs68}个破发点
Dialogue: 0,0:00:42.52,0:00:47.01,TL,,0,0,0,,全在对面手里 {\fs78}3{\fs68}个 一个没给 追平
Dialogue: 0,0:00:47.01,0:00:50.53,TL,,0,0,0,,再赢两分 这一局是硬咬下来的
Dialogue: 0,0:00:54.40,0:00:55.59,TL,,0,0,0,,下一局回破
Dialogue: 0,0:00:55.59,0:00:58.71,TL,,0,0,0,,第二个盘点拿下第一盘 {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:58.71,0:01:00.54,TL,,0,0,0,,{\fs78}43{\fs68}分钟
Dialogue: 0,0:01:01.90,0:01:03.72,TL,,0,0,0,,第二盘换了方向
Dialogue: 0,0:01:03.72,0:01:05.40,TL,,0,0,0,,她先丢了自己的发球局
Dialogue: 0,0:01:05.40,0:01:08.12,TL,,0,0,0,,紧接着在对面的发球局{\fs78}40{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:08.12,0:01:09.19,TL,,0,0,0,,{\fs78}3{\fs68}个破发点
Dialogue: 0,0:01:09.19,0:01:10.76,TL,,0,0,0,,一个也没兑现
Dialogue: 0,0:01:10.76,0:01:13.38,TL,,0,0,0,,斯维托丽娜连过{\fs78}3{\fs68}个占先保下来
Dialogue: 0,0:01:13.38,0:01:15.55,TL,,0,0,0,,举起手臂喊了出来
Dialogue: 0,0:01:21.50,0:01:23.43,TL,,0,0,0,,她把自己的发球局稳住了
Dialogue: 0,0:01:23.43,0:01:26.40,TL,,0,0,0,,可对面也稳住了 {\fs78}1{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:26.40,0:01:27.66,TL,,0,0,0,,这一盘打到这儿
Dialogue: 0,0:01:27.66,0:01:30.21,TL,,0,0,0,,她的破发点全打空了
Dialogue: 0,0:01:34.60,0:01:36.63,TL,,0,0,0,,{\fs78}2{\fs68}比{\fs78}3{\fs68} 对面发球
Dialogue: 0,0:01:36.63,0:01:38.19,TL,,0,0,0,,她两次拿到破发点
Dialogue: 0,0:01:38.19,0:01:40.35,TL,,0,0,0,,第二次兑现 {\fs78}3{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:40.35,0:01:42.66,TL,,0,0,0,,整场球在这儿换的手
Dialogue: 0,0:01:45.90,0:01:47.54,TL,,0,0,0,,紧接着自己发球局
Dialogue: 0,0:01:47.54,0:01:51.11,TL,,0,0,0,,{\fs78}30{\fs68}比{\fs78}40{\fs68}又是一个破发点 救下来
Dialogue: 0,0:01:51.11,0:01:54.06,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68} 第二盘她第一次领先
Dialogue: 0,0:01:59.20,0:02:02.08,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} 对面发球 {\fs78}3{\fs68}个赛点
Dialogue: 0,0:02:02.08,0:02:05.22,TL,,0,0,0,,她用掉了第三个 {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:02:05.22,0:02:07.44,TL,,0,0,0,,全场{\fs78}19{\fs68}局 {\fs78}9{\fs68}局易主
Dialogue: 0,0:02:07.44,0:02:08.86,TL,,0,0,0,,{\fs78}25{\fs68}个破发点
Dialogue: 0,0:02:08.86,0:02:10.77,TL,,0,0,0,,她自己造了{\fs78}16{\fs68}个
Dialogue: 0,0:02:10.77,0:02:14.16,TL,,0,0,0,,总得分{\fs78}71{\fs68}比{\fs78}64{\fs68} 只差七分
Dialogue: 0,0:02:14.16,0:02:16.36,TL,,0,0,0,,一小时{\fs78}34{\fs68}分
Dialogue: 0,0:02:19.70,0:02:22.56,TL,,0,0,0,,看台上 菲律宾国旗举了起来
Dialogue: 0,0:02:22.56,0:02:26.37,TL,,0,0,0,,这一周 她过了郑钦文和费尔南德斯
Dialogue: 0,0:02:29.20,0:02:30.98,TL,,0,0,0,,今天是斯维托丽娜
Dialogue: 0,0:02:30.98,0:02:32.18,TL,,0,0,0,,两个月里第二次
Dialogue: 0,0:02:32.18,0:02:34.18,TL,,0,0,0,,比分和柏林那次一样
Dialogue: 0,0:02:34.18,0:02:35.90,TL,,0,0,0,,下一轮碰大坂直美
Dialogue: 0,0:02:35.90,0:02:37.86,TL,,0,0,0,,她还能走多远？
