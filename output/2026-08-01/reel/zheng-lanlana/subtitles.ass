Dialogue: 0,0:00:02.70,0:00:04.96,TL,,0,0,0,,{\fs78}8{\fs68}月{\fs78}2{\fs68}日凌晨 加拿大站
Dialogue: 0,0:00:04.96,0:00:06.52,TL,,0,0,0,,资格赛第一轮
Dialogue: 0,0:00:06.52,0:00:07.97,TL,,0,0,0,,世界第{\fs78}123{\fs68}
Dialogue: 0,0:00:07.97,0:00:09.78,TL,,0,0,0,,对世界第{\fs78}78{\fs68}
Dialogue: 0,0:00:09.78,0:00:12.61,TL,,0,0,0,,排名高的那个 是对面
Dialogue: 0,0:00:13.90,0:00:15.55,TL,,0,0,0,,两年前的这个夏天
Dialogue: 0,0:00:15.55,0:00:17.02,TL,,0,0,0,,她站在巴黎
Dialogue: 0,0:00:17.02,0:00:18.66,TL,,0,0,0,,半决赛赢斯瓦泰克
Dialogue: 0,0:00:18.66,0:00:20.78,TL,,0,0,0,,决赛赢维基奇
Dialogue: 0,0:00:22.20,0:00:25.58,TL,,0,0,0,,亚洲的第一枚奥运网球单打金牌
Dialogue: 0,0:00:26.20,0:00:28.06,TL,,0,0,0,,那一年她{\fs78}21{\fs68}岁
Dialogue: 0,0:00:28.06,0:00:30.66,TL,,0,0,0,,从那儿到今天 两年
Dialogue: 0,0:00:31.00,0:00:32.84,TL,,0,0,0,,转折有确切日期
Dialogue: 0,0:00:32.84,0:00:34.84,TL,,0,0,0,,{\fs78}2025{\fs68}年{\fs78}7{\fs68}月{\fs78}18{\fs68}日
Dialogue: 0,0:00:34.84,0:00:36.97,TL,,0,0,0,,她做了右肘手术
Dialogue: 0,0:00:38.70,0:00:40.01,TL,,0,0,0,,之前那几个月
Dialogue: 0,0:00:40.01,0:00:42.42,TL,,0,0,0,,她一直带着疼在打
Dialogue: 0,0:00:43.30,0:00:45.17,TL,,0,0,0,,复出是{\fs78}9{\fs68}月的中网
Dialogue: 0,0:00:45.17,0:00:47.43,TL,,0,0,0,,第三轮同一处肘退赛
Dialogue: 0,0:00:47.43,0:00:49.51,TL,,0,0,0,,排名一直在掉
Dialogue: 0,0:00:51.10,0:00:52.32,TL,,0,0,0,,今年法网首轮
Dialogue: 0,0:00:52.32,0:00:54.13,TL,,0,0,0,,她全场只赢下{\fs78}4{\fs68}局
Dialogue: 0,0:00:54.13,0:00:57.43,TL,,0,0,0,,生涯第一次在法网首轮就走人
Dialogue: 0,0:00:58.40,0:01:01.60,TL,,0,0,0,,赢她的那个人叫赫瓦林斯卡 波兰人
Dialogue: 0,0:01:01.60,0:01:04.37,TL,,0,0,0,,当时世界第{\fs78}114{\fs68}
Dialogue: 0,0:01:05.30,0:01:06.39,TL,,0,0,0,,丢的是排名
Dialogue: 0,0:01:06.39,0:01:07.53,TL,,0,0,0,,跌出前{\fs78}100{\fs68}
Dialogue: 0,0:01:07.53,0:01:10.38,TL,,0,0,0,,{\fs78}6{\fs68}月一度掉到第{\fs78}160{\fs68}
Dialogue: 0,0:01:11.30,0:01:14.45,TL,,0,0,0,,往回爬是从{\fs78}7{\fs68}月的雅典开始的
Dialogue: 0,0:01:14.45,0:01:15.62,TL,,0,0,0,,她连赢两场
Dialogue: 0,0:01:15.62,0:01:17.44,TL,,0,0,0,,两个月来第一次
Dialogue: 0,0:01:18.20,0:01:21.04,TL,,0,0,0,,那两周她从资格赛一路打进决赛
Dialogue: 0,0:01:21.04,0:01:23.93,TL,,0,0,0,,是史上第一个做到的资格赛球员
Dialogue: 0,0:01:23.93,0:01:26.21,TL,,0,0,0,,所以那场球不丢人
Dialogue: 0,0:01:27.60,0:01:30.42,TL,,0,0,0,,八强碰上克雷奇科娃 输了
Dialogue: 0,0:01:30.42,0:01:32.26,TL,,0,0,0,,{\fs78}3{\fs68}天前华盛顿首轮
Dialogue: 0,0:01:32.26,0:01:33.96,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}6{\fs68}丢掉决胜盘
Dialogue: 0,0:01:33.96,0:01:35.66,TL,,0,0,0,,输给伊埃拉
Dialogue: 0,0:01:36.50,0:01:39.62,TL,,0,0,0,,所以才有了加拿大站的资格赛
Dialogue: 0,0:01:40.20,0:01:42.60,TL,,0,0,0,,对面这位{\fs78}22{\fs68}岁 泰国人
Dialogue: 0,0:01:42.60,0:01:44.17,TL,,0,0,0,,叫塔拉鲁迪
Dialogue: 0,0:01:44.17,0:01:47.48,TL,,0,0,0,,{\fs78}4{\fs68}天前她升到生涯最高的世界第{\fs78}78{\fs68}
Dialogue: 0,0:01:47.48,0:01:50.25,TL,,0,0,0,,是泰国排名最高的球员
Dialogue: 0,0:01:51.60,0:01:54.09,TL,,0,0,0,,今年澳网 她连过{\fs78}3{\fs68}轮资格赛
Dialogue: 0,0:01:54.09,0:01:56.30,TL,,0,0,0,,第一次打进大满贯正赛
Dialogue: 0,0:01:56.30,0:01:58.86,TL,,0,0,0,,她正在往上走 这一场
Dialogue: 0,0:01:58.86,0:02:01.10,TL,,0,0,0,,她没有什么可输的
Dialogue: 0,0:02:02.30,0:02:05.49,TL,,0,0,0,,有人说 奥运冠军沦落到打资格赛
Dialogue: 0,0:02:05.49,0:02:07.79,TL,,0,0,0,,沦落这个词用错了
Dialogue: 0,0:02:08.50,0:02:11.27,TL,,0,0,0,,手术之后的每一场球都是往回爬
Dialogue: 0,0:02:11.27,0:02:12.79,TL,,0,0,0,,比停下强
Dialogue: 0,0:02:14.00,0:02:15.29,TL,,0,0,0,,{\fs78}8{\fs68}月{\fs78}2{\fs68}日凌晨
Dialogue: 0,0:02:15.29,0:02:17.81,TL,,0,0,0,,她从资格赛继续出发
Dialogue: 0,0:02:18.80,0:02:20.60,TL,,0,0,0,,你定闹钟吗？
