Dialogue: 0,0:00:00.10,0:00:01.94,TL,,0,0,0,,第一届只有{\fs78}16{\fs68}个国家
Dialogue: 0,0:00:01.94,0:00:04.85,TL,,0,0,0,,今年{\fs78}148{\fs68}个国家来抢
Dialogue: 0,0:00:05.20,0:00:08.69,TL,,0,0,0,,去年{\fs78}9{\fs68}月 这只碗在深圳被举起来
Dialogue: 0,0:00:08.69,0:00:10.23,TL,,0,0,0,,它叫比利 简 金杯
Dialogue: 0,0:00:10.23,0:00:12.37,TL,,0,0,0,,女子网球的世界杯
Dialogue: 0,0:00:14.20,0:00:17.25,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}22{\fs68}号起 它又回到深圳
Dialogue: 0,0:00:17.25,0:00:19.95,TL,,0,0,0,,八支球队 一个冠军
Dialogue: 0,0:00:20.60,0:00:23.25,TL,,0,0,0,,{\fs78}1963{\fs68}年 国际网联{\fs78}50{\fs68}岁
Dialogue: 0,0:00:23.25,0:00:26.30,TL,,0,0,0,,办了一个女子团体赛 联合会杯
Dialogue: 0,0:00:26.30,0:00:28.48,TL,,0,0,0,,第一届在伦敦女王俱乐部
Dialogue: 0,0:00:28.48,0:00:31.71,TL,,0,0,0,,{\fs78}16{\fs68}个国家自费来打 没有奖金
Dialogue: 0,0:00:33.10,0:00:36.00,TL,,0,0,0,,决赛 美国{\fs78}2{\fs68}比{\fs78}1{\fs68}澳大利亚
Dialogue: 0,0:00:38.10,0:00:41.09,TL,,0,0,0,,杯上刻的第一个名字 是他们
Dialogue: 0,0:00:42.10,0:00:43.72,TL,,0,0,0,,赢下决胜双打的
Dialogue: 0,0:00:43.72,0:00:45.73,TL,,0,0,0,,是一个{\fs78}19{\fs68}岁的加州姑娘
Dialogue: 0,0:00:45.73,0:00:47.02,TL,,0,0,0,,比利 简 莫菲特
Dialogue: 0,0:00:47.02,0:00:49.25,TL,,0,0,0,,后来的比利 简 金
Dialogue: 0,0:00:51.30,0:00:53.38,TL,,0,0,0,,这项赛事她打了{\fs78}56{\fs68}场
Dialogue: 0,0:00:53.38,0:00:56.21,TL,,0,0,0,,赢了{\fs78}52{\fs68}场 最后{\fs78}30{\fs68}场全胜
Dialogue: 0,0:00:56.21,0:00:58.71,TL,,0,0,0,,球员加队长 捧了{\fs78}10{\fs68}次杯
Dialogue: 0,0:00:58.71,0:01:01.76,TL,,0,0,0,,场外 {\fs78}1973{\fs68}年她直落{\fs78}3{\fs68}盘赢了
Dialogue: 0,0:01:01.76,0:01:03.43,TL,,0,0,0,,男选手里格斯
Dialogue: 0,0:01:03.43,0:01:05.24,TL,,0,0,0,,同一年创立 {\fs78}WTA{\fs68}
Dialogue: 0,0:01:05.24,0:01:08.05,TL,,0,0,0,,逼美网给女子同样的奖金
Dialogue: 0,0:01:09.30,0:01:10.76,TL,,0,0,0,,{\fs78}2020{\fs68}年{\fs78}9{\fs68}月
Dialogue: 0,0:01:10.76,0:01:13.76,TL,,0,0,0,,国际网联把这只杯改成她的名字
Dialogue: 0,0:01:13.76,0:01:16.46,TL,,0,0,0,,以女性命名的重大全球团体赛
Dialogue: 0,0:01:16.46,0:01:17.84,TL,,0,0,0,,这是第一个
Dialogue: 0,0:01:17.84,0:01:19.09,TL,,0,0,0,,{\fs78}2021{\fs68}年布拉格
Dialogue: 0,0:01:19.09,0:01:21.08,TL,,0,0,0,,第一届以她命名的总决赛
Dialogue: 0,0:01:21.08,0:01:23.60,TL,,0,0,0,,她站在自己的奖杯旁边
Dialogue: 0,0:01:24.80,0:01:26.38,TL,,0,0,0,,去年深圳的颁奖礼
Dialogue: 0,0:01:26.38,0:01:28.45,TL,,0,0,0,,{\fs78}81{\fs68}岁的她就在场上
Dialogue: 0,0:01:28.45,0:01:30.99,TL,,0,0,0,,亲手给冠军披上外套
Dialogue: 0,0:01:34.80,0:01:37.35,TL,,0,0,0,,所以它有{\fs78}3{\fs68}个名字 联合会杯
Dialogue: 0,0:01:37.35,0:01:39.25,TL,,0,0,0,,{\fs78}1995{\fs68}年起叫 {\fs78}Fed{\fs68} {\fs78}Cup{\fs68}
Dialogue: 0,0:01:39.25,0:01:40.62,TL,,0,0,0,,改成主客场
Dialogue: 0,0:01:40.62,0:01:43.75,TL,,0,0,0,,{\fs78}2020{\fs68}年起 比利 简 金杯
Dialogue: 0,0:01:45.30,0:01:48.75,TL,,0,0,0,,去年起 一场对抗打{\fs78}3{\fs68}场 两场单打
Dialogue: 0,0:01:48.75,0:01:51.61,TL,,0,0,0,,一场双打 先拿两分的赢
Dialogue: 0,0:01:52.10,0:01:53.52,TL,,0,0,0,,谁拿过它？
Dialogue: 0,0:01:53.52,0:01:55.97,TL,,0,0,0,,美国{\fs78}18{\fs68}次 头一届就是他们
Dialogue: 0,0:01:55.97,0:01:58.22,TL,,0,0,0,,{\fs78}70{\fs68}年代末七连冠
Dialogue: 0,0:01:58.22,0:01:59.72,TL,,0,0,0,,捷克{\fs78}11{\fs68}次
Dialogue: 0,0:01:59.72,0:02:01.31,TL,,0,0,0,,澳大利亚{\fs78}7{\fs68}次
Dialogue: 0,0:02:01.31,0:02:04.45,TL,,0,0,0,,意大利{\fs78}6{\fs68}次 最近两届连着拿
Dialogue: 0,0:02:05.60,0:02:07.01,TL,,0,0,0,,经典太多
Dialogue: 0,0:02:07.01,0:02:08.76,TL,,0,0,0,,{\fs78}1992{\fs68}年法兰克福
Dialogue: 0,0:02:08.76,0:02:11.51,TL,,0,0,0,,格拉芙帮统一后的德国拿下第一冠
Dialogue: 0,0:02:11.51,0:02:14.81,TL,,0,0,0,,决赛赢的是桑切斯 维卡里奥
Dialogue: 0,0:02:15.60,0:02:17.86,TL,,0,0,0,,{\fs78}90{\fs68}年代是西班牙的
Dialogue: 0,0:02:17.86,0:02:21.02,TL,,0,0,0,,{\fs78}1998{\fs68}年日内瓦 第五冠
Dialogue: 0,0:02:22.50,0:02:24.32,TL,,0,0,0,,桑切斯 维卡里奥
Dialogue: 0,0:02:24.32,0:02:26.29,TL,,0,0,0,,和康奇塔 马丁内斯
Dialogue: 0,0:02:26.29,0:02:29.07,TL,,0,0,0,,{\fs78}5{\fs68}座奖杯全在那{\fs78}10{\fs68}年
Dialogue: 0,0:02:29.70,0:02:32.73,TL,,0,0,0,,然后是捷克 {\fs78}2011{\fs68}年到{\fs78}2018{\fs68}年
Dialogue: 0,0:02:32.73,0:02:35.74,TL,,0,0,0,,{\fs78}8{\fs68}年六冠 队长一直是帕拉
Dialogue: 0,0:02:36.60,0:02:38.38,TL,,0,0,0,,{\fs78}2015{\fs68}年布拉格决赛
Dialogue: 0,0:02:38.38,0:02:40.93,TL,,0,0,0,,最后一场双打赢下俄罗斯的
Dialogue: 0,0:02:40.93,0:02:43.27,TL,,0,0,0,,就有斯特里科娃 今年
Dialogue: 0,0:02:43.27,0:02:45.69,TL,,0,0,0,,她带着捷克队来深圳
Dialogue: 0,0:02:46.90,0:02:50.39,TL,,0,0,0,,意大利的前四冠在{\fs78}2006{\fs68}到{\fs78}2013{\fs68}年
Dialogue: 0,0:02:50.39,0:02:53.96,TL,,0,0,0,,斯齐亚沃尼 佩内塔 埃拉尼 文奇
Dialogue: 0,0:02:53.96,0:02:55.29,TL,,0,0,0,,那一代
Dialogue: 0,0:02:56.00,0:02:57.35,TL,,0,0,0,,去年深圳决赛
Dialogue: 0,0:02:57.35,0:03:00.32,TL,,0,0,0,,保利尼{\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68}赢了佩古拉
Dialogue: 0,0:03:00.32,0:03:03.58,TL,,0,0,0,,{\fs78}2{\fs68}比{\fs78}0{\fs68}美国 第六冠 卫冕
Dialogue: 0,0:03:04.40,0:03:06.37,TL,,0,0,0,,今年她们冲三连冠
Dialogue: 0,0:03:06.37,0:03:09.60,TL,,0,0,0,,第一场对手 是东道主中国
Dialogue: 0,0:03:10.40,0:03:13.00,TL,,0,0,0,,中国队{\fs78}1981{\fs68}年第一次参赛
Dialogue: 0,0:03:13.00,0:03:14.80,TL,,0,0,0,,最好的一年是{\fs78}2008{\fs68}
Dialogue: 0,0:03:14.80,0:03:16.69,TL,,0,0,0,,北京主场{\fs78}3{\fs68}比{\fs78}2{\fs68}法国
Dialogue: 0,0:03:16.69,0:03:19.27,TL,,0,0,0,,郑洁和晏紫赢下了决胜双打
Dialogue: 0,0:03:19.27,0:03:22.08,TL,,0,0,0,,打进半决赛 输给了西班牙
Dialogue: 0,0:03:23.40,0:03:24.36,TL,,0,0,0,,去年深圳
Dialogue: 0,0:03:24.36,0:03:27.38,TL,,0,0,0,,中国队第一次在家门口打总决赛
Dialogue: 0,0:03:27.38,0:03:28.58,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}2{\fs68}意大利
Dialogue: 0,0:03:28.58,0:03:32.39,TL,,0,0,0,,两场单打都是决胜盘领先 然后被翻
Dialogue: 0,0:03:32.90,0:03:33.97,TL,,0,0,0,,今年的名单
Dialogue: 0,0:03:33.97,0:03:37.19,TL,,0,0,0,,郑钦文 张帅 王曦雨 郭涵煜
Dialogue: 0,0:03:37.19,0:03:39.27,TL,,0,0,0,,蒋欣玗 队长郑洁
Dialogue: 0,0:03:39.27,0:03:42.11,TL,,0,0,0,,{\fs78}2008{\fs68}年那支球队的主力
Dialogue: 0,0:03:42.90,0:03:45.73,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}24{\fs68}号北京时间下午{\fs78}5{\fs68}点起
Dialogue: 0,0:03:45.73,0:03:47.80,TL,,0,0,0,,{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛 中国对意大利
Dialogue: 0,0:03:47.80,0:03:49.63,TL,,0,0,0,,去年那场的重演
Dialogue: 0,0:03:49.63,0:03:51.90,TL,,0,0,0,,赢了 {\fs78}25{\fs68}号打半决赛
Dialogue: 0,0:03:51.90,0:03:54.05,TL,,0,0,0,,决赛在{\fs78}27{\fs68}号
Dialogue: 0,0:03:55.40,0:03:58.89,TL,,0,0,0,,{\fs78}63{\fs68}年 这只碗从没到过中国队手里
Dialogue: 0,0:03:58.89,0:04:00.78,TL,,0,0,0,,连决赛都没进过
Dialogue: 0,0:04:00.78,0:04:02.40,TL,,0,0,0,,这一次在家门口
Dialogue: 0,0:04:02.40,0:04:05.35,TL,,0,0,0,,你觉得 她们能走多远？
