Dialogue: 0,0:00:04.52,0:00:07.18,TL,,0,0,0,,这只银碗 是{\fs78}126{\fs68}年前
Dialogue: 0,0:00:07.18,0:00:10.09,TL,,0,0,0,,一个大学生自己掏钱买的
Dialogue: 0,0:00:12.32,0:00:15.27,TL,,0,0,0,,{\fs78}1900{\fs68}年 哈佛大学的几个学生
Dialogue: 0,0:00:15.27,0:00:17.46,TL,,0,0,0,,想跟英国人打一场
Dialogue: 0,0:00:19.32,0:00:21.69,TL,,0,0,0,,其中一个叫德怀特 戴维斯
Dialogue: 0,0:00:21.69,0:00:25.08,TL,,0,0,0,,他去订了一只纯银的大碗当奖品
Dialogue: 0,0:00:26.32,0:00:29.63,TL,,0,0,0,,第一届在波士顿开打 美国队{\fs78}3{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:00:29.63,0:00:33.17,TL,,0,0,0,,那只碗从此有了名字 戴维斯杯
Dialogue: 0,0:00:33.17,0:00:34.17,TL,,0,0,0,,{\fs78}30{\fs68}年代
Dialogue: 0,0:00:34.17,0:00:37.43,TL,,0,0,0,,它已经是欧美之间最大的一场球
Dialogue: 0,0:00:38.32,0:00:39.83,TL,,0,0,0,,{\fs78}126{\fs68}年过去
Dialogue: 0,0:00:39.83,0:00:41.79,TL,,0,0,0,,它成了全世界规模最大的
Dialogue: 0,0:00:41.79,0:00:43.06,TL,,0,0,0,,年度团体赛事
Dialogue: 0,0:00:43.06,0:00:45.93,TL,,0,0,0,,{\fs78}150{\fs68}多个国家和地区报名
Dialogue: 0,0:00:48.82,0:00:51.03,TL,,0,0,0,,它和巡回赛最不一样的地方
Dialogue: 0,0:00:51.03,0:00:52.85,TL,,0,0,0,,你代表的不是自己
Dialogue: 0,0:00:52.85,0:00:55.64,TL,,0,0,0,,开打之前 先奏国歌
Dialogue: 0,0:00:56.32,0:00:58.20,TL,,0,0,0,,场边坐着队长和队友
Dialogue: 0,0:00:58.20,0:01:00.72,TL,,0,0,0,,换边的时候他就在你身边
Dialogue: 0,0:01:00.72,0:01:03.16,TL,,0,0,0,,这是巡回赛里没有的
Dialogue: 0,0:01:05.12,0:01:07.62,TL,,0,0,0,,一次对阵打{\fs78}5{\fs68}场 {\fs78}4{\fs68}场单打
Dialogue: 0,0:01:07.62,0:01:10.52,TL,,0,0,0,,一场双打 先拿三分的赢
Dialogue: 0,0:01:11.52,0:01:14.59,TL,,0,0,0,,而且主队挑地点 挑场地
Dialogue: 0,0:01:14.59,0:01:17.26,TL,,0,0,0,,{\fs78}2008{\fs68}年 西班牙把半决赛放进了
Dialogue: 0,0:01:17.26,0:01:18.68,TL,,0,0,0,,马德里的斗牛场
Dialogue: 0,0:01:18.68,0:01:21.79,TL,,0,0,0,,戴维斯杯的主场 是真的主场
Dialogue: 0,0:01:22.82,0:01:25.64,TL,,0,0,0,,纳达尔在那儿拿下了对美国的一分
Dialogue: 0,0:01:25.64,0:01:28.89,TL,,0,0,0,,那一年 西班牙第三次捧杯
Dialogue: 0,0:01:31.82,0:01:33.33,TL,,0,0,0,,{\fs78}1985{\fs68}年的巴拉圭
Dialogue: 0,0:01:33.33,0:01:35.47,TL,,0,0,0,,观众把球场变成了球市
Dialogue: 0,0:01:35.47,0:01:37.38,TL,,0,0,0,,巴拉圭{\fs78}3{\fs68}比{\fs78}2{\fs68}淘汰法国
Dialogue: 0,0:01:37.38,0:01:39.45,TL,,0,0,0,,球迷冲进了场里
Dialogue: 0,0:01:40.82,0:01:42.47,TL,,0,0,0,,赢下第五场的佩奇
Dialogue: 0,0:01:42.47,0:01:44.54,TL,,0,0,0,,被人群举了起来
Dialogue: 0,0:01:45.32,0:01:47.92,TL,,0,0,0,,它也是许多人的最后一站
Dialogue: 0,0:01:47.92,0:01:49.35,TL,,0,0,0,,{\fs78}2024{\fs68}年{\fs78}11{\fs68}月
Dialogue: 0,0:01:49.35,0:01:51.57,TL,,0,0,0,,纳达尔职业生涯的最后一场球
Dialogue: 0,0:01:51.57,0:01:53.51,TL,,0,0,0,,就是戴维斯杯
Dialogue: 0,0:01:54.72,0:01:57.18,TL,,0,0,0,,他输给了范德赞德舒尔普
Dialogue: 0,0:01:57.18,0:01:59.74,TL,,0,0,0,,可全场没有人在意比分
Dialogue: 0,0:02:00.82,0:02:01.84,TL,,0,0,0,,冠军榜上
Dialogue: 0,0:02:01.84,0:02:04.56,TL,,0,0,0,,美国{\fs78}32{\fs68}次 澳大利亚{\fs78}28{\fs68}次
Dialogue: 0,0:02:04.56,0:02:06.06,TL,,0,0,0,,都是老账了
Dialogue: 0,0:02:06.06,0:02:07.73,TL,,0,0,0,,现在轮到意大利
Dialogue: 0,0:02:07.73,0:02:11.36,TL,,0,0,0,,二〇二三 二四 二五 三连冠
Dialogue: 0,0:02:12.82,0:02:15.70,TL,,0,0,0,,今年{\fs78}11{\fs68}月的决赛阶段在博洛尼亚
Dialogue: 0,0:02:15.70,0:02:18.13,TL,,0,0,0,,他们在自己家里卫冕
Dialogue: 0,0:02:19.02,0:02:20.54,TL,,0,0,0,,说回中国队
Dialogue: 0,0:02:20.54,0:02:23.53,TL,,0,0,0,,戴维斯杯是一座金字塔
Dialogue: 0,0:02:24.22,0:02:26.96,TL,,0,0,0,,再往下 是世界一组
Dialogue: 0,0:02:27.32,0:02:29.19,TL,,0,0,0,,世界一组 听着像第一级
Dialogue: 0,0:02:29.19,0:02:30.86,TL,,0,0,0,,其实是第三级
Dialogue: 0,0:02:30.86,0:02:34.11,TL,,0,0,0,,中国男网以前从没上过这一层
Dialogue: 0,0:02:35.42,0:02:37.31,TL,,0,0,0,,{\fs78}2023{\fs68}年他们试过一次
Dialogue: 0,0:02:37.31,0:02:39.93,TL,,0,0,0,,客场对巴西 {\fs78}0{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:02:40.92,0:02:42.39,TL,,0,0,0,,{\fs78}3{\fs68}年后的今年{\fs78}2{\fs68}月
Dialogue: 0,0:02:42.39,0:02:45.35,TL,,0,0,0,,最强阵容到齐 吴易昺拿下一分
Dialogue: 0,0:02:45.35,0:02:48.15,TL,,0,0,0,,张之臻单双打独得两分
Dialogue: 0,0:02:49.62,0:02:50.50,TL,,0,0,0,,第四场
Dialogue: 0,0:02:50.50,0:02:53.24,TL,,0,0,0,,张之臻对葡萄牙一单博尔热斯
Dialogue: 0,0:02:53.24,0:02:56.92,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68}之后 第二盘{\fs78}5{\fs68}比{\fs78}4{\fs68} 赛点
Dialogue: 0,0:02:57.42,0:02:59.46,TL,,0,0,0,,赛点 这一球落地
Dialogue: 0,0:02:59.46,0:03:02.31,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}3{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:03:02.31,0:03:04.60,TL,,0,0,0,,张之臻举起了球拍
Dialogue: 0,0:03:05.22,0:03:07.32,TL,,0,0,0,,板凳席全站起来了
Dialogue: 0,0:03:07.32,0:03:08.16,TL,,0,0,0,,中国男网
Dialogue: 0,0:03:08.16,0:03:11.15,TL,,0,0,0,,第一次升上戴维斯杯世界一组
Dialogue: 0,0:03:13.82,0:03:15.85,TL,,0,0,0,,这一周的对手是挪威
Dialogue: 0,0:03:15.85,0:03:18.05,TL,,0,0,0,,客场 特隆赫姆
Dialogue: 0,0:03:18.05,0:03:19.79,TL,,0,0,0,,挪威队领衔的是鲁德
Dialogue: 0,0:03:19.79,0:03:21.33,TL,,0,0,0,,{\fs78}3{\fs68}次大满贯亚军
Dialogue: 0,0:03:21.33,0:03:23.47,TL,,0,0,0,,现在世界第{\fs78}18{\fs68}
Dialogue: 0,0:03:24.82,0:03:27.56,TL,,0,0,0,,挪威的二单 布德科夫 谢尔
Dialogue: 0,0:03:27.56,0:03:29.96,TL,,0,0,0,,世界第{\fs78}147{\fs68}
Dialogue: 0,0:03:30.52,0:03:31.57,TL,,0,0,0,,中国队这边
Dialogue: 0,0:03:31.57,0:03:34.62,TL,,0,0,0,,吴易昺 布云朝克特都不在名单上
Dialogue: 0,0:03:34.62,0:03:36.50,TL,,0,0,0,,单打是崔杰和特日格乐
Dialogue: 0,0:03:36.50,0:03:39.62,TL,,0,0,0,,第{\fs78}447{\fs68}和第{\fs78}835{\fs68}
Dialogue: 0,0:03:40.52,0:03:43.07,TL,,0,0,0,,所以这场球的算术很清楚
Dialogue: 0,0:03:43.07,0:03:45.90,TL,,0,0,0,,鲁德那两分 先算给挪威
Dialogue: 0,0:03:48.22,0:03:51.32,TL,,0,0,0,,中国队要赢 得在另外{\fs78}3{\fs68}场里拿两场
Dialogue: 0,0:03:51.32,0:03:54.14,TL,,0,0,0,,崔杰 特日格乐各打一场谢尔
Dialogue: 0,0:03:54.14,0:03:57.61,TL,,0,0,0,,再加上张之臻和尼敦坚赞那场双打
Dialogue: 0,0:03:59.72,0:04:03.53,TL,,0,0,0,,北京时间{\fs78}19{\fs68}号凌晨{\fs78}12{\fs68}点开打 赢了
Dialogue: 0,0:04:03.53,0:04:06.34,TL,,0,0,0,,明年进资格赛 离决赛阶段一步
Dialogue: 0,0:04:06.34,0:04:09.73,TL,,0,0,0,,输了 退回附加赛 重来一年
Dialogue: 0,0:04:11.02,0:04:12.32,TL,,0,0,0,,{\fs78}126{\fs68}年
Dialogue: 0,0:04:12.32,0:04:15.36,TL,,0,0,0,,中国男网第一次坐到这张桌子边上
Dialogue: 0,0:04:15.36,0:04:18.27,TL,,0,0,0,,你觉得 他们守得住吗？
