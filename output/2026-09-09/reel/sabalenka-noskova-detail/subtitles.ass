Dialogue: 0,0:00:04.61,0:00:06.61,TL,,0,0,1124,,{\fs46}Game.{\fs68}\N拿下这一局
Dialogue: 0,0:00:06.61,0:00:09.57,TL,,0,0,1124,,{\fs46}The world number one stretched to the{\fs68}\N世界第一在纽约
Dialogue: 0,0:00:09.57,0:00:11.52,TL,,0,0,1124,,{\fs46}limit in New York,{\fs68}\N被逼到了极限
Dialogue: 0,0:00:11.62,0:00:14.16,TL,,0,0,0,,北京时间{\fs78}9{\fs68}月{\fs78}8{\fs68}日夜里{\fs78}11{\fs68}点多
Dialogue: 0,0:00:14.16,0:00:16.25,TL,,0,0,0,,美网女单四分之一决赛
Dialogue: 0,0:00:16.25,0:00:17.90,TL,,0,0,0,,世界第{\fs78}1{\fs68}萨巴伦卡
Dialogue: 0,0:00:17.90,0:00:20.35,TL,,0,0,0,,对阵温网冠军诺斯科娃
Dialogue: 0,0:00:20.35,0:00:22.12,TL,,0,0,0,,发球火力更强的人
Dialogue: 0,0:00:22.12,0:00:24.46,TL,,0,0,0,,为什么没能笑到最后？
Dialogue: 0,0:00:29.12,0:00:31.25,TL,,0,0,0,,领先怎样被追回
Dialogue: 0,0:00:32.32,0:00:35.80,TL,,0,0,0,,首盘{\fs78}5{\fs68}比{\fs78}4{\fs68} 萨巴伦卡发球胜盘
Dialogue: 0,0:00:35.80,0:00:38.20,TL,,0,0,0,,看诺斯科娃 接发抢得这么早
Dialogue: 0,0:00:38.20,0:00:40.30,TL,,0,0,0,,直接逼到对手脚下
Dialogue: 0,0:00:40.30,0:00:42.70,TL,,0,0,0,,萨巴伦卡这一盘开场{\fs78}3{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:00:42.70,0:00:44.81,TL,,0,0,0,,后来还有拉开到{\fs78}5{\fs68}比{\fs78}1{\fs68}的机会
Dialogue: 0,0:00:44.81,0:00:46.90,TL,,0,0,0,,但领先没能一直守住
Dialogue: 0,0:00:46.90,0:00:49.83,TL,,0,0,0,,比赛进了抢七 局面却又变了
Dialogue: 0,0:00:49.83,0:00:52.22,TL,,0,0,0,,诺斯科娃出现双误和失误
Dialogue: 0,0:00:52.22,0:00:54.74,TL,,0,0,0,,萨巴伦卡重新占住主动
Dialogue: 0,0:00:54.74,0:00:58.01,TL,,0,0,0,,现在{\fs78}6{\fs68}比{\fs78}1{\fs68} 接发之后继续压住底线
Dialogue: 0,0:00:58.01,0:01:01.10,TL,,0,0,0,,看她稳住这次回合 等这一分落地
Dialogue: 0,0:01:01.10,0:01:02.39,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}1{\fs68}！
Dialogue: 0,0:01:02.39,0:01:06.06,TL,,0,0,0,,先拿一盘 但这场球远没有结束
Dialogue: 0,0:01:07.22,0:01:09.33,TL,,0,0,0,,{\fs78}4{\fs68}个盘点的拉锯
Dialogue: 0,0:01:10.42,0:01:13.41,TL,,0,0,0,,第二盘的反扑 不只是发球更猛
Dialogue: 0,0:01:13.41,0:01:15.20,TL,,0,0,0,,看诺斯科娃这次处理
Dialogue: 0,0:01:15.20,0:01:17.35,TL,,0,0,0,,判断出对手的上网路线
Dialogue: 0,0:01:17.35,0:01:19.52,TL,,0,0,0,,用反手把球穿了过去
Dialogue: 0,0:01:19.52,0:01:20.85,TL,,0,0,0,,她还用放短球
Dialogue: 0,0:01:20.85,0:01:23.46,TL,,0,0,0,,切削和主动上网改变节奏
Dialogue: 0,0:01:23.46,0:01:25.77,TL,,0,0,0,,迫使萨巴伦卡不断调整
Dialogue: 0,0:01:25.77,0:01:28.92,TL,,0,0,0,,前半盘顶住破发点 随后取得破发
Dialogue: 0,0:01:28.92,0:01:31.29,TL,,0,0,0,,优势来到了捷克姑娘这一边
Dialogue: 0,0:01:31.29,0:01:34.51,TL,,0,0,0,,但来到盘点 事情又没那么简单
Dialogue: 0,0:01:34.51,0:01:37.83,TL,,0,0,0,,第一个没兑现 萨巴伦卡守住发球局
Dialogue: 0,0:01:37.83,0:01:40.27,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68}发球胜盘 第二个盘点
Dialogue: 0,0:01:40.27,0:01:42.14,TL,,0,0,0,,她还在追 你看
Dialogue: 0,0:01:42.14,0:01:43.92,TL,,0,0,0,,领先的人也得承受压力
Dialogue: 0,0:01:43.92,0:01:46.57,TL,,0,0,0,,得分机会不会自动变成比分
Dialogue: 0,0:01:46.57,0:01:48.90,TL,,0,0,0,,诺斯科娃没有退回被动防守
Dialogue: 0,0:01:48.90,0:01:51.40,TL,,0,0,0,,还是坚持自己的发球和进攻
Dialogue: 0,0:01:51.40,0:01:54.08,TL,,0,0,0,,从一个盘点 到又一个盘点
Dialogue: 0,0:01:54.08,0:01:56.64,TL,,0,0,0,,两个人都在把对手往极限推
Dialogue: 0,0:01:56.64,0:01:59.03,TL,,0,0,0,,第三个 又被救了回来
Dialogue: 0,0:01:59.03,0:02:01.57,TL,,0,0,0,,第四个盘点 重新准备
Dialogue: 0,0:02:01.57,0:02:02.74,TL,,0,0,0,,发出去！
Dialogue: 0,0:02:02.74,0:02:04.87,TL,,0,0,0,,这次终于拿下 {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:02:04.87,0:02:07.27,TL,,0,0,0,,把比赛带进决胜盘
Dialogue: 0,0:02:08.42,0:02:10.62,TL,,0,0,0,,{\fs78}2{\fs68}比{\fs78}4{\fs68}之后稳住
Dialogue: 0,0:02:11.62,0:02:13.10,TL,,0,0,0,,走到抢{\fs78}10{\fs68}之前
Dialogue: 0,0:02:13.10,0:02:15.67,TL,,0,0,0,,萨巴伦卡还闯过一道险关
Dialogue: 0,0:02:15.67,0:02:17.31,TL,,0,0,0,,决胜盘{\fs78}2{\fs68}比{\fs78}4{\fs68}落后
Dialogue: 0,0:02:17.31,0:02:18.70,TL,,0,0,0,,她先守住发球局
Dialogue: 0,0:02:18.70,0:02:20.69,TL,,0,0,0,,再把比分追成四平
Dialogue: 0,0:02:20.69,0:02:22.60,TL,,0,0,0,,关键是重新稳住回合
Dialogue: 0,0:02:22.60,0:02:24.60,TL,,0,0,0,,而不是一拍抢回来
Dialogue: 0,0:02:24.60,0:02:26.08,TL,,0,0,0,,刚才抢{\fs78}10{\fs68}第一分
Dialogue: 0,0:02:26.08,0:02:28.17,TL,,0,0,0,,两人在网前斗得这么细
Dialogue: 0,0:02:28.17,0:02:29.95,TL,,0,0,0,,诺斯科娃先拿一分
Dialogue: 0,0:02:29.95,0:02:33.04,TL,,0,0,0,,镜头来到{\fs78}4{\fs68}比{\fs78}3{\fs68} 萨巴伦卡领先
Dialogue: 0,0:02:33.04,0:02:34.46,TL,,0,0,0,,她继续把球送深
Dialogue: 0,0:02:34.46,0:02:36.15,TL,,0,0,0,,耐心寻找下一次出手
Dialogue: 0,0:02:36.15,0:02:38.17,TL,,0,0,0,,不轻易送掉主动权
Dialogue: 0,0:02:38.17,0:02:39.77,TL,,0,0,0,,这个回合还没结束
Dialogue: 0,0:02:39.77,0:02:41.34,TL,,0,0,0,,看她继续稳住回合
Dialogue: 0,0:02:41.34,0:02:44.89,TL,,0,0,0,,再多打一个来回 拿下 {\fs78}5{\fs68}比{\fs78}3{\fs68}！
Dialogue: 0,0:02:44.89,0:02:46.58,TL,,0,0,0,,守住发球
Dialogue: 0,0:02:47.42,0:02:50.66,TL,,0,0,0,,二发得分率 {\fs78}61{\fs68}%对{\fs78}43{\fs68}
Dialogue: 0,0:02:50.66,0:02:51.61,TL,,0,0,0,,{\fs78}Ace{\fs68}更少
Dialogue: 0,0:02:51.61,0:02:54.93,TL,,0,0,0,,萨巴伦卡在二发回合里拿回优势
Dialogue: 0,0:02:57.42,0:03:00.89,TL,,0,0,0,,赛点 二发 她选择外角！
Dialogue: 0,0:03:00.89,0:03:01.81,TL,,0,0,0,,{\fs78}Ace{\fs68}！
Dialogue: 0,0:03:01.81,0:03:04.73,TL,,0,0,0,,{\fs78}10{\fs68}比{\fs78}7{\fs68} 萨巴伦卡拿下比赛
Dialogue: 0,0:03:04.73,0:03:05.98,TL,,0,0,0,,她最后{\fs78}5{\fs68}次发球
Dialogue: 0,0:03:05.98,0:03:08.25,TL,,0,0,0,,{\fs78}4{\fs68}次让对手没能回过来
Dialogue: 0,0:03:08.25,0:03:09.21,TL,,0,0,0,,你觉得
Dialogue: 0,0:03:09.21,0:03:12.68,TL,,0,0,0,,这场险胜最关键的一分是哪一分？
