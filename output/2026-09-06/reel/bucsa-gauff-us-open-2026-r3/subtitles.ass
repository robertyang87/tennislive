Dialogue: 0,0:00:10.90,0:00:14.09,TL,,0,0,0,,两盘过关 但今天并不轻松
Dialogue: 0,0:00:14.90,0:00:17.69,TL,,0,0,0,,北京时间{\fs78}9{\fs68}月{\fs78}6{\fs68}日凌晨{\fs78}3{\fs68}点多
Dialogue: 0,0:00:17.69,0:00:19.01,TL,,0,0,0,,美网女单第三轮
Dialogue: 0,0:00:19.01,0:00:20.74,TL,,0,0,0,,阿瑟 阿什球场
Dialogue: 0,0:00:20.74,0:00:22.12,TL,,0,0,0,,{\fs78}4{\fs68}号种子高芙
Dialogue: 0,0:00:22.12,0:00:24.59,TL,,0,0,0,,对面是世界第{\fs78}40{\fs68}的布克沙
Dialogue: 0,0:00:24.59,0:00:27.21,TL,,0,0,0,,开局 领先的是布克沙
Dialogue: 0,0:00:28.90,0:00:32.38,TL,,0,0,0,,第三局她破了高芙的发球局 {\fs78}2{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:32.38,0:00:35.40,TL,,0,0,0,,轮到自己发球 高芙拿到两个破发点
Dialogue: 0,0:00:35.40,0:00:37.22,TL,,0,0,0,,布克沙都救了回来
Dialogue: 0,0:00:37.22,0:00:40.27,TL,,0,0,0,,这一分她也拿下 {\fs78}3{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:42.20,0:00:44.32,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}1{\fs68} 布克沙领先
Dialogue: 0,0:00:44.32,0:00:47.04,TL,,0,0,0,,两个人{\fs78}3{\fs68}年多没交过手了
Dialogue: 0,0:00:49.20,0:00:52.19,TL,,0,0,0,,上一次在{\fs78}2023{\fs68}年的印第安维尔斯
Dialogue: 0,0:00:52.19,0:00:54.25,TL,,0,0,0,,那一场高芙两盘拿下
Dialogue: 0,0:00:54.25,0:00:56.22,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}2{\fs68} 布克沙的发球局
Dialogue: 0,0:00:56.22,0:00:58.99,TL,,0,0,0,,平分 布克沙前面两个发球局
Dialogue: 0,0:00:58.99,0:01:01.09,TL,,0,0,0,,已经救回{\fs78}3{\fs68}个破发点
Dialogue: 0,0:01:01.09,0:01:03.98,TL,,0,0,0,,这一局 还守得住吗？
Dialogue: 0,0:01:06.30,0:01:08.77,TL,,0,0,0,,这一分谁都不肯先失误
Dialogue: 0,0:01:08.77,0:01:12.90,TL,,0,0,0,,高芙首盘一发只进了{\fs78}42{\fs68}% {\fs78}4{\fs68}个双误
Dialogue: 0,0:01:12.90,0:01:15.30,TL,,0,0,0,,布克沙的机会就在这儿
Dialogue: 0,0:01:16.30,0:01:19.47,TL,,0,0,0,,转播说 这是本届最好看的球之一
Dialogue: 0,0:01:19.47,0:01:21.67,TL,,0,0,0,,赢下它的是布克沙 可这一局
Dialogue: 0,0:01:21.67,0:01:24.22,TL,,0,0,0,,她还是丢了 {\fs78}3{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:26.50,0:01:29.88,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}3{\fs68}之后 高芙保发 {\fs78}4{\fs68}比{\fs78}3{\fs68}领先
Dialogue: 0,0:01:29.88,0:01:30.94,TL,,0,0,0,,布克沙发球
Dialogue: 0,0:01:30.94,0:01:33.50,TL,,0,0,0,,高芙拿到了这一局的第三个破发点
Dialogue: 0,0:01:33.50,0:01:36.06,TL,,0,0,0,,前两个 布克沙都救了回来
Dialogue: 0,0:01:36.06,0:01:37.70,TL,,0,0,0,,这一个呢？
Dialogue: 0,0:01:40.90,0:01:44.16,TL,,0,0,0,,这一分 布克沙的回球出界 破发
Dialogue: 0,0:01:44.16,0:01:47.17,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68} 高芙拿到了发球胜盘局
Dialogue: 0,0:01:47.17,0:01:50.28,TL,,0,0,0,,接发球这一项 她全场赢了一半的分
Dialogue: 0,0:01:50.28,0:01:53.93,TL,,0,0,0,,布克沙只有{\fs78}35{\fs68}% 差距就在这儿
Dialogue: 0,0:01:56.70,0:01:59.81,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68} 盘点 这一分她拿下
Dialogue: 0,0:01:59.81,0:02:02.41,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}49{\fs68}分钟
Dialogue: 0,0:02:04.90,0:02:06.85,TL,,0,0,0,,首盘高芙的一发不稳
Dialogue: 0,0:02:06.85,0:02:08.16,TL,,0,0,0,,可布克沙的二发
Dialogue: 0,0:02:08.16,0:02:10.25,TL,,0,0,0,,她{\fs78}15{\fs68}分里赢了{\fs78}10{\fs68}个
Dialogue: 0,0:02:10.25,0:02:13.20,TL,,0,0,0,,第二盘 布克沙还有机会吗？
Dialogue: 0,0:02:15.70,0:02:19.54,TL,,0,0,0,,第二盘 {\fs78}2{\fs68}比{\fs78}2{\fs68} 布克沙发球 {\fs78}30{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:02:19.54,0:02:22.35,TL,,0,0,0,,前{\fs78}4{\fs68}局谁都没拿到破发点
Dialogue: 0,0:02:22.35,0:02:25.09,TL,,0,0,0,,高芙这一盘的一发进了{\fs78}58{\fs68}%
Dialogue: 0,0:02:25.09,0:02:27.12,TL,,0,0,0,,比首盘好了不少
Dialogue: 0,0:02:29.70,0:02:32.39,TL,,0,0,0,,转播说 又一个不可思议的球
Dialogue: 0,0:02:32.39,0:02:33.96,TL,,0,0,0,,这一分是高芙的
Dialogue: 0,0:02:33.96,0:02:37.17,TL,,0,0,0,,可这一局布克沙保住了 {\fs78}3{\fs68}比{\fs78}2{\fs68}领先
Dialogue: 0,0:02:37.17,0:02:39.60,TL,,0,0,0,,她的二发这一盘赢了一半以上
Dialogue: 0,0:02:39.60,0:02:41.30,TL,,0,0,0,,比首盘好得多
Dialogue: 0,0:02:41.30,0:02:43.86,TL,,0,0,0,,这一盘 她咬住了
Dialogue: 0,0:02:45.40,0:02:46.47,TL,,0,0,0,,高芙先破发
Dialogue: 0,0:02:46.47,0:02:49.52,TL,,0,0,0,,布克沙立刻零封破回来 {\fs78}4{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:02:49.52,0:02:52.19,TL,,0,0,0,,她发球 {\fs78}0{\fs68}比{\fs78}40{\fs68} 连着八分
Dialogue: 0,0:02:52.19,0:02:54.16,TL,,0,0,0,,都归了接发的人
Dialogue: 0,0:02:55.75,0:02:58.06,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} 高芙自己的发球局
Dialogue: 0,0:02:58.06,0:03:00.23,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}0{\fs68} 赛点
Dialogue: 0,0:03:02.10,0:03:04.35,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}4{\fs68}之后 她连拿了七分
Dialogue: 0,0:03:04.35,0:03:07.83,TL,,0,0,0,,这是第八分 落地 她吼了出来
Dialogue: 0,0:03:07.83,0:03:09.65,TL,,0,0,0,,转播说 越打越顺
Dialogue: 0,0:03:09.65,0:03:12.39,TL,,0,0,0,,{\fs78}16{\fs68}强的票 她订好了
Dialogue: 0,0:03:15.70,0:03:17.99,TL,,0,0,0,,总分{\fs78}72{\fs68}比{\fs78}54{\fs68}
Dialogue: 0,0:03:17.99,0:03:20.88,TL,,0,0,0,,高芙的非受迫失误比对手还多{\fs78}3{\fs68}个
Dialogue: 0,0:03:20.88,0:03:23.24,TL,,0,0,0,,差距在接发 布克沙的发球分
Dialogue: 0,0:03:23.24,0:03:24.86,TL,,0,0,0,,她赢了一半
Dialogue: 0,0:03:26.80,0:03:28.66,TL,,0,0,0,,转播叫她前冠军
Dialogue: 0,0:03:28.66,0:03:31.19,TL,,0,0,0,,{\fs78}2023{\fs68}年她在这里捧过杯
Dialogue: 0,0:03:31.19,0:03:33.35,TL,,0,0,0,,一发不到一半 {\fs78}6{\fs68}个双误
Dialogue: 0,0:03:33.35,0:03:35.60,TL,,0,0,0,,第二周还能这么赢吗？
