Dialogue: 0,0:00:08.50,0:00:10.06,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:10.06,0:00:11.81,TL,,0,0,0,,她救下来了
Dialogue: 0,0:00:12.30,0:00:14.53,TL,,0,0,0,,决胜盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:00:14.53,0:00:18.22,TL,,0,0,0,,这样的球 历史上有人赢回来过吗？
Dialogue: 0,0:00:19.80,0:00:22.85,TL,,0,0,0,,先说最近的一次 就在两天前
Dialogue: 0,0:00:22.85,0:00:25.20,TL,,0,0,0,,美网第二轮 凯斯对邦达尔
Dialogue: 0,0:00:25.20,0:00:26.95,TL,,0,0,0,,也是决胜盘
Dialogue: 0,0:00:30.00,0:00:32.68,TL,,0,0,0,,决胜盘{\fs78}2{\fs68}比{\fs78}5{\fs68} {\fs78}5{\fs68}个赛点
Dialogue: 0,0:00:32.68,0:00:35.21,TL,,0,0,0,,前两个在对面的发球胜赛局
Dialogue: 0,0:00:35.21,0:00:37.68,TL,,0,0,0,,后{\fs78}3{\fs68}个在她自己的发球局
Dialogue: 0,0:00:40.10,0:00:43.10,TL,,0,0,0,,{\fs78}5{\fs68}个赛点 凯斯一个都没给
Dialogue: 0,0:00:46.20,0:00:48.56,TL,,0,0,0,,拖进抢{\fs78}10{\fs68} {\fs78}3{\fs68}比{\fs78}5{\fs68}还落后
Dialogue: 0,0:00:48.56,0:00:52.29,TL,,0,0,0,,然后连拿七分 {\fs78}10{\fs68}比{\fs78}5{\fs68}赢下这场球
Dialogue: 0,0:00:55.40,0:00:58.07,TL,,0,0,0,,再往前 {\fs78}2019{\fs68}年澳网八强
Dialogue: 0,0:00:58.07,0:01:00.57,TL,,0,0,0,,普利斯科娃对小威廉姆斯
Dialogue: 0,0:01:00.57,0:01:03.46,TL,,0,0,0,,决胜盘{\fs78}1{\fs68}比{\fs78}5{\fs68} 小威的赛点
Dialogue: 0,0:01:03.46,0:01:05.22,TL,,0,0,0,,一发被判脚误
Dialogue: 0,0:01:05.22,0:01:08.76,TL,,0,0,0,,第二发之后那一拍 她崴了左脚踝
Dialogue: 0,0:01:10.16,0:01:11.35,TL,,0,0,0,,{\fs78}40{\fs68}平
Dialogue: 0,0:01:11.35,0:01:13.13,TL,,0,0,0,,她弯着腰 站了一会儿
Dialogue: 0,0:01:13.13,0:01:15.27,TL,,0,0,0,,没有叫医疗暂停
Dialogue: 0,0:01:17.08,0:01:19.41,TL,,0,0,0,,接着一个双误 破发点
Dialogue: 0,0:01:19.41,0:01:23.28,TL,,0,0,0,,再一记反手失误 这一局丢了 {\fs78}2{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:23.28,0:01:26.17,TL,,0,0,0,,{\fs78}3{\fs68}个球之前她还握着赛点
Dialogue: 0,0:01:28.10,0:01:30.72,TL,,0,0,0,,保发 再破发 {\fs78}4{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:30.72,0:01:32.66,TL,,0,0,0,,普利斯科娃自己的发球局
Dialogue: 0,0:01:32.66,0:01:35.78,TL,,0,0,0,,又面对两个赛点 接着是第四个
Dialogue: 0,0:01:35.78,0:01:38.37,TL,,0,0,0,,全救了下来 {\fs78}5{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:39.80,0:01:41.17,TL,,0,0,0,,从那个赛点起
Dialogue: 0,0:01:41.17,0:01:44.42,TL,,0,0,0,,小威在自己的发球局一分都没再拿到
Dialogue: 0,0:01:44.42,0:01:46.65,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}5{\fs68} 前两个赛点没兑现
Dialogue: 0,0:01:46.65,0:01:49.68,TL,,0,0,0,,第三个赛点她拿下了 {\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:52.80,0:01:54.15,TL,,0,0,0,,连赢{\fs78}6{\fs68}局
Dialogue: 0,0:01:54.15,0:01:55.71,TL,,0,0,0,,小威廉姆斯赛后说
Dialogue: 0,0:01:55.71,0:01:58.41,TL,,0,0,0,,我不能说那几个赛点是我自己崩了
Dialogue: 0,0:01:58.41,0:02:01.24,TL,,0,0,0,,她打出了她生涯最好的网球
Dialogue: 0,0:02:03.76,0:02:07.05,TL,,0,0,0,,男子这边 {\fs78}2023{\fs68}年澳网{\fs78}16{\fs68}强
Dialogue: 0,0:02:07.05,0:02:08.77,TL,,0,0,0,,卢布列夫对鲁内
Dialogue: 0,0:02:08.77,0:02:10.98,TL,,0,0,0,,打满{\fs78}5{\fs68}盘 最后那一盘
Dialogue: 0,0:02:10.98,0:02:13.88,TL,,0,0,0,,他死了两次 又活了两次
Dialogue: 0,0:02:14.16,0:02:16.41,TL,,0,0,0,,第一次是第五盘{\fs78}2{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:02:16.41,0:02:19.27,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}6{\fs68}自己发球 救下两个赛点
Dialogue: 0,0:02:19.27,0:02:21.43,TL,,0,0,0,,第二次在抢{\fs78}10{\fs68} {\fs78}5{\fs68}比{\fs78}7{\fs68}
Dialogue: 0,0:02:21.43,0:02:24.12,TL,,0,0,0,,鲁内离胜利只差{\fs78}3{\fs68}个球
Dialogue: 0,0:02:25.16,0:02:27.11,TL,,0,0,0,,他一分一分追了回来
Dialogue: 0,0:02:27.11,0:02:29.54,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}7{\fs68} {\fs78}9{\fs68}比{\fs78}8{\fs68} 两个赛点
Dialogue: 0,0:02:29.54,0:02:32.48,TL,,0,0,0,,再拿一分 这场球就是他的
Dialogue: 0,0:02:33.76,0:02:35.32,TL,,0,0,0,,两个都没兑现
Dialogue: 0,0:02:35.32,0:02:38.37,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}9{\fs68} {\fs78}10{\fs68}比{\fs78}9{\fs68} 第三个赛点才落地
Dialogue: 0,0:02:38.37,0:02:41.58,TL,,0,0,0,,反手擦着网带弹了过去 {\fs78}11{\fs68}比{\fs78}9{\fs68}
Dialogue: 0,0:02:41.58,0:02:43.93,TL,,0,0,0,,三小时{\fs78}37{\fs68}分
Dialogue: 0,0:02:45.96,0:02:47.67,TL,,0,0,0,,{\fs78}2024{\fs68}年温网首轮
Dialogue: 0,0:02:47.67,0:02:49.27,TL,,0,0,0,,马哈奇先丢两盘
Dialogue: 0,0:02:49.27,0:02:50.93,TL,,0,0,0,,第五盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:02:50.93,0:02:53.04,TL,,0,0,0,,最后靠抢{\fs78}10{\fs68}赢了下来
Dialogue: 0,0:02:53.04,0:02:55.60,TL,,0,0,0,,而戈芬全场一个赛点都没拿到
Dialogue: 0,0:02:55.60,0:02:57.20,TL,,0,0,0,,马哈奇不是救回来的
Dialogue: 0,0:02:57.20,0:02:59.68,TL,,0,0,0,,是一局一局追回来的
Dialogue: 0,0:03:00.46,0:03:03.37,TL,,0,0,0,,再往前 {\fs78}1995{\fs68}年法网第三轮
Dialogue: 0,0:03:03.37,0:03:06.78,TL,,0,0,0,,诺沃特娜决胜盘{\fs78}5{\fs68}比{\fs78}0{\fs68} {\fs78}40{\fs68}比{\fs78}0{\fs68}领先
Dialogue: 0,0:03:06.78,0:03:09.07,TL,,0,0,0,,{\fs78}9{\fs68}个赛点先后送到她手上
Dialogue: 0,0:03:09.07,0:03:12.31,TL,,0,0,0,,鲁宾一个一个救了回来 {\fs78}8{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:03:14.46,0:03:16.16,TL,,0,0,0,,回到昨天夜里
Dialogue: 0,0:03:16.16,0:03:18.82,TL,,0,0,0,,北京时间{\fs78}11{\fs68}点多 美网第三轮
Dialogue: 0,0:03:18.82,0:03:21.75,TL,,0,0,0,,郑钦文对{\fs78}22{\fs68}号种子凯斯
Dialogue: 0,0:03:25.26,0:03:28.38,TL,,0,0,0,,首盘{\fs78}1{\fs68}比{\fs78}6{\fs68} {\fs78}23{\fs68}分钟就丢了
Dialogue: 0,0:03:28.38,0:03:30.75,TL,,0,0,0,,决胜盘一上来又连丢{\fs78}5{\fs68}局
Dialogue: 0,0:03:30.75,0:03:33.63,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68} 然后才拿回一局
Dialogue: 0,0:03:34.46,0:03:37.03,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}1{\fs68} 凯斯发球胜赛局
Dialogue: 0,0:03:37.03,0:03:39.71,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68} 赛点
Dialogue: 0,0:03:41.66,0:03:45.43,TL,,0,0,0,,凯斯接住抛球 重来 一记反手变线
Dialogue: 0,0:03:45.43,0:03:48.33,TL,,0,0,0,,下网 凯斯全场就这一个赛点
Dialogue: 0,0:03:48.33,0:03:51.42,TL,,0,0,0,,而破发点马上轮到了郑钦文
Dialogue: 0,0:03:52.46,0:03:55.18,TL,,0,0,0,,从{\fs78}0{\fs68}比{\fs78}5{\fs68}起 她连赢{\fs78}7{\fs68}局
Dialogue: 0,0:03:55.18,0:03:57.09,TL,,0,0,0,,这个夏天她还在打资格赛
Dialogue: 0,0:03:57.09,0:03:59.66,TL,,0,0,0,,手肘手术刚过一年多
Dialogue: 0,0:04:07.06,0:04:10.66,TL,,0,0,1240,,{\fs46}Olympic gold medalist{\fs68}\N奥运冠军
Dialogue: 0,0:04:10.66,0:04:13.16,TL,,0,0,1240,,{\fs46}back from the brink{\fs68}\N从悬崖边上爬了回来
Dialogue: 0,0:04:13.16,0:04:14.46,TL,,0,0,1240,,{\fs46}five love down{\fs68}\N决胜盘零比五落后
Dialogue: 0,0:04:14.56,0:04:18.32,TL,,0,0,0,,全场她只比对手多拿一分 {\fs78}98{\fs68}比{\fs78}97{\fs68}
Dialogue: 0,0:04:18.32,0:04:21.61,TL,,0,0,0,,而局数 凯斯比她多赢两局
Dialogue: 0,0:04:24.96,0:04:28.20,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68}那会儿 你会关掉电视吗？
