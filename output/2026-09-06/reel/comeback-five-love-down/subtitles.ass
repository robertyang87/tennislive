Dialogue: 0,0:00:08.50,0:00:10.06,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:10.06,0:00:11.81,TL,,0,0,0,,她救下来了
Dialogue: 0,0:00:14.30,0:00:16.53,TL,,0,0,0,,决胜盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:00:16.53,0:00:20.22,TL,,0,0,0,,这样的球 历史上有人赢回来过吗？
Dialogue: 0,0:00:23.30,0:00:26.35,TL,,0,0,0,,先说最近的一次 就在两天前
Dialogue: 0,0:00:26.35,0:00:28.70,TL,,0,0,0,,美网第二轮 凯斯对邦达尔
Dialogue: 0,0:00:28.70,0:00:30.45,TL,,0,0,0,,也是决胜盘
Dialogue: 0,0:00:33.50,0:00:36.18,TL,,0,0,0,,决胜盘{\fs78}2{\fs68}比{\fs78}5{\fs68} {\fs78}5{\fs68}个赛点
Dialogue: 0,0:00:36.18,0:00:38.71,TL,,0,0,0,,前两个在对面的发球胜赛局
Dialogue: 0,0:00:38.71,0:00:41.18,TL,,0,0,0,,后{\fs78}3{\fs68}个在她自己的发球局
Dialogue: 0,0:00:43.60,0:00:45.87,TL,,0,0,0,,{\fs78}5{\fs68}个凯斯一个都没给
Dialogue: 0,0:00:45.87,0:00:48.23,TL,,0,0,0,,拖进抢{\fs78}10{\fs68} {\fs78}3{\fs68}比{\fs78}5{\fs68}还落后
Dialogue: 0,0:00:48.23,0:00:51.95,TL,,0,0,0,,然后连拿七分 {\fs78}10{\fs68}比{\fs78}5{\fs68}赢下这场球
Dialogue: 0,0:00:54.20,0:00:56.89,TL,,0,0,0,,往前推一年 同样是美网首轮
Dialogue: 0,0:00:56.89,0:00:58.21,TL,,0,0,0,,菲律宾人伊埃拉
Dialogue: 0,0:00:58.21,0:01:00.62,TL,,0,0,0,,对手是{\fs78}14{\fs68}号种子陶森
Dialogue: 0,0:01:00.62,0:01:02.74,TL,,0,0,0,,决胜盘{\fs78}1{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:05.00,0:01:07.69,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} 陶森发球胜赛局
Dialogue: 0,0:01:07.69,0:01:09.94,TL,,0,0,0,,一次录像回放判给了伊埃拉
Dialogue: 0,0:01:09.94,0:01:12.75,TL,,0,0,0,,陶森的情绪从那儿开始散
Dialogue: 0,0:01:13.90,0:01:15.76,TL,,0,0,0,,抢{\fs78}10{\fs68}打到{\fs78}13{\fs68}比{\fs78}11{\fs68}
Dialogue: 0,0:01:15.76,0:01:17.48,TL,,0,0,0,,{\fs78}5{\fs68}个赛点才结束
Dialogue: 0,0:01:17.48,0:01:20.47,TL,,0,0,0,,菲律宾人第一次在大满贯赢下一场球
Dialogue: 0,0:01:20.47,0:01:23.09,TL,,0,0,0,,等了整整一个公开赛年代
Dialogue: 0,0:01:25.50,0:01:28.80,TL,,0,0,0,,男子这边 {\fs78}2023{\fs68}年澳网{\fs78}16{\fs68}强
Dialogue: 0,0:01:28.80,0:01:30.51,TL,,0,0,0,,卢布列夫对鲁内
Dialogue: 0,0:01:30.51,0:01:32.77,TL,,0,0,0,,打满{\fs78}5{\fs68}盘 最后那一盘
Dialogue: 0,0:01:32.77,0:01:35.43,TL,,0,0,0,,他要在两个地方各死一次
Dialogue: 0,0:01:36.10,0:01:38.35,TL,,0,0,0,,第一次是第五盘{\fs78}2{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:01:38.35,0:01:41.21,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}6{\fs68}自己发球 救下两个赛点
Dialogue: 0,0:01:41.21,0:01:43.35,TL,,0,0,0,,第二次在抢{\fs78}10{\fs68} {\fs78}5{\fs68}比{\fs78}7{\fs68}
Dialogue: 0,0:01:43.35,0:01:46.01,TL,,0,0,0,,鲁内离胜利只差三分
Dialogue: 0,0:01:47.10,0:01:49.05,TL,,0,0,0,,他一分一分追了回来
Dialogue: 0,0:01:49.05,0:01:51.68,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}8{\fs68} 赛点 抢{\fs78}10{\fs68}再拿一分
Dialogue: 0,0:01:51.68,0:01:53.72,TL,,0,0,0,,这场球就是他的
Dialogue: 0,0:01:57.10,0:01:58.51,TL,,0,0,0,,这个没兑现
Dialogue: 0,0:01:58.51,0:02:00.82,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}9{\fs68} 第三个赛点才落地
Dialogue: 0,0:02:00.82,0:02:04.16,TL,,0,0,0,,反手打在网带上弹了过去 {\fs78}11{\fs68}比{\fs78}9{\fs68}
Dialogue: 0,0:02:04.16,0:02:07.20,TL,,0,0,0,,这场球打了三小时{\fs78}37{\fs68}分
Dialogue: 0,0:02:09.30,0:02:11.00,TL,,0,0,0,,{\fs78}2024{\fs68}年温网首轮
Dialogue: 0,0:02:11.00,0:02:12.60,TL,,0,0,0,,马哈奇先丢两盘
Dialogue: 0,0:02:12.60,0:02:14.27,TL,,0,0,0,,第五盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:02:14.27,0:02:16.38,TL,,0,0,0,,最后靠抢{\fs78}10{\fs68}赢了下来
Dialogue: 0,0:02:16.38,0:02:18.76,TL,,0,0,0,,而戈芬全场一个赛点都没拿到
Dialogue: 0,0:02:18.76,0:02:21.80,TL,,0,0,0,,他是被追平的 不是被救的
Dialogue: 0,0:02:23.30,0:02:26.22,TL,,0,0,0,,再往前 {\fs78}1995{\fs68}年法网第三轮
Dialogue: 0,0:02:26.22,0:02:29.63,TL,,0,0,0,,诺沃特娜决胜盘{\fs78}5{\fs68}比{\fs78}0{\fs68} {\fs78}40{\fs68}比{\fs78}0{\fs68}领先
Dialogue: 0,0:02:29.63,0:02:31.53,TL,,0,0,0,,手里攥着{\fs78}9{\fs68}个赛点
Dialogue: 0,0:02:31.53,0:02:34.74,TL,,0,0,0,,鲁宾一个一个救了回来 {\fs78}8{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:02:37.30,0:02:39.00,TL,,0,0,0,,回到昨天夜里
Dialogue: 0,0:02:39.00,0:02:41.66,TL,,0,0,0,,北京时间{\fs78}11{\fs68}点多 美网第三轮
Dialogue: 0,0:02:41.66,0:02:44.59,TL,,0,0,0,,郑钦文对{\fs78}22{\fs68}号种子凯斯
Dialogue: 0,0:02:48.10,0:02:51.05,TL,,0,0,0,,首盘{\fs78}1{\fs68}比{\fs78}6{\fs68} {\fs78}40{\fs68}分钟就丢了
Dialogue: 0,0:02:51.05,0:02:53.46,TL,,0,0,0,,决胜盘一上来又连丢{\fs78}5{\fs68}局
Dialogue: 0,0:02:53.46,0:02:56.33,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68} 她一局都没拿到
Dialogue: 0,0:02:57.30,0:02:59.87,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}1{\fs68} 凯斯发球胜赛局
Dialogue: 0,0:02:59.87,0:03:02.55,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68} 赛点
Dialogue: 0,0:03:04.50,0:03:08.04,TL,,0,0,0,,她接住抛球 重来 一记反手变线
Dialogue: 0,0:03:08.04,0:03:10.94,TL,,0,0,0,,下网 凯斯全场就这一个赛点
Dialogue: 0,0:03:10.94,0:03:14.05,TL,,0,0,0,,而破发点马上轮到了郑钦文
Dialogue: 0,0:03:15.30,0:03:17.11,TL,,0,0,0,,然后她连赢{\fs78}7{\fs68}局
Dialogue: 0,0:03:17.11,0:03:19.07,TL,,0,0,0,,这个夏天她还在打资格赛
Dialogue: 0,0:03:19.07,0:03:21.51,TL,,0,0,0,,肘子刚做完手术一年
Dialogue: 0,0:03:24.70,0:03:26.93,TL,,0,0,0,,{\fs78}The{\fs68} {\fs78}Olympic{\fs68} {\fs78}gold{\fs68}
Dialogue: 0,0:03:26.93,0:03:29.96,TL,,0,0,0,,{\fs78}medalist{\fs68} {\fs78}has{\fs68} {\fs78}come{\fs68} {\fs78}back{\fs68}\N
Dialogue: 0,0:03:29.96,0:03:32.04,TL,,0,0,0,,奥运冠军从悬崖边上爬了回来\N
Dialogue: 0,0:03:32.04,0:03:34.11,TL,,0,0,0,,{\fs78}from{\fs68} {\fs78}the{\fs68} {\fs78}brink{\fs68}
Dialogue: 0,0:03:34.11,0:03:36.02,TL,,0,0,0,,{\fs78}five{\fs68} {\fs78}love{\fs68} {\fs78}down{\fs68}\N
Dialogue: 0,0:03:36.02,0:03:37.30,TL,,0,0,0,,决胜盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:03:37.40,0:03:41.16,TL,,0,0,0,,全场她只比对手多拿一分 {\fs78}98{\fs68}比{\fs78}97{\fs68}
Dialogue: 0,0:03:41.16,0:03:44.45,TL,,0,0,0,,而局数 凯斯比她多赢{\fs78}3{\fs68}局
Dialogue: 0,0:03:47.80,0:03:51.04,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68}那会儿 你会关掉电视吗？
