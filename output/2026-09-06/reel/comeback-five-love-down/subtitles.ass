Dialogue: 0,0:00:06.40,0:00:10.00,TL,,0,0,1240,,{\fs46}Olympic gold medalist{\fs68}\N奥运冠军
Dialogue: 0,0:00:10.00,0:00:12.50,TL,,0,0,1240,,{\fs46}back from the brink{\fs68}\N从悬崖边上爬了回来
Dialogue: 0,0:00:12.50,0:00:13.80,TL,,0,0,1240,,{\fs46}five love down{\fs68}\N决胜盘零比五落后
Dialogue: 0,0:00:13.90,0:00:16.48,TL,,0,0,0,,凯斯只有一个赛点 没兑现
Dialogue: 0,0:00:16.48,0:00:17.30,TL,,0,0,0,,两天前
Dialogue: 0,0:00:17.30,0:00:20.78,TL,,0,0,0,,从{\fs78}5{\fs68}个赛点里活下来的也是凯斯
Dialogue: 0,0:00:21.50,0:00:24.09,TL,,0,0,0,,决胜盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后还能赢回来
Dialogue: 0,0:00:24.09,0:00:25.60,TL,,0,0,0,,她不是第一个
Dialogue: 0,0:00:25.60,0:00:28.58,TL,,0,0,0,,这样的球 历史上有过几次？
Dialogue: 0,0:00:29.40,0:00:31.58,TL,,0,0,0,,先把凯斯那一场讲完
Dialogue: 0,0:00:31.58,0:00:33.50,TL,,0,0,0,,两天前 美网第二轮
Dialogue: 0,0:00:33.50,0:00:36.33,TL,,0,0,0,,她对邦达尔 也是决胜盘
Dialogue: 0,0:00:39.60,0:00:42.28,TL,,0,0,0,,决胜盘{\fs78}2{\fs68}比{\fs78}5{\fs68} {\fs78}5{\fs68}个赛点
Dialogue: 0,0:00:42.28,0:00:44.81,TL,,0,0,0,,前两个在对面的发球胜赛局
Dialogue: 0,0:00:44.81,0:00:47.28,TL,,0,0,0,,后{\fs78}3{\fs68}个在她自己的发球局
Dialogue: 0,0:00:49.70,0:00:52.70,TL,,0,0,0,,{\fs78}5{\fs68}个赛点 凯斯一个都没给
Dialogue: 0,0:00:55.80,0:00:58.16,TL,,0,0,0,,拖进抢{\fs78}10{\fs68} {\fs78}3{\fs68}比{\fs78}5{\fs68}还落后
Dialogue: 0,0:00:58.16,0:01:01.89,TL,,0,0,0,,然后连拿七分 {\fs78}10{\fs68}比{\fs78}5{\fs68}赢下这场球
Dialogue: 0,0:01:05.00,0:01:07.67,TL,,0,0,0,,再往前 {\fs78}2019{\fs68}年澳网八强
Dialogue: 0,0:01:07.67,0:01:10.17,TL,,0,0,0,,普利斯科娃对小威廉姆斯
Dialogue: 0,0:01:10.17,0:01:13.06,TL,,0,0,0,,决胜盘{\fs78}1{\fs68}比{\fs78}5{\fs68} 小威的赛点
Dialogue: 0,0:01:13.06,0:01:14.82,TL,,0,0,0,,一发被判脚误
Dialogue: 0,0:01:14.82,0:01:18.36,TL,,0,0,0,,第二发之后那一拍 她崴了左脚踝
Dialogue: 0,0:01:19.76,0:01:20.95,TL,,0,0,0,,{\fs78}40{\fs68}平
Dialogue: 0,0:01:20.95,0:01:22.73,TL,,0,0,0,,她弯着腰 站了一会儿
Dialogue: 0,0:01:22.73,0:01:24.87,TL,,0,0,0,,没有叫医疗暂停
Dialogue: 0,0:01:26.68,0:01:29.01,TL,,0,0,0,,接着一个双误 破发点
Dialogue: 0,0:01:29.01,0:01:32.88,TL,,0,0,0,,再一记反手失误 这一局丢了 {\fs78}2{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:32.88,0:01:35.77,TL,,0,0,0,,{\fs78}3{\fs68}个球之前她还握着赛点
Dialogue: 0,0:01:37.70,0:01:40.32,TL,,0,0,0,,保发 再破发 {\fs78}4{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:40.32,0:01:42.26,TL,,0,0,0,,普利斯科娃自己的发球局
Dialogue: 0,0:01:42.26,0:01:45.38,TL,,0,0,0,,又面对两个赛点 接着是第四个
Dialogue: 0,0:01:45.38,0:01:47.97,TL,,0,0,0,,全救了下来 {\fs78}5{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:49.40,0:01:50.77,TL,,0,0,0,,从那个赛点起
Dialogue: 0,0:01:50.77,0:01:54.02,TL,,0,0,0,,小威在自己的发球局一分都没再拿到
Dialogue: 0,0:01:54.02,0:01:56.25,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}5{\fs68} 前两个赛点没兑现
Dialogue: 0,0:01:56.25,0:01:59.28,TL,,0,0,0,,第三个赛点她拿下了 {\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:02:02.40,0:02:03.75,TL,,0,0,0,,连赢{\fs78}6{\fs68}局
Dialogue: 0,0:02:03.75,0:02:05.31,TL,,0,0,0,,小威廉姆斯赛后说
Dialogue: 0,0:02:05.31,0:02:08.01,TL,,0,0,0,,我不能说那几个赛点是我自己崩了
Dialogue: 0,0:02:08.01,0:02:10.84,TL,,0,0,0,,她打出了她生涯最好的网球
Dialogue: 0,0:02:13.36,0:02:16.00,TL,,0,0,0,,男子这边 {\fs78}2024{\fs68}年温网首轮
Dialogue: 0,0:02:16.00,0:02:19.24,TL,,0,0,0,,马哈奇先丢两盘 第五盘又{\fs78}0{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:02:19.24,0:02:21.03,TL,,0,0,0,,靠抢{\fs78}10{\fs68}赢了回来
Dialogue: 0,0:02:21.03,0:02:23.21,TL,,0,0,0,,而戈芬一个赛点都没拿到
Dialogue: 0,0:02:23.21,0:02:25.91,TL,,0,0,0,,他是一局一局追回来的
Dialogue: 0,0:02:26.36,0:02:29.91,TL,,0,0,0,,再往前一年 {\fs78}2023{\fs68}年澳网{\fs78}16{\fs68}强
Dialogue: 0,0:02:29.91,0:02:31.60,TL,,0,0,0,,卢布列夫对鲁内
Dialogue: 0,0:02:31.60,0:02:33.82,TL,,0,0,0,,打满{\fs78}5{\fs68}盘 最后那一盘
Dialogue: 0,0:02:33.82,0:02:36.72,TL,,0,0,0,,他死了两次 又活了两次
Dialogue: 0,0:02:36.96,0:02:39.21,TL,,0,0,0,,第一次是第五盘{\fs78}2{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:02:39.21,0:02:42.07,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}6{\fs68}自己发球 救下两个赛点
Dialogue: 0,0:02:42.07,0:02:44.23,TL,,0,0,0,,第二次在抢{\fs78}10{\fs68} {\fs78}5{\fs68}比{\fs78}7{\fs68}
Dialogue: 0,0:02:44.23,0:02:46.92,TL,,0,0,0,,鲁内离胜利只差{\fs78}3{\fs68}个球
Dialogue: 0,0:02:47.96,0:02:49.91,TL,,0,0,0,,他一分一分追了回来
Dialogue: 0,0:02:49.91,0:02:52.34,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}7{\fs68} {\fs78}9{\fs68}比{\fs78}8{\fs68} 两个赛点
Dialogue: 0,0:02:52.34,0:02:55.28,TL,,0,0,0,,再拿一分 这场球就是他的
Dialogue: 0,0:02:56.56,0:02:58.12,TL,,0,0,0,,两个都没兑现
Dialogue: 0,0:02:58.12,0:03:01.17,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}9{\fs68} {\fs78}10{\fs68}比{\fs78}9{\fs68} 第三个赛点才落地
Dialogue: 0,0:03:01.17,0:03:04.38,TL,,0,0,0,,反手擦着网带弹了过去 {\fs78}11{\fs68}比{\fs78}9{\fs68}
Dialogue: 0,0:03:04.38,0:03:06.73,TL,,0,0,0,,三小时{\fs78}37{\fs68}分
Dialogue: 0,0:03:08.76,0:03:11.33,TL,,0,0,0,,最后一条在{\fs78}31{\fs68}年前
Dialogue: 0,0:03:11.33,0:03:13.33,TL,,0,0,0,,{\fs78}1995{\fs68}年法网第三轮
Dialogue: 0,0:03:13.33,0:03:16.70,TL,,0,0,0,,诺沃特娜决胜盘{\fs78}5{\fs68}比{\fs78}0{\fs68} {\fs78}40{\fs68}比{\fs78}0{\fs68}领先
Dialogue: 0,0:03:16.70,0:03:19.06,TL,,0,0,0,,{\fs78}9{\fs68}个赛点先后送到她手上
Dialogue: 0,0:03:19.06,0:03:22.29,TL,,0,0,0,,鲁宾一个一个救了回来 {\fs78}8{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:03:22.76,0:03:26.26,TL,,0,0,0,,凯斯多赢两局 只少拿一分 输了
Dialogue: 0,0:03:26.26,0:03:29.50,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68}那会儿 你会关掉电视吗？
