Dialogue: 0,0:00:08.50,0:00:10.06,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:10.06,0:00:11.81,TL,,0,0,0,,她救下来了
Dialogue: 0,0:00:14.30,0:00:16.53,TL,,0,0,0,,决胜盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:00:16.53,0:00:20.22,TL,,0,0,0,,这样的球 历史上有人赢回来过吗？
Dialogue: 0,0:00:23.30,0:00:26.35,TL,,0,0,0,,先说最近的一次 就在两天前
Dialogue: 0,0:00:26.35,0:00:28.70,TL,,0,0,0,,美网第二轮 凯斯对邦达尔
Dialogue: 0,0:00:28.70,0:00:30.45,TL,,0,0,0,,也是决胜盘
Dialogue: 0,0:00:33.50,0:00:36.18,TL,,0,0,0,,决胜盘{\fs78}2{\fs68}比{\fs78}5{\fs68} {\fs78}5{\fs68}个赛点
Dialogue: 0,0:00:36.18,0:00:38.71,TL,,0,0,0,,前两个在对面的发球胜赛局
Dialogue: 0,0:00:38.71,0:00:41.18,TL,,0,0,0,,后{\fs78}3{\fs68}个在她自己的发球局
Dialogue: 0,0:00:43.60,0:00:45.87,TL,,0,0,0,,{\fs78}5{\fs68}个凯斯一个都没给
Dialogue: 0,0:00:45.87,0:00:48.23,TL,,0,0,0,,拖进抢{\fs78}10{\fs68} {\fs78}3{\fs68}比{\fs78}5{\fs68}还落后
Dialogue: 0,0:00:48.23,0:00:51.95,TL,,0,0,0,,然后连拿七分 {\fs78}10{\fs68}比{\fs78}5{\fs68}赢下这场球
Dialogue: 0,0:00:54.20,0:00:57.07,TL,,0,0,0,,再往前 {\fs78}2019{\fs68}年澳网八强
Dialogue: 0,0:00:57.07,0:00:59.58,TL,,0,0,0,,普利斯科娃对小威廉姆斯
Dialogue: 0,0:00:59.58,0:01:02.47,TL,,0,0,0,,决胜盘{\fs78}1{\fs68}比{\fs78}5{\fs68} 小威的赛点
Dialogue: 0,0:01:02.47,0:01:04.23,TL,,0,0,0,,一发被判脚误
Dialogue: 0,0:01:04.23,0:01:07.76,TL,,0,0,0,,第二发之后那一拍 她崴了左脚踝
Dialogue: 0,0:01:08.96,0:01:10.15,TL,,0,0,0,,{\fs78}40{\fs68}平
Dialogue: 0,0:01:10.15,0:01:11.67,TL,,0,0,0,,她弯着腰站了一会儿
Dialogue: 0,0:01:11.67,0:01:13.76,TL,,0,0,0,,没有叫医疗暂停
Dialogue: 0,0:01:15.88,0:01:18.21,TL,,0,0,0,,接着一个双误 破发点
Dialogue: 0,0:01:18.21,0:01:22.07,TL,,0,0,0,,再一记反手失误 这一局丢了 {\fs78}5{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:22.07,0:01:24.88,TL,,0,0,0,,三分之前她还握着赛点
Dialogue: 0,0:01:26.90,0:01:29.52,TL,,0,0,0,,保发 再破发 {\fs78}4{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:29.52,0:01:32.24,TL,,0,0,0,,她自己的发球局又面对两个赛点
Dialogue: 0,0:01:32.24,0:01:35.41,TL,,0,0,0,,紧接着还有第四个 全救了下来
Dialogue: 0,0:01:35.41,0:01:37.00,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:38.60,0:01:39.97,TL,,0,0,0,,从那个赛点起
Dialogue: 0,0:01:39.97,0:01:43.22,TL,,0,0,0,,小威在自己的发球局一分都没再拿到
Dialogue: 0,0:01:43.22,0:01:45.83,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}5{\fs68} 普利斯科娃的第三个赛点
Dialogue: 0,0:01:45.83,0:01:47.38,TL,,0,0,0,,前两个没兑现
Dialogue: 0,0:01:47.38,0:01:50.16,TL,,0,0,0,,这一分她拿下了 {\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:51.60,0:01:52.95,TL,,0,0,0,,连赢{\fs78}6{\fs68}局
Dialogue: 0,0:01:52.95,0:01:54.53,TL,,0,0,0,,小威廉姆斯赛后说
Dialogue: 0,0:01:54.53,0:01:57.01,TL,,0,0,0,,我不能说我在那几个赛点上崩了
Dialogue: 0,0:01:57.01,0:01:59.90,TL,,0,0,0,,她打出了她生涯最好的网球
Dialogue: 0,0:02:02.56,0:02:05.86,TL,,0,0,0,,男子这边 {\fs78}2023{\fs68}年澳网{\fs78}16{\fs68}强
Dialogue: 0,0:02:05.86,0:02:07.57,TL,,0,0,0,,卢布列夫对鲁内
Dialogue: 0,0:02:07.57,0:02:09.83,TL,,0,0,0,,打满{\fs78}5{\fs68}盘 最后那一盘
Dialogue: 0,0:02:09.83,0:02:12.49,TL,,0,0,0,,他要在两个地方各死一次
Dialogue: 0,0:02:13.16,0:02:15.41,TL,,0,0,0,,第一次是第五盘{\fs78}2{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:02:15.41,0:02:18.27,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}6{\fs68}自己发球 救下两个赛点
Dialogue: 0,0:02:18.27,0:02:20.41,TL,,0,0,0,,第二次在抢{\fs78}10{\fs68} {\fs78}5{\fs68}比{\fs78}7{\fs68}
Dialogue: 0,0:02:20.41,0:02:23.07,TL,,0,0,0,,鲁内离胜利只差三分
Dialogue: 0,0:02:24.16,0:02:26.11,TL,,0,0,0,,他一分一分追了回来
Dialogue: 0,0:02:26.11,0:02:28.74,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}8{\fs68} 赛点 抢{\fs78}10{\fs68}再拿一分
Dialogue: 0,0:02:28.74,0:02:30.78,TL,,0,0,0,,这场球就是他的
Dialogue: 0,0:02:34.16,0:02:35.57,TL,,0,0,0,,这个没兑现
Dialogue: 0,0:02:35.57,0:02:37.88,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}9{\fs68} 第三个赛点才落地
Dialogue: 0,0:02:37.88,0:02:41.22,TL,,0,0,0,,反手打在网带上弹了过去 {\fs78}11{\fs68}比{\fs78}9{\fs68}
Dialogue: 0,0:02:41.22,0:02:44.26,TL,,0,0,0,,这场球打了三小时{\fs78}37{\fs68}分
Dialogue: 0,0:02:46.36,0:02:48.06,TL,,0,0,0,,{\fs78}2024{\fs68}年温网首轮
Dialogue: 0,0:02:48.06,0:02:49.66,TL,,0,0,0,,马哈奇先丢两盘
Dialogue: 0,0:02:49.66,0:02:51.33,TL,,0,0,0,,第五盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:02:51.33,0:02:53.44,TL,,0,0,0,,最后靠抢{\fs78}10{\fs68}赢了下来
Dialogue: 0,0:02:53.44,0:02:55.82,TL,,0,0,0,,而戈芬全场一个赛点都没拿到
Dialogue: 0,0:02:55.82,0:02:58.86,TL,,0,0,0,,他是被追平的 不是被救的
Dialogue: 0,0:03:00.36,0:03:03.28,TL,,0,0,0,,再往前 {\fs78}1995{\fs68}年法网第三轮
Dialogue: 0,0:03:03.28,0:03:06.69,TL,,0,0,0,,诺沃特娜决胜盘{\fs78}5{\fs68}比{\fs78}0{\fs68} {\fs78}40{\fs68}比{\fs78}0{\fs68}领先
Dialogue: 0,0:03:06.69,0:03:08.59,TL,,0,0,0,,手里攥着{\fs78}9{\fs68}个赛点
Dialogue: 0,0:03:08.59,0:03:11.80,TL,,0,0,0,,鲁宾一个一个救了回来 {\fs78}8{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:03:14.36,0:03:16.06,TL,,0,0,0,,回到昨天夜里
Dialogue: 0,0:03:16.06,0:03:18.72,TL,,0,0,0,,北京时间{\fs78}11{\fs68}点多 美网第三轮
Dialogue: 0,0:03:18.72,0:03:21.65,TL,,0,0,0,,郑钦文对{\fs78}22{\fs68}号种子凯斯
Dialogue: 0,0:03:25.16,0:03:28.11,TL,,0,0,0,,首盘{\fs78}1{\fs68}比{\fs78}6{\fs68} {\fs78}40{\fs68}分钟就丢了
Dialogue: 0,0:03:28.11,0:03:30.52,TL,,0,0,0,,决胜盘一上来又连丢{\fs78}5{\fs68}局
Dialogue: 0,0:03:30.52,0:03:33.39,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68} 她一局都没拿到
Dialogue: 0,0:03:34.36,0:03:36.93,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}1{\fs68} 凯斯发球胜赛局
Dialogue: 0,0:03:36.93,0:03:39.61,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68} 赛点
Dialogue: 0,0:03:41.56,0:03:45.10,TL,,0,0,0,,她接住抛球 重来 一记反手变线
Dialogue: 0,0:03:45.10,0:03:48.00,TL,,0,0,0,,下网 凯斯全场就这一个赛点
Dialogue: 0,0:03:48.00,0:03:51.11,TL,,0,0,0,,而破发点马上轮到了郑钦文
Dialogue: 0,0:03:52.36,0:03:54.17,TL,,0,0,0,,然后她连赢{\fs78}7{\fs68}局
Dialogue: 0,0:03:54.17,0:03:56.13,TL,,0,0,0,,这个夏天她还在打资格赛
Dialogue: 0,0:03:56.13,0:03:58.57,TL,,0,0,0,,肘子刚做完手术一年
Dialogue: 0,0:04:01.76,0:04:03.99,TL,,0,0,0,,{\fs78}The{\fs68} {\fs78}Olympic{\fs68} {\fs78}gold{\fs68}
Dialogue: 0,0:04:03.99,0:04:07.02,TL,,0,0,0,,{\fs78}medalist{\fs68} {\fs78}has{\fs68} {\fs78}come{\fs68} {\fs78}back{\fs68}\N
Dialogue: 0,0:04:07.02,0:04:09.10,TL,,0,0,0,,奥运冠军从悬崖边上爬了回来\N
Dialogue: 0,0:04:09.10,0:04:11.17,TL,,0,0,0,,{\fs78}from{\fs68} {\fs78}the{\fs68} {\fs78}brink{\fs68}
Dialogue: 0,0:04:11.17,0:04:13.08,TL,,0,0,0,,{\fs78}five{\fs68} {\fs78}love{\fs68} {\fs78}down{\fs68}\N
Dialogue: 0,0:04:13.08,0:04:14.36,TL,,0,0,0,,决胜盘{\fs78}0{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:04:14.46,0:04:18.22,TL,,0,0,0,,全场她只比对手多拿一分 {\fs78}98{\fs68}比{\fs78}97{\fs68}
Dialogue: 0,0:04:18.22,0:04:21.51,TL,,0,0,0,,而局数 凯斯比她多赢{\fs78}3{\fs68}局
Dialogue: 0,0:04:24.86,0:04:28.10,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68}那会儿 你会关掉电视吗？
