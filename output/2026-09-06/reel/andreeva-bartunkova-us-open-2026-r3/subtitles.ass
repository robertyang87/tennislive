Dialogue: 0,0:00:11.40,0:00:12.89,TL,,0,0,0,,今年的法网冠军
Dialogue: 0,0:00:12.89,0:00:15.19,TL,,0,0,0,,第一次打进美网第二周
Dialogue: 0,0:00:18.90,0:00:21.44,TL,,0,0,0,,北京时间{\fs78}9{\fs68}月{\fs78}6{\fs68}日凌晨一点
Dialogue: 0,0:00:21.44,0:00:24.01,TL,,0,0,0,,美网第三轮 {\fs78}17{\fs68}号球场
Dialogue: 0,0:00:24.01,0:00:25.80,TL,,0,0,0,,{\fs78}5{\fs68}号种子安德烈耶娃
Dialogue: 0,0:00:25.80,0:00:27.62,TL,,0,0,0,,对面是世界第{\fs78}34{\fs68}
Dialogue: 0,0:00:27.62,0:00:30.16,TL,,0,0,0,,{\fs78}20{\fs68}岁的捷克人巴尔通科娃
Dialogue: 0,0:00:30.16,0:00:32.72,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}2{\fs68} 她的破发点
Dialogue: 0,0:00:34.50,0:00:36.71,TL,,0,0,0,,破发成功 {\fs78}5{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:36.71,0:00:38.72,TL,,0,0,0,,两个人此前从没交过手
Dialogue: 0,0:00:38.72,0:00:40.34,TL,,0,0,0,,{\fs78}20{\fs68}岁的巴尔通科娃
Dialogue: 0,0:00:40.34,0:00:42.97,TL,,0,0,0,,前两轮她赢了谢里夫和塔 玛丽亚
Dialogue: 0,0:00:42.97,0:00:44.29,TL,,0,0,0,,才走到这儿
Dialogue: 0,0:00:44.29,0:00:46.63,TL,,0,0,0,,自己的发球局 {\fs78}40{\fs68}比{\fs78}15{\fs68}
Dialogue: 0,0:00:46.63,0:00:48.18,TL,,0,0,0,,第一个盘点
Dialogue: 0,0:00:49.20,0:00:51.93,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} 首盘{\fs78}33{\fs68}分钟
Dialogue: 0,0:00:51.93,0:00:54.98,TL,,0,0,0,,这一盘她上网{\fs78}13{\fs68}次拿下{\fs78}12{\fs68}分
Dialogue: 0,0:00:54.98,0:00:58.22,TL,,0,0,0,,巴尔通科娃的二发 只赢了三分
Dialogue: 0,0:00:59.60,0:01:00.78,TL,,0,0,0,,第二盘第一局
Dialogue: 0,0:01:00.78,0:01:03.34,TL,,0,0,0,,巴尔通科娃发球 {\fs78}15{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:03.34,0:01:04.71,TL,,0,0,0,,这一分来回很久
Dialogue: 0,0:01:04.71,0:01:07.27,TL,,0,0,0,,安德烈耶娃全场的非受迫失误
Dialogue: 0,0:01:07.27,0:01:09.57,TL,,0,0,0,,只有{\fs78}15{\fs68}个 对手{\fs78}19{\fs68}个
Dialogue: 0,0:01:09.57,0:01:11.43,TL,,0,0,0,,就是这么磨出来的
Dialogue: 0,0:01:11.43,0:01:13.07,TL,,0,0,0,,转播直接喊出来
Dialogue: 0,0:01:13.07,0:01:15.89,TL,,0,0,0,,她到底是怎么追到这个球的？
Dialogue: 0,0:01:16.60,0:01:18.09,TL,,0,0,0,,这一局两个破发点
Dialogue: 0,0:01:18.09,0:01:20.51,TL,,0,0,0,,第二个她兑现了 {\fs78}1{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:20.51,0:01:21.79,TL,,0,0,0,,接着自己发球
Dialogue: 0,0:01:21.79,0:01:24.47,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}15{\fs68} 又一个长回合
Dialogue: 0,0:01:24.47,0:01:27.95,TL,,0,0,0,,这一盘要打{\fs78}65{\fs68}分钟 首盘的两倍
Dialogue: 0,0:01:27.95,0:01:30.90,TL,,0,0,0,,转播说 又是一个了不起的球
Dialogue: 0,0:01:34.45,0:01:36.11,TL,,0,0,0,,{\fs78}30{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:01:36.11,0:01:38.49,TL,,0,0,0,,巴尔通科娃拿到这一局的破发点
Dialogue: 0,0:01:38.49,0:01:41.14,TL,,0,0,0,,也是她全场第一个破发点
Dialogue: 0,0:01:45.15,0:01:47.47,TL,,0,0,0,,她兑现了 {\fs78}1{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:49.10,0:01:52.23,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}1{\fs68} 巴尔通科娃发球 {\fs78}0{\fs68}比{\fs78}30{\fs68}
Dialogue: 0,0:01:52.23,0:01:54.13,TL,,0,0,0,,这一分安德烈耶娃拿下
Dialogue: 0,0:01:54.13,0:01:56.83,TL,,0,0,0,,可这一局她的破发点没兑现
Dialogue: 0,0:01:56.83,0:01:58.60,TL,,0,0,0,,之后是集锦里没有的
Dialogue: 0,0:01:58.60,0:02:00.05,TL,,0,0,0,,{\fs78}2{\fs68}比{\fs78}4{\fs68}她再被破
Dialogue: 0,0:02:00.05,0:02:02.84,TL,,0,0,0,,巴尔通科娃全场就两个破发点
Dialogue: 0,0:02:02.84,0:02:04.18,TL,,0,0,0,,两个都破了
Dialogue: 0,0:02:04.18,0:02:05.50,TL,,0,0,0,,她又立刻破回来
Dialogue: 0,0:02:05.50,0:02:07.55,TL,,0,0,0,,一路打到{\fs78}6{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:02:09.40,0:02:12.25,TL,,0,0,0,,抢七 安德烈耶娃{\fs78}4{\fs68}比{\fs78}0{\fs68}领先
Dialogue: 0,0:02:12.25,0:02:14.49,TL,,0,0,0,,然后被巴尔通科娃连追四分
Dialogue: 0,0:02:14.49,0:02:17.12,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}4{\fs68} 巴尔通科娃发球
Dialogue: 0,0:02:18.70,0:02:20.05,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:02:20.05,0:02:21.89,TL,,0,0,0,,巴尔通科娃连拿五分
Dialogue: 0,0:02:21.89,0:02:23.91,TL,,0,0,0,,离这一盘只差两分
Dialogue: 0,0:02:23.91,0:02:27.11,TL,,0,0,0,,安德烈耶娃全场二发得分率{\fs78}62{\fs68}%
Dialogue: 0,0:02:27.11,0:02:29.73,TL,,0,0,0,,巴尔通科娃只有{\fs78}32{\fs68}%
Dialogue: 0,0:02:29.73,0:02:32.09,TL,,0,0,0,,安德烈耶娃接下来连赢两分
Dialogue: 0,0:02:32.09,0:02:34.13,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}5{\fs68} 赛点
Dialogue: 0,0:02:35.90,0:02:38.15,TL,,0,0,0,,巴尔通科娃发球 赛点
Dialogue: 0,0:02:38.15,0:02:41.34,TL,,0,0,0,,又是一个长回合 全场最后一分
Dialogue: 0,0:02:41.34,0:02:44.54,TL,,0,0,0,,转播那一句是 米拉的魔法
Dialogue: 0,0:02:46.00,0:02:49.30,TL,,0,0,0,,最后一拍是她的制胜分 {\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:02:49.30,0:02:52.91,TL,,0,0,0,,全场她上网{\fs78}22{\fs68}次 拿下{\fs78}19{\fs68}分
Dialogue: 0,0:02:55.55,0:02:57.10,TL,,0,0,0,,{\fs78}19{\fs68}岁的{\fs78}5{\fs68}号种子
Dialogue: 0,0:02:57.10,0:03:00.75,TL,,0,0,0,,前{\fs78}3{\fs68}次来美网 最远只到第三轮
Dialogue: 0,0:03:03.05,0:03:06.34,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}0{\fs68}领先能被追到{\fs78}4{\fs68}比{\fs78}5{\fs68} 下一轮
Dialogue: 0,0:03:06.34,0:03:08.93,TL,,0,0,0,,她还会给对手这样的机会吗？
