Dialogue: 0,0:00:06.55,0:00:08.29,TL,,0,0,0,,第二盘他{\fs78}5{\fs68}比{\fs78}1{\fs68}领先
Dialogue: 0,0:00:08.29,0:00:09.93,TL,,0,0,0,,眼看就要收工
Dialogue: 0,0:00:09.93,0:00:10.99,TL,,0,0,0,,一场雨之后
Dialogue: 0,0:00:10.99,0:00:12.38,TL,,0,0,0,,对手连赢{\fs78}5{\fs68}局
Dialogue: 0,0:00:12.38,0:00:13.96,TL,,0,0,0,,反过来{\fs78}6{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:13.96,0:00:16.36,TL,,0,0,0,,最后是一个抢七救了他
Dialogue: 0,0:00:17.65,0:00:20.51,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}18{\fs68}号凌晨两点开球
Dialogue: 0,0:00:20.51,0:00:22.27,TL,,0,0,0,,辛辛那提第三轮
Dialogue: 0,0:00:22.27,0:00:25.98,TL,,0,0,0,,首盘五平 费里发球被逼到破发点
Dialogue: 0,0:00:26.45,0:00:28.17,TL,,0,0,0,,费里这一局丢了
Dialogue: 0,0:00:28.17,0:00:30.50,TL,,0,0,0,,德米纳尔发球拿下第一盘
Dialogue: 0,0:00:33.35,0:00:35.72,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} {\fs78}47{\fs68}分钟
Dialogue: 0,0:00:38.35,0:00:40.02,TL,,0,0,0,,第二盘{\fs78}1{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:40.02,0:00:42.75,TL,,0,0,0,,费里发球 一上来就{\fs78}0{\fs68}比{\fs78}30{\fs68}落后
Dialogue: 0,0:00:42.75,0:00:44.83,TL,,0,0,0,,接着是{\fs78}15{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:47.05,0:00:48.39,TL,,0,0,0,,{\fs78}15{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:48.39,0:00:50.77,TL,,0,0,0,,一个破发点 直接兑现
Dialogue: 0,0:00:50.77,0:00:51.92,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:54.95,0:00:57.81,TL,,0,0,0,,德米纳尔这一场{\fs78}32{\fs68}个非受迫失误
Dialogue: 0,0:00:57.81,0:00:59.39,TL,,0,0,0,,费里{\fs78}49{\fs68}个
Dialogue: 0,0:01:01.45,0:01:04.08,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}3{\fs68} 轮到德米纳尔发球
Dialogue: 0,0:01:04.08,0:01:06.94,TL,,0,0,0,,费里在这一局拿到{\fs78}4{\fs68}个破发点
Dialogue: 0,0:01:09.65,0:01:12.09,TL,,0,0,0,,{\fs78}4{\fs68}个 一个都没兑现
Dialogue: 0,0:01:12.09,0:01:13.92,TL,,0,0,0,,这一局打了{\fs78}12{\fs68}个小分
Dialogue: 0,0:01:13.92,0:01:16.18,TL,,0,0,0,,德米纳尔守了下来 {\fs78}1{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:19.05,0:01:20.30,TL,,0,0,0,,轮到费里发球
Dialogue: 0,0:01:20.30,0:01:22.18,TL,,0,0,0,,这一局同样拉锯
Dialogue: 0,0:01:22.18,0:01:24.12,TL,,0,0,0,,德米纳尔两次拿到破发点
Dialogue: 0,0:01:24.12,0:01:26.03,TL,,0,0,0,,第二个兑现 {\fs78}1{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:28.65,0:01:31.48,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}5{\fs68} 费里发球 {\fs78}15{\fs68}平
Dialogue: 0,0:01:31.48,0:01:33.10,TL,,0,0,0,,这时候雨下了下来
Dialogue: 0,0:01:33.10,0:01:35.18,TL,,0,0,0,,转播打出 比赛暂停
Dialogue: 0,0:01:38.75,0:01:41.61,TL,,0,0,0,,回来之后 费里先保住发球局
Dialogue: 0,0:01:41.61,0:01:42.46,TL,,0,0,0,,{\fs78}2{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:42.46,0:01:45.68,TL,,0,0,0,,他在德米纳尔的发球局上拿到破发点
Dialogue: 0,0:01:47.95,0:01:52.16,TL,,0,0,0,,破了 然后再保发 {\fs78}3{\fs68}比{\fs78}5{\fs68} {\fs78}4{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:52.16,0:01:53.31,TL,,0,0,0,,从雨停到这儿
Dialogue: 0,0:01:53.31,0:01:54.75,TL,,0,0,0,,费里一局没丢
Dialogue: 0,0:01:54.75,0:01:56.88,TL,,0,0,0,,而德米纳尔一局没赢
Dialogue: 0,0:01:58.95,0:02:01.55,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}5{\fs68} 他还得再守一次
Dialogue: 0,0:02:01.55,0:02:04.95,TL,,0,0,0,,守住了 接下来再破一次 五平
Dialogue: 0,0:02:04.95,0:02:06.26,TL,,0,0,0,,第二盘打到这里
Dialogue: 0,0:02:06.26,0:02:08.31,TL,,0,0,0,,已经一小时{\fs78}19{\fs68}分
Dialogue: 0,0:02:10.05,0:02:12.29,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}5{\fs68} 费里反超
Dialogue: 0,0:02:12.29,0:02:13.92,TL,,0,0,0,,轮到德米纳尔发球
Dialogue: 0,0:02:13.92,0:02:14.96,TL,,0,0,0,,输了这一局
Dialogue: 0,0:02:14.96,0:02:16.82,TL,,0,0,0,,比赛就要打第三盘
Dialogue: 0,0:02:16.82,0:02:18.21,TL,,0,0,0,,他保了下来
Dialogue: 0,0:02:19.55,0:02:21.13,TL,,0,0,0,,抢七打到{\fs78}3{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:02:21.13,0:02:23.15,TL,,0,0,0,,赛点在德米纳尔手里
Dialogue: 0,0:02:24.65,0:02:26.09,TL,,0,0,0,,两小时零六分
Dialogue: 0,0:02:26.09,0:02:27.52,TL,,0,0,0,,雨停之后那{\fs78}5{\fs68}局
Dialogue: 0,0:02:27.52,0:02:29.04,TL,,0,0,0,,改变了什么吗？
