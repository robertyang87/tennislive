Dialogue: 0,0:00:05.45,0:00:06.92,TL,,0,0,0,,第二盘{\fs78}43{\fs68}分钟
Dialogue: 0,0:00:06.92,0:00:09.07,TL,,0,0,0,,佩古拉只失误了{\fs78}3{\fs68}次
Dialogue: 0,0:00:11.65,0:00:12.79,TL,,0,0,0,,输的那个人
Dialogue: 0,0:00:12.79,0:00:14.72,TL,,0,0,0,,制胜分还多{\fs78}7{\fs68}记
Dialogue: 0,0:00:17.25,0:00:19.78,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}18{\fs68}号早上{\fs78}7{\fs68}点
Dialogue: 0,0:00:19.78,0:00:21.56,TL,,0,0,0,,辛辛那提第三轮
Dialogue: 0,0:00:21.56,0:00:23.00,TL,,0,0,0,,世界第{\fs78}3{\fs68}的佩古拉
Dialogue: 0,0:00:23.00,0:00:25.46,TL,,0,0,0,,对世界第{\fs78}28{\fs68}的纳瓦罗
Dialogue: 0,0:00:27.55,0:00:28.93,TL,,0,0,0,,开场第三局
Dialogue: 0,0:00:28.93,0:00:30.69,TL,,0,0,0,,纳瓦罗先被破
Dialogue: 0,0:00:32.15,0:00:34.96,TL,,0,0,0,,纳瓦罗马上破了回来 {\fs78}2{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:36.85,0:00:38.24,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}3{\fs68}那一局
Dialogue: 0,0:00:38.24,0:00:40.59,TL,,0,0,0,,两个人来回打了{\fs78}5{\fs68}次平分
Dialogue: 0,0:00:43.35,0:00:46.44,TL,,0,0,0,,第一盘就是这样一局一局咬下来的
Dialogue: 0,0:00:46.44,0:00:48.85,TL,,0,0,0,,纳瓦罗手里两个破发点没兑现
Dialogue: 0,0:00:48.85,0:00:51.20,TL,,0,0,0,,自己那一局又救回{\fs78}3{\fs68}个
Dialogue: 0,0:00:53.55,0:00:56.65,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}5{\fs68} 纳瓦罗{\fs78}15{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:56.65,0:00:59.64,TL,,0,0,0,,这一局她是从{\fs78}0{\fs68}比{\fs78}40{\fs68}爬回来的
Dialogue: 0,0:01:00.75,0:01:02.91,TL,,0,0,0,,又一个破发点救掉了
Dialogue: 0,0:01:02.91,0:01:05.49,TL,,0,0,0,,整整一局 她都站在悬崖边上
Dialogue: 0,0:01:05.49,0:01:07.28,TL,,0,0,0,,一分一分往回拽
Dialogue: 0,0:01:08.75,0:01:10.48,TL,,0,0,0,,第三个没救下来
Dialogue: 0,0:01:10.48,0:01:11.60,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:01:13.05,0:01:15.29,TL,,0,0,0,,两个盘点 第二个落地
Dialogue: 0,0:01:15.29,0:01:17.17,TL,,0,0,0,,第一盘打了{\fs78}59{\fs68}分钟
Dialogue: 0,0:01:17.17,0:01:19.48,TL,,0,0,0,,比这场球的后半程还长
Dialogue: 0,0:01:21.95,0:01:24.37,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} 她拿下了第一盘
Dialogue: 0,0:01:29.55,0:01:30.76,TL,,0,0,0,,第二盘一上来
Dialogue: 0,0:01:30.76,0:01:32.64,TL,,0,0,0,,纳瓦罗连丢{\fs78}4{\fs68}局
Dialogue: 0,0:01:32.64,0:01:35.26,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}4{\fs68} 她一局都没赢到
Dialogue: 0,0:01:37.25,0:01:38.62,TL,,0,0,0,,{\fs78}30{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:01:38.62,0:01:40.36,TL,,0,0,0,,又是同样的一分
Dialogue: 0,0:01:40.36,0:01:42.70,TL,,0,0,0,,纳瓦罗这一次也没保住
Dialogue: 0,0:01:44.95,0:01:47.85,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}4{\fs68} 纳瓦罗终于破回一局
Dialogue: 0,0:01:47.85,0:01:50.78,TL,,0,0,0,,可比赛已经过了那个能改的地方
Dialogue: 0,0:01:52.65,0:01:54.66,TL,,0,0,0,,两局之后就是赛点
Dialogue: 0,0:01:54.66,0:01:56.57,TL,,0,0,0,,从第一盘{\fs78}5{\fs68}比{\fs78}5{\fs68}算起
Dialogue: 0,0:01:56.57,0:01:58.94,TL,,0,0,0,,纳瓦罗一共只赢了两局
Dialogue: 0,0:02:00.35,0:02:02.15,TL,,0,0,0,,制胜分{\fs78}30{\fs68}比{\fs78}23{\fs68}
Dialogue: 0,0:02:02.15,0:02:03.57,TL,,0,0,0,,纳瓦罗还多{\fs78}7{\fs68}记
Dialogue: 0,0:02:03.57,0:02:05.93,TL,,0,0,0,,非受迫失误{\fs78}34{\fs68}比{\fs78}17{\fs68}
Dialogue: 0,0:02:05.93,0:02:07.79,TL,,0,0,0,,正好是对面的两倍
Dialogue: 0,0:02:07.79,0:02:09.68,TL,,0,0,0,,你更信哪一个数？
