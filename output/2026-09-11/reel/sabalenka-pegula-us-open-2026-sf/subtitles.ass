Dialogue: 0,0:00:05.00,0:00:07.34,TL,,0,0,0,,一小时{\fs78}20{\fs68}分钟 两盘
Dialogue: 0,0:00:07.34,0:00:09.44,TL,,0,0,0,,世界第{\fs78}1{\fs68}把世界第{\fs78}3{\fs68}送走
Dialogue: 0,0:00:09.44,0:00:11.86,TL,,0,0,0,,又一次站进美网决赛
Dialogue: 0,0:00:13.20,0:00:15.78,TL,,0,0,0,,北京时间{\fs78}9{\fs68}月{\fs78}11{\fs68}号早上{\fs78}7{\fs68}点多
Dialogue: 0,0:00:15.78,0:00:17.50,TL,,0,0,0,,阿瑟 阿什球场
Dialogue: 0,0:00:17.50,0:00:19.06,TL,,0,0,0,,美网女单半决赛
Dialogue: 0,0:00:19.06,0:00:21.60,TL,,0,0,0,,萨巴伦卡对阵佩古拉
Dialogue: 0,0:00:23.00,0:00:25.55,TL,,0,0,0,,第四局 发球的是佩古拉
Dialogue: 0,0:00:25.55,0:00:29.55,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68} 萨巴伦卡的第一个破发点
Dialogue: 0,0:00:30.30,0:00:31.44,TL,,0,0,0,,那个破发点
Dialogue: 0,0:00:31.44,0:00:34.27,TL,,0,0,0,,被佩古拉一记救球化解掉了
Dialogue: 0,0:00:34.27,0:00:36.62,TL,,0,0,0,,两个人就这么一局一局咬下去
Dialogue: 0,0:00:36.62,0:00:39.32,TL,,0,0,0,,谁也破不了谁 {\fs78}4{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:42.80,0:00:45.64,TL,,0,0,0,,{\fs78}40{\fs68}平 轮到萨巴伦卡发球
Dialogue: 0,0:00:45.64,0:00:47.68,TL,,0,0,0,,佩古拉全场唯一的破发点
Dialogue: 0,0:00:47.68,0:00:49.42,TL,,0,0,0,,她没能兑现
Dialogue: 0,0:00:49.96,0:00:51.05,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}5{\fs68}之后
Dialogue: 0,0:00:51.05,0:00:53.47,TL,,0,0,0,,萨巴伦卡先保住自己的发球局
Dialogue: 0,0:00:53.47,0:00:54.88,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}5{\fs68}领先
Dialogue: 0,0:00:54.88,0:00:58.14,TL,,0,0,0,,下一局 轮到对面发球保盘
Dialogue: 0,0:01:02.01,0:01:02.95,TL,,0,0,0,,换过边来
Dialogue: 0,0:01:02.95,0:01:06.34,TL,,0,0,0,,佩古拉这个发球局一上来就丢了三分
Dialogue: 0,0:01:06.34,0:01:10.09,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}15{\fs68} 第二个盘点 {\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:11.04,0:01:12.20,TL,,0,0,0,,{\fs78}43{\fs68}分钟
Dialogue: 0,0:01:12.20,0:01:15.12,TL,,0,0,0,,而这一盘的总分她只多两分
Dialogue: 0,0:01:15.97,0:01:17.64,TL,,0,0,0,,第二盘{\fs78}2{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:17.64,0:01:18.87,TL,,0,0,0,,接下来这一局
Dialogue: 0,0:01:18.87,0:01:21.14,TL,,0,0,0,,会变成整场最长的一局
Dialogue: 0,0:01:21.14,0:01:24.41,TL,,0,0,0,,萨巴伦卡在这儿连着拿到{\fs78}4{\fs68}个破发点
Dialogue: 0,0:01:27.61,0:01:28.80,TL,,0,0,0,,{\fs78}40{\fs68}平
Dialogue: 0,0:01:28.80,0:01:30.43,TL,,0,0,0,,第一个破发点她没兑现
Dialogue: 0,0:01:30.43,0:01:31.53,TL,,0,0,0,,第二个也没有
Dialogue: 0,0:01:31.53,0:01:34.35,TL,,0,0,0,,两次被佩古拉扳回平分
Dialogue: 0,0:01:37.51,0:01:40.34,TL,,0,0,0,,第四个破发点 她占先
Dialogue: 0,0:01:41.49,0:01:43.72,TL,,0,0,0,,这一次没再被追回来
Dialogue: 0,0:01:43.72,0:01:47.61,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}1{\fs68} 她转过身 面向自己的包厢
Dialogue: 0,0:01:49.26,0:01:51.06,TL,,0,0,0,,佩古拉这一盘的二发
Dialogue: 0,0:01:51.06,0:01:52.95,TL,,0,0,0,,{\fs78}11{\fs68}分只拿到两分
Dialogue: 0,0:01:52.95,0:01:56.05,TL,,0,0,0,,全场{\fs78}19{\fs68}个 她赢了{\fs78}5{\fs68}个
Dialogue: 0,0:01:56.96,0:01:59.31,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}2{\fs68} {\fs78}40{\fs68}比{\fs78}30{\fs68}
Dialogue: 0,0:01:59.31,0:02:00.81,TL,,0,0,0,,萨巴伦卡的赛点
Dialogue: 0,0:02:00.81,0:02:03.32,TL,,0,0,0,,同时也是一个破发点
Dialogue: 0,0:02:07.77,0:02:10.55,TL,,0,0,0,,一小时{\fs78}20{\fs68}分钟 比赛结束
Dialogue: 0,0:02:11.28,0:02:12.67,TL,,0,0,0,,网前握手
Dialogue: 0,0:02:12.67,0:02:16.15,TL,,0,0,0,,两年前的美网决赛 就是这两个人
Dialogue: 0,0:02:17.78,0:02:19.59,TL,,0,0,0,,那一场{\fs78}7{\fs68}比{\fs78}7{\fs68}比五
Dialogue: 0,0:02:19.59,0:02:22.02,TL,,0,0,0,,是她的第一个美网冠军
Dialogue: 0,0:02:22.63,0:02:25.79,TL,,0,0,0,,她连续第四年站进美网决赛
Dialogue: 0,0:02:26.56,0:02:30.32,TL,,0,0,0,,看台上站起来的那些人 是她的团队
Dialogue: 0,0:02:30.73,0:02:33.96,TL,,0,0,0,,另一场半决赛是高芙对莱巴金娜
Dialogue: 0,0:02:33.96,0:02:35.91,TL,,0,0,0,,谁拦得住她？
