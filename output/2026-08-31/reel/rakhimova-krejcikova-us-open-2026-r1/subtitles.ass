Dialogue: 0,0:00:06.77,0:00:09.54,TL,,0,0,0,,两个盘点 {\fs78}6{\fs68}个赛点 整场球
Dialogue: 0,0:00:09.54,0:00:12.13,TL,,0,0,0,,克雷吉茨科娃一共救下{\fs78}8{\fs68}个
Dialogue: 0,0:00:12.13,0:00:13.64,TL,,0,0,0,,{\fs78}8{\fs68}个全都救了下来
Dialogue: 0,0:00:13.64,0:00:16.63,TL,,0,0,0,,最后还是没能把这场球拿回去
Dialogue: 0,0:00:20.09,0:00:22.80,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}30{\fs68}号夜里{\fs78}11{\fs68}点多
Dialogue: 0,0:00:22.80,0:00:24.24,TL,,0,0,0,,纽约{\fs78}17{\fs68}号球场
Dialogue: 0,0:00:24.24,0:00:25.88,TL,,0,0,0,,美网女单第一轮
Dialogue: 0,0:00:25.88,0:00:28.34,TL,,0,0,0,,{\fs78}27{\fs68}号种子克雷吉茨科娃
Dialogue: 0,0:00:28.34,0:00:31.30,TL,,0,0,0,,拿过两个大满贯单打冠军
Dialogue: 0,0:00:31.67,0:00:34.87,TL,,0,0,0,,对面的拉希莫娃 世界第{\fs78}92{\fs68}位
Dialogue: 0,0:00:34.87,0:00:37.45,TL,,0,0,0,,{\fs78}5{\fs68}年前的美网两人交过一次手
Dialogue: 0,0:00:37.45,0:00:39.90,TL,,0,0,0,,赢的是克雷吉茨科娃
Dialogue: 0,0:00:41.76,0:00:44.33,TL,,0,0,0,,第一盘从{\fs78}0{\fs68}比{\fs78}1{\fs68}路缠到六平
Dialogue: 0,0:00:44.33,0:00:46.73,TL,,0,0,0,,两个人谁也没能真正把比分拉开
Dialogue: 0,0:00:46.73,0:00:49.02,TL,,0,0,0,,最后只能进抢七决胜
Dialogue: 0,0:00:49.02,0:00:49.89,TL,,0,0,0,,抢七里
Dialogue: 0,0:00:49.89,0:00:52.57,TL,,0,0,0,,克雷吉茨科娃很快落到{\fs78}2{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:00:52.57,0:00:56.09,TL,,0,0,0,,对面一口气 握住了整整{\fs78}4{\fs68}个盘点
Dialogue: 0,0:01:02.26,0:01:04.63,TL,,0,0,0,,克雷吉茨科娃连救两个盘点
Dialogue: 0,0:01:04.63,0:01:07.61,TL,,0,0,0,,把抢七从{\fs78}2{\fs68}比{\fs78}6{\fs68} 拉到{\fs78}4{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:01:07.61,0:01:08.85,TL,,0,0,0,,第三个盘点上
Dialogue: 0,0:01:08.85,0:01:11.40,TL,,0,0,0,,拉希莫娃没有再给机会
Dialogue: 0,0:01:12.54,0:01:15.66,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}4{\fs68} 第一盘归了拉希莫娃
Dialogue: 0,0:01:17.24,0:01:20.12,TL,,0,0,0,,{\fs78}65{\fs68}分钟 一盘没了
Dialogue: 0,0:01:20.81,0:01:21.83,TL,,0,0,0,,第二盘开局
Dialogue: 0,0:01:21.83,0:01:24.68,TL,,0,0,0,,克雷吉茨科娃还{\fs78}2{\fs68}比{\fs78}1{\fs68}领先过
Dialogue: 0,0:01:24.68,0:01:26.07,TL,,0,0,0,,可接下来的{\fs78}5{\fs68}局
Dialogue: 0,0:01:26.07,0:01:27.95,TL,,0,0,0,,一局都没能留住
Dialogue: 0,0:01:27.95,0:01:31.24,TL,,0,0,0,,拉希莫娃{\fs78}5{\fs68}比{\fs78}2{\fs68}发球胜赛 {\fs78}40{\fs68}比{\fs78}15{\fs68}
Dialogue: 0,0:01:31.24,0:01:32.76,TL,,0,0,0,,第一个赛点
Dialogue: 0,0:01:34.56,0:01:37.14,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68} 第二个赛点
Dialogue: 0,0:01:37.14,0:01:39.33,TL,,0,0,0,,克雷吉茨科娃又救掉一个
Dialogue: 0,0:01:39.33,0:01:40.94,TL,,0,0,0,,比分回到平分
Dialogue: 0,0:01:40.94,0:01:42.62,TL,,0,0,0,,发球胜赛的那一局
Dialogue: 0,0:01:42.62,0:01:44.88,TL,,0,0,0,,到这儿才刚刚开始
Dialogue: 0,0:01:45.55,0:01:47.83,TL,,0,0,0,,拉希莫娃立刻又拿到占先
Dialogue: 0,0:01:47.83,0:01:49.20,TL,,0,0,0,,第三个赛点
Dialogue: 0,0:01:49.20,0:01:52.08,TL,,0,0,0,,克雷吉茨科娃全场{\fs78}22{\fs68}个制胜分
Dialogue: 0,0:01:52.08,0:01:53.24,TL,,0,0,0,,对面只有{\fs78}8{\fs68}个
Dialogue: 0,0:01:53.24,0:01:56.10,TL,,0,0,0,,她不是被压着打的那一个 分
Dialogue: 0,0:01:56.10,0:01:58.44,TL,,0,0,0,,是一分一分自己丢的
Dialogue: 0,0:02:01.42,0:02:02.89,TL,,0,0,0,,第五个赛点
Dialogue: 0,0:02:02.89,0:02:05.37,TL,,0,0,0,,这一局前前后后打到{\fs78}5{\fs68}次平分
Dialogue: 0,0:02:05.37,0:02:07.14,TL,,0,0,0,,每一次把比分拉回平手
Dialogue: 0,0:02:07.14,0:02:09.81,TL,,0,0,0,,都是克雷吉茨科娃自己换来的
Dialogue: 0,0:02:09.81,0:02:12.64,TL,,0,0,0,,{\fs78}27{\fs68}号种子 两届大满贯冠军
Dialogue: 0,0:02:12.64,0:02:14.01,TL,,0,0,0,,此刻只差一分
Dialogue: 0,0:02:14.01,0:02:16.66,TL,,0,0,0,,就要在纽约的第一天出局
Dialogue: 0,0:02:19.04,0:02:20.53,TL,,0,0,0,,第六个赛点
Dialogue: 0,0:02:20.53,0:02:23.42,TL,,0,0,0,,克雷吉茨科娃还在把球送回去
Dialogue: 0,0:02:23.42,0:02:25.90,TL,,0,0,0,,这一局从{\fs78}40{\fs68}比{\fs78}15{\fs68}走到现在
Dialogue: 0,0:02:25.90,0:02:27.42,TL,,0,0,0,,拉希莫娃已经{\fs78}6{\fs68}次
Dialogue: 0,0:02:27.42,0:02:30.30,TL,,0,0,0,,站在了赢下这场球的位置上 {\fs78}6{\fs68}次
Dialogue: 0,0:02:30.30,0:02:32.12,TL,,0,0,0,,都没能收下来
Dialogue: 0,0:02:33.89,0:02:35.08,TL,,0,0,0,,第七个
Dialogue: 0,0:02:35.08,0:02:38.59,TL,,0,0,0,,这一次 拉希莫娃没有再给她机会
Dialogue: 0,0:02:45.97,0:02:48.68,TL,,0,0,0,,一小时{\fs78}53{\fs68}分钟 比赛结束
Dialogue: 0,0:02:48.68,0:02:51.44,TL,,0,0,0,,制胜分她多打出{\fs78}14{\fs68}个
Dialogue: 0,0:02:51.99,0:02:55.16,TL,,0,0,0,,非受迫失误 也多了{\fs78}15{\fs68}个
Dialogue: 0,0:02:56.58,0:02:59.94,TL,,0,0,0,,{\fs78}149{\fs68}分里 她只少了九分
Dialogue: 0,0:03:01.29,0:03:02.81,TL,,0,0,0,,是拉希莫娃太强
Dialogue: 0,0:03:02.81,0:03:05.73,TL,,0,0,0,,还是克雷吉茨科娃自己丢的？
