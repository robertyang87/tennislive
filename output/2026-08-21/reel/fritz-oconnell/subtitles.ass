Dialogue: 0,0:00:03.05,0:00:04.59,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:04.59,0:00:06.17,TL,,0,0,0,,弗里茨四连胜
Dialogue: 0,0:00:07.41,0:00:10.00,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}20{\fs68}号早上{\fs78}8{\fs68}点多
Dialogue: 0,0:00:10.00,0:00:13.24,TL,,0,0,0,,辛辛那提网球公开赛男单{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛
Dialogue: 0,0:00:13.24,0:00:16.26,TL,,0,0,0,,弗里茨迎战资格赛突围的奥康奈尔
Dialogue: 0,0:00:19.25,0:00:21.46,TL,,0,0,0,,奥康奈尔今年{\fs78}32{\fs68}岁
Dialogue: 0,0:00:21.46,0:00:23.61,TL,,0,0,0,,从资格赛一路杀进正赛
Dialogue: 0,0:00:23.61,0:00:25.34,TL,,0,0,0,,才站到这一轮
Dialogue: 0,0:00:28.29,0:00:30.54,TL,,0,0,0,,次轮他先拿下首盘{\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:30.54,0:00:32.16,TL,,0,0,0,,次盘鲁德背伤发作
Dialogue: 0,0:00:32.16,0:00:34.68,TL,,0,0,0,,一度反超{\fs78}2{\fs68}比{\fs78}1{\fs68}仍撑不住弃赛
Dialogue: 0,0:00:34.68,0:00:37.10,TL,,0,0,0,,第三轮丰塞卡又因腹伤退赛
Dialogue: 0,0:00:37.10,0:00:38.68,TL,,0,0,0,,他直接晋级
Dialogue: 0,0:00:38.68,0:00:39.82,TL,,0,0,0,,算上资格赛
Dialogue: 0,0:00:39.82,0:00:42.86,TL,,0,0,0,,到这一轮他只完整打过两场比赛
Dialogue: 0,0:00:43.45,0:00:44.54,TL,,0,0,0,,首盘{\fs78}2{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:44.54,0:00:47.02,TL,,0,0,0,,奥康奈尔一口气救回{\fs78}3{\fs68}个破发点
Dialogue: 0,0:00:47.02,0:00:48.27,TL,,0,0,0,,才把这一局保住
Dialogue: 0,0:00:48.27,0:00:49.50,TL,,0,0,0,,比分继续缠斗
Dialogue: 0,0:00:49.50,0:00:51.34,TL,,0,0,0,,一路顶到{\fs78}4{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:54.77,0:00:56.49,TL,,0,0,0,,但弗里茨顶住了压力
Dialogue: 0,0:00:56.49,0:00:58.36,TL,,0,0,0,,先是稳稳保发到{\fs78}5{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:58.36,0:00:59.97,TL,,0,0,0,,紧接着奥康奈尔发球
Dialogue: 0,0:00:59.97,0:01:02.36,TL,,0,0,0,,弗里茨第一个破发点就是盘点
Dialogue: 0,0:01:02.36,0:01:05.14,TL,,0,0,0,,一击拿下 没有给第二次机会 {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:05.14,0:01:06.96,TL,,0,0,0,,首盘顺利到手
Dialogue: 0,0:01:10.25,0:01:13.44,TL,,0,0,0,,次盘弗里茨很快建立起领先 {\fs78}2{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:13.44,0:01:14.99,TL,,0,0,0,,此后双方一路互保
Dialogue: 0,0:01:14.99,0:01:16.17,TL,,0,0,0,,战至{\fs78}4{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:16.17,0:01:18.55,TL,,0,0,0,,一个破发点都没有出现过
Dialogue: 0,0:01:22.41,0:01:25.03,TL,,0,0,0,,全场弗里茨只被逼到一个破发点
Dialogue: 0,0:01:25.03,0:01:26.11,TL,,0,0,0,,而且守住了
Dialogue: 0,0:01:26.11,0:01:27.86,TL,,0,0,0,,{\fs78}10{\fs68}个发球局一个没丢
Dialogue: 0,0:01:27.86,0:01:29.93,TL,,0,0,0,,奥康奈尔{\fs78}7{\fs68}次面对破发点
Dialogue: 0,0:01:29.93,0:01:31.36,TL,,0,0,0,,扛下来{\fs78}5{\fs68}次
Dialogue: 0,0:01:33.25,0:01:36.18,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68} 弗里茨一连逼出{\fs78}3{\fs68}个破发点
Dialogue: 0,0:01:36.18,0:01:38.82,TL,,0,0,0,,第三个 终于兑现 {\fs78}5{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:41.53,0:01:43.01,TL,,0,0,0,,两人第四次交手
Dialogue: 0,0:01:43.01,0:01:44.11,TL,,0,0,0,,弗里茨全胜
Dialogue: 0,0:01:44.11,0:01:45.75,TL,,0,0,0,,第一次在硬地上
Dialogue: 0,0:01:45.75,0:01:47.01,TL,,0,0,0,,网前这个握手
Dialogue: 0,0:01:47.01,0:01:50.03,TL,,0,0,0,,奥康奈尔从资格赛走到今天 配得上
Dialogue: 0,0:01:50.03,0:01:52.21,TL,,0,0,0,,但如果对手都打满全场
Dialogue: 0,0:01:52.21,0:01:53.94,TL,,0,0,0,,今天会不一样吗？
