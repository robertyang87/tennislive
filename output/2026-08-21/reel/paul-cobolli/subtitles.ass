Dialogue: 0,0:00:09.65,0:00:11.81,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}21{\fs68}号凌晨
Dialogue: 0,0:00:11.81,0:00:14.51,TL,,0,0,0,,辛辛那提大师赛男单{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛
Dialogue: 0,0:00:14.51,0:00:16.37,TL,,0,0,0,,保罗迎战科博利
Dialogue: 0,0:00:22.17,0:00:23.90,TL,,0,0,0,,保罗开局率先破发
Dialogue: 0,0:00:23.90,0:00:26.42,TL,,0,0,0,,靠速度和防守不断把球救回来
Dialogue: 0,0:00:26.42,0:00:28.24,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68}拿下首盘
Dialogue: 0,0:00:34.69,0:00:35.62,TL,,0,0,0,,但第二盘
Dialogue: 0,0:00:35.62,0:00:38.70,TL,,0,0,0,,科博利开始把回合拉回自己的节奏
Dialogue: 0,0:00:44.77,0:00:46.10,TL,,0,0,0,,保罗一次双误之后
Dialogue: 0,0:00:46.10,0:00:48.08,TL,,0,0,0,,科博利把比分带到{\fs78}3{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:48.08,0:00:49.98,TL,,0,0,0,,并继续守住领先
Dialogue: 0,0:01:00.95,0:01:01.65,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:01.65,0:01:04.08,TL,,0,0,0,,科博利在自己的发球局拿下这一盘
Dialogue: 0,0:01:04.08,0:01:05.94,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68}扳平总比分
Dialogue: 0,0:01:15.95,0:01:18.26,TL,,0,0,0,,决胜盘两个人继续拉锯
Dialogue: 0,0:01:18.26,0:01:21.06,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}3{\fs68}之后每一局都变得更重
Dialogue: 0,0:01:31.73,0:01:33.37,TL,,0,0,0,,科博利{\fs78}5{\fs68}比{\fs78}4{\fs68}领先
Dialogue: 0,0:01:33.37,0:01:35.19,TL,,0,0,0,,来到保罗的发球局
Dialogue: 0,0:01:35.19,0:01:36.63,TL,,0,0,0,,他拿到两个赛点
Dialogue: 0,0:01:36.63,0:01:38.54,TL,,0,0,0,,第二个没有再错过
Dialogue: 0,0:01:51.41,0:01:53.36,TL,,0,0,0,,连续第四场{\fs78}3{\fs68}盘大战
Dialogue: 0,0:01:53.36,0:01:55.56,TL,,0,0,0,,科博利又一次走了出来
