Dialogue: 0,0:00:09.41,0:00:11.01,TL,,0,0,0,,一小时{\fs78}27{\fs68}分钟
Dialogue: 0,0:00:11.01,0:00:12.12,TL,,0,0,0,,两个{\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:12.12,0:00:13.75,TL,,0,0,0,,莱巴金娜晋级
Dialogue: 0,0:00:16.61,0:00:19.24,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}20{\fs68}号凌晨快{\fs78}4{\fs68}点
Dialogue: 0,0:00:19.24,0:00:21.47,TL,,0,0,0,,辛辛那提女单{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛
Dialogue: 0,0:00:21.47,0:00:23.59,TL,,0,0,0,,施奈德对阵莱巴金娜
Dialogue: 0,0:00:26.61,0:00:28.60,TL,,0,0,0,,施奈德开局保发
Dialogue: 0,0:00:28.60,0:00:30.17,TL,,0,0,0,,接着轮到莱巴金娜
Dialogue: 0,0:00:30.17,0:00:33.14,TL,,0,0,0,,她一上来就送出{\fs78}3{\fs68}个连续破发点
Dialogue: 0,0:00:35.83,0:00:38.68,TL,,0,0,0,,随后又两次让施奈德拿到占先
Dialogue: 0,0:00:38.68,0:00:39.91,TL,,0,0,0,,{\fs78}5{\fs68}个破发点
Dialogue: 0,0:00:39.91,0:00:41.97,TL,,0,0,0,,莱巴金娜全部救下
Dialogue: 0,0:00:42.27,0:00:45.83,TL,,0,0,0,,首盘后面 施奈德又得到两次机会
Dialogue: 0,0:00:45.83,0:00:47.11,TL,,0,0,0,,比分{\fs78}3{\fs68}比{\fs78}4{\fs68}时
Dialogue: 0,0:00:47.11,0:00:49.25,TL,,0,0,0,,她拿到全场第七个破发点
Dialogue: 0,0:00:49.25,0:00:50.49,TL,,0,0,0,,还是没能兑现
Dialogue: 0,0:00:50.49,0:00:51.62,TL,,0,0,0,,莱巴金娜顶住
Dialogue: 0,0:00:51.62,0:00:53.31,TL,,0,0,0,,保发来到{\fs78}5{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:54.35,0:00:55.93,TL,,0,0,0,,整盘{\fs78}7{\fs68}个破发点
Dialogue: 0,0:00:55.93,0:00:57.97,TL,,0,0,0,,施奈德一个都没拿下
Dialogue: 0,0:00:57.97,0:01:00.57,TL,,0,0,0,,莱巴金娜却抓住自己的第一次机会
Dialogue: 0,0:01:00.57,0:01:02.48,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68}收下首盘
Dialogue: 0,0:01:05.85,0:01:08.29,TL,,0,0,0,,第二盘双方各自保发到{\fs78}1{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:08.29,0:01:10.33,TL,,0,0,0,,第三局莱巴金娜完成破发
Dialogue: 0,0:01:10.33,0:01:11.74,TL,,0,0,0,,{\fs78}2{\fs68}比{\fs78}1{\fs68}领先
Dialogue: 0,0:01:11.74,0:01:13.43,TL,,0,0,0,,这一局唯一的破发点
Dialogue: 0,0:01:13.43,0:01:15.11,TL,,0,0,0,,她一次就兑现
Dialogue: 0,0:01:16.55,0:01:18.72,TL,,0,0,0,,此后莱巴金娜一路保发
Dialogue: 0,0:01:18.72,0:01:21.12,TL,,0,0,0,,第二盘没有再送出破发点
Dialogue: 0,0:01:21.12,0:01:22.75,TL,,0,0,0,,她全场{\fs78}10{\fs68}个发球局
Dialogue: 0,0:01:22.75,0:01:24.25,TL,,0,0,0,,一个都没丢
Dialogue: 0,0:01:28.09,0:01:30.26,TL,,0,0,0,,施奈德没有立刻松手
Dialogue: 0,0:01:30.26,0:01:31.57,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}5{\fs68}落后时
Dialogue: 0,0:01:31.57,0:01:34.04,TL,,0,0,0,,她从{\fs78}40{\fs68}比{\fs78}15{\fs68}被追到平分
Dialogue: 0,0:01:34.04,0:01:35.41,TL,,0,0,0,,又救下一个赛点
Dialogue: 0,0:01:35.41,0:01:37.18,TL,,0,0,0,,保发追到{\fs78}4{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:37.97,0:01:39.75,TL,,0,0,0,,制胜分{\fs78}26{\fs68}比{\fs78}9{\fs68}
Dialogue: 0,0:01:39.75,0:01:41.95,TL,,0,0,0,,非受迫失误{\fs78}12{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:44.11,0:01:47.15,TL,,0,0,0,,刚输给斯瓦泰克 下轮再碰
Dialogue: 0,0:01:47.15,0:01:48.26,TL,,0,0,0,,你压谁？
