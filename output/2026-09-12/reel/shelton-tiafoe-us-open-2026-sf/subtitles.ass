Dialogue: 0,0:00:07.05,0:00:09.37,TL,,0,0,0,,他走进这座球场的时候还不知道
Dialogue: 0,0:00:09.37,0:00:13.17,TL,,0,0,0,,等在后面的是生涯第一个大满贯决赛
Dialogue: 0,0:00:14.50,0:00:16.78,TL,,0,0,0,,北京时间{\fs78}9{\fs68}月{\fs78}12{\fs68}号快{\fs78}8{\fs68}点
Dialogue: 0,0:00:16.78,0:00:18.32,TL,,0,0,0,,阿瑟 阿什球场
Dialogue: 0,0:00:18.32,0:00:20.30,TL,,0,0,0,,美网男单半决赛
Dialogue: 0,0:00:21.90,0:00:23.79,TL,,0,0,0,,场上是两个美国人
Dialogue: 0,0:00:23.79,0:00:25.43,TL,,0,0,0,,大满贯历史上第一次
Dialogue: 0,0:00:25.43,0:00:28.50,TL,,0,0,0,,半决赛由两个美国黑人球员包办
Dialogue: 0,0:00:28.50,0:00:31.45,TL,,0,0,0,,{\fs78}8{\fs68}号种子对{\fs78}11{\fs68}号种子
Dialogue: 0,0:00:33.10,0:00:35.05,TL,,0,0,0,,第一盘是蒂亚福的
Dialogue: 0,0:00:35.05,0:00:37.56,TL,,0,0,0,,谢尔顿送掉{\fs78}14{\fs68}个非受迫失误
Dialogue: 0,0:00:37.56,0:00:39.79,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}6{\fs68}丢掉这一盘
Dialogue: 0,0:00:41.40,0:00:43.53,TL,,0,0,0,,第二盘他像换了个人
Dialogue: 0,0:00:43.53,0:00:45.11,TL,,0,0,0,,制胜分{\fs78}13{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:00:45.11,0:00:48.14,TL,,0,0,0,,非受迫失误从{\fs78}14{\fs68}个掉到{\fs78}4{\fs68}个
Dialogue: 0,0:00:48.14,0:00:50.16,TL,,0,0,0,,这一分 蒂亚福在发球
Dialogue: 0,0:00:50.16,0:00:52.34,TL,,0,0,0,,{\fs78}15{\fs68}比{\fs78}30{\fs68}落后
Dialogue: 0,0:00:56.80,0:00:59.86,TL,,0,0,0,,谢尔顿的二发均速{\fs78}165{\fs68}公里
Dialogue: 0,0:00:59.86,0:01:01.68,TL,,0,0,0,,蒂亚福{\fs78}142{\fs68}
Dialogue: 0,0:01:01.68,0:01:06.02,TL,,0,0,0,,一发成功率 他{\fs78}75{\fs68}% 蒂亚福{\fs78}57{\fs68}%
Dialogue: 0,0:01:06.02,0:01:07.02,TL,,0,0,0,,整场下来
Dialogue: 0,0:01:07.02,0:01:10.26,TL,,0,0,0,,蒂亚福的二发只拿到{\fs78}38{\fs68}%的分
Dialogue: 0,0:01:10.26,0:01:13.79,TL,,0,0,0,,发球这一项 一整场都是一边倒
Dialogue: 0,0:01:15.40,0:01:17.29,TL,,0,0,0,,第三盘更胶着
Dialogue: 0,0:01:17.29,0:01:19.89,TL,,0,0,0,,这一盘谢尔顿拿到{\fs78}7{\fs68}个破发点
Dialogue: 0,0:01:19.89,0:01:22.04,TL,,0,0,0,,蒂亚福救下了{\fs78}5{\fs68}个
Dialogue: 0,0:01:24.60,0:01:27.09,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} 第三盘也归了谢尔顿
Dialogue: 0,0:01:27.09,0:01:28.76,TL,,0,0,0,,盘数{\fs78}2{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:28.76,0:01:30.14,TL,,0,0,0,,但这场球还没完
Dialogue: 0,0:01:30.14,0:01:32.04,TL,,0,0,0,,第四盘打了一个多小时
Dialogue: 0,0:01:32.04,0:01:34.24,TL,,0,0,0,,是全场最长的一盘
Dialogue: 0,0:01:34.24,0:01:36.04,TL,,0,0,0,,蒂亚福拿到{\fs78}3{\fs68}个破发点
Dialogue: 0,0:01:36.04,0:01:37.60,TL,,0,0,0,,一个都没兑现
Dialogue: 0,0:01:37.60,0:01:39.84,TL,,0,0,0,,谁也不肯先松手
Dialogue: 0,0:01:44.00,0:01:46.65,TL,,0,0,0,,这一局 蒂亚福{\fs78}0{\fs68}比{\fs78}30{\fs68}落后
Dialogue: 0,0:01:46.65,0:01:49.42,TL,,0,0,0,,还是把发球局保了下来 {\fs78}2{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:49.42,0:01:51.44,TL,,0,0,0,,这一盘谢尔顿发了{\fs78}8{\fs68}个{\fs78}Ace{\fs68}
Dialogue: 0,0:01:51.44,0:01:53.76,TL,,0,0,0,,一发得分率{\fs78}85{\fs68}%
Dialogue: 0,0:01:53.76,0:01:56.84,TL,,0,0,0,,第四盘{\fs78}12{\fs68}局 只有最后一局被破
Dialogue: 0,0:01:56.84,0:01:59.55,TL,,0,0,0,,在这之前谁都破不掉谁
Dialogue: 0,0:02:04.00,0:02:07.01,TL,,0,0,0,,轮到谢尔顿发球 {\fs78}40{\fs68}比{\fs78}15{\fs68}
Dialogue: 0,0:02:07.01,0:02:09.31,TL,,0,0,0,,这场球他一共发了{\fs78}20{\fs68}个{\fs78}Ace{\fs68}
Dialogue: 0,0:02:09.31,0:02:10.81,TL,,0,0,0,,蒂亚福只有{\fs78}3{\fs68}个
Dialogue: 0,0:02:10.81,0:02:13.90,TL,,0,0,0,,制胜分{\fs78}47{\fs68}比{\fs78}27{\fs68} 也是他的
Dialogue: 0,0:02:13.90,0:02:16.40,TL,,0,0,0,,僵局一直撑到{\fs78}5{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:02:19.60,0:02:21.56,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}6{\fs68} 蒂亚福发球
Dialogue: 0,0:02:21.56,0:02:25.48,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}40{\fs68} 谢尔顿一口气拿到{\fs78}3{\fs68}个赛点
Dialogue: 0,0:02:29.62,0:02:31.57,TL,,0,0,0,,蒂亚福救回来一个
Dialogue: 0,0:02:31.57,0:02:34.46,TL,,0,0,0,,{\fs78}15{\fs68}比{\fs78}40{\fs68} 还剩两个
Dialogue: 0,0:02:34.46,0:02:37.17,TL,,0,0,0,,第二个赛点上 他在底线站了很久
Dialogue: 0,0:02:37.17,0:02:39.65,TL,,0,0,0,,球迟迟没有抛起来
Dialogue: 0,0:02:42.32,0:02:44.68,TL,,0,0,0,,第二个赛点 蒂亚福双误
Dialogue: 0,0:02:44.68,0:02:48.20,TL,,0,0,0,,三小时{\fs78}17{\fs68}分 比赛就这样结束了
Dialogue: 0,0:02:51.97,0:02:54.45,TL,,0,0,0,,赢的那个人没有先庆祝
Dialogue: 0,0:02:54.45,0:02:57.37,TL,,0,0,0,,两个美国人在网前抱了很久
Dialogue: 0,0:02:57.37,0:03:01.06,TL,,0,0,0,,解说的原话是 他抱住了自己的朋友
Dialogue: 0,0:03:02.67,0:03:05.68,TL,,0,0,0,,阿什{\fs78}1972{\fs68}年打进美网决赛
Dialogue: 0,0:03:05.68,0:03:06.93,TL,,0,0,0,,之后{\fs78}54{\fs68}年
Dialogue: 0,0:03:06.93,0:03:10.47,TL,,0,0,0,,再没有美国黑人男子站上过这里
Dialogue: 0,0:03:11.67,0:03:14.78,TL,,0,0,0,,{\fs78}23{\fs68}岁 第一次打进大满贯决赛
Dialogue: 0,0:03:14.78,0:03:18.12,TL,,0,0,0,,周日对兹维列夫 他拿得下吗？
