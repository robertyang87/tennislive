Dialogue: 0,0:00:00.10,0:00:01.54,TL,,0,0,0,,八张门票发完了
Dialogue: 0,0:00:01.54,0:00:03.62,TL,,0,0,0,,只有一张是送的
Dialogue: 0,0:00:03.97,0:00:05.08,TL,,0,0,0,,这块牌子
Dialogue: 0,0:00:05.08,0:00:08.55,TL,,0,0,0,,{\fs78}9{\fs68}月这一周在{\fs78}7{\fs68}个城市各举了一次
Dialogue: 0,0:00:09.07,0:00:12.91,TL,,0,0,0,,上面写着 决赛圈见 博洛尼亚
Dialogue: 0,0:00:13.77,0:00:16.42,TL,,0,0,0,,八支队伍 {\fs78}11{\fs68}月打{\fs78}6{\fs68}天
Dialogue: 0,0:00:16.42,0:00:19.79,TL,,0,0,0,,而这八张门票 来自一座塔
Dialogue: 0,0:00:21.07,0:00:24.21,TL,,0,0,0,,塔尖是决赛圈 底下第一层叫资格赛
Dialogue: 0,0:00:24.21,0:00:26.47,TL,,0,0,0,,再往下才是世界组
Dialogue: 0,0:00:27.67,0:00:29.53,TL,,0,0,0,,{\fs78}2{\fs68}月{\fs78}26{\fs68}支队伍开打
Dialogue: 0,0:00:29.53,0:00:31.92,TL,,0,0,0,,{\fs78}9{\fs68}月剩下{\fs78}14{\fs68}支
Dialogue: 0,0:00:32.67,0:00:34.14,TL,,0,0,0,,德国在哈雷
Dialogue: 0,0:00:34.14,0:00:36.55,TL,,0,0,0,,兹维列夫两场单打全赢
Dialogue: 0,0:00:36.55,0:00:39.44,TL,,0,0,0,,最后一场{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:40.07,0:00:41.83,TL,,0,0,0,,真正拧过来的是双打
Dialogue: 0,0:00:41.83,0:00:43.26,TL,,0,0,0,,克拉维茨和皮茨
Dialogue: 0,0:00:43.26,0:00:45.83,TL,,0,0,0,,赢了梅克蒂奇和帕维奇
Dialogue: 0,0:00:46.47,0:00:49.59,TL,,0,0,0,,然后他们也举起了那块牌子
Dialogue: 0,0:00:51.17,0:00:53.70,TL,,0,0,0,,布拉格是{\fs78}7{\fs68}场里唯一打满的
Dialogue: 0,0:00:53.70,0:00:56.88,TL,,0,0,0,,前{\fs78}4{\fs68}场{\fs78}2{\fs68}比{\fs78}2{\fs68} 第五场是活的
Dialogue: 0,0:00:58.07,0:01:01.40,TL,,0,0,0,,莱赫奇卡{\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}7{\fs68}比{\fs78}5{\fs68}拿下勒纳 钱
Dialogue: 0,0:01:01.40,0:01:03.04,TL,,0,0,0,,捷克{\fs78}3{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:03.77,0:01:05.02,TL,,0,0,0,,被他们送走的
Dialogue: 0,0:01:05.02,0:01:08.07,TL,,0,0,0,,是拿过{\fs78}32{\fs68}次冠军的美国
Dialogue: 0,0:01:08.67,0:01:09.59,TL,,0,0,0,,魁北克城
Dialogue: 0,0:01:09.59,0:01:12.26,TL,,0,0,0,,奥热-阿利亚西姆一个人拿两分
Dialogue: 0,0:01:12.26,0:01:15.34,TL,,0,0,0,,最后一场先丢一盘再翻回来
Dialogue: 0,0:01:16.17,0:01:17.88,TL,,0,0,0,,牌子是法语的
Dialogue: 0,0:01:17.88,0:01:20.42,TL,,0,0,0,,队史第一次赢下法国
Dialogue: 0,0:01:20.92,0:01:23.37,TL,,0,0,0,,伦敦铜箱馆 英国{\fs78}4{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:23.37,0:01:26.08,TL,,0,0,0,,门票在第三场就拿到了
Dialogue: 0,0:01:26.62,0:01:29.69,TL,,0,0,0,,帕滕和斯库普斯基{\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:29.69,0:01:32.12,TL,,0,0,0,,看台上全是米字旗
Dialogue: 0,0:01:32.72,0:01:34.16,TL,,0,0,0,,维也纳的红土上
Dialogue: 0,0:01:34.16,0:01:38.19,TL,,0,0,0,,罗季奥诺夫打完最后一分直接躺下了
Dialogue: 0,0:01:39.37,0:01:41.75,TL,,0,0,0,,他一个人赢了两场单打
Dialogue: 0,0:01:41.75,0:01:44.65,TL,,0,0,0,,奥地利连续第二年拿到门票
Dialogue: 0,0:01:45.27,0:01:48.29,TL,,0,0,0,,首尔 权纯雨{\fs78}6{\fs68}比{\fs78}1{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:48.29,0:01:50.55,TL,,0,0,0,,球一落地就躺下了
Dialogue: 0,0:01:50.97,0:01:53.92,TL,,0,0,0,,韩国队史第一次打进决赛圈
Dialogue: 0,0:01:55.07,0:01:58.15,TL,,0,0,0,,西班牙是去年的亚军 {\fs78}2{\fs68}月轮空
Dialogue: 0,0:01:58.15,0:02:01.43,TL,,0,0,0,,{\fs78}9{\fs68}月直接打这一轮 客场{\fs78}3{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:02:03.62,0:02:07.38,TL,,0,0,0,,圣地亚哥 红土 梅里达先丢一盘
Dialogue: 0,0:02:07.38,0:02:10.34,TL,,0,0,0,,再连赢两盘掀翻塔比洛
Dialogue: 0,0:02:12.82,0:02:14.42,TL,,0,0,0,,门票长这样
Dialogue: 0,0:02:14.42,0:02:16.05,TL,,0,0,0,,出发地各不相同
Dialogue: 0,0:02:16.05,0:02:17.83,TL,,0,0,0,,目的地都是博洛尼亚
Dialogue: 0,0:02:17.83,0:02:20.40,TL,,0,0,0,,上面印着每支队的{\fs78}5{\fs68}个人
Dialogue: 0,0:02:21.22,0:02:24.24,TL,,0,0,0,,还剩一张 是送的 东道主意大利
Dialogue: 0,0:02:24.24,0:02:26.38,TL,,0,0,0,,一场资格赛都没打
Dialogue: 0,0:02:28.62,0:02:31.72,TL,,0,0,0,,他们连着{\fs78}3{\fs68}年把杯子留在家里
Dialogue: 0,0:02:33.12,0:02:36.26,TL,,0,0,0,,决赛圈就摆在他们自己的主场
Dialogue: 0,0:02:36.72,0:02:38.55,TL,,0,0,0,,{\fs78}11{\fs68}月的规矩不一样了
Dialogue: 0,0:02:38.55,0:02:41.90,TL,,0,0,0,,不再是{\fs78}5{\fs68}场三胜 改成{\fs78}3{\fs68}场两胜
Dialogue: 0,0:02:42.72,0:02:44.80,TL,,0,0,0,,两场单打加一场双打
Dialogue: 0,0:02:44.80,0:02:48.26,TL,,0,0,0,,八支队伍抽完签直接单败淘汰
Dialogue: 0,0:02:49.22,0:02:51.28,TL,,0,0,0,,输一场就回家
Dialogue: 0,0:02:53.42,0:02:55.25,TL,,0,0,0,,签还没抽 这一次
Dialogue: 0,0:02:55.25,0:02:58.20,TL,,0,0,0,,谁能把它从意大利手里带走？
