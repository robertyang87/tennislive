Dialogue: 0,0:00:03.85,0:00:06.44,TL,,0,0,0,,夺冠第二天 郑钦文一袭白裙
Dialogue: 0,0:00:06.44,0:00:08.70,TL,,0,0,0,,捧杯登上八达岭长城
Dialogue: 0,0:00:08.70,0:00:11.82,TL,,0,0,0,,她写道 期待已久的奖杯照
Dialogue: 0,0:00:12.25,0:00:14.22,TL,,0,0,0,,前一晚 她以外卡出战
Dialogue: 0,0:00:14.22,0:00:17.18,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}击败安德烈耶娃
Dialogue: 0,0:00:17.18,0:00:20.79,TL,,0,0,0,,成为首位中网女单冠军的中国球员
Dialogue: 0,0:00:22.10,0:00:24.63,TL,,0,0,0,,可为什么 冠军总爱捧着奖杯
Dialogue: 0,0:00:24.63,0:00:26.85,TL,,0,0,0,,去城市地标拍照？
Dialogue: 0,0:00:27.70,0:00:29.53,TL,,0,0,0,,澳网早就这么拍
Dialogue: 0,0:00:29.53,0:00:32.11,TL,,0,0,0,,{\fs78}2015{\fs68}年 德约科维奇夺冠后
Dialogue: 0,0:00:32.11,0:00:35.48,TL,,0,0,0,,站在亚拉河边 身后划过赛艇
Dialogue: 0,0:00:36.00,0:00:37.03,TL,,0,0,0,,{\fs78}2012{\fs68}年
Dialogue: 0,0:00:37.03,0:00:40.25,TL,,0,0,0,,他选的是皇家展览馆前的喷泉
Dialogue: 0,0:00:41.40,0:00:43.86,TL,,0,0,0,,{\fs78}4{\fs68}周是一圈长枪短炮
Dialogue: 0,0:00:43.86,0:00:45.72,TL,,0,0,0,,冠军照从来不是私事
Dialogue: 0,0:00:45.72,0:00:49.37,TL,,0,0,0,,而是赛事准备给全世界媒体的素材
Dialogue: 0,0:00:50.00,0:00:51.64,TL,,0,0,0,,镜头前的这个笑容
Dialogue: 0,0:00:51.64,0:00:54.27,TL,,0,0,0,,就是赛事最好的宣传
Dialogue: 0,0:00:54.70,0:00:57.07,TL,,0,0,0,,法网冠军当晚就要换上西装
Dialogue: 0,0:00:57.07,0:00:59.03,TL,,0,0,0,,走进赛事的摄影棚
Dialogue: 0,0:00:59.03,0:01:00.45,TL,,0,0,0,,今年的兹维列夫
Dialogue: 0,0:01:00.45,0:01:03.15,TL,,0,0,0,,面对的是一排长焦镜头
Dialogue: 0,0:01:04.00,0:01:05.76,TL,,0,0,0,,奖杯也要进城
Dialogue: 0,0:01:05.76,0:01:07.94,TL,,0,0,0,,{\fs78}2025{\fs68}年法网冠军高芙
Dialogue: 0,0:01:07.94,0:01:10.46,TL,,0,0,0,,身后就是埃菲尔铁塔
Dialogue: 0,0:01:11.25,0:01:12.63,TL,,0,0,0,,{\fs78}2025{\fs68}年罗马
Dialogue: 0,0:01:12.63,0:01:14.56,TL,,0,0,0,,阿尔卡拉斯把奖杯带到了
Dialogue: 0,0:01:14.56,0:01:16.75,TL,,0,0,0,,夜色里的古堡前
Dialogue: 0,0:01:17.90,0:01:20.38,TL,,0,0,0,,巡回赛自己也是摄制方
Dialogue: 0,0:01:20.38,0:01:21.98,TL,,0,0,0,,{\fs78}2017{\fs68}年迈阿密
Dialogue: 0,0:01:21.98,0:01:24.73,TL,,0,0,0,,女子网球协会的镜头跟着康塔
Dialogue: 0,0:01:24.73,0:01:26.88,TL,,0,0,0,,来到海边灯塔下
Dialogue: 0,0:01:27.50,0:01:29.23,TL,,0,0,0,,为什么要这么拍？
Dialogue: 0,0:01:29.23,0:01:31.84,TL,,0,0,0,,赛事要传播 赞助商要露出
Dialogue: 0,0:01:31.84,0:01:33.69,TL,,0,0,0,,城市要一张名片
Dialogue: 0,0:01:33.69,0:01:34.62,TL,,0,0,0,,北京官方
Dialogue: 0,0:01:34.62,0:01:37.96,TL,,0,0,0,,就把长城照写成了赏红叶攻略
Dialogue: 0,0:01:38.70,0:01:40.98,TL,,0,0,0,,一张奖杯照 拍的是冠军
Dialogue: 0,0:01:40.98,0:01:42.76,TL,,0,0,0,,也是赛事和城市
Dialogue: 0,0:01:42.76,0:01:45.68,TL,,0,0,0,,下一座地标 会在哪？
