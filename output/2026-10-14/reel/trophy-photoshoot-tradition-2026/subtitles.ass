Dialogue: 0,0:00:03.48,0:00:05.81,TL,,0,0,0,,夺冠第二天 郑钦文一袭白裙
Dialogue: 0,0:00:05.81,0:00:07.84,TL,,0,0,0,,捧杯登上八达岭长城
Dialogue: 0,0:00:07.84,0:00:10.64,TL,,0,0,0,,她写道 期待已久的奖杯照
Dialogue: 0,0:00:11.28,0:00:13.05,TL,,0,0,0,,前一晚 她以外卡出战
Dialogue: 0,0:00:13.05,0:00:15.71,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}击败安德烈耶娃
Dialogue: 0,0:00:15.71,0:00:18.97,TL,,0,0,0,,成为首位中网女单冠军的中国球员
Dialogue: 0,0:00:19.61,0:00:21.89,TL,,0,0,0,,可为什么 冠军总爱捧着奖杯
Dialogue: 0,0:00:21.89,0:00:23.89,TL,,0,0,0,,去城市地标拍照？
Dialogue: 0,0:00:24.53,0:00:26.18,TL,,0,0,0,,澳网早就这么拍
Dialogue: 0,0:00:26.18,0:00:28.50,TL,,0,0,0,,{\fs78}2015{\fs68}年 德约科维奇夺冠后
Dialogue: 0,0:00:28.50,0:00:31.52,TL,,0,0,0,,站在亚拉河边 身后划过赛艇
Dialogue: 0,0:00:32.16,0:00:33.09,TL,,0,0,0,,{\fs78}2012{\fs68}年
Dialogue: 0,0:00:33.09,0:00:35.99,TL,,0,0,0,,他选的是皇家展览馆前的喷泉
Dialogue: 0,0:00:36.62,0:00:38.84,TL,,0,0,0,,{\fs78}4{\fs68}周是一圈长枪短炮
Dialogue: 0,0:00:38.84,0:00:40.50,TL,,0,0,0,,冠军照从来不是私事
Dialogue: 0,0:00:40.50,0:00:43.78,TL,,0,0,0,,而是赛事准备给全世界媒体的素材
Dialogue: 0,0:00:44.42,0:00:45.90,TL,,0,0,0,,镜头前的这个笑容
Dialogue: 0,0:00:45.90,0:00:48.27,TL,,0,0,0,,就是赛事最好的宣传
Dialogue: 0,0:00:48.91,0:00:51.04,TL,,0,0,0,,法网冠军当晚就要换上西装
Dialogue: 0,0:00:51.04,0:00:52.80,TL,,0,0,0,,走进赛事的摄影棚
Dialogue: 0,0:00:52.80,0:00:54.08,TL,,0,0,0,,今年的兹维列夫
Dialogue: 0,0:00:54.08,0:00:56.50,TL,,0,0,0,,面对的是一排长焦镜头
Dialogue: 0,0:00:57.14,0:00:58.72,TL,,0,0,0,,奖杯也要进城
Dialogue: 0,0:00:58.72,0:01:00.68,TL,,0,0,0,,{\fs78}2025{\fs68}年法网冠军高芙
Dialogue: 0,0:01:00.68,0:01:02.96,TL,,0,0,0,,身后就是埃菲尔铁塔
Dialogue: 0,0:01:03.60,0:01:04.84,TL,,0,0,0,,{\fs78}2025{\fs68}年罗马
Dialogue: 0,0:01:04.84,0:01:06.58,TL,,0,0,0,,阿尔卡拉斯把奖杯带到了
Dialogue: 0,0:01:06.58,0:01:08.53,TL,,0,0,0,,夜色里的古堡前
Dialogue: 0,0:01:09.17,0:01:11.40,TL,,0,0,0,,巡回赛自己也是摄制方
Dialogue: 0,0:01:11.40,0:01:12.84,TL,,0,0,0,,{\fs78}2017{\fs68}年迈阿密
Dialogue: 0,0:01:12.84,0:01:15.31,TL,,0,0,0,,女子网球协会的镜头跟着康塔
Dialogue: 0,0:01:15.31,0:01:17.22,TL,,0,0,0,,来到海边灯塔下
Dialogue: 0,0:01:17.86,0:01:19.42,TL,,0,0,0,,为什么要这么拍？
Dialogue: 0,0:01:19.42,0:01:21.76,TL,,0,0,0,,赛事要传播 赞助商要露出
Dialogue: 0,0:01:21.76,0:01:23.43,TL,,0,0,0,,城市要一张名片
Dialogue: 0,0:01:23.43,0:01:24.26,TL,,0,0,0,,北京官方
Dialogue: 0,0:01:24.26,0:01:27.28,TL,,0,0,0,,就把长城照写成了赏红叶攻略
Dialogue: 0,0:01:29.06,0:01:31.11,TL,,0,0,0,,一张奖杯照 拍的是冠军
Dialogue: 0,0:01:31.11,0:01:32.71,TL,,0,0,0,,也是赛事和城市
Dialogue: 0,0:01:32.71,0:01:35.33,TL,,0,0,0,,下一座地标 会在哪？
