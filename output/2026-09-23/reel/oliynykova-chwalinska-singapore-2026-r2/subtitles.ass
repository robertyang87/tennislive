Dialogue: 0,0:00:01.30,0:00:03.88,TL,,0,0,0,,北京时间{\fs78}9{\fs68}月{\fs78}23{\fs68}日下午一点多
Dialogue: 0,0:00:03.88,0:00:05.31,TL,,0,0,0,,新加坡室内硬地
Dialogue: 0,0:00:05.31,0:00:08.32,TL,,0,0,0,,{\fs78}WTA500{\fs68}赛女单八分之一决赛
Dialogue: 0,0:00:08.32,0:00:11.37,TL,,0,0,0,,{\fs78}5{\fs68}号种子 世界第{\fs78}25{\fs68}的赫瓦林斯卡
Dialogue: 0,0:00:11.37,0:00:14.11,TL,,0,0,0,,对世界第{\fs78}47{\fs68}的奥利尼科娃
Dialogue: 0,0:00:14.11,0:00:15.72,TL,,0,0,0,,第一局就打到了平分
Dialogue: 0,0:00:15.72,0:00:17.71,TL,,0,0,0,,最后还是赫瓦林斯卡保住了
Dialogue: 0,0:00:17.71,0:00:18.92,TL,,0,0,0,,这已经是第一盘里
Dialogue: 0,0:00:18.92,0:00:22.34,TL,,0,0,0,,奥利尼科娃离拿下一局最近的一次
Dialogue: 0,0:00:25.54,0:00:28.27,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}3{\fs68} 轮到奥利尼科娃发球
Dialogue: 0,0:00:28.27,0:00:31.12,TL,,0,0,0,,转播打出一张统计 非受迫失误
Dialogue: 0,0:00:31.12,0:00:34.65,TL,,0,0,0,,{\fs78}12{\fs68}比{\fs78}2{\fs68} 她打了{\fs78}3{\fs68}局 已经送出{\fs78}12{\fs68}个
Dialogue: 0,0:00:34.65,0:00:37.53,TL,,0,0,0,,这一局 赫瓦林斯卡在底线上
Dialogue: 0,0:00:37.53,0:00:39.52,TL,,0,0,0,,把她左右来回调动
Dialogue: 0,0:00:39.52,0:00:42.47,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}40{\fs68} 第一个破发点就交了出去
Dialogue: 0,0:00:42.47,0:00:43.87,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:46.18,0:00:48.30,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}5{\fs68} 奥利尼科娃再发球
Dialogue: 0,0:00:48.30,0:00:49.92,TL,,0,0,0,,又是{\fs78}0{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:49.92,0:00:52.97,TL,,0,0,0,,{\fs78}3{\fs68}个盘点 前两个她救了下来
Dialogue: 0,0:00:52.97,0:00:56.10,TL,,0,0,0,,第三个 赫瓦林斯卡 站在底线中间
Dialogue: 0,0:00:56.10,0:00:59.69,TL,,0,0,0,,不急着发力 一拍一拍把球送回对角
Dialogue: 0,0:00:59.69,0:01:00.56,TL,,0,0,0,,最后一拍
Dialogue: 0,0:01:00.56,0:01:03.32,TL,,0,0,0,,是奥利尼科娃自己打出了边线
Dialogue: 0,0:01:03.32,0:01:05.88,TL,,0,0,0,,{\fs78}26{\fs68}分钟 {\fs78}6{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:09.66,0:01:11.73,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}0{\fs68}之后 第二盘第一局
Dialogue: 0,0:01:11.73,0:01:13.29,TL,,0,0,0,,形势第一次倒了过来
Dialogue: 0,0:01:13.29,0:01:14.83,TL,,0,0,0,,赫瓦林斯卡自己发球
Dialogue: 0,0:01:14.83,0:01:17.37,TL,,0,0,0,,奥利尼科娃{\fs78}30{\fs68}比{\fs78}15{\fs68}领先
Dialogue: 0,0:01:17.37,0:01:18.22,TL,,0,0,0,,这一分
Dialogue: 0,0:01:18.22,0:01:21.18,TL,,0,0,0,,两个人在底线上来回拉了很久
Dialogue: 0,0:01:21.18,0:01:23.51,TL,,0,0,0,,最后是赫瓦林斯卡先往前压
Dialogue: 0,0:01:23.51,0:01:26.03,TL,,0,0,0,,一路站到网前 把它收掉
Dialogue: 0,0:01:26.03,0:01:28.56,TL,,0,0,0,,可这一局 她还是被破了
Dialogue: 0,0:01:28.56,0:01:29.75,TL,,0,0,0,,这是整场比赛
Dialogue: 0,0:01:29.75,0:01:32.79,TL,,0,0,0,,奥利尼科娃唯一赢下的一局
Dialogue: 0,0:01:40.42,0:01:42.73,TL,,0,0,0,,从那一局之后 她连拿{\fs78}6{\fs68}局
Dialogue: 0,0:01:42.73,0:01:45.74,TL,,0,0,0,,对手的发球局一个都没再保住
Dialogue: 0,0:01:45.74,0:01:48.96,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}5{\fs68} 赫瓦林斯卡发球胜赛
Dialogue: 0,0:01:52.50,0:01:54.58,TL,,0,0,0,,镜头先扫过奥利尼科娃
Dialogue: 0,0:01:54.58,0:01:56.09,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}6{\fs68} {\fs78}1{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:56.09,0:01:57.73,TL,,0,0,0,,她已经没有退路
Dialogue: 0,0:01:57.73,0:02:00.49,TL,,0,0,0,,赫瓦林斯卡发球 {\fs78}40{\fs68}比{\fs78}30{\fs68}
Dialogue: 0,0:02:00.49,0:02:03.38,TL,,0,0,0,,赛点 奥利尼科娃冲到网前
Dialogue: 0,0:02:03.38,0:02:06.73,TL,,0,0,0,,赫瓦林斯卡一拍高球从她头顶越过去
Dialogue: 0,0:02:06.73,0:02:07.97,TL,,0,0,0,,她转身往回追
Dialogue: 0,0:02:07.97,0:02:10.44,TL,,0,0,0,,扑到底线角上 没够着
Dialogue: 0,0:02:10.44,0:02:13.71,TL,,0,0,0,,{\fs78}59{\fs68}分钟 {\fs78}6{\fs68}比{\fs78}0{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:02:17.06,0:02:18.68,TL,,0,0,0,,她赢下的{\fs78}51{\fs68}分里
Dialogue: 0,0:02:18.68,0:02:21.62,TL,,0,0,0,,有{\fs78}33{\fs68}分是对手的非受迫失误
Dialogue: 0,0:02:21.62,0:02:24.00,TL,,0,0,0,,她自己全场只失误{\fs78}7{\fs68}次
Dialogue: 0,0:02:24.00,0:02:25.56,TL,,0,0,0,,这是她生涯第三次
Dialogue: 0,0:02:25.56,0:02:27.17,TL,,0,0,0,,打进巡回赛八强
Dialogue: 0,0:02:27.17,0:02:30.36,TL,,0,0,0,,下一轮的对手是{\fs78}4{\fs68}号种子梅尔滕斯
Dialogue: 0,0:02:30.36,0:02:32.38,TL,,0,0,0,,只丢一局的这一个小时
Dialogue: 0,0:02:32.38,0:02:35.80,TL,,0,0,0,,能让她把法网之后的那口气接上吗？
