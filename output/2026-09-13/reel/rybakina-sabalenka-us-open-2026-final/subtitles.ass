Dialogue: 0,0:00:06.90,0:00:08.75,TL,,0,0,0,,通道尽头的牌子写着
Dialogue: 0,0:00:08.75,0:00:11.14,TL,,0,0,0,,压力 是一种荣幸
Dialogue: 0,0:00:11.80,0:00:14.50,TL,,0,0,0,,北京时间{\fs78}9{\fs68}月{\fs78}13{\fs68}号凌晨{\fs78}4{\fs68}点多
Dialogue: 0,0:00:14.50,0:00:16.13,TL,,0,0,0,,美网女单决赛
Dialogue: 0,0:00:16.13,0:00:18.52,TL,,0,0,0,,莱巴金娜已经是新科世界第{\fs78}1{\fs68}
Dialogue: 0,0:00:18.52,0:00:21.18,TL,,0,0,0,,对面是世界第{\fs78}1{\fs68}萨巴伦卡
Dialogue: 0,0:00:22.00,0:00:25.17,TL,,0,0,0,,首盘她的一发只进了{\fs78}27{\fs68}%
Dialogue: 0,0:00:25.17,0:00:26.53,TL,,0,0,0,,可在这个盘点上
Dialogue: 0,0:00:26.53,0:00:29.39,TL,,0,0,0,,她把萨巴伦卡拖进了长回合
Dialogue: 0,0:00:29.39,0:00:30.82,TL,,0,0,0,,她是带着伤来的
Dialogue: 0,0:00:30.82,0:00:32.78,TL,,0,0,0,,辛辛那提四分之一决赛
Dialogue: 0,0:00:32.78,0:00:35.39,TL,,0,0,0,,她对斯瓦泰克中途退了赛
Dialogue: 0,0:00:35.39,0:00:38.15,TL,,0,0,0,,而这一分 决定了第一盘
Dialogue: 0,0:00:39.20,0:00:42.80,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68} 第一盘{\fs78}45{\fs68}分钟 归她
Dialogue: 0,0:00:45.70,0:00:49.12,TL,,0,0,0,,第二盘莱巴金娜的一发提到{\fs78}61{\fs68}%
Dialogue: 0,0:00:49.12,0:00:51.50,TL,,0,0,0,,两个破发点却没兑现
Dialogue: 0,0:00:53.10,0:00:55.10,TL,,0,0,0,,萨巴伦卡这一分打得极好
Dialogue: 0,0:00:55.10,0:00:57.95,TL,,0,0,0,,一记小球放在她够不着的地方
Dialogue: 0,0:00:57.95,0:00:59.69,TL,,0,0,0,,第二盘{\fs78}5{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:59.69,0:01:01.67,TL,,0,0,0,,莱巴金娜在自己的发球局
Dialogue: 0,0:01:01.67,0:01:03.29,TL,,0,0,0,,救下两个盘点
Dialogue: 0,0:01:03.29,0:01:05.16,TL,,0,0,0,,可两局之后还是被破
Dialogue: 0,0:01:05.16,0:01:07.71,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} 一盘扳回
Dialogue: 0,0:01:09.00,0:01:12.06,TL,,0,0,0,,而这一分 莱巴金娜一步都没慌
Dialogue: 0,0:01:12.06,0:01:14.18,TL,,0,0,0,,对手的小球又放到网前
Dialogue: 0,0:01:14.18,0:01:17.18,TL,,0,0,0,,她追上去 反手把球挑回底线
Dialogue: 0,0:01:17.18,0:01:19.05,TL,,0,0,0,,全场她{\fs78}36{\fs68}个制胜分
Dialogue: 0,0:01:19.05,0:01:21.27,TL,,0,0,0,,对{\fs78}24{\fs68}次非受迫失误
Dialogue: 0,0:01:21.27,0:01:24.24,TL,,0,0,0,,萨巴伦卡是{\fs78}32{\fs68}对{\fs78}35{\fs68}
Dialogue: 0,0:01:25.60,0:01:28.82,TL,,0,0,0,,决胜盘她的发球局一共只丢了三分
Dialogue: 0,0:01:28.82,0:01:31.58,TL,,0,0,0,,其中两分还是最后一局的双误
Dialogue: 0,0:01:31.58,0:01:32.75,TL,,0,0,0,,第二个冠军点
Dialogue: 0,0:01:32.75,0:01:36.08,TL,,0,0,0,,她用全场第{\fs78}12{\fs68}个 {\fs78}ACE{\fs68} 结束了比赛
Dialogue: 0,0:01:38.90,0:01:40.59,TL,,0,0,0,,两小时{\fs78}21{\fs68}分
Dialogue: 0,0:01:40.59,0:01:41.90,TL,,0,0,0,,网前那一握
Dialogue: 0,0:01:41.90,0:01:44.92,TL,,0,0,0,,萨巴伦卡的美网三连冠没了
Dialogue: 0,0:01:46.30,0:01:49.43,TL,,0,0,0,,她爬上看台 抱住了教练和家人
Dialogue: 0,0:01:49.43,0:01:51.37,TL,,0,0,0,,这是她的第三个大满贯
Dialogue: 0,0:01:51.37,0:01:53.44,TL,,0,0,0,,也是第一个美网冠军
Dialogue: 0,0:01:53.44,0:01:55.26,TL,,0,0,0,,{\fs78}8{\fs68}个月前的澳网决赛
Dialogue: 0,0:01:55.26,0:01:56.70,TL,,0,0,0,,她赢下萨巴伦卡
Dialogue: 0,0:01:56.70,0:01:58.90,TL,,0,0,0,,靠的也是一记 {\fs78}ACE{\fs68}
Dialogue: 0,0:02:00.30,0:02:01.55,TL,,0,0,0,,领奖的时候她说
Dialogue: 0,0:02:01.55,0:02:02.74,TL,,0,0,0,,我来这儿{\fs78}10{\fs68}年了
Dialogue: 0,0:02:02.74,0:02:06.03,TL,,0,0,0,,从来没成功过 差得远 她说
Dialogue: 0,0:02:06.03,0:02:08.34,TL,,0,0,0,,这一程一直在跟伤病周旋
Dialogue: 0,0:02:08.34,0:02:11.36,TL,,0,0,0,,可所有事情都站到了她这边
Dialogue: 0,0:02:13.80,0:02:15.12,TL,,0,0,0,,{\fs78}2022{\fs68}年温网
Dialogue: 0,0:02:15.12,0:02:16.50,TL,,0,0,0,,今年一月的澳网
Dialogue: 0,0:02:16.50,0:02:18.38,TL,,0,0,0,,加上今天的纽约
Dialogue: 0,0:02:18.38,0:02:21.25,TL,,0,0,0,,四大满贯 她只差一个法网
Dialogue: 0,0:02:21.25,0:02:24.31,TL,,0,0,0,,红土那一座 她拿得下吗？
