Dialogue: 0,0:00:06.01,0:00:07.46,TL,,0,0,0,,整场决赛打完
Dialogue: 0,0:00:07.46,0:00:10.09,TL,,0,0,0,,中岛一个破发点都没能拿到
Dialogue: 0,0:00:11.05,0:00:13.70,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}14{\fs68}号早上{\fs78}8{\fs68}点一刻
Dialogue: 0,0:00:13.70,0:00:16.35,TL,,0,0,0,,蒙特利尔{\fs78}ATP1000{\fs68}男单决赛
Dialogue: 0,0:00:16.35,0:00:18.74,TL,,0,0,0,,开场第一个发球局是中岛的
Dialogue: 0,0:00:18.74,0:00:19.47,TL,,0,0,0,,{\fs78}3{\fs68}个{\fs78}Ace{\fs68}
Dialogue: 0,0:00:19.47,0:00:22.23,TL,,0,0,0,,解说说这几乎是完美的一局
Dialogue: 0,0:00:26.13,0:00:28.56,TL,,0,0,0,,{\fs78}5{\fs68}号种子 世界第{\fs78}10{\fs68}的谢尔顿
Dialogue: 0,0:00:28.56,0:00:29.95,TL,,0,0,0,,对{\fs78}28{\fs68}号种子
Dialogue: 0,0:00:29.95,0:00:32.04,TL,,0,0,0,,世界第{\fs78}31{\fs68}的中岛
Dialogue: 0,0:00:32.04,0:00:34.91,TL,,0,0,0,,上一次加拿大公开赛男单决赛由两个
Dialogue: 0,0:00:34.91,0:00:36.03,TL,,0,0,0,,美国人来打
Dialogue: 0,0:00:36.03,0:00:39.03,TL,,0,0,0,,还要追溯到{\fs78}1995{\fs68}年阿加西胜桑普
Dialogue: 0,0:00:39.03,0:00:39.75,TL,,0,0,0,,拉斯
Dialogue: 0,0:00:39.75,0:00:42.58,TL,,0,0,0,,而这两个人此前已经交过{\fs78}5{\fs68}次手
Dialogue: 0,0:00:42.58,0:00:44.08,TL,,0,0,0,,谢尔顿五战全胜
Dialogue: 0,0:00:44.08,0:00:46.79,TL,,0,0,0,,中岛只从他手里赢下过一盘
Dialogue: 0,0:00:46.79,0:00:49.26,TL,,0,0,0,,谢尔顿最近{\fs78}4{\fs68}个巡回赛决赛
Dialogue: 0,0:00:49.26,0:00:50.87,TL,,0,0,0,,也全都赢了
Dialogue: 0,0:00:51.09,0:00:52.43,TL,,0,0,0,,首盘{\fs78}3{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:52.43,0:00:54.11,TL,,0,0,0,,轮到中岛发球
Dialogue: 0,0:00:54.11,0:00:55.40,TL,,0,0,0,,谢尔顿连拿三分
Dialogue: 0,0:00:55.40,0:00:57.33,TL,,0,0,0,,一口气拿到{\fs78}3{\fs68}个破发点
Dialogue: 0,0:00:57.33,0:01:00.08,TL,,0,0,0,,中岛从{\fs78}0{\fs68}比{\fs78}40{\fs68}救回到{\fs78}30{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:01:00.08,0:01:02.03,TL,,0,0,0,,第三个还是没能守住
Dialogue: 0,0:01:02.03,0:01:04.62,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68} 谢尔顿第一次把比分拉开
Dialogue: 0,0:01:04.62,0:01:07.54,TL,,0,0,0,,他转身冲着自己的球员席吼了很久
Dialogue: 0,0:01:07.54,0:01:10.67,TL,,0,0,0,,那是这场决赛第一次出现明确的倾斜
Dialogue: 0,0:01:12.61,0:01:15.66,TL,,0,0,0,,紧接着他保住自己的发球局 {\fs78}5{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:15.66,0:01:18.17,TL,,0,0,0,,中间还打出了全场最快的一发
Dialogue: 0,0:01:18.17,0:01:20.05,TL,,0,0,0,,{\fs78}228{\fs68}公里
Dialogue: 0,0:01:23.77,0:01:25.15,TL,,0,0,0,,首盘后半段
Dialogue: 0,0:01:25.15,0:01:27.60,TL,,0,0,0,,谢尔顿开始把这片球场变成自己的
Dialogue: 0,0:01:27.60,0:01:28.57,TL,,0,0,0,,主场
Dialogue: 0,0:01:28.57,0:01:31.16,TL,,0,0,0,,一记救球让整个蒙特利尔一起站了
Dialogue: 0,0:01:31.16,0:01:34.79,TL,,0,0,0,,起来 解说只说得出一句 太精彩了
Dialogue: 0,0:01:34.79,0:01:36.50,TL,,0,0,0,,中岛并不是打得不好
Dialogue: 0,0:01:36.50,0:01:39.18,TL,,0,0,0,,只是对面那个人今晚每一拍都落在
Dialogue: 0,0:01:39.18,0:01:40.74,TL,,0,0,0,,正确的位置上
Dialogue: 0,0:01:41.89,0:01:45.12,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} 首盘只用了{\fs78}33{\fs68}分钟
Dialogue: 0,0:01:45.12,0:01:47.06,TL,,0,0,0,,解说给了一句很准的话
Dialogue: 0,0:01:47.06,0:01:49.38,TL,,0,0,0,,这一盘属于卫冕冠军
Dialogue: 0,0:01:49.38,0:01:50.59,TL,,0,0,0,,而到这里为止
Dialogue: 0,0:01:50.59,0:01:52.50,TL,,0,0,0,,中岛的发球局丢了一个
Dialogue: 0,0:01:52.50,0:01:55.22,TL,,0,0,0,,谢尔顿的发球局一个破发点都还没
Dialogue: 0,0:01:55.22,0:01:56.58,TL,,0,0,0,,被人拿到过
Dialogue: 0,0:01:58.21,0:02:01.59,TL,,0,0,0,,第二盘变成了一场纯粹的发球较量
Dialogue: 0,0:02:01.59,0:02:03.78,TL,,0,0,0,,两个人的发球局都稳得可怕
Dialogue: 0,0:02:03.78,0:02:05.04,TL,,0,0,0,,整整{\fs78}12{\fs68}局
Dialogue: 0,0:02:05.04,0:02:08.02,TL,,0,0,0,,双方一个破发点都没有出现过
Dialogue: 0,0:02:08.02,0:02:09.40,TL,,0,0,0,,不是拿到了没兑现
Dialogue: 0,0:02:09.40,0:02:11.13,TL,,0,0,0,,是根本没拿到
Dialogue: 0,0:02:11.13,0:02:14.14,TL,,0,0,0,,谢尔顿的正手在这一段打得随心所欲
Dialogue: 0,0:02:14.14,0:02:16.04,TL,,0,0,0,,两条斜线加一条直线
Dialogue: 0,0:02:16.04,0:02:18.63,TL,,0,0,0,,解说说他每个方向都能得分
Dialogue: 0,0:02:21.01,0:02:22.69,TL,,0,0,0,,中岛也没有退
Dialogue: 0,0:02:22.69,0:02:24.54,TL,,0,0,0,,他这一路走得并不轻松
Dialogue: 0,0:02:24.54,0:02:26.84,TL,,0,0,0,,两年前一场严重的膝伤让他
Dialogue: 0,0:02:26.84,0:02:28.99,TL,,0,0,0,,从巡回赛上消失了很久
Dialogue: 0,0:02:28.99,0:02:30.56,TL,,0,0,0,,这个赛季重新爬回来
Dialogue: 0,0:02:30.56,0:02:33.00,TL,,0,0,0,,一周前在华盛顿打进半决赛
Dialogue: 0,0:02:33.00,0:02:34.44,TL,,0,0,0,,这一站又连过五关
Dialogue: 0,0:02:34.44,0:02:37.19,TL,,0,0,0,,站进了自己的第一个大师赛决赛
Dialogue: 0,0:02:37.19,0:02:39.69,TL,,0,0,0,,整场比赛他也只丢了一个发球局
Dialogue: 0,0:02:39.69,0:02:41.98,TL,,0,0,0,,{\fs78}8{\fs68}个{\fs78}Ace{\fs68}还比对手多一个
Dialogue: 0,0:02:45.05,0:02:48.10,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}5{\fs68}之后各自再保一局 {\fs78}6{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:02:48.10,0:02:50.66,TL,,0,0,0,,这一盘要用抢七来分胜负
Dialogue: 0,0:02:50.66,0:02:52.90,TL,,0,0,0,,而这已经是两人交手以来
Dialogue: 0,0:02:52.90,0:02:56.25,TL,,0,0,0,,第九次把一盘咬到{\fs78}7{\fs68}比{\fs78}5{\fs68}或者{\fs78}7{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:02:56.25,0:02:59.62,TL,,0,0,0,,前{\fs78}8{\fs68}次 中岛一盘都没赢下来过
Dialogue: 0,0:03:02.81,0:03:05.78,TL,,0,0,0,,进入抢七 谢尔顿先拿到赛点
Dialogue: 0,0:03:05.78,0:03:07.18,TL,,0,0,0,,中岛救下第一个
Dialogue: 0,0:03:07.18,0:03:09.89,TL,,0,0,0,,那是他今晚最后一次靠近
Dialogue: 0,0:03:12.85,0:03:15.18,TL,,0,0,0,,网前 两个人抱了一下
Dialogue: 0,0:03:15.18,0:03:18.27,TL,,0,0,0,,中岛用这两周把自己的实时排名送到
Dialogue: 0,0:03:18.27,0:03:20.38,TL,,0,0,0,,了生涯最高的第{\fs78}22{\fs68}位
Dialogue: 0,0:03:20.38,0:03:21.56,TL,,0,0,0,,而对面那个人
Dialogue: 0,0:03:21.56,0:03:23.86,TL,,0,0,0,,刚刚做完一件更难的事
Dialogue: 0,0:03:26.81,0:03:29.30,TL,,0,0,0,,去年他在多伦多捧起这座奖杯
Dialogue: 0,0:03:29.30,0:03:31.70,TL,,0,0,0,,今年在蒙特利尔又捧了一次
Dialogue: 0,0:03:31.70,0:03:33.60,TL,,0,0,0,,加拿大公开赛连拿两年
Dialogue: 0,0:03:33.60,0:03:35.25,TL,,0,0,0,,本世纪之前只有穆雷
Dialogue: 0,0:03:35.25,0:03:37.41,TL,,0,0,0,,德约科维奇和纳达尔做到过
Dialogue: 0,0:03:37.41,0:03:38.87,TL,,0,0,0,,他是第四个
Dialogue: 0,0:03:38.87,0:03:41.38,TL,,0,0,0,,这是他生涯第七个巡回赛冠军
Dialogue: 0,0:03:41.38,0:03:42.76,TL,,0,0,0,,本赛季的第四个
Dialogue: 0,0:03:42.76,0:03:44.52,TL,,0,0,0,,也是他第一次一盘不失
Dialogue: 0,0:03:44.52,0:03:46.16,TL,,0,0,0,,拿下一站冠军
Dialogue: 0,0:03:46.16,0:03:48.86,TL,,0,0,0,,{\fs78}23{\fs68}岁 他还能走到哪儿？
