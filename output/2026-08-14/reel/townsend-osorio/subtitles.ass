Dialogue: 0,0:00:07.45,0:00:09.55,TL,,0,0,0,,全场为这一分站了起来
Dialogue: 0,0:00:09.55,0:00:11.26,TL,,0,0,0,,她输掉了第一盘
Dialogue: 0,0:00:13.85,0:00:16.67,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}13{\fs68}号夜里{\fs78}11{\fs68}点{\fs78}10{\fs68}分
Dialogue: 0,0:00:16.67,0:00:17.77,TL,,0,0,0,,辛辛那提站
Dialogue: 0,0:00:17.77,0:00:20.11,TL,,0,0,0,,女单第一轮 {\fs78}3{\fs68}号球场
Dialogue: 0,0:00:23.55,0:00:26.28,TL,,0,0,0,,汤森德{\fs78}30{\fs68}岁 左手持拍
Dialogue: 0,0:00:26.28,0:00:27.90,TL,,0,0,0,,单打世界第{\fs78}94{\fs68}
Dialogue: 0,0:00:27.90,0:00:28.98,TL,,0,0,0,,双打世界第{\fs78}2{\fs68}
Dialogue: 0,0:00:28.98,0:00:30.87,TL,,0,0,0,,{\fs78}3{\fs68}个大满贯冠军
Dialogue: 0,0:00:34.15,0:00:36.10,TL,,0,0,0,,首盘汤森德发了{\fs78}5{\fs68}个 {\fs78}Ace{\fs68}
Dialogue: 0,0:00:36.10,0:00:38.71,TL,,0,0,0,,破发点却是{\fs78}0{\fs68}比{\fs78}2{\fs68} 整整一盘
Dialogue: 0,0:00:38.71,0:00:41.55,TL,,0,0,0,,她一次都没能破掉对手的发球局
Dialogue: 0,0:00:41.55,0:00:44.25,TL,,0,0,0,,发球是她的强项 接发不是
Dialogue: 0,0:00:46.15,0:00:47.72,TL,,0,0,0,,奥索里奥{\fs78}24{\fs68}岁
Dialogue: 0,0:00:47.72,0:00:49.31,TL,,0,0,0,,世界第{\fs78}55{\fs68}
Dialogue: 0,0:00:49.31,0:00:51.56,TL,,0,0,0,,首盘她一发只进了三成九
Dialogue: 0,0:00:51.56,0:00:52.55,TL,,0,0,0,,可进的那些
Dialogue: 0,0:00:52.55,0:00:54.36,TL,,0,0,0,,九成一都赢了
Dialogue: 0,0:00:57.15,0:01:00.06,TL,,0,0,0,,{\fs78}40{\fs68}分钟 第一盘归了奥索里奥
Dialogue: 0,0:01:00.06,0:01:02.83,TL,,0,0,0,,汤森德要么从这儿开始把接发扳过来
Dialogue: 0,0:01:02.83,0:01:05.04,TL,,0,0,0,,要么这场球就到此为止
Dialogue: 0,0:01:08.75,0:01:11.79,TL,,0,0,0,,第二盘第一局汤森德拿到一个破发点
Dialogue: 0,0:01:11.79,0:01:13.63,TL,,0,0,0,,奥索里奥救掉了
Dialogue: 0,0:01:13.63,0:01:14.54,TL,,0,0,0,,之后{\fs78}5{\fs68}局
Dialogue: 0,0:01:14.54,0:01:17.54,TL,,0,0,0,,对手的发球局她一次都没再碰到
Dialogue: 0,0:01:17.54,0:01:18.71,TL,,0,0,0,,三平
Dialogue: 0,0:01:21.25,0:01:23.43,TL,,0,0,0,,第七局 {\fs78}40{\fs68}比{\fs78}15{\fs68}
Dialogue: 0,0:01:23.43,0:01:25.13,TL,,0,0,0,,汤森德拿到破发点
Dialogue: 0,0:01:25.13,0:01:26.54,TL,,0,0,0,,一个就够了
Dialogue: 0,0:01:26.54,0:01:29.36,TL,,0,0,0,,这是她整场第一次破掉对手的发球局
Dialogue: 0,0:01:29.36,0:01:30.42,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:33.85,0:01:37.14,TL,,0,0,0,,第九局再破一次 {\fs78}6{\fs68}比{\fs78}3{\fs68} 扳平
Dialogue: 0,0:01:39.95,0:01:40.98,TL,,0,0,0,,整个第二盘
Dialogue: 0,0:01:40.98,0:01:43.57,TL,,0,0,0,,奥索里奥一个破发点都没有
Dialogue: 0,0:01:43.57,0:01:45.40,TL,,0,0,0,,决胜盘她连下两局
Dialogue: 0,0:01:45.40,0:01:47.24,TL,,0,0,0,,一路拉到{\fs78}5{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:49.95,0:01:52.08,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}2{\fs68} 奥索里奥发球
Dialogue: 0,0:01:52.08,0:01:53.43,TL,,0,0,0,,刚才那记救球
Dialogue: 0,0:01:53.43,0:01:56.59,TL,,0,0,0,,把汤森德送到了这场球的第一个赛点
Dialogue: 0,0:01:56.59,0:01:59.19,TL,,0,0,0,,再赢一分 比赛就结束了
Dialogue: 0,0:01:59.19,0:02:01.44,TL,,0,0,0,,而这一分 奥索里奥拿走了
Dialogue: 0,0:02:01.44,0:02:02.82,TL,,0,0,0,,还保住了发球局
Dialogue: 0,0:02:02.82,0:02:04.44,TL,,0,0,0,,追到{\fs78}3{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:02:11.40,0:02:12.48,TL,,0,0,0,,两小时{\fs78}10{\fs68}分
Dialogue: 0,0:02:12.48,0:02:13.45,TL,,0,0,0,,第二个赛点
Dialogue: 0,0:02:13.45,0:02:14.85,TL,,0,0,0,,她一分没丢
Dialogue: 0,0:02:14.85,0:02:16.75,TL,,0,0,0,,双打世界第{\fs78}2{\fs68}的那双手
Dialogue: 0,0:02:16.75,0:02:19.25,TL,,0,0,0,,在单打里还能走多远？
