Dialogue: 0,0:00:10.93,0:00:14.04,TL,,0,0,0,,三大满贯全部早轮出局的这个赛季
Dialogue: 0,0:00:14.04,0:00:17.29,TL,,0,0,0,,她在多伦多拿到了本赛季第一个冠军
Dialogue: 0,0:00:19.97,0:00:22.02,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}14{\fs68}号清晨
Dialogue: 0,0:00:22.02,0:00:24.30,TL,,0,0,0,,{\fs78}WTA1000{\fs68}多伦多女单决赛
Dialogue: 0,0:00:24.30,0:00:25.72,TL,,0,0,0,,{\fs78}7{\fs68}号种子斯瓦泰克
Dialogue: 0,0:00:25.72,0:00:27.80,TL,,0,0,0,,对阵{\fs78}2{\fs68}号种子莱巴金娜
Dialogue: 0,0:00:27.80,0:00:29.65,TL,,0,0,0,,生涯交手战成{\fs78}6{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:00:29.65,0:00:31.70,TL,,0,0,0,,胜者拿下这座冠军
Dialogue: 0,0:00:34.05,0:00:35.67,TL,,0,0,0,,开局就是一个破发
Dialogue: 0,0:00:35.67,0:00:37.42,TL,,0,0,0,,莱巴金娜连续两个双误
Dialogue: 0,0:00:37.42,0:00:39.14,TL,,0,0,0,,还有一次拙劣的放小球
Dialogue: 0,0:00:39.14,0:00:41.59,TL,,0,0,0,,第一局就把主动权交了出去
Dialogue: 0,0:00:41.59,0:00:43.87,TL,,0,0,0,,斯瓦泰克稳稳保住这一分优势
Dialogue: 0,0:00:43.87,0:00:46.04,TL,,0,0,0,,一连保住接下来几个发球局
Dialogue: 0,0:00:46.04,0:00:47.85,TL,,0,0,0,,比分很快被拉开
Dialogue: 0,0:00:50.21,0:00:51.86,TL,,0,0,0,,斯瓦泰克越打越顺
Dialogue: 0,0:00:51.86,0:00:54.63,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}2{\fs68}时她自己一度送出破发点
Dialogue: 0,0:00:54.63,0:00:57.00,TL,,0,0,0,,可莱巴金娜两个反手都打丢了
Dialogue: 0,0:00:57.00,0:00:58.85,TL,,0,0,0,,斯瓦泰克顶住这波压力
Dialogue: 0,0:00:58.85,0:01:00.18,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}2{\fs68}再破一次
Dialogue: 0,0:01:00.18,0:01:02.35,TL,,0,0,0,,{\fs78}29{\fs68}分钟拿下首盘
Dialogue: 0,0:01:06.09,0:01:07.95,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} 首盘结束
Dialogue: 0,0:01:07.95,0:01:10.39,TL,,0,0,0,,莱巴金娜这一盘只拿到两局
Dialogue: 0,0:01:10.39,0:01:12.74,TL,,0,0,0,,斯瓦泰克打得干净利落
Dialogue: 0,0:01:15.21,0:01:16.36,TL,,0,0,0,,次盘一开始
Dialogue: 0,0:01:16.36,0:01:18.45,TL,,0,0,0,,莱巴金娜顶住了盘平的压力
Dialogue: 0,0:01:18.45,0:01:19.87,TL,,0,0,0,,找回了一些手感
Dialogue: 0,0:01:19.87,0:01:21.91,TL,,0,0,0,,这一路她打得并不轻松
Dialogue: 0,0:01:21.91,0:01:24.12,TL,,0,0,0,,公开赛年代只有{\fs78}4{\fs68}个人在通
Dialogue: 0,0:01:24.12,0:01:26.27,TL,,0,0,0,,向多伦多决赛的路上打出过
Dialogue: 0,0:01:26.27,0:01:27.73,TL,,0,0,0,,{\fs78}4{\fs68}场{\fs78}3{\fs68}盘鏖战
Dialogue: 0,0:01:27.73,0:01:28.76,TL,,0,0,0,,她是其中之一
Dialogue: 0,0:01:28.76,0:01:30.65,TL,,0,0,0,,半决赛逆转高芙之前
Dialogue: 0,0:01:30.65,0:01:33.38,TL,,0,0,0,,还先后苦战{\fs78}3{\fs68}盘拿下卡萨金娜
Dialogue: 0,0:01:33.38,0:01:35.85,TL,,0,0,0,,萨姆索诺娃和大坂直美
Dialogue: 0,0:01:39.89,0:01:42.00,TL,,0,0,0,,但莱巴金娜没有轻易放弃
Dialogue: 0,0:01:42.00,0:01:43.84,TL,,0,0,0,,她稳住了自己的发球局
Dialogue: 0,0:01:43.84,0:01:45.72,TL,,0,0,0,,把比分反超到{\fs78}2{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:45.72,0:01:49.04,TL,,0,0,0,,这场看似一边倒的决赛突然有了悬念
Dialogue: 0,0:01:49.04,0:01:50.52,TL,,0,0,0,,轮到斯瓦泰克发球
Dialogue: 0,0:01:50.52,0:01:52.47,TL,,0,0,0,,这一局她打得格外艰难
Dialogue: 0,0:01:52.47,0:01:54.42,TL,,0,0,0,,一次次被逼到关键分
Dialogue: 0,0:01:54.42,0:01:56.60,TL,,0,0,0,,好几个球都是在底线来回拉扯了
Dialogue: 0,0:01:56.60,0:01:58.24,TL,,0,0,0,,很久才分出胜负
Dialogue: 0,0:01:58.24,0:02:00.58,TL,,0,0,0,,莱巴金娜眼看就要把比分追平
Dialogue: 0,0:02:00.58,0:02:03.44,TL,,0,0,0,,看台上的加拿大观众也跟着屏住了
Dialogue: 0,0:02:03.44,0:02:06.85,TL,,0,0,0,,呼吸 斯瓦泰克还是顶住了这波压力
Dialogue: 0,0:02:06.85,0:02:09.49,TL,,0,0,0,,一分一分把这个艰难的发球局拿了下
Dialogue: 0,0:02:09.49,0:02:10.03,TL,,0,0,0,,来
Dialogue: 0,0:02:13.13,0:02:14.88,TL,,0,0,0,,紧接着她又拿下一局
Dialogue: 0,0:02:14.88,0:02:16.64,TL,,0,0,0,,把比分反超到{\fs78}4{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:02:16.64,0:02:17.81,TL,,0,0,0,,从{\fs78}1{\fs68}比{\fs78}2{\fs68}落后
Dialogue: 0,0:02:17.81,0:02:20.89,TL,,0,0,0,,她硬是把主动权重新抢了回来
Dialogue: 0,0:02:20.89,0:02:22.56,TL,,0,0,0,,这两个艰难的发球局
Dialogue: 0,0:02:22.56,0:02:25.26,TL,,0,0,0,,成了整场决赛里唯一真正悬而未决的
Dialogue: 0,0:02:25.26,0:02:25.98,TL,,0,0,0,,时刻
Dialogue: 0,0:02:25.98,0:02:29.01,TL,,0,0,0,,往前一步是斯瓦泰克稳稳锁定比赛
Dialogue: 0,0:02:29.01,0:02:29.97,TL,,0,0,0,,往后一步
Dialogue: 0,0:02:29.97,0:02:32.64,TL,,0,0,0,,莱巴金娜或许还能把这场决赛拖进
Dialogue: 0,0:02:32.64,0:02:33.77,TL,,0,0,0,,第三盘
Dialogue: 0,0:02:36.01,0:02:37.99,TL,,0,0,0,,莱巴金娜没有轻易放弃
Dialogue: 0,0:02:37.99,0:02:40.19,TL,,0,0,0,,她又一次守住了自己的发球局
Dialogue: 0,0:02:40.19,0:02:41.76,TL,,0,0,0,,把比分追到{\fs78}4{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:02:41.76,0:02:45.04,TL,,0,0,0,,试图把这场决赛重新拖回悬念之中
Dialogue: 0,0:02:45.04,0:02:46.83,TL,,0,0,0,,但这已经是她这场比赛里
Dialogue: 0,0:02:46.83,0:02:49.66,TL,,0,0,0,,最后一次把差距缩小到一局以内
Dialogue: 0,0:02:49.66,0:02:52.86,TL,,0,0,0,,看台上的悬念也随之慢慢散去
Dialogue: 0,0:02:54.81,0:02:57.31,TL,,0,0,0,,斯瓦泰克全场只让她赢下{\fs78}5{\fs68}局
Dialogue: 0,0:02:57.31,0:02:59.15,TL,,0,0,0,,一发成功率打到八成
Dialogue: 0,0:02:59.15,0:03:01.35,TL,,0,0,0,,全场总得分{\fs78}56{\fs68}比{\fs78}41{\fs68}
Dialogue: 0,0:03:01.35,0:03:03.39,TL,,0,0,0,,比分和过程一样干脆
Dialogue: 0,0:03:03.39,0:03:05.27,TL,,0,0,0,,莱巴金娜想找回节奏
Dialogue: 0,0:03:05.27,0:03:07.97,TL,,0,0,0,,但斯瓦泰克的发球局稳如磐石
Dialogue: 0,0:03:07.97,0:03:10.14,TL,,0,0,0,,{\fs78}8{\fs68}个发球局全部保住
Dialogue: 0,0:03:10.14,0:03:12.77,TL,,0,0,0,,看台上 越来越多人开始意识到
Dialogue: 0,0:03:12.77,0:03:15.73,TL,,0,0,0,,这场决赛可能不会再有转折了
Dialogue: 0,0:03:15.73,0:03:17.11,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}4{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:03:17.11,0:03:19.67,TL,,0,0,0,,她已经逼近这场决赛的终点
Dialogue: 0,0:03:21.65,0:03:24.25,TL,,0,0,0,,赛点 莱巴金娜先救回一个
Dialogue: 0,0:03:24.25,0:03:25.22,TL,,0,0,0,,第二个赛点
Dialogue: 0,0:03:25.22,0:03:27.73,TL,,0,0,0,,斯瓦泰克一记正手直线制胜分
Dialogue: 0,0:03:27.73,0:03:29.69,TL,,0,0,0,,把冠军收进了口袋
Dialogue: 0,0:03:31.17,0:03:33.71,TL,,0,0,0,,这是她过去将近一年里唯一的冠军
Dialogue: 0,0:03:33.71,0:03:36.97,TL,,0,0,0,,上一次举杯是去年{\fs78}8{\fs68}月的辛辛那提
Dialogue: 0,0:03:36.97,0:03:39.93,TL,,0,0,0,,这个赛季三大满贯全部早轮出局
Dialogue: 0,0:03:39.93,0:03:41.90,TL,,0,0,0,,排名跌到世界第{\fs78}8{\fs68}
Dialogue: 0,0:03:43.13,0:03:44.48,TL,,0,0,0,,赛前她自己说
Dialogue: 0,0:03:44.48,0:03:46.51,TL,,0,0,0,,这可能是她网球生涯里
Dialogue: 0,0:03:46.51,0:03:48.36,TL,,0,0,0,,最难的一个赛季
Dialogue: 0,0:03:48.36,0:03:49.99,TL,,0,0,0,,下一站辛辛那提
Dialogue: 0,0:03:49.99,0:03:52.46,TL,,0,0,0,,她能把这股势头带下去吗？
