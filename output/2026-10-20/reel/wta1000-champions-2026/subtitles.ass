Dialogue: 0,0:00:00.04,0:00:02.83,TL,,0,0,0,,{\fs78}10{\fs68}站 九冠 {\fs78}4{\fs68}个第一次
Dialogue: 0,0:00:05.92,0:00:09.46,TL,,0,0,0,,{\fs78}2026{\fs68}赛季 {\fs78}WTA1000{\fs68}赛全部收官
Dialogue: 0,0:00:09.50,0:00:11.40,TL,,0,0,0,,救冠军点 外卡逆袭
Dialogue: 0,0:00:11.40,0:00:13.47,TL,,0,0,0,,首冠就是{\fs78}1000{\fs68}分赛
Dialogue: 0,0:00:14.67,0:00:17.47,TL,,0,0,0,,{\fs78}2{\fs68}月 多哈 穆霍娃上一次夺冠
Dialogue: 0,0:00:17.47,0:00:19.36,TL,,0,0,0,,还是{\fs78}2019{\fs68}年
Dialogue: 0,0:00:19.74,0:00:21.71,TL,,0,0,0,,之后输掉了{\fs78}4{\fs68}场决赛
Dialogue: 0,0:00:21.71,0:00:24.06,TL,,0,0,0,,这一次 她半决赛先丢一盘
Dialogue: 0,0:00:24.06,0:00:25.64,TL,,0,0,0,,逆转萨卡里
Dialogue: 0,0:00:25.68,0:00:27.35,TL,,0,0,0,,决赛{\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:27.35,0:00:29.58,TL,,0,0,0,,击败{\fs78}19{\fs68}岁的姆博科
Dialogue: 0,0:00:35.22,0:00:37.19,TL,,0,0,0,,{\fs78}6{\fs68}年半 终于等来第二冠
Dialogue: 0,0:00:37.19,0:00:39.57,TL,,0,0,0,,也是第一个{\fs78}1000{\fs68}分赛冠军
Dialogue: 0,0:00:41.52,0:00:44.06,TL,,0,0,0,,一周后的迪拜 佩古拉要打破的
Dialogue: 0,0:00:44.06,0:00:46.76,TL,,0,0,0,,是连续{\fs78}6{\fs68}次止步四强的魔咒
Dialogue: 0,0:00:46.90,0:00:49.27,TL,,0,0,0,,半决赛先丢一盘 又被破发
Dialogue: 0,0:00:49.27,0:00:51.61,TL,,0,0,0,,硬是逆转了阿尼西莫娃
Dialogue: 0,0:00:51.80,0:00:53.63,TL,,0,0,0,,决赛{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:53.63,0:00:56.42,TL,,0,0,0,,直落两盘击败斯维托丽娜
Dialogue: 0,0:00:56.51,0:00:58.92,TL,,0,0,0,,最后一分 是一记{\fs78}Ace{\fs68}
Dialogue: 0,0:01:01.52,0:01:02.04,TL,,0,0,88,,{\an2}{\fnInter 24pt SemiBold\b0\fs44\bord2.5\fsp0.6}Ladies and gentlemen,{\fnNoto Sans CJK SC\b1\fs68\bord4\fsp0}\N女士们 先生们
Dialogue: 0,0:01:02.24,0:01:04.18,TL,,0,0,88,,{\an2}{\fnInter 24pt SemiBold\b0\fs44\bord2.5\fsp0.6}your winner once again, Jessica Pegula.{\fnNoto Sans CJK SC\b1\fs68\bord4\fsp0}\N再一次 冠军是杰西卡 佩古拉！
Dialogue: 0,0:01:06.12,0:01:07.25,TL,,0,0,0,,印第安维尔斯
Dialogue: 0,0:01:07.25,0:01:10.57,TL,,0,0,0,,萨巴伦卡此前两进决赛 都输了
Dialogue: 0,0:01:11.24,0:01:13.83,TL,,0,0,0,,决赛还连续{\fs78}4{\fs68}次输给莱巴金娜
Dialogue: 0,0:01:13.83,0:01:16.31,TL,,0,0,0,,这一次 她又丢了首盘
Dialogue: 0,0:01:16.43,0:01:18.29,TL,,0,0,0,,决胜盘抢七 {\fs78}5{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:01:18.29,0:01:20.52,TL,,0,0,0,,莱巴金娜握着冠军点
Dialogue: 0,0:01:25.46,0:01:28.11,TL,,0,0,0,,一记反手斜线 化解！
Dialogue: 0,0:01:31.88,0:01:33.71,TL,,0,0,0,,再连拿两分 世界第{\fs78}1{\fs68}
Dialogue: 0,0:01:33.71,0:01:35.71,TL,,0,0,0,,终于在沙漠捧杯
Dialogue: 0,0:01:35.92,0:01:37.23,TL,,0,0,0,,两周后的迈阿密
Dialogue: 0,0:01:37.23,0:01:39.31,TL,,0,0,0,,她没给任何人机会
Dialogue: 0,0:01:39.48,0:01:41.06,TL,,0,0,0,,半决赛世界第{\fs78}1{\fs68}对第二
Dialogue: 0,0:01:41.06,0:01:43.58,TL,,0,0,0,,直落两盘赢了莱巴金娜
Dialogue: 0,0:01:43.62,0:01:47.28,TL,,0,0,0,,决赛{\fs78}3{\fs68}盘击败高芙 全周只丢一盘
Dialogue: 0,0:01:47.44,0:01:50.45,TL,,0,0,0,,阳光双冠 她是史上第五人
Dialogue: 0,0:01:51.55,0:01:54.10,TL,,0,0,0,,上一位 是斯瓦泰克
Dialogue: 0,0:02:01.47,0:02:05.06,TL,,0,0,0,,马德里 科斯秋克只是{\fs78}26{\fs68}号种子
Dialogue: 0,0:02:06.11,0:02:08.74,TL,,0,0,0,,她先后击败佩古拉和诺斯科娃
Dialogue: 0,0:02:08.74,0:02:10.19,TL,,0,0,0,,决赛对安德列娃
Dialogue: 0,0:02:10.19,0:02:12.15,TL,,0,0,0,,第二盘{\fs78}4{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:02:12.19,0:02:13.56,TL,,0,0,0,,她救下两个盘点
Dialogue: 0,0:02:13.56,0:02:15.32,TL,,0,0,0,,还连发两记{\fs78}Ace{\fs68}
Dialogue: 0,0:02:19.71,0:02:21.65,TL,,0,0,0,,乌克兰人第一次在马德里封后
Dialogue: 0,0:02:21.65,0:02:24.26,TL,,0,0,0,,庆祝方式 是一个后空翻
Dialogue: 0,0:02:28.92,0:02:31.17,TL,,0,0,0,,斯维托丽娜上次在罗马夺冠
Dialogue: 0,0:02:31.17,0:02:33.08,TL,,0,0,0,,还是{\fs78}2018{\fs68}年
Dialogue: 0,0:02:33.78,0:02:35.65,TL,,0,0,0,,{\fs78}8{\fs68}年后 {\fs78}31{\fs68}岁的她
Dialogue: 0,0:02:35.65,0:02:37.89,TL,,0,0,0,,一周连胜{\fs78}3{\fs68}位前五
Dialogue: 0,0:02:38.06,0:02:40.82,TL,,0,0,0,,莱巴金娜 斯瓦泰克 高芙
Dialogue: 0,0:02:40.82,0:02:43.69,TL,,0,0,0,,决赛鏖战{\fs78}2{\fs68}小时{\fs78}49{\fs68}分钟
Dialogue: 0,0:02:48.73,0:02:51.18,TL,,0,0,0,,第三个罗马冠军 生涯第{\fs78}20{\fs68}冠
Dialogue: 0,0:02:51.18,0:02:53.49,TL,,0,0,0,,公开赛年代乌克兰第一人
Dialogue: 0,0:02:53.66,0:02:56.98,TL,,0,0,0,,到了夏天 最失落的人是斯瓦泰克
Dialogue: 0,0:02:57.15,0:03:00.57,TL,,0,0,0,,赛季一个决赛都没进 排名滑到第八
Dialogue: 0,0:03:00.76,0:03:03.85,TL,,0,0,0,,多伦多 她{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛逆转科斯秋克
Dialogue: 0,0:03:03.85,0:03:06.43,TL,,0,0,0,,半决赛向斯维托丽娜复仇
Dialogue: 0,0:03:06.53,0:03:09.68,TL,,0,0,0,,决赛{\fs78}75{\fs68}分钟横扫莱巴金娜
Dialogue: 0,0:03:16.65,0:03:18.29,TL,,0,0,0,,第{\fs78}12{\fs68}个{\fs78}1000{\fs68}分赛冠军
Dialogue: 0,0:03:18.29,0:03:19.57,TL,,0,0,0,,{\fs78}2009{\fs68}年以来
Dialogue: 0,0:03:19.57,0:03:21.41,TL,,0,0,0,,只有小威比她多
Dialogue: 0,0:03:21.82,0:03:25.43,TL,,0,0,0,,辛辛那提 {\fs78}56{\fs68}年来第一次全美决赛
Dialogue: 0,0:03:25.60,0:03:27.31,TL,,0,0,0,,高芙首战丢掉一盘
Dialogue: 0,0:03:27.31,0:03:30.58,TL,,0,0,0,,之后连赢{\fs78}12{\fs68}盘 只丢{\fs78}32{\fs68}局
Dialogue: 0,0:03:30.65,0:03:32.04,TL,,0,0,0,,决赛开局{\fs78}5{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:03:32.04,0:03:34.43,TL,,0,0,0,,直落两盘击败佩古拉
Dialogue: 0,0:03:39.24,0:03:40.96,TL,,0,0,0,,继小威 阿扎伦卡之后
Dialogue: 0,0:03:40.96,0:03:44.10,TL,,0,0,0,,第三位两夺辛辛那提的女子球员
Dialogue: 0,0:03:47.01,0:03:48.41,TL,,0,0,0,,然后是北京
Dialogue: 0,0:03:48.41,0:03:51.80,TL,,0,0,0,,郑钦文赛季中一度跌到第{\fs78}160{\fs68}位
Dialogue: 0,0:03:51.89,0:03:53.84,TL,,0,0,0,,这次拿着外卡回到中网
Dialogue: 0,0:03:53.84,0:03:56.34,TL,,0,0,0,,前{\fs78}4{\fs68}场全部打满{\fs78}3{\fs68}盘
Dialogue: 0,0:03:56.43,0:03:57.93,TL,,0,0,0,,决赛首盘{\fs78}0{\fs68}比{\fs78}2{\fs68}落后
Dialogue: 0,0:03:57.93,0:03:59.59,TL,,0,0,0,,第十局化解{\fs78}3{\fs68}个盘点
Dialogue: 0,0:03:59.59,0:04:01.94,TL,,0,0,0,,然后一口气连赢{\fs78}11{\fs68}分
Dialogue: 0,0:04:02.08,0:04:03.91,TL,,0,0,0,,最后一分
Dialogue: 0,0:04:04.03,0:04:05.86,TL,,0,0,0,,{\fs78}Ace{\fs68}！
Dialogue: 0,0:04:05.98,0:04:07.00,TL,,0,0,0,,中网{\fs78}1000{\fs68}赛
Dialogue: 0,0:04:07.00,0:04:09.52,TL,,0,0,0,,她是第一位中国女单冠军
Dialogue: 0,0:04:09.92,0:04:13.19,TL,,0,0,0,,也是中网复办以来第一位外卡冠军
Dialogue: 0,0:04:20.28,0:04:22.09,TL,,0,0,0,,最后一站 武汉
Dialogue: 0,0:04:22.09,0:04:25.19,TL,,0,0,0,,赫瓦林斯卡今年打进过法网决赛
Dialogue: 0,0:04:25.40,0:04:28.04,TL,,0,0,0,,可巡回赛冠军数 还是零
Dialogue: 0,0:04:28.04,0:04:31.39,TL,,0,0,0,,半决赛{\fs78}3{\fs68}比{\fs78}5{\fs68}落后 救下两个盘点
Dialogue: 0,0:04:31.50,0:04:33.11,TL,,0,0,0,,击败斯瓦泰克
Dialogue: 0,0:04:33.11,0:04:36.38,TL,,0,0,0,,决赛先丢一盘 次盘{\fs78}0{\fs68}比{\fs78}2{\fs68}落后
Dialogue: 0,0:04:36.48,0:04:38.99,TL,,0,0,0,,决胜盘连下最后{\fs78}4{\fs68}局
Dialogue: 0,0:04:45.98,0:04:47.31,TL,,0,0,0,,{\fs78}2009{\fs68}年以来
Dialogue: 0,0:04:47.31,0:04:49.16,TL,,0,0,0,,生涯首冠就是{\fs78}1000{\fs68}分赛的
Dialogue: 0,0:04:49.16,0:04:50.62,TL,,0,0,0,,只有{\fs78}3{\fs68}个人
Dialogue: 0,0:04:51.89,0:04:54.86,TL,,0,0,0,,大坂 安德莱斯库 姆博科
Dialogue: 0,0:05:02.25,0:05:04.78,TL,,0,0,0,,{\fs78}10{\fs68}站九冠 {\fs78}4{\fs68}个第一次
Dialogue: 0,0:05:04.95,0:05:07.48,TL,,0,0,0,,萨巴伦卡两冠 最稳
Dialogue: 0,0:05:09.06,0:05:10.79,TL,,0,0,0,,可{\fs78}9{\fs68}个不同的冠军说明
Dialogue: 0,0:05:10.79,0:05:13.13,TL,,0,0,0,,今年没有谁能一手遮天
Dialogue: 0,0:05:14.42,0:05:15.48,TL,,0,0,0,,{\fs78}10{\fs68}站决赛
Dialogue: 0,0:05:15.48,0:05:17.86,TL,,0,0,0,,你心里最好看的是哪一场？
