        }
      },
      {
        "source": "sf",
        "start": 347.0,
        "end": 355.4,
        "cx": 0.5,
        "track": false,
        "narration": "半决赛，他六比三、六比四击败四届上海冠军德约科维奇，成了大师赛史上排名最低的决赛选手。",
        "voice": {
          "pitch": "+10Hz"
        },
        "inset": {
          "image": "assets/reel/vach/vach-sf.png",
          "kind": "story_text",
          "corner": "tr",
          "width": 0.6,
          "pad": 0.085,
