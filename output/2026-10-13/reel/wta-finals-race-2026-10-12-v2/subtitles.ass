Dialogue: 0,0:00:03.15,0:00:04.72,TL,,0,0,0,,{\fs78}2022{\fs68}到{\fs78}2025{\fs68}
Dialogue: 0,0:00:04.72,0:00:07.56,TL,,0,0,0,,斯瓦泰克连续{\fs78}4{\fs68}年都拿大满贯 今年
Dialogue: 0,0:00:07.56,0:00:10.95,TL,,0,0,0,,最好只是{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛 这条纪录断了
Dialogue: 0,0:00:11.35,0:00:13.52,TL,,0,0,0,,现在 另一条纪录也悬了
Dialogue: 0,0:00:13.52,0:00:16.38,TL,,0,0,0,,她已经连续{\fs78}5{\fs68}年打进年终总决赛
Dialogue: 0,0:00:16.38,0:00:17.29,TL,,0,0,0,,再进一次
Dialogue: 0,0:00:17.29,0:00:19.56,TL,,0,0,0,,追平拉德万斯卡的连续{\fs78}6{\fs68}年
Dialogue: 0,0:00:19.56,0:00:21.89,TL,,0,0,0,,进不了 就停在{\fs78}5{\fs68}年
Dialogue: 0,0:00:22.75,0:00:23.65,TL,,0,0,0,,{\fs78}8{\fs68}月多伦多
Dialogue: 0,0:00:23.65,0:00:26.10,TL,,0,0,0,,她{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68}击败莱巴金娜
Dialogue: 0,0:00:26.10,0:00:27.99,TL,,0,0,0,,拿到本赛季第一个冠军
Dialogue: 0,0:00:27.99,0:00:31.08,TL,,0,0,0,,赛后她说 这个赛季一路颠簸
Dialogue: 0,0:00:32.55,0:00:34.78,TL,,0,0,0,,可到了{\fs78}10{\fs68}月 总决赛积分榜上
Dialogue: 0,0:00:34.78,0:00:36.49,TL,,0,0,0,,她只排第十
Dialogue: 0,0:00:37.15,0:00:38.93,TL,,0,0,0,,{\fs78}8{\fs68}个名额已经定了{\fs78}4{\fs68}个
Dialogue: 0,0:00:38.93,0:00:40.63,TL,,0,0,0,,莱巴金娜 萨巴伦卡
Dialogue: 0,0:00:40.63,0:00:43.11,TL,,0,0,0,,安德烈耶娃和诺斯科娃
Dialogue: 0,0:00:44.15,0:00:45.44,TL,,0,0,0,,诺斯科娃排第八
Dialogue: 0,0:00:45.44,0:00:46.78,TL,,0,0,0,,但她是温网冠军
Dialogue: 0,0:00:46.78,0:00:49.34,TL,,0,0,0,,有大满贯冠军保底 稳进
Dialogue: 0,0:00:49.34,0:00:50.85,TL,,0,0,0,,今年第九到{\fs78}20{\fs68}名里
Dialogue: 0,0:00:50.85,0:00:52.37,TL,,0,0,0,,没有别的大满贯冠军
Dialogue: 0,0:00:52.37,0:00:55.03,TL,,0,0,0,,所以剩下四席 全看积分
Dialogue: 0,0:00:55.75,0:00:57.97,TL,,0,0,0,,斯瓦泰克{\fs78}3799{\fs68}分
Dialogue: 0,0:00:57.97,0:01:00.10,TL,,0,0,0,,圈内第四个位置是穆霍娃
Dialogue: 0,0:01:00.10,0:01:04.25,TL,,0,0,0,,{\fs78}4615{\fs68}分 差距 {\fs78}816{\fs68}分
Dialogue: 0,0:01:04.95,0:01:06.90,TL,,0,0,0,,穆霍娃今年打进温网决赛
Dialogue: 0,0:01:06.90,0:01:08.58,TL,,0,0,0,,眼下排第七
Dialogue: 0,0:01:09.35,0:01:10.55,TL,,0,0,0,,斯瓦泰克身前
Dialogue: 0,0:01:10.55,0:01:14.39,TL,,0,0,0,,还有排第九的科斯秋克 {\fs78}3910{\fs68}分
Dialogue: 0,0:01:15.15,0:01:16.65,TL,,0,0,0,,北京本是追分的机会
Dialogue: 0,0:01:16.65,0:01:18.81,TL,,0,0,0,,{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛她却输给梅尔滕斯
Dialogue: 0,0:01:18.81,0:01:20.94,TL,,0,0,0,,首盘抢七一分没拿
Dialogue: 0,0:01:21.35,0:01:22.47,TL,,0,0,0,,她只剩三站
Dialogue: 0,0:01:22.47,0:01:24.56,TL,,0,0,0,,武汉{\fs78}1000{\fs68}赛 宁波{\fs78}500{\fs68}赛
Dialogue: 0,0:01:24.56,0:01:26.25,TL,,0,0,0,,东京{\fs78}500{\fs68}赛
Dialogue: 0,0:01:26.95,0:01:29.11,TL,,0,0,0,,武汉打进决赛拿{\fs78}650{\fs68}分
Dialogue: 0,0:01:29.11,0:01:32.35,TL,,0,0,0,,再在宁波或东京进半决赛拿{\fs78}195{\fs68}分
Dialogue: 0,0:01:32.35,0:01:35.88,TL,,0,0,0,,合计{\fs78}845{\fs68}分 才刚好越过这道坎
Dialogue: 0,0:01:36.35,0:01:38.89,TL,,0,0,0,,武汉她是{\fs78}7{\fs68}号种子 首轮轮空
Dialogue: 0,0:01:38.89,0:01:40.46,TL,,0,0,0,,{\fs78}14{\fs68}号次轮对弗雷赫
Dialogue: 0,0:01:40.46,0:01:43.55,TL,,0,0,0,,{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛可能就撞上萨巴伦卡
Dialogue: 0,0:01:44.35,0:01:46.34,TL,,0,0,0,,而且对手不会停下
Dialogue: 0,0:01:46.34,0:01:47.74,TL,,0,0,0,,佩古拉
Dialogue: 0,0:01:48.15,0:01:49.99,TL,,0,0,0,,斯维托丽娜 科斯秋克
Dialogue: 0,0:01:49.99,0:01:52.31,TL,,0,0,0,,也都报了宁波和东京
Dialogue: 0,0:01:53.15,0:01:55.09,TL,,0,0,0,,还要穆霍娃原地踏步
Dialogue: 0,0:01:55.09,0:01:55.98,TL,,0,0,0,,本节目估计
Dialogue: 0,0:01:55.98,0:01:59.01,TL,,0,0,0,,她进总决赛的机会大约{\fs78}10{\fs68}%
Dialogue: 0,0:01:59.55,0:02:01.40,TL,,0,0,0,,印第安维尔斯的末班车
Dialogue: 0,0:02:01.40,0:02:02.89,TL,,0,0,0,,她赶得上吗？
