    {
      "id": "bundle:42635cfcbb55949d72f76b8fb7aeaaeeed62e548e79d7431e125f60330fb7f44",
      "request_id": "42635cfcbb55949d72f76b8fb7aeaaeeed62e548e79d7431e125f60330fb7f44",
      "request": {
        "backend": "edge",
        "cache_key": "b2f91831d1e777f92c6351bf22dd2067",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "七比六、七比五，萨巴伦卡拿下小组首胜。下一场对安德烈娃，她能把关键时刻的稳定延续下去吗？",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "cc99920c027f6314234906656d66273d6711e2dfa29a5183596ad0ce41b1e965",
