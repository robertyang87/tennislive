Dialogue: 0,0:00:14.73,0:00:16.47,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68}比{\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:16.47,0:00:17.37,TL,,0,0,0,,佩古拉拿下
Dialogue: 0,0:00:17.37,0:00:18.70,TL,,0,0,0,,决胜盘{\fs78}5{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:00:18.70,0:00:21.08,TL,,0,0,0,,科斯蒂亚扛住{\fs78}4{\fs68}个赛点中的{\fs78}3{\fs68}个
Dialogue: 0,0:00:21.08,0:00:23.49,TL,,0,0,0,,佩古拉第四个才终于兑现
Dialogue: 0,0:00:24.97,0:00:27.25,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}20{\fs68}号凌晨一点
Dialogue: 0,0:00:27.25,0:00:30.03,TL,,0,0,0,,辛辛那提网球公开赛女单{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛
Dialogue: 0,0:00:30.03,0:00:31.76,TL,,0,0,0,,在灯光球场打响
Dialogue: 0,0:00:31.76,0:00:34.62,TL,,0,0,0,,{\fs78}3{\fs68}号种子佩古拉对阵科斯蒂亚
Dialogue: 0,0:00:38.01,0:00:39.68,TL,,0,0,0,,两人此前交手{\fs78}3{\fs68}次
Dialogue: 0,0:00:39.68,0:00:41.19,TL,,0,0,0,,佩古拉两胜一负
Dialogue: 0,0:00:41.19,0:00:44.61,TL,,0,0,0,,上一次交手要追溯到{\fs78}5{\fs68}年前的马德里
Dialogue: 0,0:00:47.07,0:00:49.61,TL,,0,0,0,,首盘一开局佩古拉就顶住压力
Dialogue: 0,0:00:49.61,0:00:50.83,TL,,0,0,0,,一路建立领先
Dialogue: 0,0:00:50.83,0:00:52.53,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}2{\fs68}逼出{\fs78}3{\fs68}个盘点
Dialogue: 0,0:00:52.53,0:00:53.73,TL,,0,0,0,,随即拿下{\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:53.73,0:00:55.16,TL,,0,0,0,,只用了{\fs78}26{\fs68}分钟
Dialogue: 0,0:00:55.16,0:00:58.04,TL,,0,0,0,,比赛的天平从一开始就没有回摆
Dialogue: 0,0:01:00.27,0:01:02.21,TL,,0,0,0,,次盘科斯蒂亚 顶了回来
Dialogue: 0,0:01:02.21,0:01:04.91,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}4{\fs68}时逼出破发点完成破发
Dialogue: 0,0:01:04.91,0:01:06.70,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68}扳回一盘
Dialogue: 0,0:01:09.31,0:01:10.79,TL,,0,0,0,,决胜盘{\fs78}5{\fs68}比{\fs78}5{\fs68}后
Dialogue: 0,0:01:10.79,0:01:13.07,TL,,0,0,0,,佩古拉先完成破发 {\fs78}6{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:13.07,0:01:15.07,TL,,0,0,0,,科斯蒂亚随即在她的发球局里
Dialogue: 0,0:01:15.07,0:01:17.07,TL,,0,0,0,,连续施压 逼出破发点
Dialogue: 0,0:01:17.07,0:01:18.79,TL,,0,0,0,,把比分拖回悬念之中
Dialogue: 0,0:01:18.79,0:01:20.65,TL,,0,0,0,,双方在{\fs78}40{\fs68}平反复拉锯
Dialogue: 0,0:01:20.65,0:01:22.46,TL,,0,0,0,,一次次拉回占先
Dialogue: 0,0:01:25.07,0:01:26.99,TL,,0,0,0,,{\fs78}4{\fs68}次交手 三胜一负
Dialogue: 0,0:01:26.99,0:01:28.11,TL,,0,0,0,,她上一次赢
Dialogue: 0,0:01:28.11,0:01:30.07,TL,,0,0,0,,还是{\fs78}15{\fs68}年前的事
Dialogue: 0,0:01:30.07,0:01:32.08,TL,,0,0,0,,下一次还要等多久？
