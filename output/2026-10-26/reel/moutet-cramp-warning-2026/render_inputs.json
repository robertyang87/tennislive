        "start": 240.0,
        "end": 248.6,
        "cx": 0.5,
        "track": false,
        "narration": "接下来九分，他拿了七分，七比四赢下抢七。可抽筋倒地，为什么还会被警告？",
        "voice": {
          "pitch": "+10Hz"
        }
      },
      {
        "source": "lyon",
        "start": 248.6,
        "end": 267.4,
        "cx": 0.5,
        "track": false,
        "narration": "",
        "quote": [
          {
            "at": 0.2,
            "end": 3.4,
            "text": "Oh, it's glorious.\n太漂亮了。"
