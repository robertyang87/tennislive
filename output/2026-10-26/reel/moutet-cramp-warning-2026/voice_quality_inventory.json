        "cache_key": "e7fe911df989ed36d2f5e4a5d13af77d",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "十月二十号，里昂站首轮，法国人穆泰对阵同胞安贝尔。打到决胜盘，穆泰二比零领先。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "cc96dd704e309349bf6876c391db3f1fb6396f587f5467080930e3a6febf0de3",
      "words_sha256": "a6639dd684ea6c2a5a22992eb5c3807ec1a299efbbb1fa6c2cbdacc7ec614842"
    },
    {
