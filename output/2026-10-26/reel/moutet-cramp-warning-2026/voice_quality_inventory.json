      "request_id": "d03f9f230507ae1739218c25c2eca3122a16b984aea96cdf7c1fc9577bb3a7f3",
      "request": {
        "backend": "edge",
        "cache_key": "aa84275e788a8044bf96c9527a4be6b4",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "他被扶了起来，比赛接着打。可主裁还是判他超时，给了一次警告。按规则，抽筋不能叫医疗暂停。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "f9a2ceb50c9e235e67164389c872a2aae36bbd393295692fc820193ceaf44333",
      "words_sha256": "77ecf9af15aabe04ef6cf4f956ae054803c5010b24756a3feb285e9ca270b378"
    },
    {
      "id": "bundle:e9cf797f4785480d8b6328c000da64ba317a9f0e0898acf6f52f8cbcbfe3f7ef",
      "request_id": "e9cf797f4785480d8b6328c000da64ba317a9f0e0898acf6f52f8cbcbfe3f7ef",
      "request": {
        "backend": "edge",
        "cache_key": "d20290d7f1dd665642eb2a4195d5407f",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "决胜盘打进抢七，他先零比二落后。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "c3ec7bb52982f4ed72ffa6c133a2aabe3a8b58a5d8d97f162d76e65eeb3c56a7",
      "words_sha256": "6ca8f3ed0f3fc27d112a4e2fadc45ca78bab871c7978b06ce56a95014399807e"
    },
