Dialogue: 0,0:00:08.67,0:00:09.83,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}2{\fs68}落后
Dialogue: 0,0:00:09.83,0:00:12.23,TL,,0,0,0,,卢布列夫把这场球拿了回来
Dialogue: 0,0:00:12.23,0:00:15.65,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}31{\fs68}号夜里{\fs78}11{\fs68}点多
Dialogue: 0,0:00:17.07,0:00:20.11,TL,,0,0,0,,美网男单第一轮 纽约{\fs78}7{\fs68}号球场
Dialogue: 0,0:00:20.11,0:00:23.05,TL,,0,0,0,,第一盘抢七 卢布列夫{\fs78}3{\fs68}比{\fs78}6{\fs68}落后
Dialogue: 0,0:00:23.05,0:00:26.38,TL,,0,0,0,,连救两个盘点 第三个没救下来
Dialogue: 0,0:00:27.25,0:00:29.18,TL,,0,0,0,,第二盘又是抢七
Dialogue: 0,0:00:29.18,0:00:32.58,TL,,0,0,0,,这一次 卢布列夫一分都没拿到
Dialogue: 0,0:00:33.61,0:00:35.08,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}2{\fs68}落后
Dialogue: 0,0:00:35.08,0:00:37.40,TL,,0,0,0,,可这是大满贯 {\fs78}5{\fs68}盘三胜
Dialogue: 0,0:00:37.40,0:00:39.61,TL,,0,0,0,,他还剩{\fs78}3{\fs68}盘可打
Dialogue: 0,0:00:42.21,0:00:43.09,TL,,0,0,0,,第三盘
Dialogue: 0,0:00:43.09,0:00:45.56,TL,,0,0,0,,维尔塔宁的一发得分率掉了下来
Dialogue: 0,0:00:45.56,0:00:48.67,TL,,0,0,0,,从{\fs78}74{\fs68}% 到{\fs78}21{\fs68}%
Dialogue: 0,0:00:48.67,0:00:50.62,TL,,0,0,0,,{\fs78}27{\fs68}分钟 {\fs78}6{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:00:50.62,0:00:52.98,TL,,0,0,0,,卢布列夫一局都没让
Dialogue: 0,0:00:54.21,0:00:57.37,TL,,0,0,0,,第四盘 卢布列夫继续压着打
Dialogue: 0,0:00:57.37,0:01:00.56,TL,,0,0,0,,这一盘他的一发得分率是{\fs78}91{\fs68}%
Dialogue: 0,0:01:00.56,0:01:03.21,TL,,0,0,0,,维尔塔宁只有{\fs78}46{\fs68}%
Dialogue: 0,0:01:05.71,0:01:06.86,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:06.86,0:01:09.41,TL,,0,0,0,,中间这两盘一共{\fs78}55{\fs68}分钟
Dialogue: 0,0:01:09.41,0:01:11.70,TL,,0,0,0,,维尔塔宁只拿到两局
Dialogue: 0,0:01:11.70,0:01:13.70,TL,,0,0,0,,比赛回到原点
Dialogue: 0,0:01:15.21,0:01:17.79,TL,,0,0,0,,决胜盘 {\fs78}12{\fs68}局全是保发
Dialogue: 0,0:01:17.79,0:01:19.37,TL,,0,0,0,,谁也破不了谁
Dialogue: 0,0:01:19.37,0:01:21.83,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}5{\fs68} 轮到卢布列夫发球
Dialogue: 0,0:01:21.83,0:01:24.44,TL,,0,0,0,,屏幕上黄字亮了 赛点
Dialogue: 0,0:01:24.44,0:01:26.21,TL,,0,0,0,,这一分是维尔塔宁的
Dialogue: 0,0:01:26.21,0:01:29.18,TL,,0,0,0,,他只要赢下来 比赛就结束
Dialogue: 0,0:01:29.61,0:01:31.74,TL,,0,0,0,,维尔塔宁的赛点没了
Dialogue: 0,0:01:31.74,0:01:34.10,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}6{\fs68} 进抢七
Dialogue: 0,0:01:34.76,0:01:36.50,TL,,0,0,0,,决胜盘打进抢七
Dialogue: 0,0:01:36.50,0:01:39.05,TL,,0,0,0,,美网的规矩是抢满{\fs78}10{\fs68}分
Dialogue: 0,0:01:39.05,0:01:42.33,TL,,0,0,0,,这一次 卢布列夫没有再让机会溜走
Dialogue: 0,0:01:42.33,0:01:46.06,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}1{\fs68} {\fs78}5{\fs68}比{\fs78}2{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68} 一路领先
Dialogue: 0,0:01:48.64,0:01:51.26,TL,,0,0,0,,{\fs78}20{\fs68}记 {\fs78}Ace{\fs68} {\fs78}3{\fs68}次双误
Dialogue: 0,0:01:51.26,0:01:52.45,TL,,0,0,0,,{\fs78}3{\fs68}个多小时里
Dialogue: 0,0:01:52.45,0:01:54.59,TL,,0,0,0,,他连着保住了{\fs78}20{\fs68}个发球局
Dialogue: 0,0:01:54.59,0:01:57.81,TL,,0,0,0,,发球一直在 只是机会没兑现
Dialogue: 0,0:02:00.24,0:02:02.76,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} 还差四分
Dialogue: 0,0:02:04.75,0:02:07.84,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}4{\fs68} 卢布列夫拿到第一个赛点
Dialogue: 0,0:02:07.84,0:02:09.65,TL,,0,0,0,,维尔塔宁救掉了
Dialogue: 0,0:02:09.65,0:02:11.55,TL,,0,0,0,,{\fs78}9{\fs68}比{\fs78}5{\fs68} 第二个赛点
Dialogue: 0,0:02:11.55,0:02:14.56,TL,,0,0,0,,{\fs78}3{\fs68}个多小时之后 就剩这一分
Dialogue: 0,0:02:17.14,0:02:19.32,TL,,0,0,0,,从北京时间夜里{\fs78}11{\fs68}点多
Dialogue: 0,0:02:19.32,0:02:21.29,TL,,0,0,0,,打到凌晨快{\fs78}3{\fs68}点
Dialogue: 0,0:02:21.29,0:02:24.60,TL,,0,0,0,,三小时{\fs78}42{\fs68}分钟 整整{\fs78}5{\fs68}盘
Dialogue: 0,0:02:24.60,0:02:27.94,TL,,0,0,0,,第二个赛点 卢布列夫把它拿下了
Dialogue: 0,0:02:33.35,0:02:36.84,TL,,0,0,0,,{\fs78}7{\fs68}号球场的看台上 人全站了起来
Dialogue: 0,0:02:36.84,0:02:38.82,TL,,0,0,0,,全场{\fs78}24{\fs68}个破发点
Dialogue: 0,0:02:38.82,0:02:40.73,TL,,0,0,0,,卢布列夫只兑现了{\fs78}7{\fs68}个
Dialogue: 0,0:02:40.73,0:02:44.22,TL,,0,0,0,,可决胜盘那个赛点 他没有放过
Dialogue: 0,0:02:45.68,0:02:48.60,TL,,0,0,0,,网前 他和维尔塔宁握了手
Dialogue: 0,0:02:48.60,0:02:51.49,TL,,0,0,0,,这个{\fs78}25{\fs68}岁的芬兰人是幸运落败者
Dialogue: 0,0:02:51.49,0:02:52.89,TL,,0,0,0,,资格赛输了球之后
Dialogue: 0,0:02:52.89,0:02:55.69,TL,,0,0,0,,靠别人退赛才递补进的正赛
Dialogue: 0,0:02:55.69,0:02:57.65,TL,,0,0,0,,而{\fs78}28{\fs68}岁的卢布列夫
Dialogue: 0,0:02:57.65,0:03:00.39,TL,,0,0,0,,大满贯的四分之一决赛他去过{\fs78}10{\fs68}次
Dialogue: 0,0:03:00.39,0:03:02.15,TL,,0,0,0,,{\fs78}10{\fs68}次都停在那儿
Dialogue: 0,0:03:02.15,0:03:05.57,TL,,0,0,0,,这一次 他能不能再往前一步？
