Dialogue: 0,0:00:00.05,0:00:01.26,TL,,0,0,0,,从奥运冠军
Dialogue: 0,0:00:01.26,0:00:02.84,TL,,0,0,0,,到美网资格赛
Dialogue: 0,0:00:02.84,0:00:05.40,TL,,0,0,0,,她为什么又回到了起点？
Dialogue: 0,0:00:13.82,0:00:16.88,TL,,0,0,0,,{\fs78}19{\fs68}岁 第一次参加大满贯资格赛
Dialogue: 0,0:00:16.88,0:00:19.30,TL,,0,0,0,,连赢{\fs78}3{\fs68}场 再赢正赛首轮
Dialogue: 0,0:00:19.30,0:00:22.46,TL,,0,0,0,,她第一次把名字写进大满贯
Dialogue: 0,0:00:25.32,0:00:27.72,TL,,0,0,0,,两年后 她已是巴黎奥运冠军
Dialogue: 0,0:00:27.72,0:00:29.48,TL,,0,0,0,,最高世界第{\fs78}4{\fs68}
Dialogue: 0,0:00:29.48,0:00:30.88,TL,,0,0,0,,很少有人想到
Dialogue: 0,0:00:30.88,0:00:33.55,TL,,0,0,0,,她还会回到资格赛起点
Dialogue: 0,0:00:34.82,0:00:38.33,TL,,0,0,0,,右肘疼痛从{\fs78}2024{\fs68}年温网前开始
Dialogue: 0,0:00:38.33,0:00:40.76,TL,,0,0,0,,她硬撑到{\fs78}2025{\fs68}年{\fs78}7{\fs68}月手术
Dialogue: 0,0:00:40.76,0:00:43.05,TL,,0,0,0,,也退出了当年美网
Dialogue: 0,0:00:44.82,0:00:47.20,TL,,0,0,0,,两个月后北京第一次复出
Dialogue: 0,0:00:47.20,0:00:50.68,TL,,0,0,0,,赢了两场 右肘却再次疼到退赛
Dialogue: 0,0:00:50.68,0:00:53.51,TL,,0,0,0,,归来 变成又一次停下
Dialogue: 0,0:00:55.32,0:00:56.79,TL,,0,0,0,,武汉 全运会
Dialogue: 0,0:00:56.79,0:00:58.17,TL,,0,0,0,,二零二六澳网
Dialogue: 0,0:00:58.17,0:00:59.77,TL,,0,0,0,,她接连缺席
Dialogue: 0,0:00:59.77,0:01:01.06,TL,,0,0,0,,直到{\fs78}2{\fs68}月多哈
Dialogue: 0,0:01:01.06,0:01:03.41,TL,,0,0,0,,她才第二次回到赛场
Dialogue: 0,0:01:03.82,0:01:05.16,TL,,0,0,0,,第二次复出首战
Dialogue: 0,0:01:05.16,0:01:06.60,TL,,0,0,0,,她轰出{\fs78}20{\fs68}记{\fs78}ACE{\fs68}
Dialogue: 0,0:01:06.60,0:01:08.97,TL,,0,0,0,,{\fs78}43{\fs68}个制胜分逆转肯宁
Dialogue: 0,0:01:08.97,0:01:11.21,TL,,0,0,0,,郑钦文还没有结束
Dialogue: 0,0:01:13.82,0:01:16.44,TL,,0,0,0,,可复出 不等于回到从前
Dialogue: 0,0:01:16.44,0:01:18.50,TL,,0,0,0,,{\fs78}2026{\fs68}年{\fs78}11{\fs68}胜{\fs78}13{\fs68}负
Dialogue: 0,0:01:18.50,0:01:20.31,TL,,0,0,0,,跌到世界第{\fs78}127{\fs68}
Dialogue: 0,0:01:20.31,0:01:23.35,TL,,0,0,0,,也错过美网正赛直接入围
Dialogue: 0,0:01:24.82,0:01:25.81,TL,,0,0,0,,所以这一次
Dialogue: 0,0:01:25.81,0:01:29.43,TL,,0,0,0,,没有奥运冠军的捷径 {\fs78}3{\fs68}轮 三道门
Dialogue: 0,0:01:29.43,0:01:31.75,TL,,0,0,0,,必须全部赢下来
Dialogue: 0,0:01:32.82,0:01:34.85,TL,,0,0,0,,第一道门 尤晓迪
Dialogue: 0,0:01:34.85,0:01:36.45,TL,,0,0,0,,世界第{\fs78}198{\fs68}
Dialogue: 0,0:01:36.45,0:01:38.87,TL,,0,0,0,,{\fs78}4{\fs68}月刚拿六安{\fs78}W100{\fs68}冠军
Dialogue: 0,0:01:38.87,0:01:41.45,TL,,0,0,0,,决赛打满三小时零八分
Dialogue: 0,0:01:41.45,0:01:44.34,TL,,0,0,0,,她擅长把比赛拖进苦战
Dialogue: 0,0:01:44.82,0:01:46.98,TL,,0,0,0,,第二轮可能是布雷尔
Dialogue: 0,0:01:46.98,0:01:48.58,TL,,0,0,0,,她最高世界第{\fs78}42{\fs68}
Dialogue: 0,0:01:48.58,0:01:50.41,TL,,0,0,0,,右膝{\fs78}10{\fs68}字韧带重伤后
Dialogue: 0,0:01:50.41,0:01:53.55,TL,,0,0,0,,靠保护排名{\fs78}140{\fs68}回到这里
Dialogue: 0,0:01:54.82,0:01:56.59,TL,,0,0,0,,也可能是马烨欣
Dialogue: 0,0:01:56.59,0:01:57.95,TL,,0,0,0,,世界第{\fs78}181{\fs68}
Dialogue: 0,0:01:57.95,0:02:01.36,TL,,0,0,0,,去年首次打进{\fs78}WTA125{\fs68}级别决赛
Dialogue: 0,0:02:01.36,0:02:04.66,TL,,0,0,0,,也在争一张中国球员的正赛门票
Dialogue: 0,0:02:04.82,0:02:06.21,TL,,0,0,0,,真正的决胜轮
Dialogue: 0,0:02:06.21,0:02:09.19,TL,,0,0,0,,还要从另一半签表里等出一个人
Dialogue: 0,0:02:09.19,0:02:11.59,TL,,0,0,0,,这里原版漏掉了两位
Dialogue: 0,0:02:11.82,0:02:13.41,TL,,0,0,0,,{\fs78}20{\fs68}岁的普里丹基纳
Dialogue: 0,0:02:13.41,0:02:16.95,TL,,0,0,0,,生涯最高第{\fs78}168{\fs68} 右手持拍
Dialogue: 0,0:02:18.32,0:02:19.92,TL,,0,0,0,,她先要对法雷
Dialogue: 0,0:02:19.92,0:02:21.44,TL,,0,0,0,,世界第{\fs78}222{\fs68}
Dialogue: 0,0:02:21.44,0:02:24.85,TL,,0,0,0,,但本赛季已经拿下{\fs78}32{\fs68}场胜利
Dialogue: 0,0:02:25.32,0:02:27.91,TL,,0,0,0,,另一场有{\fs78}35{\fs68}岁的马里诺
Dialogue: 0,0:02:27.91,0:02:29.30,TL,,0,0,0,,身高一米八三
Dialogue: 0,0:02:29.30,0:02:30.93,TL,,0,0,0,,发球和正手是武器
Dialogue: 0,0:02:30.93,0:02:32.73,TL,,0,0,0,,最喜欢硬地
Dialogue: 0,0:02:34.24,0:02:35.40,TL,,0,0,0,,她的对手费罗
Dialogue: 0,0:02:35.40,0:02:37.35,TL,,0,0,0,,世界第{\fs78}141{\fs68}
Dialogue: 0,0:02:37.35,0:02:38.95,TL,,0,0,0,,速度快 变化多
Dialogue: 0,0:02:38.95,0:02:41.53,TL,,0,0,0,,正手是最喜欢的一拍
Dialogue: 0,0:02:42.24,0:02:44.87,TL,,0,0,0,,{\fs78}7{\fs68}个人 不是{\fs78}7{\fs68}个空名字
Dialogue: 0,0:02:44.87,0:02:46.79,TL,,0,0,0,,每个人都带着自己的伤
Dialogue: 0,0:02:46.79,0:02:47.91,TL,,0,0,0,,自己的武器
Dialogue: 0,0:02:47.91,0:02:48.97,TL,,0,0,0,,自己的理由
Dialogue: 0,0:02:48.97,0:02:51.00,TL,,0,0,0,,守在三道门后
Dialogue: 0,0:02:51.24,0:02:54.59,TL,,0,0,0,,{\fs78}4{\fs68}年前 她从资格赛走进大满贯
Dialogue: 0,0:02:54.59,0:02:57.65,TL,,0,0,0,,如今 金牌不能替她赢下这一分
Dialogue: 0,0:02:57.65,0:02:59.30,TL,,0,0,0,,伤病把她送回起点
Dialogue: 0,0:02:59.30,0:03:01.13,TL,,0,0,0,,但起点不是终点
Dialogue: 0,0:03:01.13,0:03:02.58,TL,,0,0,0,,她能把自己的名字
Dialogue: 0,0:03:02.58,0:03:05.16,TL,,0,0,0,,一分一分打回正赛吗？
