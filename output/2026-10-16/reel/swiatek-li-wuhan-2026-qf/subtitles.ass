Dialogue: 0,0:00:16.95,0:00:19.27,TL,,0,0,363,,{\an2}武汉{\fs78}1000{\fs68}赛女单{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛
Dialogue: 0,0:00:19.27,0:00:21.12,TL,,0,0,363,,{\an2}斯瓦泰克对阵安李
Dialogue: 0,0:00:21.12,0:00:22.76,TL,,0,0,363,,{\an2}开场连赢两局之后
Dialogue: 0,0:00:22.76,0:00:25.75,TL,,0,0,363,,{\an2}比赛来到{\fs78}4{\fs68}比{\fs78}3{\fs68} 她的发球局
Dialogue: 0,0:00:27.31,0:00:30.04,TL,,0,0,304,,{\an2}看近端 安李把球连续打向两侧
Dialogue: 0,0:00:30.04,0:00:32.01,TL,,0,0,304,,{\an2}她沿底线左右追球
Dialogue: 0,0:00:32.01,0:00:33.70,TL,,0,0,304,,{\an2}再追到正手外侧时
Dialogue: 0,0:00:33.70,0:00:36.62,TL,,0,0,304,,{\an2}伸拍也没能救回这一分
Dialogue: 0,0:00:40.31,0:00:43.34,TL,,0,0,363,,{\an2}{\fs78}5{\fs68}比{\fs78}4{\fs68}的发球胜盘局 {\fs78}15{\fs68}比{\fs78}40{\fs68}
