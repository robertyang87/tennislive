Dialogue: 0,0:00:01.30,0:00:04.22,TL,,0,0,0,,当年救回{\fs78}5{\fs68}个赛点的黄泽林 这一次
Dialogue: 0,0:00:04.22,0:00:07.27,TL,,0,0,0,,可能要到决赛才能再碰吴易昺
Dialogue: 0,0:00:07.27,0:00:09.36,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}27{\fs68}号到{\fs78}10{\fs68}月{\fs78}3{\fs68}号
Dialogue: 0,0:00:09.36,0:00:11.74,TL,,0,0,0,,亚运网球在名古屋进行
Dialogue: 0,0:00:11.74,0:00:13.64,TL,,0,0,0,,男单谁能冲金？
Dialogue: 0,0:00:13.64,0:00:15.08,TL,,0,0,0,,先把这张签表
Dialogue: 0,0:00:15.08,0:00:17.62,TL,,0,0,0,,和两个人的路线看清楚
Dialogue: 0,0:00:19.70,0:00:23.10,TL,,0,0,0,,先把完整签表放在这里 可以暂停看
Dialogue: 0,0:00:23.10,0:00:24.68,TL,,0,0,0,,黄泽林在上半区
Dialogue: 0,0:00:24.68,0:00:26.52,TL,,0,0,0,,吴易昺在下半区
Dialogue: 0,0:00:26.52,0:00:27.97,TL,,0,0,0,,后面画出的路线
Dialogue: 0,0:00:27.97,0:00:30.40,TL,,0,0,0,,全部是潜在对阵
Dialogue: 0,0:00:30.60,0:00:31.79,TL,,0,0,0,,满屏的轮空
Dialogue: 0,0:00:31.79,0:00:34.26,TL,,0,0,0,,不是种子球员的特殊待遇
Dialogue: 0,0:00:34.26,0:00:36.89,TL,,0,0,0,,{\fs78}33{\fs68}人放进{\fs78}64{\fs68}签的框架
Dialogue: 0,0:00:36.89,0:00:38.65,TL,,0,0,0,,首轮实际只有一场比赛
Dialogue: 0,0:00:38.65,0:00:41.08,TL,,0,0,0,,其他{\fs78}31{\fs68}人都轮空
Dialogue: 0,0:00:42.00,0:00:43.32,TL,,0,0,0,,吴易昺的首场球
Dialogue: 0,0:00:43.32,0:00:45.90,TL,,0,0,0,,对手是伊朗选手亚兹达尼
Dialogue: 0,0:00:45.90,0:00:46.99,TL,,0,0,0,,不是纳加尔
Dialogue: 0,0:00:46.99,0:00:50.08,TL,,0,0,0,,两人最早在{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛相遇
Dialogue: 0,0:00:52.00,0:00:53.57,TL,,0,0,0,,按种子路线推演
Dialogue: 0,0:00:53.57,0:00:55.39,TL,,0,0,0,,吴易昺在{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛
Dialogue: 0,0:00:55.39,0:00:57.49,TL,,0,0,0,,可能遇到菲特里亚迪
Dialogue: 0,0:00:57.49,0:01:00.86,TL,,0,0,0,,过关后 才可能碰纳加尔 注意
Dialogue: 0,0:01:00.86,0:01:03.88,TL,,0,0,0,,纳加尔也得先赢下自己的比赛
Dialogue: 0,0:01:04.60,0:01:07.29,TL,,0,0,0,,再往前看 舍甫琴科和松冈隼
Dialogue: 0,0:01:07.29,0:01:08.91,TL,,0,0,0,,在隔壁分区
Dialogue: 0,0:01:08.91,0:01:11.99,TL,,0,0,0,,吴易昺与他们 最早半决赛见
Dialogue: 0,0:01:11.99,0:01:15.40,TL,,0,0,0,,这两道分区之间 不能连错线
Dialogue: 0,0:01:15.50,0:01:17.68,TL,,0,0,0,,吴易昺曾在{\fs78}2018{\fs68}年
Dialogue: 0,0:01:17.68,0:01:19.81,TL,,0,0,0,,拿到亚运男单银牌
Dialogue: 0,0:01:19.81,0:01:21.36,TL,,0,0,0,,这次想更进一步
Dialogue: 0,0:01:21.36,0:01:23.98,TL,,0,0,0,,就得尽量顺利闯过前面的比赛
Dialogue: 0,0:01:23.98,0:01:27.11,TL,,0,0,0,,把体能和状态 留给后半程
Dialogue: 0,0:01:28.00,0:01:29.73,TL,,0,0,0,,黄泽林第{\fs78}108{\fs68}
Dialogue: 0,0:01:29.73,0:01:31.64,TL,,0,0,0,,舍甫琴科第{\fs78}109{\fs68}
Dialogue: 0,0:01:31.64,0:01:33.80,TL,,0,0,0,,吴易昺第{\fs78}113{\fs68}
Dialogue: 0,0:01:33.80,0:01:36.26,TL,,0,0,0,,{\fs78}3{\fs68}个人挨得很近 头号种子
Dialogue: 0,0:01:36.26,0:01:39.40,TL,,0,0,0,,并不等于明显高出所有人一档
Dialogue: 0,0:01:40.10,0:01:41.82,TL,,0,0,0,,再看黄泽林
Dialogue: 0,0:01:41.82,0:01:43.35,TL,,0,0,0,,他在{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛
Dialogue: 0,0:01:43.35,0:01:45.61,TL,,0,0,0,,就可能遇到绵贯阳介
Dialogue: 0,0:01:45.61,0:01:47.49,TL,,0,0,0,,{\fs78}13{\fs68}号种子这个数字
Dialogue: 0,0:01:47.49,0:01:49.28,TL,,0,0,0,,容易让人低估他
Dialogue: 0,0:01:49.28,0:01:50.64,TL,,0,0,0,,上一届亚运会
Dialogue: 0,0:01:50.64,0:01:53.30,TL,,0,0,0,,他可是拿到男单银牌的人
Dialogue: 0,0:01:54.00,0:01:55.98,TL,,0,0,0,,这一次又是在日本比赛
Dialogue: 0,0:01:55.98,0:01:58.48,TL,,0,0,0,,绵贯这一关值得提前留意
Dialogue: 0,0:01:58.48,0:02:00.35,TL,,0,0,0,,如果黄泽林继续晋级
Dialogue: 0,0:02:00.35,0:02:02.73,TL,,0,0,0,,{\fs78}1{\fs68}/{\fs78}4{\fs68}决赛可能遇斯卡托夫
Dialogue: 0,0:02:02.73,0:02:06.50,TL,,0,0,0,,半决赛这一侧 还有权纯雨和曾俊欣
Dialogue: 0,0:02:07.40,0:02:09.98,TL,,0,0,0,,中国队另一位男单球员孟凡茗
Dialogue: 0,0:02:09.98,0:02:11.44,TL,,0,0,0,,也在上半区
Dialogue: 0,0:02:11.44,0:02:13.61,TL,,0,0,0,,他首场对手苏尔塔诺夫
Dialogue: 0,0:02:13.61,0:02:16.20,TL,,0,0,0,,是上届亚运会铜牌得主
Dialogue: 0,0:02:16.20,0:02:18.69,TL,,0,0,0,,过关之后 又可能遇到权纯雨
Dialogue: 0,0:02:18.69,0:02:20.70,TL,,0,0,0,,开局就不轻松
Dialogue: 0,0:02:20.80,0:02:23.54,TL,,0,0,0,,回到{\fs78}2023{\fs68}年杭州亚运会
Dialogue: 0,0:02:23.54,0:02:27.16,TL,,0,0,0,,黄泽林在决胜盘抢七 {\fs78}1{\fs68}比{\fs78}6{\fs68}落后
Dialogue: 0,0:02:27.16,0:02:28.57,TL,,0,0,0,,他救回{\fs78}5{\fs68}个赛点
Dialogue: 0,0:02:28.57,0:02:31.69,TL,,0,0,0,,连拿七分 最后{\fs78}8{\fs68}比{\fs78}6{\fs68}逆转
Dialogue: 0,0:02:33.90,0:02:36.06,TL,,0,0,0,,吴易昺有争金机会
Dialogue: 0,0:02:36.06,0:02:38.02,TL,,0,0,0,,但签表上的每一个名字
Dialogue: 0,0:02:38.02,0:02:40.09,TL,,0,0,0,,都得真打过去
Dialogue: 0,0:02:41.10,0:02:43.30,TL,,0,0,0,,当时是{\fs78}1{\fs68}/{\fs78}8{\fs68}决赛
Dialogue: 0,0:02:43.30,0:02:45.71,TL,,0,0,0,,如果今年两人都能连闯数关
Dialogue: 0,0:02:45.71,0:02:48.72,TL,,0,0,0,,再次交手 争的就可能是金牌
Dialogue: 0,0:02:48.72,0:02:52.16,TL,,0,0,0,,这个重逢 得靠双方自己打出来
Dialogue: 0,0:02:52.50,0:02:53.59,TL,,0,0,0,,这枚金牌
Dialogue: 0,0:02:53.59,0:02:56.35,TL,,0,0,0,,还关联洛杉矶奥运会的洲际资格
Dialogue: 0,0:02:56.35,0:02:59.31,TL,,0,0,0,,球员届时仍要满足国际网联的资格
Dialogue: 0,0:02:59.31,0:03:01.60,TL,,0,0,0,,排名和代表团名额条件
Dialogue: 0,0:03:01.60,0:03:04.71,TL,,0,0,0,,不是拿了冠军 就无条件入围
Dialogue: 0,0:03:05.40,0:03:07.61,TL,,0,0,0,,你更想看到哪场对决？
Dialogue: 0,0:03:07.61,0:03:09.18,TL,,0,0,0,,吴易昺对舍甫琴科
Dialogue: 0,0:03:09.18,0:03:12.25,TL,,0,0,0,,还是他与黄泽林在决赛重逢？
Dialogue: 0,0:03:12.25,0:03:15.04,TL,,0,0,0,,先记住 都是潜在对阵
