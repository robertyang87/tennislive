Dialogue: 0,0:00:15.25,0:00:19.16,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}7{\fs68}日 美网女双第三轮 台湾内战
Dialogue: 0,0:00:19.16,0:00:20.95,TL,,0,0,0,,谢淑薇和奥斯塔彭科
Dialogue: 0,0:00:20.95,0:00:22.53,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:22.53,0:00:25.06,TL,,0,0,0,,淘汰詹皓晴和茹安
Dialogue: 0,0:00:25.92,0:00:27.01,TL,,0,0,0,,网前致意
Dialogue: 0,0:00:27.01,0:00:29.56,TL,,0,0,0,,詹皓晴和奥斯塔彭科碰了碰手
Dialogue: 0,0:00:29.56,0:00:32.09,TL,,0,0,0,,没有等谢淑薇 转身就走
Dialogue: 0,0:00:32.09,0:00:35.01,TL,,0,0,0,,奥斯塔彭科在旁边摊了摊手
Dialogue: 0,0:00:35.01,0:00:38.01,TL,,0,0,0,,这两个人 又一次没有握手
Dialogue: 0,0:00:40.09,0:00:42.36,TL,,0,0,0,,赢球之后 奥斯塔彭科转身
Dialogue: 0,0:00:42.36,0:00:44.86,TL,,0,0,0,,冲着对方包厢吼了回去
Dialogue: 0,0:00:46.25,0:00:47.73,TL,,0,0,0,,谢淑薇先发了文
Dialogue: 0,0:00:47.73,0:00:49.50,TL,,0,0,0,,最近打台湾选手的比赛
Dialogue: 0,0:00:49.50,0:00:51.14,TL,,0,0,0,,不是选手喜欢挑衅
Dialogue: 0,0:00:51.14,0:00:54.26,TL,,0,0,0,,就是加油团一点网球礼仪都不懂
Dialogue: 0,0:00:54.26,0:00:56.52,TL,,0,0,0,,她还说 搭档今天被激怒到
Dialogue: 0,0:00:56.52,0:00:58.73,TL,,0,0,0,,要求她一定要赢
Dialogue: 0,0:01:00.10,0:01:02.30,TL,,0,0,0,,詹皓晴在限时动态里回击
Dialogue: 0,0:01:02.30,0:01:04.32,TL,,0,0,0,,从某年法网混双开始
Dialogue: 0,0:01:04.32,0:01:06.12,TL,,0,0,0,,她连续{\fs78}3{\fs68}次站在网前
Dialogue: 0,0:01:06.12,0:01:09.27,TL,,0,0,0,,都等不到握手 所以这次就不等了
Dialogue: 0,0:01:09.27,0:01:11.04,TL,,0,0,0,,不是没风度
Dialogue: 0,0:01:12.57,0:01:14.11,TL,,0,0,0,,她还说 前一天
Dialogue: 0,0:01:14.11,0:01:16.77,TL,,0,0,0,,谢淑薇在走廊用球袋撞她
Dialogue: 0,0:01:16.77,0:01:19.11,TL,,0,0,0,,当天赛前 她在休息室睡觉
Dialogue: 0,0:01:19.11,0:01:20.82,TL,,0,0,0,,被撞椅子吓醒
Dialogue: 0,0:01:20.82,0:01:21.66,TL,,0,0,0,,她又说
Dialogue: 0,0:01:21.66,0:01:24.37,TL,,0,0,0,,谢淑薇以前在中网找路人骂她们
Dialogue: 0,0:01:24.37,0:01:26.34,TL,,0,0,0,,这一条没拿出证据
Dialogue: 0,0:01:26.34,0:01:27.33,TL,,0,0,0,,最后一句
Dialogue: 0,0:01:27.33,0:01:30.33,TL,,0,0,0,,总不能每次都是恶人先告状
Dialogue: 0,0:01:31.21,0:01:33.39,TL,,0,0,0,,她说的{\fs78}3{\fs68}次 对得上
Dialogue: 0,0:01:33.39,0:01:36.06,TL,,0,0,0,,两人在法网混双只相遇过一次
Dialogue: 0,0:01:36.06,0:01:39.13,TL,,0,0,0,,是{\fs78}2023{\fs68}年 詹皓晴赢了
Dialogue: 0,0:01:39.13,0:01:41.03,TL,,0,0,0,,{\fs78}2025{\fs68}年中网和宁波
Dialogue: 0,0:01:41.03,0:01:42.68,TL,,0,0,0,,谢淑薇两次赢球
Dialogue: 0,0:01:42.68,0:01:45.06,TL,,0,0,0,,两次都跳过了詹皓晴
Dialogue: 0,0:01:45.06,0:01:47.63,TL,,0,0,0,,中网那次 谢淑薇还发了一句
Dialogue: 0,0:01:47.63,0:01:50.57,TL,,0,0,0,,人生只有宿便 没有宿敌
Dialogue: 0,0:01:51.58,0:01:52.61,TL,,0,0,0,,两人的心结
Dialogue: 0,0:01:52.61,0:01:56.35,TL,,0,0,0,,从亚运搭档一路吵到奥运教练席位
Dialogue: 0,0:01:56.78,0:01:58.79,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}27{\fs68}日亚运开打
Dialogue: 0,0:01:58.79,0:02:00.76,TL,,0,0,0,,两人又成了队友
Dialogue: 0,0:02:01.65,0:02:03.51,TL,,0,0,0,,网前那只手 下一次
Dialogue: 0,0:02:03.51,0:02:05.51,TL,,0,0,0,,谁会先伸出来？
