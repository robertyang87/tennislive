Dialogue: 0,0:00:03.66,0:00:05.44,TL,,0,0,0,,女子冠军拿{\fs78}1000{\fs68}分
Dialogue: 0,0:00:05.44,0:00:07.61,TL,,0,0,0,,男子冠军拿{\fs78}500{\fs68}分
Dialogue: 0,0:00:07.61,0:00:08.99,TL,,0,0,0,,怎么同一个中网
Dialogue: 0,0:00:08.99,0:00:11.02,TL,,0,0,0,,还有两种级别？
Dialogue: 0,0:00:11.12,0:00:14.25,TL,,0,0,0,,答案藏在两套巡回赛体系里
Dialogue: 0,0:00:14.35,0:00:16.93,TL,,0,0,0,,女子赛事属于女子网球协会
Dialogue: 0,0:00:16.93,0:00:19.05,TL,,0,0,0,,男子属于职业网球联合会
Dialogue: 0,0:00:19.05,0:00:21.44,TL,,0,0,0,,各有自己的赛事分级
Dialogue: 0,0:00:21.54,0:00:22.16,TL,,0,0,0,,所以
Dialogue: 0,0:00:22.16,0:00:25.26,TL,,0,0,0,,一座球场可以承办不同级别的赛事
Dialogue: 0,0:00:25.26,0:00:28.37,TL,,0,0,0,,场馆大小 不等于赛事等级
Dialogue: 0,0:00:28.47,0:00:30.01,TL,,0,0,0,,今天熟悉的中网
Dialogue: 0,0:00:30.01,0:00:32.03,TL,,0,0,0,,从{\fs78}2004{\fs68}年讲起
Dialogue: 0,0:00:32.03,0:00:35.91,TL,,0,0,0,,最初的比赛 办在北京光彩网球中心
Dialogue: 0,0:00:36.57,0:00:37.66,TL,,0,0,0,,{\fs78}2009{\fs68}年
Dialogue: 0,0:00:37.66,0:00:40.10,TL,,0,0,0,,它搬进北京奥运会的网球场馆
Dialogue: 0,0:00:40.10,0:00:42.46,TL,,0,0,0,,也就是国家网球中心
Dialogue: 0,0:00:42.56,0:00:45.07,TL,,0,0,0,,同一年 男子升级为{\fs78}500{\fs68}赛
Dialogue: 0,0:00:45.07,0:00:47.80,TL,,0,0,0,,女子进入当时的皇冠赛行列
Dialogue: 0,0:00:47.80,0:00:50.30,TL,,0,0,0,,男女走上了不同的级别
Dialogue: 0,0:00:50.40,0:00:53.10,TL,,0,0,0,,{\fs78}2011{\fs68}年 钻石球场启用
Dialogue: 0,0:00:53.10,0:00:54.52,TL,,0,0,0,,{\fs78}15000{\fs68}个座位
Dialogue: 0,0:00:54.52,0:00:56.85,TL,,0,0,0,,加上可以闭合的顶棚
Dialogue: 0,0:00:58.90,0:01:01.17,TL,,0,0,0,,如今的女单是{\fs78}1000{\fs68}赛
Dialogue: 0,0:01:01.17,0:01:04.29,TL,,0,0,0,,{\fs78}2024{\fs68}年起 正赛扩到{\fs78}96{\fs68}签
Dialogue: 0,0:01:04.29,0:01:06.21,TL,,0,0,0,,比赛也铺得更开
Dialogue: 0,0:01:06.31,0:01:08.39,TL,,0,0,0,,高芙在{\fs78}2024{\fs68}年捧杯
Dialogue: 0,0:01:08.39,0:01:11.17,TL,,0,0,0,,把自己的名字留在了北京
Dialogue: 0,0:01:11.27,0:01:12.76,TL,,0,0,0,,男子虽然是{\fs78}500{\fs68}赛
Dialogue: 0,0:01:12.76,0:01:14.88,TL,,0,0,0,,却照样能留下经典
Dialogue: 0,0:01:14.88,0:01:17.62,TL,,0,0,0,,{\fs78}2024{\fs68}年 阿尔卡拉斯与辛纳
Dialogue: 0,0:01:17.62,0:01:20.29,TL,,0,0,0,,苦战三小时{\fs78}21{\fs68}分钟
Dialogue: 0,0:01:21.47,0:01:24.52,TL,,0,0,0,,决胜盘抢七 阿尔卡拉斯{\fs78}0{\fs68}比{\fs78}3{\fs68}落后
Dialogue: 0,0:01:24.52,0:01:27.99,TL,,0,0,0,,接着连得七分 第一次在中网夺冠
Dialogue: 0,0:01:29.97,0:01:33.29,TL,,0,0,0,,再看看这座奖杯 很有中国味
Dialogue: 0,0:01:33.39,0:01:34.83,TL,,0,0,0,,男单的中国之杯
Dialogue: 0,0:01:34.83,0:01:37.24,TL,,0,0,0,,造型源自金瓯永固杯
Dialogue: 0,0:01:37.24,0:01:40.83,TL,,0,0,0,,冠军拿走的 也是一份北京记忆
Dialogue: 0,0:01:41.59,0:01:43.25,TL,,0,0,0,,而对中国球迷来说
Dialogue: 0,0:01:43.25,0:01:45.34,TL,,0,0,0,,这里还有主场的意义
Dialogue: 0,0:01:45.34,0:01:48.61,TL,,0,0,0,,世界巡回赛 来到自己家门口
Dialogue: 0,0:01:48.71,0:01:52.12,TL,,0,0,0,,{\fs78}2024{\fs68}年 郑钦文打进中网四强
Dialogue: 0,0:01:52.12,0:01:53.67,TL,,0,0,0,,看台上的加油声
Dialogue: 0,0:01:53.67,0:01:55.18,TL,,0,0,0,,把一项国际赛事
Dialogue: 0,0:01:55.18,0:01:58.11,TL,,0,0,0,,变成了很多人的现场记忆
Dialogue: 0,0:01:58.21,0:02:00.93,TL,,0,0,0,,从光彩网球中心到钻石球场
Dialogue: 0,0:02:00.93,0:02:04.22,TL,,0,0,0,,中网的变化 不只是球场变大了
Dialogue: 0,0:02:04.32,0:02:06.82,TL,,0,0,0,,它让更多人有机会现场看球
Dialogue: 0,0:02:06.82,0:02:08.46,TL,,0,0,0,,也让年轻球员看见
Dialogue: 0,0:02:08.46,0:02:10.89,TL,,0,0,0,,自己的舞台可以有多大
Dialogue: 0,0:02:10.98,0:02:14.77,TL,,0,0,0,,{\fs78}2026{\fs68}年 男女正赛{\fs78}9{\fs68}月{\fs78}30{\fs68}日开打
Dialogue: 0,0:02:14.77,0:02:16.58,TL,,0,0,0,,男单决赛{\fs78}10{\fs68}月{\fs78}6{\fs68}日
Dialogue: 0,0:02:16.58,0:02:18.97,TL,,0,0,0,,女单决赛{\fs78}10{\fs68}月{\fs78}11{\fs68}日
Dialogue: 0,0:02:19.78,0:02:21.50,TL,,0,0,0,,你最难忘的中网记忆
Dialogue: 0,0:02:21.50,0:02:23.39,TL,,0,0,0,,是一场比赛 一位球员
Dialogue: 0,0:02:23.39,0:02:25.87,TL,,0,0,0,,还是第一次走进钻石球场？
