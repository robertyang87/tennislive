        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "2019 年辛辛那提，他唯一一次大师赛决赛，输给梅德韦杰夫。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "d81c4a36264f7dc82f99c54eb6a161f1d7395b732650107d6b016cbdeac8baa5",
      "words_sha256": "14d77c9d32b862a5a4021cfb47c90a26a0ec5c3ed6b38693e573a43aaec21a8e"
    },
    {
