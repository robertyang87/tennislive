        "cache_key": "92d7279f8fd5abda2c0426d53da75fcc",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "手术之后，他从头爬起。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "325508f40341d3304384d4f4948a6240a29cc3cf6e50af1e7170f6813c917081",
