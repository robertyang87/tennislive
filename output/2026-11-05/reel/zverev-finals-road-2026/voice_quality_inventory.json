        "cache_key": "7cdf77de1f45e1677c0666c22b8f1ff4",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "十一月二日，他第一次登上世界第一。提前锁定年终第一，到真正站上周榜榜首，这是两个不同的时刻。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "ab38a4aa6edd4dcd549764a80ffb55c992f2e75e1d482b997a34c7b183444078",
