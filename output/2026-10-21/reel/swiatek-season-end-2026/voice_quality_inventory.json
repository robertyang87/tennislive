      "words_sha256": "bf85a1447305c5b07f599021d301522d9f03e25fde07e0c9db67b2634cf695af"
    },
    {
      "id": "bundle:12ad69c21205c76de55ce3dcfe6ce8a413dc4e94259ef9183a8c6998489a1a03",
      "request_id": "12ad69c21205c76de55ce3dcfe6ce8a413dc4e94259ef9183a8c6998489a1a03",
      "request": {
        "backend": "edge",
        "cache_key": "cfa170a8491f2b8b7855c3007c465d23",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "距离拿下这一盘，只差一局。随后却连丢七局，最终止步第四轮。四站大满贯，最好成绩仍是年初澳网四分之一决赛。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "bfb914aa256fe6377276a158b967ed6180d256ce61f573f7b5917a7cda606ca8",
      "words_sha256": "28580ae9f777a98f3c6e74409ed043a9ee274f4ff45160eb9aac8679d3d0663f"
    },
    {
