Dialogue: 0,0:00:10.75,0:00:12.78,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:12.78,0:00:14.23,TL,,0,0,0,,{\fs78}20{\fs68}岁的贝莱克
Dialogue: 0,0:00:14.23,0:00:17.54,TL,,0,0,0,,淘汰了{\fs78}23{\fs68}号种子克雷吉茨科娃
Dialogue: 0,0:00:18.75,0:00:21.85,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}16{\fs68}号晚上{\fs78}10{\fs68}点{\fs78}49{\fs68}分
Dialogue: 0,0:00:21.85,0:00:24.53,TL,,0,0,0,,辛辛那提女单第二轮 {\fs78}4{\fs68}号场
Dialogue: 0,0:00:26.75,0:00:28.02,TL,,0,0,0,,克雷吉茨科娃
Dialogue: 0,0:00:28.02,0:00:29.75,TL,,0,0,0,,{\fs78}23{\fs68}号种子
Dialogue: 0,0:00:29.75,0:00:31.61,TL,,0,0,0,,{\fs78}2021{\fs68}年法网冠军
Dialogue: 0,0:00:31.61,0:00:33.85,TL,,0,0,0,,{\fs78}2024{\fs68}年温网冠军
Dialogue: 0,0:00:35.65,0:00:37.19,TL,,0,0,0,,对面的贝莱克{\fs78}20{\fs68}岁
Dialogue: 0,0:00:37.19,0:00:39.73,TL,,0,0,0,,同样来自捷克 非种子
Dialogue: 0,0:00:42.35,0:00:43.41,TL,,0,0,0,,第一盘五平
Dialogue: 0,0:00:43.41,0:00:44.74,TL,,0,0,0,,贝莱克发球
Dialogue: 0,0:00:44.74,0:00:47.17,TL,,0,0,0,,克雷吉茨科娃拿到两个破发点
Dialogue: 0,0:00:47.17,0:00:49.81,TL,,0,0,0,,破掉就能发球拿下这一盘
Dialogue: 0,0:00:52.55,0:00:55.04,TL,,0,0,0,,两个都被贝莱克救了下来
Dialogue: 0,0:00:55.04,0:00:57.47,TL,,0,0,0,,这一局她保住 {\fs78}6{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:59.85,0:01:03.14,TL,,0,0,0,,抢七 贝莱克{\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}3{\fs68}个盘点
Dialogue: 0,0:01:03.14,0:01:05.85,TL,,0,0,0,,再赢一分 第一盘就归她
Dialogue: 0,0:01:08.35,0:01:11.56,TL,,0,0,0,,克雷吉茨科娃连救两个 {\fs78}6{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:14.85,0:01:17.95,TL,,0,0,0,,第三个 克雷吉茨科娃没能再救
Dialogue: 0,0:01:17.95,0:01:21.33,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}6{\fs68} 第一盘打了一小时零二分钟
Dialogue: 0,0:01:24.35,0:01:25.54,TL,,0,0,0,,第二盘开头
Dialogue: 0,0:01:25.54,0:01:27.76,TL,,0,0,0,,两个人各破了一次发球局
Dialogue: 0,0:01:29.85,0:01:31.22,TL,,0,0,0,,三平之前那一局
Dialogue: 0,0:01:31.22,0:01:32.81,TL,,0,0,0,,贝莱克拿了{\fs78}5{\fs68}个局点
Dialogue: 0,0:01:32.81,0:01:35.90,TL,,0,0,0,,前{\fs78}4{\fs68}个都被克雷吉茨科娃救掉
Dialogue: 0,0:01:38.35,0:01:39.42,TL,,0,0,0,,整个第二盘
Dialogue: 0,0:01:39.42,0:01:42.27,TL,,0,0,0,,贝莱克的非受迫失误只有{\fs78}3{\fs68}个
Dialogue: 0,0:01:42.27,0:01:44.59,TL,,0,0,0,,克雷吉茨科娃{\fs78}15{\fs68}个
Dialogue: 0,0:01:46.25,0:01:49.29,TL,,0,0,0,,三平之后 克雷吉茨科娃保住发球局
Dialogue: 0,0:01:49.29,0:01:50.74,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68}领先
Dialogue: 0,0:01:53.25,0:01:55.77,TL,,0,0,0,,那是她整场最后一次领先
Dialogue: 0,0:01:55.77,0:01:58.36,TL,,0,0,0,,后面{\fs78}3{\fs68}局 全归贝莱克
Dialogue: 0,0:02:00.25,0:02:02.04,TL,,0,0,0,,两个人此前交手两次
Dialogue: 0,0:02:02.04,0:02:03.63,TL,,0,0,0,,贝莱克都输了
Dialogue: 0,0:02:03.63,0:02:05.07,TL,,0,0,0,,{\fs78}20{\fs68}岁的第一次
Dialogue: 0,0:02:05.07,0:02:06.54,TL,,0,0,0,,能走多远？
