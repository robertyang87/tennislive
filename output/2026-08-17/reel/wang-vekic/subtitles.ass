Dialogue: 0,0:00:09.05,0:00:10.40,TL,,0,0,0,,两小时{\fs78}11{\fs68}分钟
Dialogue: 0,0:00:10.40,0:00:13.87,TL,,0,0,0,,王欣瑜{\fs78}3{\fs68}盘赢下{\fs78}31{\fs68}号种子维基奇
Dialogue: 0,0:00:16.05,0:00:19.00,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}16{\fs68}号晚上{\fs78}10{\fs68}点{\fs78}50{\fs68}分
Dialogue: 0,0:00:19.00,0:00:21.08,TL,,0,0,0,,辛辛那提女单第二轮
Dialogue: 0,0:00:21.08,0:00:24.57,TL,,0,0,0,,王欣瑜 世界第{\fs78}36{\fs68} 非种子
Dialogue: 0,0:00:25.55,0:00:26.79,TL,,0,0,0,,对面是维基奇
Dialogue: 0,0:00:26.79,0:00:27.82,TL,,0,0,0,,克罗地亚人
Dialogue: 0,0:00:27.82,0:00:29.11,TL,,0,0,0,,世界第{\fs78}34{\fs68}
Dialogue: 0,0:00:29.11,0:00:31.19,TL,,0,0,0,,本站{\fs78}31{\fs68}号种子
Dialogue: 0,0:00:32.85,0:00:33.99,TL,,0,0,0,,第一盘{\fs78}1{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:33.99,0:00:36.27,TL,,0,0,0,,王欣瑜拿到两个破发点
Dialogue: 0,0:00:36.27,0:00:37.45,TL,,0,0,0,,两个都没兑现
Dialogue: 0,0:00:37.45,0:00:39.74,TL,,0,0,0,,维基奇从平分守了下来
Dialogue: 0,0:00:41.25,0:00:43.56,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}4{\fs68} 轮到王欣瑜发球
Dialogue: 0,0:00:43.56,0:00:45.22,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}30{\fs68}落后
Dialogue: 0,0:00:45.22,0:00:46.91,TL,,0,0,0,,一个破发点没救下来
Dialogue: 0,0:00:46.91,0:00:49.41,TL,,0,0,0,,第一盘就这么走了 {\fs78}3{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:00:51.75,0:00:52.97,TL,,0,0,0,,第二盘第一局
Dialogue: 0,0:00:52.97,0:00:55.56,TL,,0,0,0,,王欣瑜的发球局又被破了
Dialogue: 0,0:00:56.95,0:00:59.23,TL,,0,0,0,,然后王欣瑜连下{\fs78}6{\fs68}局
Dialogue: 0,0:00:59.23,0:01:02.16,TL,,0,0,0,,破回来 保住自己的 再破一次
Dialogue: 0,0:01:02.16,0:01:03.40,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:04.95,0:01:07.44,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}1{\fs68} {\fs78}39{\fs68}分钟
Dialogue: 0,0:01:07.44,0:01:08.51,TL,,0,0,0,,整个第二盘
Dialogue: 0,0:01:08.51,0:01:11.50,TL,,0,0,0,,维基奇{\fs78}3{\fs68}个发球局一个都没保住
Dialogue: 0,0:01:13.45,0:01:15.46,TL,,0,0,0,,决胜盘换了个形状
Dialogue: 0,0:01:15.46,0:01:17.94,TL,,0,0,0,,一发得分率两个人都上了七成五
Dialogue: 0,0:01:17.94,0:01:19.51,TL,,0,0,0,,一局一局往下走
Dialogue: 0,0:01:19.51,0:01:21.30,TL,,0,0,0,,谁也不给对方机会
Dialogue: 0,0:01:22.75,0:01:23.70,TL,,0,0,0,,打到四平
Dialogue: 0,0:01:23.70,0:01:26.57,TL,,0,0,0,,两个人前{\fs78}8{\fs68}个发球局一个都没丢
Dialogue: 0,0:01:26.57,0:01:27.42,TL,,0,0,0,,第九局
Dialogue: 0,0:01:27.42,0:01:29.98,TL,,0,0,0,,王欣瑜终于破了维基奇的发球局
Dialogue: 0,0:01:29.98,0:01:31.15,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:33.15,0:01:35.86,TL,,0,0,0,,发球胜赛局她先丢到{\fs78}30{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:01:35.86,0:01:38.26,TL,,0,0,0,,救下之后再没给第二次机会
Dialogue: 0,0:01:40.15,0:01:41.74,TL,,0,0,0,,两个人第三次交手
Dialogue: 0,0:01:41.74,0:01:43.84,TL,,0,0,0,,前两次都是维基奇赢
Dialogue: 0,0:01:47.05,0:01:49.23,TL,,0,0,0,,第三次 她赢了
Dialogue: 0,0:01:49.23,0:01:50.65,TL,,0,0,0,,下一轮呢？
