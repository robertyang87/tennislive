Dialogue: 0,0:00:06.35,0:00:08.32,TL,,0,0,0,,世界第{\fs78}6{\fs68}的梅德韦杰夫
Dialogue: 0,0:00:08.32,0:00:09.92,TL,,0,0,0,,第二盘{\fs78}2{\fs68}比{\fs78}5{\fs68}落后
Dialogue: 0,0:00:09.92,0:00:11.98,TL,,0,0,0,,对面还握着两个盘点
Dialogue: 0,0:00:11.98,0:00:14.72,TL,,0,0,0,,他一个都没给 连赢{\fs78}5{\fs68}局
Dialogue: 0,0:00:16.55,0:00:18.26,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}16{\fs68}号晚上
Dialogue: 0,0:00:18.26,0:00:19.64,TL,,0,0,0,,{\fs78}11{\fs68}点{\fs78}10{\fs68}分开球
Dialogue: 0,0:00:19.64,0:00:22.02,TL,,0,0,0,,辛辛那提大师赛男单第二轮
Dialogue: 0,0:00:23.95,0:00:26.29,TL,,0,0,0,,对面是{\fs78}36{\fs68}岁的特伦杰利蒂
Dialogue: 0,0:00:26.29,0:00:27.86,TL,,0,0,0,,世界第{\fs78}90{\fs68}
Dialogue: 0,0:00:29.35,0:00:30.77,TL,,0,0,0,,他从资格赛打起
Dialogue: 0,0:00:30.77,0:00:32.92,TL,,0,0,0,,第二轮赢的是锦织圭
Dialogue: 0,0:00:33.95,0:00:35.89,TL,,0,0,0,,梅德韦杰夫首轮轮空
Dialogue: 0,0:00:35.89,0:00:38.39,TL,,0,0,0,,今晚是他这一站的第一场球
Dialogue: 0,0:00:39.55,0:00:41.01,TL,,0,0,0,,{\fs78}2016{\fs68}年{\fs78}7{\fs68}月
Dialogue: 0,0:00:41.01,0:00:43.08,TL,,0,0,0,,托迪的挑战赛红土
Dialogue: 0,0:00:43.08,0:00:46.32,TL,,0,0,0,,{\fs78}10{\fs68}年前 特伦杰利蒂赢过他一次
Dialogue: 0,0:00:47.15,0:00:49.10,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:49.10,0:00:51.66,TL,,0,0,0,,今晚第二盘也是{\fs78}7{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:00:52.55,0:00:54.00,TL,,0,0,0,,首盘打得很紧
Dialogue: 0,0:00:54.00,0:00:56.65,TL,,0,0,0,,前{\fs78}8{\fs68}局一局没破 {\fs78}4{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:58.75,0:00:59.56,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:59.56,0:01:02.44,TL,,0,0,0,,特伦杰利蒂的发球局两次打到占先
Dialogue: 0,0:01:02.44,0:01:03.72,TL,,0,0,0,,才守下来
Dialogue: 0,0:01:05.05,0:01:07.46,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}4{\fs68}之后他丢了发球局
Dialogue: 0,0:01:07.46,0:01:09.93,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} 梅德韦杰夫{\fs78}3{\fs68}个盘点
Dialogue: 0,0:01:09.93,0:01:11.60,TL,,0,0,0,,第三个才收工
Dialogue: 0,0:01:13.15,0:01:14.39,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:14.39,0:01:15.72,TL,,0,0,0,,可第二盘一开始
Dialogue: 0,0:01:15.72,0:01:17.28,TL,,0,0,0,,风向就反了
Dialogue: 0,0:01:18.75,0:01:20.03,TL,,0,0,0,,第二盘一开局
Dialogue: 0,0:01:20.03,0:01:22.37,TL,,0,0,0,,他先守住了自己的发球局
Dialogue: 0,0:01:24.55,0:01:26.27,TL,,0,0,0,,接着破掉梅德韦杰夫
Dialogue: 0,0:01:26.27,0:01:28.12,TL,,0,0,0,,一路连到{\fs78}5{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:31.35,0:01:34.15,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68} 特伦杰利蒂自己发球
Dialogue: 0,0:01:34.15,0:01:35.43,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68}
Dialogue: 0,0:01:35.43,0:01:36.72,TL,,0,0,0,,第一个盘点
Dialogue: 0,0:01:37.95,0:01:39.11,TL,,0,0,0,,没拿下
Dialogue: 0,0:01:39.11,0:01:41.60,TL,,0,0,0,,这一局也丢了 {\fs78}5{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:42.95,0:01:45.80,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} 特伦杰利蒂在对手发球局上
Dialogue: 0,0:01:45.80,0:01:47.45,TL,,0,0,0,,又拿到一个盘点
Dialogue: 0,0:01:47.45,0:01:49.36,TL,,0,0,0,,梅德韦杰夫救掉了
Dialogue: 0,0:01:50.85,0:01:53.22,TL,,0,0,0,,他保住发球局 {\fs78}5{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:01:53.22,0:01:56.05,TL,,0,0,0,,第{\fs78}11{\fs68}局特伦杰利蒂{\fs78}30{\fs68}比{\fs78}0{\fs68}领先
Dialogue: 0,0:01:56.05,0:01:57.33,TL,,0,0,0,,连丢四分
Dialogue: 0,0:02:01.65,0:02:04.14,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}6{\fs68} 梅德韦杰夫发球
Dialogue: 0,0:02:04.14,0:02:06.62,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}15{\fs68} 两个赛点
Dialogue: 0,0:02:09.45,0:02:11.11,TL,,0,0,0,,一发只进了不到一半
Dialogue: 0,0:02:11.11,0:02:12.38,TL,,0,0,0,,还送了{\fs78}9{\fs68}个双误
Dialogue: 0,0:02:12.38,0:02:14.18,TL,,0,0,0,,他还是赢下来了
Dialogue: 0,0:02:17.25,0:02:19.58,TL,,0,0,0,,这一场 你替谁可惜？
