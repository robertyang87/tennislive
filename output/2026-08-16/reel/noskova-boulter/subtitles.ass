Dialogue: 0,0:00:07.25,0:00:08.36,TL,,0,0,0,,开场第一局
Dialogue: 0,0:00:08.36,0:00:09.79,TL,,0,0,0,,她就被破发
Dialogue: 0,0:00:10.85,0:00:12.26,TL,,0,0,0,,之后{\fs78}8{\fs68}个发球局
Dialogue: 0,0:00:12.26,0:00:13.68,TL,,0,0,0,,一个都没丢
Dialogue: 0,0:00:13.68,0:00:16.26,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}16{\fs68}号凌晨{\fs78}3{\fs68}点
Dialogue: 0,0:00:16.26,0:00:18.00,TL,,0,0,0,,辛辛那提第二轮
Dialogue: 0,0:00:19.25,0:00:20.95,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:20.95,0:00:22.94,TL,,0,0,0,,诺斯科娃赢了布尔特
Dialogue: 0,0:00:22.94,0:00:24.21,TL,,0,0,0,,而开场是{\fs78}0{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:24.21,0:00:26.09,TL,,0,0,0,,她丢了第一个发球局
Dialogue: 0,0:00:27.85,0:00:30.09,TL,,0,0,0,,诺斯科娃{\fs78}21{\fs68}岁 捷克人
Dialogue: 0,0:00:30.09,0:00:31.43,TL,,0,0,0,,当期世界第{\fs78}8{\fs68}
Dialogue: 0,0:00:31.43,0:00:33.25,TL,,0,0,0,,本站{\fs78}6{\fs68}号种子
Dialogue: 0,0:00:34.35,0:00:35.54,TL,,0,0,0,,上个月温网
Dialogue: 0,0:00:35.54,0:00:38.16,TL,,0,0,0,,她拿下了自己的第一个大满贯
Dialogue: 0,0:00:40.75,0:00:42.06,TL,,0,0,0,,丢掉发球局之后
Dialogue: 0,0:00:42.06,0:00:45.26,TL,,0,0,0,,她在布尔特发球时拿到{\fs78}3{\fs68}个破发点
Dialogue: 0,0:00:47.15,0:00:48.70,TL,,0,0,0,,第三个破发点上
Dialogue: 0,0:00:48.70,0:00:50.59,TL,,0,0,0,,她把这一局破了回来
Dialogue: 0,0:00:50.59,0:00:51.78,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:53.55,0:00:54.84,TL,,0,0,0,,温网夺冠之后
Dialogue: 0,0:00:54.84,0:00:56.93,TL,,0,0,0,,她只打过一场球 多伦多
Dialogue: 0,0:00:56.93,0:00:58.49,TL,,0,0,0,,输给麦克纳莉
Dialogue: 0,0:01:00.95,0:01:02.50,TL,,0,0,0,,所以今天这一场
Dialogue: 0,0:01:02.50,0:01:04.56,TL,,0,0,0,,是她当上大满贯冠军之后的
Dialogue: 0,0:01:04.56,0:01:05.84,TL,,0,0,0,,第一场胜利
Dialogue: 0,0:01:07.35,0:01:09.20,TL,,0,0,0,,从破回来那一局开始
Dialogue: 0,0:01:09.20,0:01:12.71,TL,,0,0,0,,她的发球局再也没有丢过 {\fs78}8{\fs68}个
Dialogue: 0,0:01:12.71,0:01:13.97,TL,,0,0,0,,一个不少
Dialogue: 0,0:01:14.35,0:01:15.47,TL,,0,0,0,,她发了{\fs78}10{\fs68}个 {\fs78}ACE{\fs68}
Dialogue: 0,0:01:15.47,0:01:17.28,TL,,0,0,0,,布尔特一个都没有
Dialogue: 0,0:01:19.95,0:01:21.75,TL,,0,0,0,,她的一发进了{\fs78}32{\fs68}个
Dialogue: 0,0:01:21.75,0:01:23.86,TL,,0,0,0,,其中{\fs78}25{\fs68}分是她的
Dialogue: 0,0:01:26.35,0:01:28.71,TL,,0,0,0,,第一盘只打了{\fs78}41{\fs68}分钟
Dialogue: 0,0:01:28.71,0:01:31.15,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68} 她上来发球胜盘
Dialogue: 0,0:01:32.75,0:01:34.04,TL,,0,0,0,,两个盘点
Dialogue: 0,0:01:34.04,0:01:36.90,TL,,0,0,0,,第二个上她拿下了这一盘 {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:39.15,0:01:41.98,TL,,0,0,0,,而布尔特整场只有两个破发点
Dialogue: 0,0:01:41.98,0:01:43.49,TL,,0,0,0,,都在第一局
Dialogue: 0,0:01:45.55,0:01:46.47,TL,,0,0,0,,她赛后说
Dialogue: 0,0:01:46.47,0:01:49.07,TL,,0,0,0,,一上来就被破发从来都不好受
Dialogue: 0,0:01:49.07,0:01:51.12,TL,,0,0,0,,我得找回自己的节奏
Dialogue: 0,0:01:52.35,0:01:53.46,TL,,0,0,0,,第二盘开局
Dialogue: 0,0:01:53.46,0:01:55.87,TL,,0,0,0,,她又先破了布尔特的发球局
Dialogue: 0,0:01:55.87,0:01:57.92,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}0{\fs68} {\fs78}2{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:59.55,0:02:01.41,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}1{\fs68}的时候诺斯科娃还有
Dialogue: 0,0:02:01.41,0:02:02.64,TL,,0,0,0,,一个破发点
Dialogue: 0,0:02:02.64,0:02:04.64,TL,,0,0,0,,布尔特把这一局保了下来
Dialogue: 0,0:02:06.95,0:02:09.16,TL,,0,0,0,,对面的布尔特{\fs78}30{\fs68}岁 英国人
Dialogue: 0,0:02:09.16,0:02:10.72,TL,,0,0,0,,当期世界第{\fs78}71{\fs68}
Dialogue: 0,0:02:10.72,0:02:12.76,TL,,0,0,0,,生日就在两个星期前
Dialogue: 0,0:02:14.55,0:02:16.19,TL,,0,0,0,,两个人上一次交手
Dialogue: 0,0:02:16.19,0:02:18.63,TL,,0,0,0,,是去年{\fs78}10{\fs68}月的大阪硬地
Dialogue: 0,0:02:20.95,0:02:23.94,TL,,0,0,0,,那一场布尔特两盘拿下 {\fs78}7{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:02:23.94,0:02:25.05,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:02:27.35,0:02:29.74,TL,,0,0,0,,今天换到辛辛那提的硬地
Dialogue: 0,0:02:29.74,0:02:31.67,TL,,0,0,0,,比分整个调了个头
Dialogue: 0,0:02:33.75,0:02:36.27,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68} 她拿到两个赛点
Dialogue: 0,0:02:37.95,0:02:39.52,TL,,0,0,0,,一小时{\fs78}16{\fs68}分钟
Dialogue: 0,0:02:39.52,0:02:40.87,TL,,0,0,0,,两个{\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:02:40.87,0:02:43.35,TL,,0,0,0,,第三轮 她能走多远？
