      "id": "voice_02.mp3",
      "audio_sha256": "ff49d603cbaa8ad849896a1739386a76d6c8400762a326085e57886b1f4d7d24",
      "words_sha256": "e565522da1e14dd5aecef58b487fc4fca04b1caa05caa3bf54954c240078c353",
      "words_path": "voice_02.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "ef3fb1bafb4eaff1e4ea2344c5390c08",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "首局救回零比四十，还是失守。十八岁的塔格尔先占上风。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_04.mp3",
      "audio_sha256": "ec71adc1c8c3c00dc94d25156971d8064f83b72e5fd07cf19b17376bf711da2c",
      "words_sha256": "bac23ff7f7844d1df94f5fe2566f0b699f46d77dff98693254c12de18020d394",
      "words_path": "voice_04.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "5620746e3643372445637bb6bdf4d4e0",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "上一次单打赢球，还是去年七月的华盛顿。此后十五个月，跨过两个赛季，连败已经来到十六场。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_05.mp3",
      "audio_sha256": "9b1e65245a5eb7917ece62ed321a017aa2e6677291ae5933fc062c17e2e775a9",
      "words_sha256": "dcf92354999d48a1e91b02b3f31475fe3c2888d866e34a3e9eba8a36cd59f04f",
      "words_path": "voice_05.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "666aa7e95fdc8a7c50d688158868500d",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "塔格尔用单手反拍抢攻，把大威压在底线。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_07.mp3",
      "audio_sha256": "5374a3307779ebab19d416052ebdf38170f7293f14e7ff5d9bcafc955f576745",
      "words_sha256": "9f2277de2f9c1ae619b7e1633fa46e840c477252b5399363de7701d225d87903",
      "words_path": "voice_07.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "e633350d4151e671f8abcce1879cff19",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "塔格尔不断抢攻，首盘两次破掉大威的发球局。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_09.mp3",
      "audio_sha256": "caededd8c8c94b7d5622b57c2afa1bed6e59f9ecf8b920f3e442218cb19253d8",
      "words_sha256": "d3d13f914c6ea50cd84133b32d993f6af3c2ea0c052e65901680b334d8ddb776",
      "words_path": "voice_09.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "2cebd4be841d2ddbe0bd657856868f2a",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "二比四，大威又被逼到破发点。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_11.mp3",
      "audio_sha256": "63f52db87306329e99fcc07448634a6238f3df48746c30877e91cf3ad53be04f",
      "words_sha256": "1d4b8e70f4e1e20be74abf30597896b66ee8b39d99e6821f7998e6ef8b9f6859",
      "words_path": "voice_11.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "2afb49a6cff08cf8f5607537a5b8c180",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "二比五落后，这一盘的退路越来越窄。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_13.mp3",
      "audio_sha256": "0c0e3319cddc9cc5751aa0d01349fdbfd8b6fe187b545f73f1b99758694b27ab",
      "words_sha256": "12149acfa873da293eb3f35db597ac581f261676b6087dc07bcda97c6c074821",
      "words_path": "voice_13.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "1e59c7298c1ebe285b8597739088a5f8",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "对手的发球局，她仍然找不到突破口。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_16.mp3",
      "audio_sha256": "3162d00f4aa70ff67a51b89c7c2d91273fdd3b7cc6b934f0482f5e2762396187",
      "words_sha256": "cd66aefa9a88c7b5f1d0aedf5279e1fc98f6990f6fcb29b781b2c82cd718fd12",
      "words_path": "voice_16.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "e0c8b7f87a728069170325336864d833",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第二盘，开局依然是被动。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_18.mp3",
      "audio_sha256": "de6d08723e873657b13499333494f2c4ae9c369bdf34b3a607b2b121b53aa1d2",
      "words_sha256": "80b2d6ef3668f52c5c6ce0e16cf91a488d34c666341a9d13a00320c93502cc43",
      "words_path": "voice_18.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "778cc80376c0be58cd13640b56855950",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "塔格尔的接发很深，大威很难先发起进攻。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_20.mp3",
      "audio_sha256": "40d83778c32ab81078ed68856a1ef7d21110ff02a746059ce2958769f79e8d55",
      "words_sha256": "b2dfb18778dcaf0985f94767df93ca503927e3d07b6ac73293d0ecf606d9efad",
      "words_path": "voice_20.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "856f2e1a7be0b59a0258409eade636cd",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "单打的胜利还没等来，发球局的危机又来了。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_22.mp3",
      "audio_sha256": "a760e5cc440846cc2a3a38cf808a4dfe7723e89135ae263ba162160858ba853b",
      "words_sha256": "39b1823f073dc0cc2220511ef7fa7ea1be91c5516f3ef51b1f37ad7d734d106e",
      "words_path": "voice_22.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "951b237f16e7756ba3d82adbb8557dec",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第二盘第一个发球局，还是没能守住。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_24.mp3",
      "audio_sha256": "1ee7490636e70153ac76e8a96ab28eadd3a9dc65bbd33b364cca0938849fde9a",
      "words_sha256": "91e2b459e0f090e3408da1b2ec316e28ebb80643136068b1f1b5e97eba209fb2",
      "words_path": "voice_24.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "a3cc8ed4a5f7f51ba7703cc289e39fa9",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "零比二后，大威还在追。全场十六个破发点，她救下十二个。一次次被逼到边缘，她还在把比赛往回拉。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_26.mp3",
      "audio_sha256": "4ca31d593364d6dba4f5fbb88aa455a31433cc343d1bb00248eecd7ac7f0b7e3",
      "words_sha256": "6dc14c0db7a3319665c5a900ec9cbace061392a7cc9fbc8b89286b03e43f5b26",
      "words_path": "voice_26.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "a7d8e6005dae2de2e73010e88bf76094",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "从零比二追回一局。一比三落后，她还在努力把比分拉回来。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_27.mp3",
      "audio_sha256": "787af3381f3f39f57df158aa8497e5a650e838da1fd4dd384c786a7635055ec9",
      "words_sha256": "a3746fab2690c1ba7d80f1d807b56c90221929b3b6154ad5b9b5c915247dbe89",
      "words_path": "voice_27.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "519dcf8e9f2ce8d7fa243a102e335686",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "一比三后，这个发球局又被拉进苦战。大威把这一分拿下来，追到二比三。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_29.mp3",
      "audio_sha256": "7654a550ed459cc3d34d8ebf4149b6ebe898185cab11e52e31ce9942465be841",
      "words_sha256": "691851e79b28a291ab2f6d8da3e3ea885cf0cec45626d7d92768a8408e507eda",
      "words_path": "voice_29.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "af5bc9afcd7bb6a2d9b2df41f1444e68",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "可守住一局之后，她始终没拿到破发点。二比四时，危机没能再化解，对手迎来发球胜赛局。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_31.mp3",
      "audio_sha256": "2389ad4edbed6c6774bbed7a8949bac92b59eaa817aeb9013f9bba9cfebbe9dc",
      "words_sha256": "29f69837fdc4dd043e66fe3dd6c9cae55f640046350a6df136ded13df2f55578",
      "words_path": "voice_31.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "d7b6600b4345453b5d1ba45aaf809789",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "这一次，她又没能等来单打的胜利。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_33.mp3",
      "audio_sha256": "4801c9318c3a7ccf150a5dcccda51b3631bbf888a56913623a0bfb797f72b3d3",
      "words_sha256": "c378c41fea579285a5ea443e1782ebd37efa74c931993a222fbe3a0e5a48032f",
      "words_path": "voice_33.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "f6124e54362adb4f8d3aac25dc08e528",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "制胜分，七比二十九。对手一发进球的二十五分，全部拿下。抵抗没能变成反攻，这就是比分背后的差距。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_34.mp3",
      "audio_sha256": "e28cc0db04888d42475a9bf2c66fb06599cf104a2f66e91785678cfc544d2a1d",
      "words_sha256": "b71a6e265fb97130a6786d1c74a8e71cbf739d298d1bab6973b01e24de05c264",
      "words_path": "voice_34.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "117f7b7048b2bcd1b1f1b79b50480dad",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "十六连败，指的是单打。就在昨天，大威搭档曾丽美，六比零、七比五赢下双打首轮。她的广州之旅，还在继续。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_35.mp3",
      "audio_sha256": "c2213f714567b246d2aadfadfbd0632b4b7051f1d5deb459b72e8d1b128aaa36",
      "words_sha256": "fe39c54457b4b00fb024f36c5c0d7a3755f9333c47767eec593de8dc179747c6",
      "words_path": "voice_35.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "b3fbc697d984bb2832278ec6c19750ca",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "下一场，去双打赛场继续看她。也愿下一次单打，等来一场久违的胜利。你还会为她加油吗？",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_outro.mp3",
      "audio_sha256": "3d7277d26afc569ab1979d3485891d79e290c7f020c7ffccb0a9e1a2d11c811f",
      "words_sha256": "ffd92401e4e51d044cd0ba811dd56c27dfa59f0de4734ee872348e09ba3401b8",
      "words_path": "voice_outro.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "20da8f5468902afbbecb78daefb15d83",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "关注网球时插，时插归我，好球归你。",
        "voice": "zh-CN-YunjianNeural"
      }
    }
  ]
}
