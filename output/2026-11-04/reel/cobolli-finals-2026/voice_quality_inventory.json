        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "决赛对面，又是兹维列夫。第四盘抢七，科博利把比赛拖进决胜盘，冠军还没有分出。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "923064621d0f2f9472f04873195aae942d1926901e6911ae0b279365cee2a5f4",
      "words_sha256": "c1c0a492830d72d4669a05265b2b23a30d120bb15d207ea10ba1f1e0fe3ddeef"
    },
