        "cache_key": "94f8c7307c772e0721d815fa89a8a702",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "年初四连败，年末第一次入围总决赛。科博利的这一年，中间隔着多少次重新出发？",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "9f6a780cc78a0f44531da964a252619999eedce14923ab4e79472f7a19ba7633",
      "words_sha256": "af566588637ed9c73a1de976965e37428a5bdd908a89a7e9fa334f5e672b4d73"
    },
