        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "四分之一决赛，鲁内赛前因腿伤退出，弗里茨直接晋级半决赛。",
        "voice": "zh-CN-YunjianNeural"
