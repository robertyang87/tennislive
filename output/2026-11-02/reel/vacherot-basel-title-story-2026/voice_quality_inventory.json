        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第二轮，两次抢七都拿下。瓦舍罗，三盘闯过霍达尔。",
        "voice": "zh-CN-YunjianNeural"
      },
