Dialogue: 0,0:00:07.45,0:00:09.30,TL,,0,0,0,,两个大满贯冠军
Dialogue: 0,0:00:09.30,0:00:11.62,TL,,0,0,0,,而这一座 是她整个生涯唯一的
Dialogue: 0,0:00:11.62,0:00:13.66,TL,,0,0,0,,一座{\fs78}1000{\fs68}分赛冠军
Dialogue: 0,0:00:14.95,0:00:18.09,TL,,0,0,0,,{\fs78}2012{\fs68}年{\fs78}8{\fs68}月{\fs78}19{\fs68}日 辛辛那提
Dialogue: 0,0:00:20.45,0:00:22.11,TL,,0,0,0,,{\fs78}3{\fs68}个星期前的奥运会
Dialogue: 0,0:00:22.11,0:00:23.29,TL,,0,0,0,,女单第一轮
Dialogue: 0,0:00:23.29,0:00:26.21,TL,,0,0,0,,她输给了自己的好朋友汉图楚娃
Dialogue: 0,0:00:27.95,0:00:29.39,TL,,0,0,0,,那一届奥运网球
Dialogue: 0,0:00:29.39,0:00:31.30,TL,,0,0,0,,就打在温网的场地上
Dialogue: 0,0:00:31.30,0:00:32.90,TL,,0,0,0,,而一个月前的温网
Dialogue: 0,0:00:32.90,0:00:34.55,TL,,0,0,0,,她第二轮就输了
Dialogue: 0,0:00:36.45,0:00:38.42,TL,,0,0,0,,淘汰她的是科斯蒂亚
Dialogue: 0,0:00:38.42,0:00:39.90,TL,,0,0,0,,记住这个名字
Dialogue: 0,0:00:39.90,0:00:40.99,TL,,0,0,0,,同一个夏天
Dialogue: 0,0:00:40.99,0:00:42.25,TL,,0,0,0,,同一块草地
Dialogue: 0,0:00:42.25,0:00:43.58,TL,,0,0,0,,她输了两次
Dialogue: 0,0:00:44.95,0:00:47.01,TL,,0,0,0,,而这不只是两场球
Dialogue: 0,0:00:47.01,0:00:48.82,TL,,0,0,0,,{\fs78}2012{\fs68}年的前{\fs78}7{\fs68}个月
Dialogue: 0,0:00:48.82,0:00:50.47,TL,,0,0,0,,她的成绩是这样的
Dialogue: 0,0:00:51.95,0:00:53.19,TL,,0,0,0,,澳网第四轮
Dialogue: 0,0:00:53.19,0:00:55.40,TL,,0,0,0,,法网第四轮 卫冕失败
Dialogue: 0,0:00:55.40,0:00:56.53,TL,,0,0,0,,温网第二轮
Dialogue: 0,0:00:56.53,0:00:58.12,TL,,0,0,0,,奥运会第一轮
Dialogue: 0,0:01:00.95,0:01:02.13,TL,,0,0,0,,再往回数
Dialogue: 0,0:01:02.13,0:01:04.52,TL,,0,0,0,,她已经{\fs78}14{\fs68}个月没有拿到过一个冠军
Dialogue: 0,0:01:04.52,0:01:05.22,TL,,0,0,0,,了
Dialogue: 0,0:01:06.95,0:01:08.10,TL,,0,0,0,,上一次夺冠
Dialogue: 0,0:01:08.10,0:01:09.90,TL,,0,0,0,,是{\fs78}2011{\fs68}年的法网
Dialogue: 0,0:01:09.90,0:01:12.61,TL,,0,0,0,,那一年 她成了亚洲第一个拿到
Dialogue: 0,0:01:12.61,0:01:14.65,TL,,0,0,0,,大满贯单打冠军的人
Dialogue: 0,0:01:15.45,0:01:16.57,TL,,0,0,0,,奥运会之后
Dialogue: 0,0:01:16.57,0:01:18.45,TL,,0,0,0,,她宣布请了一个新教练
Dialogue: 0,0:01:18.45,0:01:20.46,TL,,0,0,0,,卡洛斯 罗德里格斯
Dialogue: 0,0:01:20.46,0:01:23.63,TL,,0,0,0,,把海宁带成世界第{\fs78}1{\fs68}的那个阿根廷人
Dialogue: 0,0:01:24.45,0:01:25.98,TL,,0,0,0,,辛辛那提的前一站
Dialogue: 0,0:01:25.98,0:01:28.02,TL,,0,0,0,,是蒙特利尔的罗杰斯杯
Dialogue: 0,0:01:30.95,0:01:32.72,TL,,0,0,0,,她一路打进决赛
Dialogue: 0,0:01:32.72,0:01:35.15,TL,,0,0,0,,半决赛{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:35.15,0:01:37.38,TL,,0,0,0,,赢的正是拉德万斯卡
Dialogue: 0,0:01:39.45,0:01:41.53,TL,,0,0,0,,决赛遇上科维托娃
Dialogue: 0,0:01:41.53,0:01:43.02,TL,,0,0,0,,那场球赶上下雨
Dialogue: 0,0:01:43.02,0:01:44.97,TL,,0,0,0,,一直拖到星期一的晚上
Dialogue: 0,0:01:46.95,0:01:49.98,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}7{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}3{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:01:49.98,0:01:52.35,TL,,0,0,0,,差一步 又是一个亚军
Dialogue: 0,0:01:54.95,0:01:56.20,TL,,0,0,0,,而辛辛那提
Dialogue: 0,0:01:56.20,0:01:58.19,TL,,0,0,0,,{\fs78}8{\fs68}月{\fs78}11{\fs68}号就开赛了
Dialogue: 0,0:01:58.19,0:01:59.56,TL,,0,0,0,,她是{\fs78}9{\fs68}号种子
Dialogue: 0,0:01:59.56,0:02:00.92,TL,,0,0,0,,第一轮轮空
Dialogue: 0,0:02:02.95,0:02:04.23,TL,,0,0,0,,第二轮的对手
Dialogue: 0,0:02:04.23,0:02:06.70,TL,,0,0,0,,正是温网那一场把她淘汰出局的
Dialogue: 0,0:02:06.70,0:02:07.60,TL,,0,0,0,,那个人
Dialogue: 0,0:02:10.45,0:02:13.49,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}4{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:02:13.49,0:02:14.62,TL,,0,0,0,,她丢了一盘
Dialogue: 0,0:02:14.62,0:02:16.33,TL,,0,0,0,,打满{\fs78}3{\fs68}盘才过
Dialogue: 0,0:02:18.45,0:02:19.47,TL,,0,0,0,,而那一场
Dialogue: 0,0:02:19.47,0:02:22.00,TL,,0,0,0,,卡洛斯还不在她的教练席上
Dialogue: 0,0:02:22.00,0:02:23.26,TL,,0,0,0,,合作是宣布了
Dialogue: 0,0:02:23.26,0:02:24.50,TL,,0,0,0,,可到这个时候
Dialogue: 0,0:02:24.50,0:02:26.56,TL,,0,0,0,,两个人还从来没见过面
Dialogue: 0,0:02:28.95,0:02:30.36,TL,,0,0,0,,{\fs78}8{\fs68}月{\fs78}15{\fs68}号
Dialogue: 0,0:02:30.36,0:02:31.54,TL,,0,0,0,,星期三的晚上
Dialogue: 0,0:02:31.54,0:02:33.70,TL,,0,0,0,,卡洛斯到了辛辛那提
Dialogue: 0,0:02:36.95,0:02:38.85,TL,,0,0,0,,第二天 第三轮
Dialogue: 0,0:02:38.85,0:02:41.15,TL,,0,0,0,,他第一次坐进她的包厢
Dialogue: 0,0:02:43.95,0:02:46.86,TL,,0,0,0,,对手是从资格赛打上来的拉尔松
Dialogue: 0,0:02:46.86,0:02:48.99,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:02:51.45,0:02:52.92,TL,,0,0,0,,从这一场开始
Dialogue: 0,0:02:52.92,0:02:54.44,TL,,0,0,0,,这一周剩下的比赛
Dialogue: 0,0:02:54.44,0:02:55.98,TL,,0,0,0,,她只再丢了一盘
Dialogue: 0,0:02:58.95,0:03:00.24,TL,,0,0,0,,四分之一决赛
Dialogue: 0,0:03:00.24,0:03:02.56,TL,,0,0,0,,头号种子拉德万斯卡
Dialogue: 0,0:03:02.56,0:03:04.66,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}1{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:03:06.95,0:03:09.11,TL,,0,0,0,,一个多月前的温网亚军
Dialogue: 0,0:03:09.11,0:03:10.98,TL,,0,0,0,,而几天前在蒙特利尔
Dialogue: 0,0:03:10.98,0:03:12.52,TL,,0,0,0,,李娜也赢了她
Dialogue: 0,0:03:13.95,0:03:16.18,TL,,0,0,0,,半决赛 大威廉姆斯
Dialogue: 0,0:03:16.18,0:03:18.46,TL,,0,0,0,,这一站她拿的是外卡
Dialogue: 0,0:03:20.95,0:03:23.97,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} {\fs78}3{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:03:23.97,0:03:25.84,TL,,0,0,0,,这是两个人第三次交手
Dialogue: 0,0:03:25.84,0:03:27.43,TL,,0,0,0,,李娜第三次赢
Dialogue: 0,0:03:29.45,0:03:31.58,TL,,0,0,0,,决赛的对手是科贝尔
Dialogue: 0,0:03:31.58,0:03:34.32,TL,,0,0,0,,她在这一站赢过小威廉姆斯
Dialogue: 0,0:03:36.95,0:03:40.02,TL,,0,0,0,,决赛 第一盘 {\fs78}1{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:03:42.45,0:03:43.64,TL,,0,0,0,,李娜赛后说
Dialogue: 0,0:03:43.64,0:03:45.09,TL,,0,0,0,,第一盘她打得难以置信
Dialogue: 0,0:03:45.09,0:03:46.48,TL,,0,0,0,,我想加快节奏
Dialogue: 0,0:03:46.48,0:03:47.95,TL,,0,0,0,,可她一个失误都没有
Dialogue: 0,0:03:47.95,0:03:49.86,TL,,0,0,0,,每一个球都回到我这边
Dialogue: 0,0:03:52.45,0:03:54.28,TL,,0,0,0,,第二盘 {\fs78}3{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:03:54.28,0:03:56.17,TL,,0,0,0,,轮到科贝尔发球
Dialogue: 0,0:03:59.45,0:04:02.97,TL,,0,0,0,,这一局来回打了{\fs78}24{\fs68}个小分 {\fs78}9{\fs68}次平分
Dialogue: 0,0:04:02.97,0:04:05.13,TL,,0,0,0,,李娜连着浪费{\fs78}7{\fs68}个破发点
Dialogue: 0,0:04:05.13,0:04:06.79,TL,,0,0,0,,最后才把它拿下来
Dialogue: 0,0:04:09.95,0:04:12.26,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} 扳回一盘
Dialogue: 0,0:04:12.26,0:04:15.01,TL,,0,0,0,,决胜盘 她只丢了一局
Dialogue: 0,0:04:17.95,0:04:20.97,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:04:20.97,0:04:22.25,TL,,0,0,0,,那{\fs78}14{\fs68}个月
Dialogue: 0,0:04:22.25,0:04:23.59,TL,,0,0,0,,到这里结束了
Dialogue: 0,0:04:26.95,0:04:28.80,TL,,0,0,0,,这是她{\fs78}2011{\fs68}年法网之后的
Dialogue: 0,0:04:28.80,0:04:29.86,TL,,0,0,0,,第一个冠军
Dialogue: 0,0:04:29.86,0:04:31.53,TL,,0,0,0,,也是生涯第六个
Dialogue: 0,0:04:34.45,0:04:36.25,TL,,0,0,0,,她在颁奖台上说了一句
Dialogue: 0,0:04:36.25,0:04:39.06,TL,,0,0,0,,我觉得这是一个很好的开始
Dialogue: 0,0:04:41.95,0:04:44.75,TL,,0,0,0,,从第二轮打到决赛 {\fs78}5{\fs68}场球
Dialogue: 0,0:04:44.75,0:04:46.58,TL,,0,0,0,,她一共只丢了{\fs78}3{\fs68}盘
Dialogue: 0,0:04:49.95,0:04:52.52,TL,,0,0,0,,{\fs78}5{\fs68}个月后 她打进澳网决赛
Dialogue: 0,0:04:52.52,0:04:53.97,TL,,0,0,0,,一年零五个月后
Dialogue: 0,0:04:53.97,0:04:55.90,TL,,0,0,0,,她拿到了第二个大满贯
Dialogue: 0,0:04:58.95,0:05:00.30,TL,,0,0,0,,而这一座奖杯
Dialogue: 0,0:05:00.30,0:05:03.00,TL,,0,0,0,,到她退役都是唯一的一座
Dialogue: 0,0:05:03.00,0:05:05.38,TL,,0,0,0,,你还记得那个星期三的晚上吗？
