Dialogue: 0,0:00:08.75,0:00:10.60,TL,,0,0,0,,两个大满贯冠军
Dialogue: 0,0:00:10.60,0:00:12.92,TL,,0,0,0,,而这一座 是她整个生涯唯一的
Dialogue: 0,0:00:12.92,0:00:14.96,TL,,0,0,0,,一座{\fs78}1000{\fs68}分赛冠军
Dialogue: 0,0:00:16.25,0:00:19.39,TL,,0,0,0,,{\fs78}2012{\fs68}年{\fs78}8{\fs68}月{\fs78}19{\fs68}日 辛辛那提
Dialogue: 0,0:00:21.75,0:00:23.37,TL,,0,0,0,,一年零两个月之前
Dialogue: 0,0:00:23.37,0:00:24.71,TL,,0,0,0,,她在法网夺冠
Dialogue: 0,0:00:24.71,0:00:27.38,TL,,0,0,0,,成了亚洲第一个拿到大满贯单打冠军
Dialogue: 0,0:00:27.38,0:00:28.18,TL,,0,0,0,,的人
Dialogue: 0,0:00:30.75,0:00:32.32,TL,,0,0,0,,从那天到这个{\fs78}8{\fs68}月
Dialogue: 0,0:00:32.32,0:00:34.47,TL,,0,0,0,,她一个冠军都没有再拿到
Dialogue: 0,0:00:37.75,0:00:39.55,TL,,0,0,0,,{\fs78}2012{\fs68}年的前{\fs78}7{\fs68}个月
Dialogue: 0,0:00:39.55,0:00:41.20,TL,,0,0,0,,她的成绩是这样的
Dialogue: 0,0:00:44.25,0:00:45.49,TL,,0,0,0,,澳网第四轮
Dialogue: 0,0:00:45.49,0:00:47.70,TL,,0,0,0,,法网第四轮 卫冕失败
Dialogue: 0,0:00:47.70,0:00:48.83,TL,,0,0,0,,温网第二轮
Dialogue: 0,0:00:48.83,0:00:50.42,TL,,0,0,0,,奥运会第一轮
Dialogue: 0,0:00:53.25,0:00:54.50,TL,,0,0,0,,温网那一场
Dialogue: 0,0:00:54.50,0:00:56.90,TL,,0,0,0,,淘汰她的是科斯蒂亚
Dialogue: 0,0:00:56.90,0:00:58.41,TL,,0,0,0,,记住这个名字
Dialogue: 0,0:01:00.75,0:01:02.17,TL,,0,0,0,,紧接着的奥运会
Dialogue: 0,0:01:02.17,0:01:03.40,TL,,0,0,0,,女单第一轮
Dialogue: 0,0:01:03.40,0:01:06.32,TL,,0,0,0,,她输给了自己的好朋友汉图楚娃
Dialogue: 0,0:01:09.25,0:01:12.51,TL,,0,0,0,,那一届奥运网球就打在温网的场地上
Dialogue: 0,0:01:12.51,0:01:13.66,TL,,0,0,0,,同一块草地
Dialogue: 0,0:01:13.66,0:01:14.91,TL,,0,0,0,,同一个夏天
Dialogue: 0,0:01:14.91,0:01:16.23,TL,,0,0,0,,她输了两次
Dialogue: 0,0:01:17.25,0:01:18.38,TL,,0,0,0,,奥运会之后
Dialogue: 0,0:01:18.38,0:01:20.28,TL,,0,0,0,,她宣布请了一个新教练
Dialogue: 0,0:01:20.28,0:01:22.65,TL,,0,0,0,,卡洛斯 罗德里格斯
Dialogue: 0,0:01:24.75,0:01:26.00,TL,,0,0,0,,他带过海宁
Dialogue: 0,0:01:26.00,0:01:27.99,TL,,0,0,0,,那个{\fs78}7{\fs68}次拿到大满贯
Dialogue: 0,0:01:27.99,0:01:30.17,TL,,0,0,0,,当过世界第{\fs78}1{\fs68}的比利时人
Dialogue: 0,0:01:32.75,0:01:33.82,TL,,0,0,0,,{\fs78}8{\fs68}月{\fs78}13{\fs68}号
Dialogue: 0,0:01:33.82,0:01:35.31,TL,,0,0,0,,辛辛那提开赛
Dialogue: 0,0:01:35.31,0:01:36.67,TL,,0,0,0,,她是{\fs78}9{\fs68}号种子
Dialogue: 0,0:01:36.67,0:01:38.05,TL,,0,0,0,,第一轮轮空
Dialogue: 0,0:01:40.75,0:01:42.07,TL,,0,0,0,,第二轮的对手
Dialogue: 0,0:01:42.07,0:01:44.63,TL,,0,0,0,,正是{\fs78}6{\fs68}个星期前把她淘汰出温网的
Dialogue: 0,0:01:44.63,0:01:45.55,TL,,0,0,0,,那个人
Dialogue: 0,0:01:48.25,0:01:51.29,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}4{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:01:51.29,0:01:52.42,TL,,0,0,0,,她丢了一盘
Dialogue: 0,0:01:52.42,0:01:54.13,TL,,0,0,0,,打满{\fs78}3{\fs68}盘才过
Dialogue: 0,0:01:56.25,0:01:57.27,TL,,0,0,0,,而那一场
Dialogue: 0,0:01:57.27,0:01:59.80,TL,,0,0,0,,卡洛斯还不在她的教练席上
Dialogue: 0,0:01:59.80,0:02:01.06,TL,,0,0,0,,合作是宣布了
Dialogue: 0,0:02:01.06,0:02:02.30,TL,,0,0,0,,可到这个时候
Dialogue: 0,0:02:02.30,0:02:04.36,TL,,0,0,0,,两个人还从来没见过面
Dialogue: 0,0:02:06.75,0:02:08.16,TL,,0,0,0,,{\fs78}8{\fs68}月{\fs78}15{\fs68}号
Dialogue: 0,0:02:08.16,0:02:09.34,TL,,0,0,0,,星期三的晚上
Dialogue: 0,0:02:09.34,0:02:11.50,TL,,0,0,0,,卡洛斯到了辛辛那提
Dialogue: 0,0:02:14.75,0:02:16.65,TL,,0,0,0,,第二天 第三轮
Dialogue: 0,0:02:16.65,0:02:18.95,TL,,0,0,0,,他第一次坐进她的包厢
Dialogue: 0,0:02:21.75,0:02:24.66,TL,,0,0,0,,对手是从资格赛打上来的拉尔松
Dialogue: 0,0:02:24.66,0:02:26.79,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:02:29.25,0:02:30.72,TL,,0,0,0,,从这一场开始
Dialogue: 0,0:02:30.72,0:02:32.24,TL,,0,0,0,,这一周剩下的比赛
Dialogue: 0,0:02:32.24,0:02:33.78,TL,,0,0,0,,她只再丢了一盘
Dialogue: 0,0:02:36.75,0:02:38.04,TL,,0,0,0,,四分之一决赛
Dialogue: 0,0:02:38.04,0:02:40.36,TL,,0,0,0,,头号种子拉德万斯卡
Dialogue: 0,0:02:40.36,0:02:42.46,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}1{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:02:44.75,0:02:45.84,TL,,0,0,0,,一个多月前
Dialogue: 0,0:02:45.84,0:02:48.11,TL,,0,0,0,,这个人刚刚打进温网决赛
Dialogue: 0,0:02:51.25,0:02:53.48,TL,,0,0,0,,半决赛 大威廉姆斯
Dialogue: 0,0:02:53.48,0:02:55.76,TL,,0,0,0,,这一站她拿的是外卡
Dialogue: 0,0:02:58.25,0:03:01.27,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}5{\fs68} {\fs78}3{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:03:01.27,0:03:03.14,TL,,0,0,0,,这是两个人第三次交手
Dialogue: 0,0:03:03.14,0:03:04.73,TL,,0,0,0,,李娜第三次赢
Dialogue: 0,0:03:06.75,0:03:08.88,TL,,0,0,0,,决赛的对手是科贝尔
Dialogue: 0,0:03:08.88,0:03:11.62,TL,,0,0,0,,她在这一站赢过小威廉姆斯
Dialogue: 0,0:03:14.25,0:03:17.32,TL,,0,0,0,,决赛 第一盘 {\fs78}1{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:03:19.75,0:03:20.94,TL,,0,0,0,,李娜赛后说
Dialogue: 0,0:03:20.94,0:03:22.39,TL,,0,0,0,,第一盘她打得难以置信
Dialogue: 0,0:03:22.39,0:03:23.78,TL,,0,0,0,,我想加快节奏
Dialogue: 0,0:03:23.78,0:03:25.25,TL,,0,0,0,,可她一个失误都没有
Dialogue: 0,0:03:25.25,0:03:27.16,TL,,0,0,0,,每一个球都回到我这边
Dialogue: 0,0:03:29.75,0:03:31.58,TL,,0,0,0,,第二盘 {\fs78}3{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:03:31.58,0:03:33.47,TL,,0,0,0,,轮到科贝尔发球
Dialogue: 0,0:03:36.75,0:03:40.27,TL,,0,0,0,,这一局来回打了{\fs78}24{\fs68}个小分 {\fs78}9{\fs68}次平分
Dialogue: 0,0:03:40.27,0:03:42.43,TL,,0,0,0,,李娜连着浪费{\fs78}7{\fs68}个破发点
Dialogue: 0,0:03:42.43,0:03:44.09,TL,,0,0,0,,最后才把它拿下来
Dialogue: 0,0:03:47.25,0:03:49.56,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68} 扳回一盘
Dialogue: 0,0:03:49.56,0:03:52.31,TL,,0,0,0,,决胜盘 她只丢了一局
Dialogue: 0,0:03:55.25,0:03:58.27,TL,,0,0,0,,{\fs78}1{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:03:58.27,0:03:59.87,TL,,0,0,0,,距离她上一个冠军
Dialogue: 0,0:03:59.87,0:04:01.82,TL,,0,0,0,,过去了一年零两个月
Dialogue: 0,0:04:04.25,0:04:06.10,TL,,0,0,0,,这是她{\fs78}2011{\fs68}年法网之后的
Dialogue: 0,0:04:06.10,0:04:07.16,TL,,0,0,0,,第一个冠军
Dialogue: 0,0:04:07.16,0:04:08.83,TL,,0,0,0,,也是生涯第六个
Dialogue: 0,0:04:11.75,0:04:13.55,TL,,0,0,0,,她在颁奖台上说了一句
Dialogue: 0,0:04:13.55,0:04:16.36,TL,,0,0,0,,我觉得这是一个很好的开始
Dialogue: 0,0:04:19.25,0:04:22.05,TL,,0,0,0,,从第二轮打到决赛 {\fs78}5{\fs68}场球
Dialogue: 0,0:04:22.05,0:04:23.88,TL,,0,0,0,,她一共只丢了{\fs78}3{\fs68}盘
Dialogue: 0,0:04:27.25,0:04:29.82,TL,,0,0,0,,{\fs78}5{\fs68}个月后 她打进澳网决赛
Dialogue: 0,0:04:29.82,0:04:31.27,TL,,0,0,0,,一年零五个月后
Dialogue: 0,0:04:31.27,0:04:33.20,TL,,0,0,0,,她拿到了第二个大满贯
Dialogue: 0,0:04:36.25,0:04:37.60,TL,,0,0,0,,而这一座奖杯
Dialogue: 0,0:04:37.60,0:04:40.30,TL,,0,0,0,,到她退役都是唯一的一座
Dialogue: 0,0:04:40.30,0:04:42.68,TL,,0,0,0,,你还记得那个星期三的晚上吗？
