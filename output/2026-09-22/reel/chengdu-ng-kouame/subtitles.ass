Dialogue: 0,0:00:03.88,0:00:05.05,TL,,0,0,0,,成都签表里
Dialogue: 0,0:00:05.05,0:00:08.31,TL,,0,0,0,,夸梅名字前的 {\fs78}NG{\fs68} 是什么意思？
Dialogue: 0,0:00:08.83,0:00:11.94,TL,,0,0,0,,它来自 {\fs78}Next{\fs68} {\fs78}Gen{\fs68} 也就是新生代
Dialogue: 0,0:00:15.43,0:00:16.18,TL,,0,0,0,,在这里
Dialogue: 0,0:00:16.18,0:00:19.29,TL,,0,0,0,,表示他通过 {\fs78}ATP{\fs68} 新生代加速计划
Dialogue: 0,0:00:19.29,0:00:21.59,TL,,0,0,0,,获得了这个参赛位置
Dialogue: 0,0:00:22.23,0:00:22.89,TL,,0,0,0,,记住
Dialogue: 0,0:00:22.89,0:00:25.49,TL,,0,0,0,,这两个字母说明的是怎么进来的
Dialogue: 0,0:00:25.49,0:00:29.09,TL,,0,0,0,,不是种子序号 也不是没有世界排名
Dialogue: 0,0:00:29.66,0:00:32.20,TL,,0,0,0,,具体怎样才能进入签表？
Dialogue: 0,0:00:32.20,0:00:34.51,TL,,0,0,0,,按{\fs78}2026{\fs68}年规则 首先
Dialogue: 0,0:00:34.51,0:00:37.53,TL,,0,0,0,,要在{\fs78}2006{\fs68}年或以后出生
Dialogue: 0,0:00:38.26,0:00:40.85,TL,,0,0,0,,走到 {\fs78}ATP{\fs68} {\fs78}250{\fs68}赛这一层
Dialogue: 0,0:00:40.85,0:00:43.87,TL,,0,0,0,,还要进入单打世界前{\fs78}250{\fs68}
Dialogue: 0,0:00:44.72,0:00:46.70,TL,,0,0,0,,注意 看的是世界排名
Dialogue: 0,0:00:46.70,0:00:49.01,TL,,0,0,0,,不是新生代积分榜
Dialogue: 0,0:00:49.50,0:00:51.82,TL,,0,0,0,,符合条件 也不能随便挑比赛
Dialogue: 0,0:00:51.82,0:00:53.60,TL,,0,0,0,,还要满足指定比赛周
Dialogue: 0,0:00:53.60,0:00:57.22,TL,,0,0,0,,报名和排名优先等规定 名额有限
Dialogue: 0,0:00:57.91,0:01:00.41,TL,,0,0,0,,成都签表把夸梅标为 {\fs78}NG{\fs68}
Dialogue: 0,0:01:00.41,0:01:02.40,TL,,0,0,0,,{\fs78}ATP{\fs68} 的官方报道也确认
Dialogue: 0,0:01:02.40,0:01:05.34,TL,,0,0,0,,他本周使用了这项加速计划
Dialogue: 0,0:01:06.01,0:01:09.03,TL,,0,0,0,,{\fs78}ATP{\fs68} 为什么要开这条通道？
Dialogue: 0,0:01:09.82,0:01:12.01,TL,,0,0,0,,因为网球通常按排名录取
Dialogue: 0,0:01:12.01,0:01:13.86,TL,,0,0,0,,但排名来自过去的成绩
Dialogue: 0,0:01:13.86,0:01:16.73,TL,,0,0,0,,未必立刻跟上年轻人的进步
Dialogue: 0,0:01:17.26,0:01:19.45,TL,,0,0,0,,加速计划让一部分新人
Dialogue: 0,0:01:19.45,0:01:21.18,TL,,0,0,0,,在已经证明自己之后
Dialogue: 0,0:01:21.18,0:01:24.00,TL,,0,0,0,,更早挑战更高一级赛事
Dialogue: 0,0:01:25.16,0:01:28.26,TL,,0,0,0,,{\fs78}2023{\fs68}年底 {\fs78}ATP{\fs68} 公布扩展方案
Dialogue: 0,0:01:28.26,0:01:29.79,TL,,0,0,0,,从{\fs78}2024{\fs68}年开始
Dialogue: 0,0:01:29.79,0:01:32.43,TL,,0,0,0,,增加年轻职业球员的机会
Dialogue: 0,0:01:33.26,0:01:34.28,TL,,0,0,0,,官方的初衷
Dialogue: 0,0:01:34.28,0:01:37.01,TL,,0,0,0,,是培养人才 改善成长的路径
Dialogue: 0,0:01:37.01,0:01:40.48,TL,,0,0,0,,也让新人全年在巡回赛中被看见
Dialogue: 0,0:01:41.02,0:01:43.15,TL,,0,0,0,,制度给的是有限的入场机会
Dialogue: 0,0:01:43.15,0:01:46.53,TL,,0,0,0,,胜场和积分 仍然要自己争取
Dialogue: 0,0:01:46.96,0:01:48.36,TL,,0,0,0,,夸梅是谁？
Dialogue: 0,0:01:48.36,0:01:51.48,TL,,0,0,0,,这位{\fs78}17{\fs68}岁的法国新秀 {\fs78}2026{\fs68}年初
Dialogue: 0,0:01:51.48,0:01:54.38,TL,,0,0,0,,先拿下两座 {\fs78}ITF{\fs68} 单打冠军
Dialogue: 0,0:01:54.38,0:01:56.82,TL,,0,0,0,,随后从资格赛打进蒙彼利埃
Dialogue: 0,0:01:56.82,0:01:59.07,TL,,0,0,0,,完成巡回赛首秀
Dialogue: 0,0:02:00.06,0:02:02.64,TL,,0,0,0,,{\fs78}3{\fs68}月迈阿密 他击败斯瓦伊达
Dialogue: 0,0:02:02.64,0:02:04.69,TL,,0,0,0,,拿到巡回赛首胜
Dialogue: 0,0:02:05.17,0:02:07.04,TL,,0,0,0,,成为纳达尔{\fs78}2003{\fs68}年之后
Dialogue: 0,0:02:07.04,0:02:10.44,TL,,0,0,0,,赢下大师赛正赛的最年轻球员
Dialogue: 0,0:02:11.17,0:02:12.08,TL,,0,0,0,,到了法网
Dialogue: 0,0:02:12.08,0:02:15.15,TL,,0,0,0,,他先击败前美网冠军西里奇
Dialogue: 0,0:02:15.97,0:02:17.95,TL,,0,0,0,,又用四小时{\fs78}56{\fs68}分钟
Dialogue: 0,0:02:17.95,0:02:19.95,TL,,0,0,0,,{\fs78}5{\fs68}盘大战淘汰巴列霍
Dialogue: 0,0:02:19.95,0:02:23.28,TL,,0,0,0,,闯进第三轮 最终输给塔比洛
Dialogue: 0,0:02:23.90,0:02:25.86,TL,,0,0,0,,他的团队里有加斯奎特
Dialogue: 0,0:02:25.86,0:02:28.24,TL,,0,0,0,,偶像则是德约科维奇
Dialogue: 0,0:02:28.69,0:02:31.03,TL,,0,0,0,,天赋已经被看见 稳定性
Dialogue: 0,0:02:31.03,0:02:34.23,TL,,0,0,0,,还要在更高水平的对抗里磨出来
Dialogue: 0,0:02:34.89,0:02:36.49,TL,,0,0,0,,把他的入场路线连起来
Dialogue: 0,0:02:36.49,0:02:39.28,TL,,0,0,0,,就不会混淆 蒙彼利埃靠资格赛
Dialogue: 0,0:02:39.28,0:02:40.96,TL,,0,0,0,,迈阿密和法网拿外卡
Dialogue: 0,0:02:40.96,0:02:43.28,TL,,0,0,0,,成都走加速计划
Dialogue: 0,0:02:43.96,0:02:44.84,TL,,0,0,0,,一个球员
Dialogue: 0,0:02:44.84,0:02:47.48,TL,,0,0,0,,可以在不同赛事走不同入口
Dialogue: 0,0:02:47.48,0:02:50.54,TL,,0,0,0,,那历史上还有谁用过这个机制？
Dialogue: 0,0:02:50.54,0:02:54.11,TL,,0,0,0,,下面两位都有 {\fs78}ATP{\fs68} 官方报道确认
Dialogue: 0,0:02:54.86,0:02:57.69,TL,,0,0,0,,不过 保存下来的多哈{\fs78}2024{\fs68}年
Dialogue: 0,0:02:57.69,0:03:00.21,TL,,0,0,0,,布宜诺斯艾利斯{\fs78}2025{\fs68}年签表
Dialogue: 0,0:03:00.21,0:03:02.97,TL,,0,0,0,,并没有在他们名字前印出 {\fs78}NG{\fs68}
Dialogue: 0,0:03:03.95,0:03:04.97,TL,,0,0,0,,同一机制
Dialogue: 0,0:03:04.97,0:03:08.58,TL,,0,0,0,,不等于每张旧签表都用同样的字母
Dialogue: 0,0:03:09.24,0:03:11.61,TL,,0,0,0,,第一个例子 是门西克
Dialogue: 0,0:03:11.61,0:03:12.90,TL,,0,0,0,,{\fs78}2024{\fs68}年多哈
Dialogue: 0,0:03:12.90,0:03:15.53,TL,,0,0,0,,{\fs78}18{\fs68}岁的他通过加速计划参赛
Dialogue: 0,0:03:15.53,0:03:18.57,TL,,0,0,0,,连续击败达维多维奇 福基纳 穆雷
Dialogue: 0,0:03:18.57,0:03:22.10,TL,,0,0,0,,卢布列夫和孟菲尔斯 闯进决赛
Dialogue: 0,0:03:23.00,0:03:24.87,TL,,0,0,0,,虽然最终输给哈恰诺夫
Dialogue: 0,0:03:24.87,0:03:27.89,TL,,0,0,0,,但亚军让他的排名从第{\fs78}116{\fs68}
Dialogue: 0,0:03:27.89,0:03:30.00,TL,,0,0,0,,跃升到第{\fs78}87{\fs68}
Dialogue: 0,0:03:30.77,0:03:31.92,TL,,0,0,0,,一周的胜场
Dialogue: 0,0:03:31.92,0:03:35.35,TL,,0,0,0,,改善了此后更多赛事的报名条件
Dialogue: 0,0:03:36.06,0:03:36.77,TL,,0,0,0,,一年后
Dialogue: 0,0:03:36.77,0:03:39.75,TL,,0,0,0,,他又在迈阿密决赛击败德约科维奇
Dialogue: 0,0:03:39.75,0:03:41.93,TL,,0,0,0,,拿下大师赛冠军
Dialogue: 0,0:03:42.57,0:03:43.82,TL,,0,0,0,,这是后续成长
Dialogue: 0,0:03:43.82,0:03:47.27,TL,,0,0,0,,不能把那一站也说成是靠 {\fs78}NG{\fs68} 入场
Dialogue: 0,0:03:47.93,0:03:50.32,TL,,0,0,0,,第二个例子 是丰塞卡
Dialogue: 0,0:03:50.32,0:03:52.37,TL,,0,0,0,,{\fs78}2025{\fs68}年布宜诺斯艾利斯
Dialogue: 0,0:03:52.37,0:03:54.99,TL,,0,0,0,,{\fs78}18{\fs68}岁的他使用加速计划参赛
Dialogue: 0,0:03:54.99,0:03:57.88,TL,,0,0,0,,四分之一决赛挽救两个赛点
Dialogue: 0,0:03:58.53,0:04:00.27,TL,,0,0,0,,决赛击败塞伦多洛
Dialogue: 0,0:04:00.27,0:04:03.32,TL,,0,0,0,,直接拿到首个巡回赛冠军
Dialogue: 0,0:04:03.83,0:04:06.95,TL,,0,0,0,,同年 他又赢下巴塞尔{\fs78}500{\fs68}赛冠军
Dialogue: 0,0:04:06.95,0:04:09.46,TL,,0,0,0,,年终来到世界第{\fs78}24{\fs68}
Dialogue: 0,0:04:10.08,0:04:13.24,TL,,0,0,0,,机会把门打开 但从签表走到奖杯
Dialogue: 0,0:04:13.24,0:04:15.83,TL,,0,0,0,,他仍然得一场一场赢下来
Dialogue: 0,0:04:16.59,0:04:18.32,TL,,0,0,0,,所以 {\fs78}NG{\fs68} 的价值
Dialogue: 0,0:04:18.32,0:04:20.08,TL,,0,0,0,,是让已有成绩的年轻人
Dialogue: 0,0:04:20.08,0:04:22.94,TL,,0,0,0,,早点接受更高水平的检验
Dialogue: 0,0:04:23.52,0:04:25.86,TL,,0,0,0,,门西克和丰塞卡接住了机会
Dialogue: 0,0:04:25.86,0:04:28.87,TL,,0,0,0,,这次成都 轮到夸梅作答
Dialogue: 0,0:04:29.53,0:04:32.79,TL,,0,0,0,,你觉得 给达标的新秀 留少量名额
Dialogue: 0,0:04:32.79,0:04:35.19,TL,,0,0,0,,会让巡回赛更有活力吗？
Dialogue: 0,0:04:35.19,0:04:38.45,TL,,0,0,0,,这里是网球时差 网球有故事
