Dialogue: 0,0:00:03.78,0:00:06.46,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}18{\fs68}日 昂跑宣布进军足球
Dialogue: 0,0:00:06.46,0:00:08.71,TL,,0,0,0,,姆巴佩成为全球品牌大使
Dialogue: 0,0:00:08.71,0:00:11.82,TL,,0,0,0,,还会参与足球产品的开发测试
Dialogue: 0,0:00:12.82,0:00:15.31,TL,,0,0,0,,从费德勒到姆巴佩 这背后
Dialogue: 0,0:00:15.31,0:00:17.79,TL,,0,0,0,,至少有三本不同的账
Dialogue: 0,0:00:18.03,0:00:20.80,TL,,0,0,0,,第一本 是运动员自己的账
Dialogue: 0,0:00:20.80,0:00:22.55,TL,,0,0,0,,昂跑{\fs78}2010{\fs68}年成立
Dialogue: 0,0:00:22.55,0:00:25.92,TL,,0,0,0,,费德勒{\fs78}2019{\fs68}年才成为投资者
Dialogue: 0,0:00:26.17,0:00:27.91,TL,,0,0,0,,他不是创始人
Dialogue: 0,0:00:27.91,0:00:29.53,TL,,0,0,0,,也不能因为他持股
Dialogue: 0,0:00:29.53,0:00:32.98,TL,,0,0,0,,就把公司的每个决定都算在他头上
Dialogue: 0,0:00:33.98,0:00:35.96,TL,,0,0,0,,代言按合同取得报酬
Dialogue: 0,0:00:35.96,0:00:37.66,TL,,0,0,0,,持股的资产价值
Dialogue: 0,0:00:37.66,0:00:40.75,TL,,0,0,0,,则与公司经营表现联系起来
Dialogue: 0,0:00:40.99,0:00:43.45,TL,,0,0,0,,公司发展得好 股权可能升值
Dialogue: 0,0:00:43.45,0:00:46.75,TL,,0,0,0,,发展不及预期 也要承受损失
Dialogue: 0,0:00:47.00,0:00:48.46,TL,,0,0,0,,股份值多少钱
Dialogue: 0,0:00:48.46,0:00:50.90,TL,,0,0,0,,与卖掉之后实际赚到多少钱
Dialogue: 0,0:00:50.90,0:00:52.43,TL,,0,0,0,,更是两回事
Dialogue: 0,0:00:52.43,0:00:55.25,TL,,0,0,0,,费德勒还参与了产品合作
Dialogue: 0,0:00:55.50,0:00:57.74,TL,,0,0,0,,{\fs78}2020{\fs68}年推出的 {\fs78}THE{\fs68} {\fs78}ROGER{\fs68}
Dialogue: 0,0:00:57.74,0:01:00.41,TL,,0,0,0,,先是一双网球风格的日常鞋
Dialogue: 0,0:01:00.41,0:01:03.01,TL,,0,0,0,,之后才有专业网球鞋
Dialogue: 0,0:01:04.01,0:01:05.72,TL,,0,0,0,,喜欢网球明星的人
Dialogue: 0,0:01:05.72,0:01:08.04,TL,,0,0,0,,不一定每天都打网球
Dialogue: 0,0:01:08.29,0:01:10.26,TL,,0,0,0,,却可能每天都穿鞋
Dialogue: 0,0:01:10.26,0:01:11.27,TL,,0,0,0,,商业转化
Dialogue: 0,0:01:11.27,0:01:14.38,TL,,0,0,0,,就不必只发生在比赛装备上
Dialogue: 0,0:01:14.63,0:01:17.22,TL,,0,0,0,,第二本 是个人品牌的账
Dialogue: 0,0:01:17.22,0:01:18.29,TL,,0,0,0,,有一个细节
Dialogue: 0,0:01:18.29,0:01:21.25,TL,,0,0,0,,比猜他赚了多少亿更值得看
Dialogue: 0,0:01:21.50,0:01:23.78,TL,,0,0,0,,昂跑{\fs78}2024{\fs68}年度报告披露
Dialogue: 0,0:01:23.78,0:01:25.26,TL,,0,0,0,,{\fs78}THE{\fs68} {\fs78}ROGER{\fs68} 的品牌权利
Dialogue: 0,0:01:25.26,0:01:27.40,TL,,0,0,0,,是经授权使用的
Dialogue: 0,0:01:28.40,0:01:30.26,TL,,0,0,0,,持股 参与产品
Dialogue: 0,0:01:30.26,0:01:33.97,TL,,0,0,0,,授权使用姓名和品牌 可以分别安排
Dialogue: 0,0:01:33.97,0:01:35.22,TL,,0,0,0,,没有公开费率
Dialogue: 0,0:01:35.22,0:01:38.21,TL,,0,0,0,,就不能替他算出授权收入
Dialogue: 0,0:01:39.21,0:01:41.93,TL,,0,0,0,,第三本 才是公司的生意账
Dialogue: 0,0:01:41.93,0:01:45.47,TL,,0,0,0,,进入足球之前 昂跑靠什么赚钱？
Dialogue: 0,0:01:45.72,0:01:47.30,TL,,0,0,0,,{\fs78}2026{\fs68}年第二季度
Dialogue: 0,0:01:47.30,0:01:49.88,TL,,0,0,0,,净销售额{\fs78}8{\fs68}.{\fs78}5{\fs68}亿瑞士法郎
Dialogue: 0,0:01:49.88,0:01:52.49,TL,,0,0,0,,鞋类占了约{\fs78}92{\fs68}%
Dialogue: 0,0:01:53.48,0:01:55.30,TL,,0,0,0,,这个季度结束在{\fs78}6{\fs68}月
Dialogue: 0,0:01:55.30,0:01:58.93,TL,,0,0,0,,不能说成{\fs78}9{\fs68}月签约姆巴佩带来的成绩
Dialogue: 0,0:01:59.17,0:02:01.85,TL,,0,0,0,,同一季度 约{\fs78}46{\fs68}%的收入
Dialogue: 0,0:02:01.85,0:02:04.83,TL,,0,0,0,,直接来自面向消费者的渠道
Dialogue: 0,0:02:05.83,0:02:07.50,TL,,0,0,0,,品牌更接近顾客
Dialogue: 0,0:02:07.50,0:02:09.23,TL,,0,0,0,,也需要自己承担门店
Dialogue: 0,0:02:09.23,0:02:11.17,TL,,0,0,0,,获客和服务成本
Dialogue: 0,0:02:11.17,0:02:12.25,TL,,0,0,0,,所以有名气
Dialogue: 0,0:02:12.25,0:02:14.97,TL,,0,0,0,,不等于利润会自动留下来
Dialogue: 0,0:02:15.22,0:02:16.83,TL,,0,0,0,,再看姆巴佩
Dialogue: 0,0:02:16.83,0:02:19.87,TL,,0,0,0,,官方公布的合作包括产品开发测试
Dialogue: 0,0:02:19.87,0:02:22.66,TL,,0,0,0,,亨利担任足球业务负责人
Dialogue: 0,0:02:23.66,0:02:24.93,TL,,0,0,0,,明星带来的关注
Dialogue: 0,0:02:24.93,0:02:27.84,TL,,0,0,0,,可以缩短新品牌被认识的时间
Dialogue: 0,0:02:27.84,0:02:31.34,TL,,0,0,0,,但被认识 只是购买之前的一步
Dialogue: 0,0:02:31.59,0:02:35.18,TL,,0,0,0,,昂跑准备把喷丝鞋面技术带进足球
Dialogue: 0,0:02:35.18,0:02:38.31,TL,,0,0,0,,这项技术 此前用于跑鞋
Dialogue: 0,0:02:38.56,0:02:39.49,TL,,0,0,0,,跑得快
Dialogue: 0,0:02:39.49,0:02:42.47,TL,,0,0,0,,与在足球场上稳定地急停 转向
Dialogue: 0,0:02:42.47,0:02:45.35,TL,,0,0,0,,触球 是不同的产品要求
Dialogue: 0,0:02:45.60,0:02:48.21,TL,,0,0,0,,研发方向已经公布 性能和销量
Dialogue: 0,0:02:48.21,0:02:50.81,TL,,0,0,0,,还要等真实产品来回答
Dialogue: 0,0:02:51.05,0:02:53.59,TL,,0,0,0,,这次扩张可能有两条路
Dialogue: 0,0:02:53.59,0:02:57.58,TL,,0,0,0,,第一条 专业足球装备形成持续需求
Dialogue: 0,0:02:57.82,0:02:58.61,TL,,0,0,0,,第二条
Dialogue: 0,0:02:58.61,0:03:01.92,TL,,0,0,0,,新受众先购买已有的日常鞋服
Dialogue: 0,0:03:02.17,0:03:04.48,TL,,0,0,0,,两条都可能创造收入
Dialogue: 0,0:03:04.48,0:03:06.91,TL,,0,0,0,,但不能只看集团总销售额
Dialogue: 0,0:03:06.91,0:03:08.62,TL,,0,0,0,,就认定是哪条成功
Dialogue: 0,0:03:08.62,0:03:11.53,TL,,0,0,0,,更不能都归到一名球员身上
Dialogue: 0,0:03:11.78,0:03:13.42,TL,,0,0,0,,未来值得看三件事
Dialogue: 0,0:03:13.42,0:03:14.97,TL,,0,0,0,,产品有没有推出
Dialogue: 0,0:03:14.97,0:03:16.74,TL,,0,0,0,,渠道能不能稳定供货
Dialogue: 0,0:03:16.74,0:03:20.06,TL,,0,0,0,,第一批尝鲜的人 会不会继续买
Dialogue: 0,0:03:21.06,0:03:24.21,TL,,0,0,0,,再与库存 费用和利润放在一起核对
Dialogue: 0,0:03:24.21,0:03:27.02,TL,,0,0,0,,才能判断这门生意有没有站稳
Dialogue: 0,0:03:27.02,0:03:29.30,TL,,0,0,0,,明星可以把人带到品牌面前
Dialogue: 0,0:03:29.30,0:03:31.82,TL,,0,0,0,,让人掏钱 穿上 再回来买
Dialogue: 0,0:03:31.82,0:03:33.95,TL,,0,0,0,,最后还得靠产品
Dialogue: 0,0:03:34.19,0:03:36.71,TL,,0,0,0,,你会为球星买鞋吗？
