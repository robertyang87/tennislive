Dialogue: 0,0:00:04.81,0:00:06.48,TL,,0,0,0,,看底线后面
Dialogue: 0,0:00:06.48,0:00:09.90,TL,,0,0,0,,戴维斯杯 为什么还有人在喊出界？
Dialogue: 0,0:00:10.65,0:00:13.63,TL,,0,0,0,,{\fs78}ATP{\fs68}巡回赛已经采用实时电子司线
Dialogue: 0,0:00:13.63,0:00:15.00,TL,,0,0,0,,换到国家队比赛
Dialogue: 0,0:00:15.00,0:00:17.37,TL,,0,0,0,,执裁方式却可能不同
Dialogue: 0,0:00:18.13,0:00:19.65,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}19{\fs68}到{\fs78}20{\fs68}号
Dialogue: 0,0:00:19.65,0:00:20.93,TL,,0,0,0,,德国和克罗地亚在
Dialogue: 0,0:00:20.93,0:00:22.92,TL,,0,0,0,,哈雷打资格赛第二轮
Dialogue: 0,0:00:22.92,0:00:24.83,TL,,0,0,0,,这是室内硬地
Dialogue: 0,0:00:25.65,0:00:28.51,TL,,0,0,0,,先分清 到底是谁在判
Dialogue: 0,0:00:29.29,0:00:31.98,TL,,0,0,0,,人工司线 是人先判断落点
Dialogue: 0,0:00:31.98,0:00:34.66,TL,,0,0,0,,挑战式鹰眼 则是在规定条件下
Dialogue: 0,0:00:34.66,0:00:36.61,TL,,0,0,0,,用电子回放复核
Dialogue: 0,0:00:36.61,0:00:39.11,TL,,0,0,0,,两者可以同时存在
Dialogue: 0,0:00:39.89,0:00:42.03,TL,,0,0,0,,实时电子司线更进一步
Dialogue: 0,0:00:42.03,0:00:44.35,TL,,0,0,0,,系统直接判断出界并播报
Dialogue: 0,0:00:44.35,0:00:46.32,TL,,0,0,0,,通常不再由司线员先喊
Dialogue: 0,0:00:46.32,0:00:48.31,TL,,0,0,0,,再等球员挑战
Dialogue: 0,0:00:49.09,0:00:50.98,TL,,0,0,0,,还有一种叫视频复核
Dialogue: 0,0:00:50.98,0:00:54.03,TL,,0,0,0,,处理二跳 触网 妨碍等争议
Dialogue: 0,0:00:54.03,0:00:57.71,TL,,0,0,0,,它和电子司线 解决的是不同的问题
Dialogue: 0,0:00:58.49,0:01:00.41,TL,,0,0,0,,所以 看到人工司线
Dialogue: 0,0:01:00.41,0:01:03.81,TL,,0,0,0,,不能直接说这场比赛没有电子辅助
Dialogue: 0,0:01:03.81,0:01:05.20,TL,,0,0,0,,看见鹰眼回放
Dialogue: 0,0:01:05.20,0:01:08.09,TL,,0,0,0,,也不代表用了全自动司线
Dialogue: 0,0:01:08.85,0:01:12.19,TL,,0,0,0,,再看规则 决定权不在同一处
Dialogue: 0,0:01:12.97,0:01:14.91,TL,,0,0,0,,{\fs78}ATP{\fs68}从{\fs78}2025{\fs68}年起
Dialogue: 0,0:01:14.91,0:01:17.34,TL,,0,0,0,,要求巡回赛正赛和资格赛使用实
Dialogue: 0,0:01:17.34,0:01:20.74,TL,,0,0,0,,时电子司线 覆盖各种场地 注意
Dialogue: 0,0:01:20.74,0:01:23.79,TL,,0,0,0,,这不等于所有男子职业比赛
Dialogue: 0,0:01:24.73,0:01:26.71,TL,,0,0,0,,戴维斯杯属于{\fs78}ITF{\fs68}管理的
Dialogue: 0,0:01:26.71,0:01:28.03,TL,,0,0,0,,国家队赛事
Dialogue: 0,0:01:28.03,0:01:29.59,TL,,0,0,0,,球员还是那些球员
Dialogue: 0,0:01:29.59,0:01:32.17,TL,,0,0,0,,适用的赛事规则却换了
Dialogue: 0,0:01:32.93,0:01:35.51,TL,,0,0,0,,{\fs78}2026{\fs68}年戴杯规则第{\fs78}10{\fs68}.{\fs78}5{\fs68}条
Dialogue: 0,0:01:35.51,0:01:36.83,TL,,0,0,0,,给主办方保留了
Dialogue: 0,0:01:36.83,0:01:39.60,TL,,0,0,0,,申请使用电子司线的空间
Dialogue: 0,0:01:40.33,0:01:42.67,TL,,0,0,0,,没有由{\fs78}ITF{\fs68}提供系统的场次
Dialogue: 0,0:01:42.67,0:01:44.03,TL,,0,0,0,,国家协会想使用
Dialogue: 0,0:01:44.03,0:01:47.24,TL,,0,0,0,,就要取得许可并符合承办要求
Dialogue: 0,0:01:48.01,0:01:50.99,TL,,0,0,0,,规则也列出了人工司线人员配置
Dialogue: 0,0:01:50.99,0:01:53.85,TL,,0,0,0,,因此 人工执裁本身符合制度
Dialogue: 0,0:01:53.85,0:01:56.79,TL,,0,0,0,,并不能证明这站比赛落后
Dialogue: 0,0:01:57.57,0:02:00.59,TL,,0,0,0,,接下来 两天比赛怎么算账？
Dialogue: 0,0:02:01.37,0:02:04.15,TL,,0,0,0,,资格赛一场国家队对抗 安排两天
Dialogue: 0,0:02:04.15,0:02:06.85,TL,,0,0,0,,赛制是{\fs78}4{\fs68}场单打加一场双打
Dialogue: 0,0:02:06.85,0:02:09.39,TL,,0,0,0,,实际可能提前分出胜负
Dialogue: 0,0:02:10.17,0:02:12.62,TL,,0,0,0,,可以把部署成本拆成两部分
Dialogue: 0,0:02:12.62,0:02:14.75,TL,,0,0,0,,设备运输 安装和校准
Dialogue: 0,0:02:14.75,0:02:17.42,TL,,0,0,0,,加上比赛期间的技术服务
Dialogue: 0,0:02:18.17,0:02:20.47,TL,,0,0,0,,在固定投入相同的假设下
Dialogue: 0,0:02:20.47,0:02:23.03,TL,,0,0,0,,比赛越多 每场分摊越少
Dialogue: 0,0:02:23.03,0:02:24.84,TL,,0,0,0,,但巡回赛场地也更多
Dialogue: 0,0:02:24.84,0:02:28.11,TL,,0,0,0,,不能只拿总场次一除就下结论
Dialogue: 0,0:02:28.89,0:02:31.20,TL,,0,0,0,,短赛期会影响采购意愿
Dialogue: 0,0:02:31.20,0:02:34.63,TL,,0,0,0,,却不足以证明德国网协就是为了省钱
Dialogue: 0,0:02:34.63,0:02:38.35,TL,,0,0,0,,我没有找到主办方公开解释这个选择
Dialogue: 0,0:02:39.13,0:02:41.46,TL,,0,0,0,,而费用也不是主队全包
Dialogue: 0,0:02:41.46,0:02:42.30,TL,,0,0,0,,规则规定
Dialogue: 0,0:02:42.30,0:02:45.08,TL,,0,0,0,,{\fs78}ITF{\fs68}支付指定裁判的往返旅费
Dialogue: 0,0:02:45.08,0:02:46.70,TL,,0,0,0,,主队承担相关酬金
Dialogue: 0,0:02:46.70,0:02:49.09,TL,,0,0,0,,住宿和当地交通等
Dialogue: 0,0:02:49.85,0:02:52.83,TL,,0,0,0,,硬地 也有自己的部署条件
Dialogue: 0,0:02:53.61,0:02:57.02,TL,,0,0,0,,设备要适应场馆 机位和比赛环境
Dialogue: 0,0:02:57.02,0:02:58.80,TL,,0,0,0,,不过 哈雷这座球馆
Dialogue: 0,0:02:58.80,0:03:01.36,TL,,0,0,0,,本来就举办{\fs78}ATP{\fs68}赛事
Dialogue: 0,0:03:02.13,0:03:04.23,TL,,0,0,0,,所以不能把这场解释成
Dialogue: 0,0:03:04.23,0:03:06.92,TL,,0,0,0,,临时场馆装不了电子系统
Dialogue: 0,0:03:06.92,0:03:09.29,TL,,0,0,0,,也不能反过来说 办过巡回赛
Dialogue: 0,0:03:09.29,0:03:11.83,TL,,0,0,0,,设备就一定全年留着
Dialogue: 0,0:03:12.61,0:03:14.65,TL,,0,0,0,,{\fs78}ATP{\fs68}统一采用这项技术
Dialogue: 0,0:03:14.65,0:03:16.29,TL,,0,0,0,,除了追求判罚一致
Dialogue: 0,0:03:16.29,0:03:19.31,TL,,0,0,0,,还看重持续收集球和球员的运动数据
Dialogue: 0,0:03:19.31,0:03:21.59,TL,,0,0,0,,用于分析和新统计
Dialogue: 0,0:03:22.37,0:03:24.80,TL,,0,0,0,,电子司线也离不开人
Dialogue: 0,0:03:24.80,0:03:26.59,TL,,0,0,0,,主裁仍要管理比赛
Dialogue: 0,0:03:26.59,0:03:28.44,TL,,0,0,0,,技术岗位要维护系统
Dialogue: 0,0:03:28.44,0:03:31.71,TL,,0,0,0,,出现故障还需要处理和备用方案
Dialogue: 0,0:03:32.49,0:03:35.99,TL,,0,0,0,,保留司线岗位 确实留下了实践机会
Dialogue: 0,0:03:35.99,0:03:38.99,TL,,0,0,0,,但把它说成{\fs78}ITF{\fs68}刻意保护晋升通道
Dialogue: 0,0:03:38.99,0:03:40.87,TL,,0,0,0,,没有足够证据
Dialogue: 0,0:03:41.65,0:03:43.20,TL,,0,0,0,,未来要扩大使用
Dialogue: 0,0:03:43.20,0:03:46.51,TL,,0,0,0,,关键在可靠性 部署成本和组织安排
Dialogue: 0,0:03:46.51,0:03:49.38,TL,,0,0,0,,而不只是换掉场边的几个人
Dialogue: 0,0:03:50.13,0:03:51.22,TL,,0,0,0,,回到开头
Dialogue: 0,0:03:51.22,0:03:53.74,TL,,0,0,0,,戴杯为什么还有人工司线？
Dialogue: 0,0:03:53.74,0:03:55.92,TL,,0,0,0,,规则允许 落地条件不同
Dialogue: 0,0:03:55.92,0:03:58.53,TL,,0,0,0,,个案理由还要看证据
