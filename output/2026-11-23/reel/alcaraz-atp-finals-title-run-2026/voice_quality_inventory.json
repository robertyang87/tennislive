        "backend": "edge",
        "cache_key": "1b6b6bcd7e8469c05f5f6bfe692761cb",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "最后一拍，反拍制胜。阿尔卡拉斯仰面倒在球场上，起身后走向团队拥抱。去年决赛失利，今年这座奖杯终于属于他。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "752fd8094cd40ff371e24c9d7fcd8d96a8624ba74c202e05021d1c2d5bc3c6a5",
