        "cache_key": "2d7a1ad48739f50ca4e222c20d865abe",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "四比四，兹维列夫又保住发球局，追到五比四。比赛最终打到六比六，小分三比六，三个连续盘点。兹维列夫再拿一分，就能扳平盘数。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "b884de7a49317df19f91676d6134bdad244c06b161072508cd226d610aff7c3d",
      "words_sha256": "6c5b2ccc318f638c409ba53f0481e011acce27917138ae961ac3dd582b967c00"
    },
