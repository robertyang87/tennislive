Dialogue: 0,0:00:00.10,0:00:01.56,TL,,0,0,0,,闭眼单脚站不稳
Dialogue: 0,0:00:01.56,0:00:03.70,TL,,0,0,0,,她被撤下了半决赛
Dialogue: 0,0:00:11.84,0:00:15.43,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}25{\fs68}日 新加坡{\fs78}WTA500{\fs68}赛
Dialogue: 0,0:00:15.43,0:00:17.84,TL,,0,0,0,,世界第{\fs78}180{\fs68}的普罗佐罗娃
Dialogue: 0,0:00:17.84,0:00:19.42,TL,,0,0,0,,下午逆转王欣瑜
Dialogue: 0,0:00:19.42,0:00:22.43,TL,,0,0,0,,生涯第一次打进巡回赛半决赛
Dialogue: 0,0:00:23.56,0:00:26.26,TL,,0,0,0,,可这场半决赛 她没能打上
Dialogue: 0,0:00:26.26,0:00:28.27,TL,,0,0,0,,当晚的女双四分之一决赛
Dialogue: 0,0:00:28.27,0:00:31.00,TL,,0,0,0,,第二盘{\fs78}2{\fs68}比{\fs78}5{\fs68} {\fs78}15{\fs68}平
Dialogue: 0,0:00:32.86,0:00:36.26,TL,,0,0,0,,对面是{\fs78}3{\fs68}号种子加藤未唯和佩雷斯
Dialogue: 0,0:00:36.26,0:00:37.81,TL,,0,0,0,,加藤一记高压
Dialogue: 0,0:00:37.81,0:00:40.41,TL,,0,0,0,,打中了网前的普罗佐罗娃
Dialogue: 0,0:00:40.41,0:00:41.98,TL,,0,0,0,,她捂着脸倒在地上
Dialogue: 0,0:00:41.98,0:00:45.43,TL,,0,0,0,,佩雷斯和加藤马上跑到网对面去看她
Dialogue: 0,0:00:45.43,0:00:48.97,TL,,0,0,0,,她随后下场接受治疗 双打退赛
Dialogue: 0,0:00:50.36,0:00:52.03,TL,,0,0,0,,她在社交媒体上写
Dialogue: 0,0:00:52.03,0:00:54.81,TL,,0,0,0,,球擦过脸颊 打在肩膀上
Dialogue: 0,0:00:54.81,0:00:57.39,TL,,0,0,0,,理疗师坚持带她下场做测试
Dialogue: 0,0:00:57.39,0:01:00.56,TL,,0,0,0,,很遗憾 我不知道自己可以拒绝
Dialogue: 0,0:01:01.36,0:01:03.79,TL,,0,0,0,,连打{\fs78}3{\fs68}天 每天{\fs78}3{\fs68}个多小时
Dialogue: 0,0:01:03.79,0:01:07.09,TL,,0,0,0,,她说自己累了 闭眼单脚站立站不稳
Dialogue: 0,0:01:07.09,0:01:08.65,TL,,0,0,0,,其他项目都过了
Dialogue: 0,0:01:08.65,0:01:10.72,TL,,0,0,0,,只有这一项没过
Dialogue: 0,0:01:11.36,0:01:13.98,TL,,0,0,0,,理疗师说 至少休息{\fs78}6{\fs68}天
Dialogue: 0,0:01:13.98,0:01:16.95,TL,,0,0,0,,半决赛 吉布森不战而胜
Dialogue: 0,0:01:18.28,0:01:21.62,TL,,0,0,0,,她写道 梦幻的一周 今天结束了
Dialogue: 0,0:01:21.62,0:01:24.54,TL,,0,0,0,,她还直接艾特了{\fs78}WTA{\fs68} 我觉得
Dialogue: 0,0:01:24.54,0:01:27.59,TL,,0,0,0,,你们需要重新考虑一下自己的规则
Dialogue: 0,0:01:28.68,0:01:30.16,TL,,0,0,0,,后来她又补了一句
Dialogue: 0,0:01:30.16,0:01:32.16,TL,,0,0,0,,赛事方一直在为她争取
Dialogue: 0,0:01:32.16,0:01:34.79,TL,,0,0,0,,最后拍板的 是{\fs78}WTA{\fs68}
Dialogue: 0,0:01:34.79,0:01:37.63,TL,,0,0,0,,{\fs78}WTA{\fs68}至今没有公开回应
Dialogue: 0,0:01:38.28,0:01:39.99,TL,,0,0,0,,那规则怎么写？
Dialogue: 0,0:01:39.99,0:01:42.30,TL,,0,0,0,,{\fs78}WTA2026{\fs68}年的规则书里
Dialogue: 0,0:01:42.30,0:01:45.00,TL,,0,0,0,,脑震荡这个词一次都没有出现
Dialogue: 0,0:01:45.00,0:01:48.29,TL,,0,0,0,,管这件事的 是身体无法比赛条款
Dialogue: 0,0:01:48.29,0:01:51.58,TL,,0,0,0,,理疗师或赛事医生建议 裁判长拍板
Dialogue: 0,0:01:51.58,0:01:54.22,TL,,0,0,0,,没有给球员留推翻的口子
Dialogue: 0,0:01:54.96,0:01:57.41,TL,,0,0,0,,{\fs78}6{\fs68}天 规则书里也没写
Dialogue: 0,0:01:57.41,0:01:59.35,TL,,0,0,0,,国际运动脑震荡共识里
Dialogue: 0,0:01:59.35,0:02:01.34,TL,,0,0,0,,重返赛场要走六步
Dialogue: 0,0:02:01.34,0:02:04.35,TL,,0,0,0,,每一步通常至少{\fs78}24{\fs68}小时
Dialogue: 0,0:02:04.88,0:02:06.60,TL,,0,0,0,,那项闭眼单脚站立
Dialogue: 0,0:02:06.60,0:02:08.75,TL,,0,0,0,,是平衡测试的一环
Dialogue: 0,0:02:08.75,0:02:11.30,TL,,0,0,0,,研究发现 人累了也会站不稳
Dialogue: 0,0:02:11.30,0:02:13.41,TL,,0,0,0,,休息{\fs78}20{\fs68}分钟左右才恢复
Dialogue: 0,0:02:13.41,0:02:15.42,TL,,0,0,0,,她的抱怨不是没道理
Dialogue: 0,0:02:15.42,0:02:18.04,TL,,0,0,0,,可规则的底线是 疑似脑震荡
Dialogue: 0,0:02:18.04,0:02:20.27,TL,,0,0,0,,当天就不能再上场
Dialogue: 0,0:02:21.08,0:02:23.81,TL,,0,0,0,,规矩这么硬 是有来路的
Dialogue: 0,0:02:23.81,0:02:25.14,TL,,0,0,0,,{\fs78}2015{\fs68}年美网
Dialogue: 0,0:02:25.14,0:02:27.54,TL,,0,0,0,,布沙尔{\fs78}3{\fs68}盘赢下齐布尔科娃
Dialogue: 0,0:02:27.54,0:02:29.13,TL,,0,0,0,,打进第四轮
Dialogue: 0,0:02:29.13,0:02:30.55,TL,,0,0,0,,之后的一个晚上
Dialogue: 0,0:02:30.55,0:02:33.07,TL,,0,0,0,,她在光线昏暗的理疗室里滑倒
Dialogue: 0,0:02:33.07,0:02:35.67,TL,,0,0,0,,撞到了头 脑震荡
Dialogue: 0,0:02:37.88,0:02:40.76,TL,,0,0,0,,她退出了第四轮单打和两项双打
Dialogue: 0,0:02:40.76,0:02:43.57,TL,,0,0,0,,一个月后在北京又因为头晕退赛
Dialogue: 0,0:02:43.57,0:02:45.60,TL,,0,0,0,,那个赛季就此结束
Dialogue: 0,0:02:45.60,0:02:46.47,TL,,0,0,0,,{\fs78}3{\fs68}年后
Dialogue: 0,0:02:46.47,0:02:50.94,TL,,0,0,0,,陪审团判美国网协承担{\fs78}75{\fs68}%的责任
Dialogue: 0,0:02:52.08,0:02:53.59,TL,,0,0,0,,{\fs78}2025{\fs68}年迈阿密
Dialogue: 0,0:02:53.59,0:02:56.19,TL,,0,0,0,,汤森在双打四分之一决赛摔倒
Dialogue: 0,0:02:56.19,0:02:58.99,TL,,0,0,0,,轻度脑震荡 当时没被查出来
Dialogue: 0,0:02:58.99,0:03:01.50,TL,,0,0,0,,歇了两天 她照样打了半决赛
Dialogue: 0,0:03:01.50,0:03:04.97,TL,,0,0,0,,结果越来越糟 一路缺席到罗马
Dialogue: 0,0:03:08.04,0:03:10.39,TL,,0,0,0,,{\fs78}2024{\fs68}年罗马 德约科维奇
Dialogue: 0,0:03:10.39,0:03:13.59,TL,,0,0,0,,被看台上掉下来的水瓶砸中了头
Dialogue: 0,0:03:13.59,0:03:16.00,TL,,0,0,0,,两天后 他两盘输给塔比洛
Dialogue: 0,0:03:16.00,0:03:18.30,TL,,0,0,0,,说自己完全没有平衡感
Dialogue: 0,0:03:18.30,0:03:22.08,TL,,0,0,0,,那一次 上不上场 是他自己定的
Dialogue: 0,0:03:24.20,0:03:26.60,TL,,0,0,0,,打出开头那一球的加藤未唯
Dialogue: 0,0:03:26.60,0:03:28.90,TL,,0,0,0,,自己也被规则拦下过
Dialogue: 0,0:03:28.90,0:03:30.56,TL,,0,0,0,,{\fs78}2023{\fs68}年法网女双
Dialogue: 0,0:03:30.56,0:03:32.96,TL,,0,0,0,,她在分与分之间把球打回对面
Dialogue: 0,0:03:32.96,0:03:35.07,TL,,0,0,0,,砸中了一名球童
Dialogue: 0,0:03:36.00,0:03:37.91,TL,,0,0,0,,主裁先只给了警告
Dialogue: 0,0:03:37.91,0:03:40.37,TL,,0,0,0,,裁判长和大满贯监督复核后
Dialogue: 0,0:03:40.37,0:03:43.61,TL,,0,0,0,,改判取消资格 申诉也被驳回
Dialogue: 0,0:03:43.61,0:03:46.15,TL,,0,0,0,,汤森和德约那两次 没人拦
Dialogue: 0,0:03:46.15,0:03:48.83,TL,,0,0,0,,加藤那次 裁判长说了算
Dialogue: 0,0:03:48.83,0:03:52.13,TL,,0,0,0,,普罗佐罗娃撞上的 是后一种
Dialogue: 0,0:03:54.60,0:03:58.30,TL,,0,0,0,,{\fs78}3{\fs68}次逆转 停在一项闭眼单脚站立上
Dialogue: 0,0:03:58.30,0:03:59.93,TL,,0,0,0,,自己说没事的球员
Dialogue: 0,0:03:59.93,0:04:01.58,TL,,0,0,0,,该不该被拦下？
Dialogue: 0,0:04:01.58,0:04:03.22,TL,,0,0,0,,你站哪边？
