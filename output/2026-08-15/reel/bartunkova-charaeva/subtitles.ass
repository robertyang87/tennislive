Dialogue: 0,0:00:07.75,0:00:09.01,TL,,0,0,0,,发球胜赛局
Dialogue: 0,0:00:09.01,0:00:10.46,TL,,0,0,0,,她拿到{\fs78}7{\fs68}个赛点
Dialogue: 0,0:00:10.46,0:00:12.55,TL,,0,0,0,,恰拉耶娃救掉了{\fs78}6{\fs68}个
Dialogue: 0,0:00:14.25,0:00:16.81,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}14{\fs68}号夜里{\fs78}11{\fs68}点
Dialogue: 0,0:00:16.81,0:00:18.82,TL,,0,0,0,,辛辛那提女单第一轮
Dialogue: 0,0:00:18.82,0:00:20.37,TL,,0,0,0,,{\fs78}20{\fs68}岁的巴尔通科娃
Dialogue: 0,0:00:20.37,0:00:21.66,TL,,0,0,0,,世界第{\fs78}39{\fs68}
Dialogue: 0,0:00:21.66,0:00:23.70,TL,,0,0,0,,对手排名{\fs78}113{\fs68}
Dialogue: 0,0:00:26.65,0:00:28.13,TL,,0,0,0,,开场第一个发球局
Dialogue: 0,0:00:28.13,0:00:29.85,TL,,0,0,0,,她就被拖进{\fs78}6{\fs68}次平分
Dialogue: 0,0:00:29.85,0:00:30.98,TL,,0,0,0,,{\fs78}3{\fs68}个破发点
Dialogue: 0,0:00:30.98,0:00:32.64,TL,,0,0,0,,最后还是丢了
Dialogue: 0,0:00:32.64,0:00:34.70,TL,,0,0,0,,这一盘她的一发只有四成一
Dialogue: 0,0:00:34.70,0:00:36.34,TL,,0,0,0,,还送出{\fs78}4{\fs68}个双误
Dialogue: 0,0:00:39.55,0:00:41.66,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}3{\fs68}之后她连丢两局
Dialogue: 0,0:00:41.66,0:00:43.34,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}6{\fs68}丢掉首盘
Dialogue: 0,0:00:43.34,0:00:45.08,TL,,0,0,0,,用了{\fs78}56{\fs68}分钟
Dialogue: 0,0:00:45.08,0:00:47.88,TL,,0,0,0,,这一盘恰拉耶娃拿到{\fs78}7{\fs68}个破发点
Dialogue: 0,0:00:47.88,0:00:49.15,TL,,0,0,0,,兑现两个
Dialogue: 0,0:00:50.35,0:00:52.12,TL,,0,0,0,,第二盘开局又被破
Dialogue: 0,0:00:52.12,0:00:53.57,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}2{\fs68}落后
Dialogue: 0,0:00:53.57,0:00:56.26,TL,,0,0,0,,一盘一破 转播解说的原话是
Dialogue: 0,0:00:56.26,0:00:58.10,TL,,0,0,0,,她里外都是麻烦
Dialogue: 0,0:01:01.55,0:01:03.40,TL,,0,0,0,,然后她连赢{\fs78}5{\fs68}局
Dialogue: 0,0:01:03.40,0:01:06.23,TL,,0,0,0,,扳回来靠的不是突然发力 是接发
Dialogue: 0,0:01:06.23,0:01:09.42,TL,,0,0,0,,这一盘她接对方二发拿下七成的分
Dialogue: 0,0:01:12.95,0:01:15.87,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}2{\fs68}之后她的发球局又丢了一个
Dialogue: 0,0:01:15.87,0:01:18.05,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}4{\fs68} 第二盘还是回来了
Dialogue: 0,0:01:18.05,0:01:20.72,TL,,0,0,0,,这场球被她硬拽回了起点
Dialogue: 0,0:01:23.35,0:01:26.14,TL,,0,0,0,,决胜盘她一上来连下{\fs78}3{\fs68}局
Dialogue: 0,0:01:26.14,0:01:28.02,TL,,0,0,0,,第二局拿到{\fs78}4{\fs68}个破发点
Dialogue: 0,0:01:28.02,0:01:29.77,TL,,0,0,0,,破掉对手发球局
Dialogue: 0,0:01:29.77,0:01:31.24,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}0{\fs68} {\fs78}4{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:31.24,0:01:33.40,TL,,0,0,0,,看起来这场球要结束了
Dialogue: 0,0:01:37.05,0:01:38.78,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68} 轮到她发球
Dialogue: 0,0:01:38.78,0:01:39.92,TL,,0,0,0,,赢下这一局
Dialogue: 0,0:01:39.92,0:01:41.81,TL,,0,0,0,,这场球就结束了
Dialogue: 0,0:01:41.81,0:01:44.03,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}15{\fs68} 两个赛点
Dialogue: 0,0:01:44.03,0:01:45.80,TL,,0,0,0,,她一个都没拿下
Dialogue: 0,0:01:45.80,0:01:47.32,TL,,0,0,0,,解说在这一局里说
Dialogue: 0,0:01:47.32,0:01:48.88,TL,,0,0,0,,她看起来不像想赢
Dialogue: 0,0:01:48.88,0:01:50.44,TL,,0,0,0,,更像不想输
Dialogue: 0,0:01:52.65,0:01:55.04,TL,,0,0,0,,这一局她一共拿到{\fs78}7{\fs68}个赛点
Dialogue: 0,0:01:55.04,0:01:57.38,TL,,0,0,0,,恰拉耶娃救下了前{\fs78}6{\fs68}个
Dialogue: 0,0:01:57.38,0:01:59.95,TL,,0,0,0,,中间恰拉耶娃{\fs78}3{\fs68}次拿到破发点
Dialogue: 0,0:01:59.95,0:02:01.86,TL,,0,0,0,,也全被她挡了回去
Dialogue: 0,0:02:04.35,0:02:05.87,TL,,0,0,0,,两小时{\fs78}47{\fs68}分
Dialogue: 0,0:02:05.87,0:02:08.31,TL,,0,0,0,,{\fs78}207{\fs68}分她只多拿七分
Dialogue: 0,0:02:08.31,0:02:10.17,TL,,0,0,0,,这样熬下来的一场胜利
Dialogue: 0,0:02:10.17,0:02:11.93,TL,,0,0,0,,算好还是不算？
