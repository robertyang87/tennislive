      "request_id": "dc132ba02615f0dc5a3a8eace264bebd2ac3a32da5c5fc6a286f1de687510177",
      "request": {
        "backend": "edge",
        "cache_key": "d82e29097adc87101dbe6d4d4321e928",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "迈阿密半决赛，萨巴伦卡再次让她止步。四月的斯图加特，她先挽救两个赛点过关，最终在决赛击败穆霍娃。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "58cf74fdfa0d85307cc06a9a991d75c31ce8712d183b7d73dd35de20f12d7f87",
      "words_sha256": "2774db0513b706ab7592f42301a231ecf3be2e8a5de1908b22a9f640fe0dc5ca"
    },
    {
      "id": "bundle:dea83931b1596da74898d0c4e365b069089b7c6ab74eab27321e4bb1e732bdce",
      "request_id": "dea83931b1596da74898d0c4e365b069089b7c6ab74eab27321e4bb1e732bdce",
      "request": {
        "backend": "edge",
        "cache_key": "9870dc93a4bab0eb0122dfcde9aeabb8",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "去年，宁波夺冠后，她在东京赶上年终末班车。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "260c7f6f4a4b866e5a4fd9142ca9ef54cd93e988f60dc38755d4c4f86a468380",
      "words_sha256": "4586cdf216824b640c7c9b866ee5140abfea612590a89b514ade6212adbee23d"
    },
    {
