      "id": "bundle:b8f065b4dd599bcf63777946970e59d86a6edf9f0db427e4a1c6de5c2316daeb",
      "request_id": "b8f065b4dd599bcf63777946970e59d86a6edf9f0db427e4a1c6de5c2316daeb",
      "request": {
        "backend": "edge",
        "cache_key": "96acbe7d34bb6109d944edcb47f14f8b",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "随后五战全胜，在利雅得封后。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "080891d6dd39707dceeef55c5dd8a1181cd2847358c962c03270db625f0a691a",
