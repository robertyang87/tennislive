        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第一个赛点，她直接拿下。五十分钟，小组赛两连胜。",
        "voice": "zh-CN-YunjianNeural"
