        "cache_key": "13e56ae262b566785eded3dbcdc54e34",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "六比二、六比零。来到赛点局，她已经连赢七局。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
