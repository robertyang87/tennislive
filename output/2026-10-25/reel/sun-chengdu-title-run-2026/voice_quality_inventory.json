        "cache_key": "52a0aa72f0615ee3ad258263a3f10e70",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第一盘一比三落后，孙心然叫了医疗暂停。右膝缠上绷带，她重新站回底线。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_04.mp3",
      "audio_sha256": "04dc34a42f642b4fe1c37e898d0d24733f58f216c541c8ccfcab9f5b902af59b",
      "words_sha256": "a5ca887e8b356e2c8e0aab552bc9ee6950b7cdcc2dbc7297bd85b20726cdabc3",
