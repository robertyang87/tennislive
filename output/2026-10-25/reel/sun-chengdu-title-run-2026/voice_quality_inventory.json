      "audio_sha256": "56ac03a275c522797024ac644fc668adebd1cd6cb8637ebd9409691aa82dcc21",
      "words_sha256": "163ab4a7fb9044937745f25f8ea57af233232c983c74839f417ea2d14aa6632c",
      "words_path": "voice_28.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "f9013916e7e596b9be67b948d66881c2",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第三盘五比一，冠军只剩最后一局。她走向发球线，深吸一口气。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_32.mp3",
      "audio_sha256": "2aea1b19a3a85099ccdc628595b22be244efa386836f2ee6e970040caa5f68f2",
      "words_sha256": "6ff1c9ec866e02f6d3754f29986c94910fc039ed709cb9822be37e881efffde6",
      "words_path": "voice_32.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "1fa5f868ac37e61d995319938d21d5d4",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "她说，不要放弃坚持下来，我相信我一定可以。十六岁，五战全胜，年终世界第一。下一站广州——成人赛场，她能把这股劲带到哪儿？",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_cover.mp3",
      "audio_sha256": "edefb949cde8f9857d83b452f7a355241e0ba16e9977a2a147ef6853248d3357",
