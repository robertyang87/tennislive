        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "不要放弃坚持下来，我相信我一定可以。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_outro.mp3",
