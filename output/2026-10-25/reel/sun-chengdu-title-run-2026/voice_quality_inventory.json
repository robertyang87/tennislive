      "request": {
        "backend": "edge",
        "cache_key": "dffeaa9f0e183b46026adb2aedbdcb5c",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "暂停回来，她连破带保追平比分，又把第一盘拖进了抢七。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_07.mp3",
      "audio_sha256": "774288dddf402d7684cbd76ef8dbec16b92559e66f6e6ed0fd4d89350a7325be",
      "words_sha256": "18a5396445d570f38f267608ab9003205a15052cd6feb53419ddff29b1a48c55",
      "words_path": "voice_07.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "9a4511bfe561ae719dd1266c39ac4f88",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第二场，只用了五十分钟。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_08.mp3",
      "audio_sha256": "e2953d1b8c8b2c500aba374f32be7f3278633182d13a96ab56b3f67ae117561d",
      "words_sha256": "d4f81a7c672780355110ad47b2e49ba8c215c36bfe1211ce2377f28b6ac8806e",
