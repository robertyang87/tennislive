        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "第一盘六比三，只用了不到半小时。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
