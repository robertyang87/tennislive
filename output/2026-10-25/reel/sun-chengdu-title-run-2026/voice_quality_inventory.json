        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "半决赛，她更快了。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
