        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "首战，她一度一比四落后。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_03.mp3",
      "audio_sha256": "149ad420374b13374735798ce89b3253dc21b22553c0139ae6eeb35f4586c81f",
      "words_sha256": "94a9155a73883d460651395f6f7da2b7a323a8bb1346f119240e697f4503bec6",
