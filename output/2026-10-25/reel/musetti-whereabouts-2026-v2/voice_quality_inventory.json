      "words_sha256": "56b21ac7c3dcd0280f5e39493a9b8234e185be176481d4df529bdab3d9f8ae98",
      "words_path": "voice_05.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "e6c721a5202a348dfa0a2c732008de4d",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "督导同意了。一个闹钟，为什么这么要紧？",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_06.mp3",
      "audio_sha256": "cbe850d37348f662d545b6f944bd87d0a6563fe84173852fc51adb7591dabdd8",
      "words_sha256": "13383027b85e1ac2a488a25819d543500657a51865f09b1a7706799ec1d19687",
      "words_path": "voice_06.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "ab2c7c80301ee8f2c78759db9dc049b0",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "世界排名前一百的单打球员，都在国际网球诚信机构的，注册检查库里。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_07.mp3",
      "audio_sha256": "5bbdc6f48571a85c56530a4400771534ab616e59473d5319102ab7e84ef69c5e",
      "words_sha256": "7aed000e466db84c40bf49839eaff761bcbe2c0e9d99cac261b023f650c0ba19",
      "words_path": "voice_07.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "d239bffb62054c961f2c47418b35fd73",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "他们要申报每一天的行踪：晚上住在哪儿，再留出一个六十分钟的时段，检查员上门得找得到人。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_08.mp3",
      "audio_sha256": "05eaf737fd9d062e8c7316c2d1a9affd297c8a458bd89bc382463d2ca5036648",
      "words_sha256": "003949c0d161d130bdc50fe795e10b529eeaa004f30e499e2d75ca8d3a9c7857",
      "words_path": "voice_08.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "7a97ea98c44b99b28fb2298fc08534aa",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "这个时段，只能定在早上五点到晚上十一点之间。比赛期间，还可以不报。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_09.mp3",
      "audio_sha256": "b470ce036b5053b1e7cbc91013d8aac721152cb6c3cb3f46bcbd8555a347b8b3",
      "words_sha256": "302f0516282ff10413c6cdcca4cf5a6c7d841ef50b652ebad37a554db75b94fb",
      "words_path": "voice_09.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "678f032ea7acf5745a1fcb2749dd7da3",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "检查员找不到人，算错过检查；行踪没报或报错，算申报失误。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_10.mp3",
      "audio_sha256": "ad2ba84ea2ef844fed4397a761c52e3e512cddddd2ce5fa9bc8bee8aef7d9c77",
      "words_sha256": "0c66824b8a280ab500919b74d1a34cde48928d4c5fa2bad3f8ba81d14e77323c",
      "words_path": "voice_10.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "32a38707ad4d94b01cfc0d7ec3f5d003",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "十二个月内，两种加起来满三次，就构成违规。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_11.mp3",
      "audio_sha256": "19c11737500a5144cc91bcffaeced4ab44041c3d93b04dc190adabfcdbaa14b5",
      "words_sha256": "991b47591413a06f27fb246b3ebf8e243017d7f2c2a0839631c912f933d6b305",
      "words_path": "voice_11.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "4cfc374dad16eee7ebba2a49c5fee6d3",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "第一次违规，禁赛两年，视过错程度，最少减到一年。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_12.mp3",
      "audio_sha256": "bdcfab10a527f5ced65ae97dcec600e8e7958cba63a1a826a02e5e6865112dc0",
      "words_sha256": "ab0de6bef0320f7367080b838de38c3b51e86bfc3010d2fcd0c3c52771d84525",
      "words_path": "voice_12.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "1e22d900595994076fdaacc44782efc3",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "那凌晨一点的闹钟，是怎么定的？多家媒体说，他把时段报在了凌晨一点，可这和规则对不上。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_13.mp3",
      "audio_sha256": "e70e0705157845cf2afacde6de98d3a538553edb89f34154428c78838d5bd438",
      "words_sha256": "46078fa66c88663b06f1d27e447cac793ba1da531466936469585d32270c8cc2",
      "words_path": "voice_13.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "a6144176d801897a1c9703241d3ab6ea",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "他本人只说了一句：闹钟设在凌晨一点。具体为什么，他没有解释。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_14.mp3",
      "audio_sha256": "a56775d0ed790990b7fcd945d9e91b2e103f4de3426d49bd97da3625c4478d26",
      "words_sha256": "18e65100fb9866efd0e282f0c532080cd469b4dd0011ce240a1f9fd74328ded1",
      "words_path": "voice_14.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "6fcf62b1412c17ea663e34e310117490",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "所以，他宁可在场上先把行踪改了。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_15.mp3",
      "audio_sha256": "dd91ff1278dba2bfd385f075e1187134a45e41a128920aa0efabc675d3917cd3",
      "words_sha256": "d3b897f67c66a2d5ff8e7b63b94771648c4556580e1ea070106de44cd60381b2",
      "words_path": "voice_15.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "d7cd5bb27e26f74b6971aa841fe968c0",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "凌晨一点多，穆塞蒂六比四拿下决胜盘，整场打了三个半小时。凌晨一点还查药检，太严了吗？评论区说说。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_cover.mp3",
      "audio_sha256": "b1d59b9d0e27e36d4e7bbeb6a7bcc60677a2c51d607d1fe2f177b4e63d21d084",
      "words_sha256": "cf2a076b7a33fc3bc2560ba66b9b54c7f222822e3011105989709b43f23b9fe0",
      "words_path": "voice_cover.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "b3952a7b94b57fbb66a5ae3873131df5",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "凌晨一点，比赛打到一半，他为什么要掏手机？",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_outro.mp3",
      "audio_sha256": "a3eb831710b1f9f1a5809b4d507b346caaa8a407fa447616d03486e7493d0679",
      "words_sha256": "74d567be7f7803b20932324ddb499c26d9b44b49f356f71996592439089032e6",
      "words_path": "voice_outro.words.json",
