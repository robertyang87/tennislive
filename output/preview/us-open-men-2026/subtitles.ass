Dialogue: 0,0:00:00.17,0:00:01.81,TL,,0,0,0,,世界第{\fs78}1{\fs68}辛纳退出
Dialogue: 0,0:00:01.81,0:00:04.22,TL,,0,0,0,,美网突然失去最稳的答案
Dialogue: 0,0:00:07.98,0:00:11.01,TL,,0,0,0,,可奖杯并没有自动递给阿尔卡拉斯
Dialogue: 0,0:00:14.70,0:00:17.22,TL,,0,0,0,,他当然仍是上限最高的人
Dialogue: 0,0:00:20.98,0:00:22.82,TL,,0,0,0,,但他{\fs78}4{\fs68}个月没有正式比赛
Dialogue: 0,0:00:22.82,0:00:24.54,TL,,0,0,0,,右腕刚刚伤愈
Dialogue: 0,0:00:24.54,0:00:25.67,TL,,0,0,0,,最强的上限
Dialogue: 0,0:00:25.67,0:00:28.11,TL,,0,0,0,,偏偏撞上{\fs78}4{\fs68}个月的比赛荒
Dialogue: 0,0:00:30.98,0:00:32.09,TL,,0,0,0,,北美零热身
Dialogue: 0,0:00:32.09,0:00:33.69,TL,,0,0,0,,直接回纽约
Dialogue: 0,0:00:33.69,0:00:34.94,TL,,0,0,0,,第一周不是赶路
Dialogue: 0,0:00:34.94,0:00:36.71,TL,,0,0,0,,是一次{\fs78}5{\fs68}盘体检
Dialogue: 0,0:00:38.48,0:00:40.87,TL,,0,0,0,,德约科维奇的{\fs78}24{\fs68}座大满贯
Dialogue: 0,0:00:40.87,0:00:43.01,TL,,0,0,0,,仍是最可怕的底牌
Dialogue: 0,0:00:46.78,0:00:49.12,TL,,0,0,0,,可他只热身一场 身体不适
Dialogue: 0,0:00:49.12,0:00:51.15,TL,,0,0,0,,第一战就{\fs78}3{\fs68}盘出局
Dialogue: 0,0:00:54.12,0:00:56.59,TL,,0,0,0,,兹维列夫今年终于拿下法网
Dialogue: 0,0:00:56.59,0:00:58.48,TL,,0,0,0,,可到了北美 手握赛点
Dialogue: 0,0:00:58.48,0:01:00.57,TL,,0,0,0,,还是被保罗翻了过去
Dialogue: 0,0:01:02.16,0:01:04.19,TL,,0,0,0,,梅德韦杰夫也一样
Dialogue: 0,0:01:04.19,0:01:05.66,TL,,0,0,0,,{\fs78}3{\fs68}个赛点没收下
Dialogue: 0,0:01:05.66,0:01:07.11,TL,,0,0,0,,反被中岛逆转
Dialogue: 0,0:01:07.11,0:01:08.67,TL,,0,0,0,,最熟悉纽约的人
Dialogue: 0,0:01:08.67,0:01:10.46,TL,,0,0,0,,如今最难预测
Dialogue: 0,0:01:13.46,0:01:16.42,TL,,0,0,0,,真正不能漏掉的 是美国人
Dialogue: 0,0:01:16.42,0:01:19.09,TL,,0,0,0,,弗里茨刚拿下华盛顿冠军
Dialogue: 0,0:01:22.16,0:01:25.80,TL,,0,0,0,,两年前 他已站上美网决赛场 发球
Dialogue: 0,0:01:25.80,0:01:27.45,TL,,0,0,0,,反拍 {\fs78}5{\fs68}盘耐心
Dialogue: 0,0:01:27.45,0:01:29.12,TL,,0,0,0,,他绝不是陪跑
Dialogue: 0,0:01:32.16,0:01:35.18,TL,,0,0,0,,谢尔顿在蒙特利尔一盘未丢地卫冕
Dialogue: 0,0:01:35.18,0:01:37.63,TL,,0,0,0,,发球和气势都在往上走
Dialogue: 0,0:01:41.16,0:01:44.31,TL,,0,0,0,,可{\fs78}3{\fs68}天后 他在辛辛那提首战出局
Dialogue: 0,0:01:44.31,0:01:46.44,TL,,0,0,0,,状态又被拉回问号
Dialogue: 0,0:01:47.76,0:01:49.42,TL,,0,0,0,,再加蒙特利尔亚军
Dialogue: 0,0:01:49.42,0:01:52.64,TL,,0,0,0,,辛辛那提又掀翻梅德韦杰夫的中岛
Dialogue: 0,0:01:52.64,0:01:53.82,TL,,0,0,0,,美国人的机会
Dialogue: 0,0:01:53.82,0:01:55.56,TL,,0,0,0,,从来不只一条
Dialogue: 0,0:01:57.06,0:01:58.72,TL,,0,0,0,,门还在继续开
Dialogue: 0,0:01:58.72,0:02:01.15,TL,,0,0,0,,菲斯今年{\fs78}5{\fs68}次进大师赛八强
Dialogue: 0,0:02:01.15,0:02:03.62,TL,,0,0,0,,辛辛那提已经杀进四强
Dialogue: 0,0:02:05.76,0:02:07.75,TL,,0,0,0,,科博利也进了四强
Dialogue: 0,0:02:07.75,0:02:08.78,TL,,0,0,0,,两个年轻人
Dialogue: 0,0:02:08.78,0:02:09.97,TL,,0,0,0,,不是未来时
Dialogue: 0,0:02:09.97,0:02:11.73,TL,,0,0,0,,已经是现在时
Dialogue: 0,0:02:14.76,0:02:16.22,TL,,0,0,0,,{\fs78}19{\fs68}岁的霍达尔
Dialogue: 0,0:02:16.22,0:02:17.45,TL,,0,0,0,,华盛顿决赛
Dialogue: 0,0:02:17.45,0:02:19.03,TL,,0,0,0,,蒙特利尔四强
Dialogue: 0,0:02:19.03,0:02:21.01,TL,,0,0,0,,两年前的青少年冠军
Dialogue: 0,0:02:21.01,0:02:23.33,TL,,0,0,0,,这次第一次打男单正赛
Dialogue: 0,0:02:24.76,0:02:26.67,TL,,0,0,0,,后面还有丰塞卡
Dialogue: 0,0:02:26.67,0:02:27.73,TL,,0,0,0,,名字越往后
Dialogue: 0,0:02:27.73,0:02:30.37,TL,,0,0,0,,争冠版图里的雷反而越密
Dialogue: 0,0:02:34.11,0:02:36.78,TL,,0,0,0,,所以第一选择仍是阿尔卡拉斯
Dialogue: 0,0:02:36.78,0:02:39.54,TL,,0,0,0,,前提是右腕扛过第一周
Dialogue: 0,0:02:42.76,0:02:45.93,TL,,0,0,0,,第二集团 弗里茨先站在最前面
Dialogue: 0,0:02:48.76,0:02:50.21,TL,,0,0,0,,谢尔顿上限够高
Dialogue: 0,0:02:50.21,0:02:52.26,TL,,0,0,0,,状态却最难押
Dialogue: 0,0:02:54.76,0:02:56.54,TL,,0,0,0,,兹维列夫仍在这一档
Dialogue: 0,0:02:56.54,0:02:58.67,TL,,0,0,0,,关键分却不能再掉
Dialogue: 0,0:03:00.76,0:03:02.85,TL,,0,0,0,,黑马先看菲斯
Dialogue: 0,0:03:02.85,0:03:05.55,TL,,0,0,0,,可最后的问题只有一个 纽约
Dialogue: 0,0:03:05.55,0:03:08.67,TL,,0,0,0,,会不会属于一个从未捧过大满贯的
Dialogue: 0,0:03:08.67,0:03:09.45,TL,,0,0,0,,人？
