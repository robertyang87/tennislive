Dialogue: 0,0:00:04.31,0:00:05.83,TL,,0,0,0,,总决赛还没开打
Dialogue: 0,0:00:05.83,0:00:07.76,TL,,0,0,0,,卫冕冠军先退了赛
Dialogue: 0,0:00:07.76,0:00:10.64,TL,,0,0,0,,周五的媒体日 {\fs78}8{\fs68}位正选到了{\fs78}7{\fs68}位
Dialogue: 0,0:00:10.64,0:00:12.35,TL,,0,0,0,,唯独莱巴金娜缺席
Dialogue: 0,0:00:12.35,0:00:14.47,TL,,0,0,0,,赛事方给的口径只有{\fs78}4{\fs68}个字
Dialogue: 0,0:00:14.47,0:00:16.33,TL,,0,0,0,,身体不适 周六
Dialogue: 0,0:00:16.33,0:00:18.03,TL,,0,0,0,,当地时间上午 {\fs78}11{\fs68} 点多
Dialogue: 0,0:00:18.03,0:00:20.46,TL,,0,0,0,,官宣来了 因为病毒性疾病
Dialogue: 0,0:00:20.46,0:00:23.03,TL,,0,0,0,,莱巴金娜退出本届总决赛
Dialogue: 0,0:00:23.03,0:00:25.86,TL,,0,0,0,,她是年终世界第{\fs78}1{\fs68} 也是卫冕冠军
Dialogue: 0,0:00:25.86,0:00:27.34,TL,,0,0,0,,这是 {\fs78}2021{\fs68} 年以来
Dialogue: 0,0:00:27.34,0:00:30.15,TL,,0,0,0,,现任世界第{\fs78}1{\fs68}第一次缺席总决赛
Dialogue: 0,0:00:30.15,0:00:32.98,TL,,0,0,0,,她留下一句话 这个赛季很不可思议
Dialogue: 0,0:00:32.98,0:00:35.51,TL,,0,0,0,,但我的身体还没准备好比赛
Dialogue: 0,0:00:35.51,0:00:37.05,TL,,0,0,0,,揭幕战就在明天
Dialogue: 0,0:00:37.05,0:00:40.02,TL,,0,0,0,,对手诺斯科娃已经站在那里了
Dialogue: 0,0:00:40.02,0:00:43.33,TL,,0,0,0,,问题来了 这一场 谁来打？
Dialogue: 0,0:00:49.31,0:00:51.97,TL,,0,0,0,,顶上来的人 叫科斯秋克
Dialogue: 0,0:00:51.97,0:00:53.79,TL,,0,0,0,,{\fs78}3{\fs68}天前我们刚讲过她
Dialogue: 0,0:00:53.79,0:00:55.60,TL,,0,0,0,,全年竞逐榜排第十
Dialogue: 0,0:00:55.60,0:00:57.98,TL,,0,0,0,,冠军保留席把门槛抬高之后
Dialogue: 0,0:00:57.98,0:00:59.92,TL,,0,0,0,,她得连赢两站才够格
Dialogue: 0,0:00:59.92,0:01:01.77,TL,,0,0,0,,门关得严严实实
Dialogue: 0,0:01:01.77,0:01:03.86,TL,,0,0,0,,可谁也没想到 {\fs78}3{\fs68}天前
Dialogue: 0,0:01:03.86,0:01:05.37,TL,,0,0,0,,门在她面前关上
Dialogue: 0,0:01:05.37,0:01:07.81,TL,,0,0,0,,{\fs78}3{\fs68}天后 门从里面开了
Dialogue: 0,0:01:07.81,0:01:10.10,TL,,0,0,0,,科斯秋克是本届的第一替补
Dialogue: 0,0:01:10.10,0:01:13.08,TL,,0,0,0,,人早就到了印第安维尔斯现场待命
Dialogue: 0,0:01:13.08,0:01:15.86,TL,,0,0,0,,莱巴金娜一退 她直接顶进签表
Dialogue: 0,0:01:15.86,0:01:18.85,TL,,0,0,0,,揭幕战 由她来打诺斯科娃
Dialogue: 0,0:01:21.31,0:01:24.05,TL,,0,0,0,,先说结论 可能颠覆很多人的印象
Dialogue: 0,0:01:24.05,0:01:26.47,TL,,0,0,0,,科斯秋克不是来凑数的
Dialogue: 0,0:01:26.47,0:01:28.31,TL,,0,0,0,,因为她顶进来的时候
Dialogue: 0,0:01:28.31,0:01:30.73,TL,,0,0,0,,莱巴金娜一场比赛都还没打
Dialogue: 0,0:01:30.73,0:01:32.90,TL,,0,0,0,,她不需要接盘任何人的战绩
Dialogue: 0,0:01:32.90,0:01:35.89,TL,,0,0,0,,她是满格入场 {\fs78}3{\fs68}场小组赛一场不少
Dialogue: 0,0:01:35.89,0:01:39.05,TL,,0,0,0,,积分 奖金全按正选口径算
Dialogue: 0,0:01:39.05,0:01:41.45,TL,,0,0,0,,换句话说 全年排第十的她
Dialogue: 0,0:01:41.45,0:01:44.01,TL,,0,0,0,,捧起这座总决赛奖杯的通道
Dialogue: 0,0:01:44.01,0:01:46.54,TL,,0,0,0,,在规则上是真实敞开的
Dialogue: 0,0:01:46.54,0:01:49.06,TL,,0,0,0,,至于大家印象里那句 替补没戏
Dialogue: 0,0:01:49.06,0:01:50.92,TL,,0,0,0,,那说的是另一种替补
Dialogue: 0,0:01:50.92,0:01:52.99,TL,,0,0,0,,半路顶进来的那一种
Dialogue: 0,0:01:52.99,0:01:55.08,TL,,0,0,0,,两种替补命运完全不一样
Dialogue: 0,0:01:55.08,0:01:58.15,TL,,0,0,0,,分水岭 就是顶进来的时间点
Dialogue: 0,0:02:03.31,0:02:05.56,TL,,0,0,0,,先看替补是怎么定的
Dialogue: 0,0:02:05.56,0:02:06.83,TL,,0,0,0,,不是临时抓人
Dialogue: 0,0:02:06.83,0:02:10.37,TL,,0,0,0,,是赛季竞逐收官时按顺位预先点名
Dialogue: 0,0:02:10.37,0:02:12.08,TL,,0,0,0,,人在现场待命
Dialogue: 0,0:02:12.08,0:02:14.04,TL,,0,0,0,,{\fs78}WTA{\fs68} 设两名替补
Dialogue: 0,0:02:14.04,0:02:16.01,TL,,0,0,0,,先看第八到第{\fs78}20{\fs68}名里
Dialogue: 0,0:02:16.01,0:02:18.81,TL,,0,0,0,,有没有第二位当年的大满贯冠军排队
Dialogue: 0,0:02:18.81,0:02:21.42,TL,,0,0,0,,没有 才纯按顺位往下
Dialogue: 0,0:02:21.42,0:02:24.07,TL,,0,0,0,,今年排第九的斯瓦泰克赛季已经结束
Dialogue: 0,0:02:24.07,0:02:24.86,TL,,0,0,0,,明确不来
Dialogue: 0,0:02:24.86,0:02:27.10,TL,,0,0,0,,顺位就落到第十的科斯秋克和
Dialogue: 0,0:02:27.10,0:02:29.45,TL,,0,0,0,,第{\fs78}11{\fs68}的施耐德 记住
Dialogue: 0,0:02:29.45,0:02:31.15,TL,,0,0,0,,替补必须本人到场
Dialogue: 0,0:02:31.15,0:02:33.13,TL,,0,0,0,,整个小组赛阶段随叫随到
Dialogue: 0,0:02:33.13,0:02:35.46,TL,,0,0,0,,不来 就等于放弃排队
Dialogue: 0,0:02:35.46,0:02:37.13,TL,,0,0,0,,科斯秋克顶进去之后
Dialogue: 0,0:02:37.13,0:02:39.85,TL,,0,0,0,,替补席顺延一位 施耐德接上班
Dialogue: 0,0:02:39.85,0:02:41.77,TL,,0,0,0,,后面还排着约维奇
Dialogue: 0,0:02:41.77,0:02:43.18,TL,,0,0,0,,{\fs78}ATP{\fs68} 那边更严
Dialogue: 0,0:02:43.18,0:02:44.98,TL,,0,0,0,,官方只指定一名替补
Dialogue: 0,0:02:44.98,0:02:46.38,TL,,0,0,0,,规则书原文写明
Dialogue: 0,0:02:46.38,0:02:48.40,TL,,0,0,0,,必须出席赛前媒体发布会
Dialogue: 0,0:02:48.40,0:02:51.34,TL,,0,0,0,,待命一直持续到最后一场小组赛开打
Dialogue: 0,0:02:51.34,0:02:54.35,TL,,0,0,0,,今年都灵的那个人 是德米纳尔
Dialogue: 0,0:03:00.31,0:03:03.02,TL,,0,0,0,,替补什么时候顶进来 分三种情况
Dialogue: 0,0:03:03.02,0:03:06.35,TL,,0,0,0,,这条时间线是今天最关键的一张图
Dialogue: 0,0:03:06.35,0:03:08.37,TL,,0,0,0,,第一种 首战之前顶入
Dialogue: 0,0:03:08.37,0:03:11.32,TL,,0,0,0,,就是科斯秋克这一种 满格正选
Dialogue: 0,0:03:11.32,0:03:14.48,TL,,0,0,0,,打满{\fs78}3{\fs68}场 从零攒自己的战绩
Dialogue: 0,0:03:14.48,0:03:17.52,TL,,0,0,0,,第二种 已经打了一两场才有人退出
Dialogue: 0,0:03:17.52,0:03:20.14,TL,,0,0,0,,替补继承的只是席位和赛程
Dialogue: 0,0:03:20.14,0:03:21.06,TL,,0,0,0,,不是战绩
Dialogue: 0,0:03:21.06,0:03:23.36,TL,,0,0,0,,退赛者打完的比赛全部保留
Dialogue: 0,0:03:23.36,0:03:25.03,TL,,0,0,0,,她从 {\fs78}0{\fs68} 胜 {\fs78}0{\fs68} 负起步
Dialogue: 0,0:03:25.03,0:03:26.91,TL,,0,0,0,,只打剩下的场次
Dialogue: 0,0:03:26.91,0:03:29.56,TL,,0,0,0,,第三种 只剩最后一场小组赛
Dialogue: 0,0:03:29.56,0:03:32.51,TL,,0,0,0,,照样能换人 {\fs78}2024{\fs68} 年的卡萨金娜
Dialogue: 0,0:03:32.51,0:03:34.44,TL,,0,0,0,,{\fs78}2023{\fs68} 年的胡尔卡奇
Dialogue: 0,0:03:34.44,0:03:36.31,TL,,0,0,0,,都只打了一场
Dialogue: 0,0:03:41.31,0:03:42.63,TL,,0,0,0,,但有一条硬线
Dialogue: 0,0:03:42.63,0:03:44.58,TL,,0,0,0,,半决赛开始就不再递补
Dialogue: 0,0:03:44.58,0:03:47.54,TL,,0,0,0,,谁退赛 对手直接轮空晋级
Dialogue: 0,0:03:47.54,0:03:49.58,TL,,0,0,0,,还有个最容易讲错的点
Dialogue: 0,0:03:49.58,0:03:52.38,TL,,0,0,0,,比赛中退赛 不等于退出赛事
Dialogue: 0,0:03:52.38,0:03:55.04,TL,,0,0,0,,丢掉一场 人留在赛事里继续打
Dialogue: 0,0:03:55.04,0:03:55.94,TL,,0,0,0,,替补不上
Dialogue: 0,0:03:55.94,0:03:59.02,TL,,0,0,0,,只有正式退出整个赛事 递补才触发
Dialogue: 0,0:03:59.02,0:04:01.73,TL,,0,0,0,,而且退了 就不能再回来
Dialogue: 0,0:04:04.31,0:04:05.51,TL,,0,0,0,,再说钱
Dialogue: 0,0:04:05.51,0:04:07.67,TL,,0,0,0,,替补这个身份本身就值钱
Dialogue: 0,0:04:07.67,0:04:09.93,TL,,0,0,0,,{\fs78}WTA{\fs68} 的替补费是 {\fs78}10{\fs68} 万美元
Dialogue: 0,0:04:09.93,0:04:12.12,TL,,0,0,0,,一场没打 坐在场边也能领
Dialogue: 0,0:04:12.12,0:04:13.08,TL,,0,0,0,,真上了场
Dialogue: 0,0:04:13.08,0:04:15.38,TL,,0,0,0,,参赛费和胜场奖金按自己打过
Dialogue: 0,0:04:15.38,0:04:17.72,TL,,0,0,0,,的场次另算 小组赛每赢一场
Dialogue: 0,0:04:17.72,0:04:20.62,TL,,0,0,0,,再加 {\fs78}23{\fs68} 万美元和 {\fs78}200{\fs68} 分
Dialogue: 0,0:04:20.62,0:04:23.11,TL,,0,0,0,,科斯秋克按正选口径走到底
Dialogue: 0,0:04:23.11,0:04:24.98,TL,,0,0,0,,{\fs78}3{\fs68}场全胜夺冠的话
Dialogue: 0,0:04:24.98,0:04:28.21,TL,,0,0,0,,奖金路径和任何正选完全一样
Dialogue: 0,0:04:32.31,0:04:34.11,TL,,0,0,0,,但赛中顶入的替补
Dialogue: 0,0:04:34.11,0:04:36.49,TL,,0,0,0,,面前有一堵数学的墙
Dialogue: 0,0:04:36.49,0:04:38.15,TL,,0,0,0,,小组排名先比胜场
Dialogue: 0,0:04:38.15,0:04:41.07,TL,,0,0,0,,再比一个冷门指标 已赛场次
Dialogue: 0,0:04:41.07,0:04:43.45,TL,,0,0,0,,同为两胜 打满{\fs78}3{\fs68}场的人
Dialogue: 0,0:04:43.45,0:04:45.48,TL,,0,0,0,,排在只打两场的人前面
Dialogue: 0,0:04:45.48,0:04:46.77,TL,,0,0,0,,{\fs78}3{\fs68}个人同胜场
Dialogue: 0,0:04:46.77,0:04:49.82,TL,,0,0,0,,没打满{\fs78}3{\fs68}场的 直接先出局
Dialogue: 0,0:04:49.82,0:04:53.08,TL,,0,0,0,,也就是说 半路顶进来的人哪怕全赢
Dialogue: 0,0:04:53.08,0:04:55.39,TL,,0,0,0,,也几乎总被 场次 这一条压住
Dialogue: 0,0:04:55.39,0:04:57.43,TL,,0,0,0,,出不了线 不是实力问题
Dialogue: 0,0:04:57.43,0:04:59.38,TL,,0,0,0,,是规则砌的墙
Dialogue: 0,0:05:02.31,0:05:05.39,TL,,0,0,0,,历史把这条分界线划得清清楚楚
Dialogue: 0,0:05:05.39,0:05:07.05,TL,,0,0,0,,赛前顶入的替补
Dialogue: 0,0:05:07.05,0:05:10.01,TL,,0,0,0,,能走多远只看实力 {\fs78}2018{\fs68} 年
Dialogue: 0,0:05:10.01,0:05:12.31,TL,,0,0,0,,贝尔腾斯赛前顶替哈勒普
Dialogue: 0,0:05:12.31,0:05:14.30,TL,,0,0,0,,{\fs78}2{\fs68}胜{\fs78}1{\fs68}负打进四强
Dialogue: 0,0:05:14.30,0:05:15.82,TL,,0,0,0,,而赛中顶入的
Dialogue: 0,0:05:15.82,0:05:17.84,TL,,0,0,0,,至今没有一个人进过四强
Dialogue: 0,0:05:17.84,0:05:19.65,TL,,0,0,0,,上限就是赢一场
Dialogue: 0,0:05:19.65,0:05:22.48,TL,,0,0,0,,{\fs78}2011{\fs68} 年 巴托丽只打最后一场
Dialogue: 0,0:05:22.48,0:05:25.51,TL,,0,0,0,,赢了阿扎伦卡 照样小组第四出局
Dialogue: 0,0:05:25.51,0:05:28.22,TL,,0,0,0,,那堵数学的墙 她第一个撞上
Dialogue: 0,0:05:28.22,0:05:29.24,TL,,0,0,0,,{\fs78}2021{\fs68} 年
Dialogue: 0,0:05:29.24,0:05:31.23,TL,,0,0,0,,辛纳顶替受伤的贝雷蒂尼
Dialogue: 0,0:05:31.23,0:05:33.33,TL,,0,0,0,,开赛前四小时才接到通知
Dialogue: 0,0:05:33.33,0:05:35.32,TL,,0,0,0,,那天晚上横扫胡尔卡奇
Dialogue: 0,0:05:35.32,0:05:38.22,TL,,0,0,0,,还把梅德韦杰夫拖进决胜盘抢七
Dialogue: 0,0:05:38.22,0:05:40.48,TL,,0,0,0,,打出赛中替补最好看的一次
Dialogue: 0,0:05:40.48,0:05:42.53,TL,,0,0,0,,结果还是没出线
Dialogue: 0,0:05:47.31,0:05:48.96,TL,,0,0,0,,最仓促的是 {\fs78}2008{\fs68}
Dialogue: 0,0:05:48.96,0:05:51.46,TL,,0,0,0,,年的斯捷潘内克 世界第 {\fs78}27{\fs68}
Dialogue: 0,0:05:51.46,0:05:54.12,TL,,0,0,0,,正在泰国度假 排在他前面的 {\fs78}16{\fs68}
Dialogue: 0,0:05:54.12,0:05:56.47,TL,,0,0,0,,个人都拒绝来当替补
Dialogue: 0,0:05:56.47,0:05:57.62,TL,,0,0,0,,罗迪克一退赛
Dialogue: 0,0:05:57.62,0:05:59.99,TL,,0,0,0,,他飞到上海 装备卡在海关
Dialogue: 0,0:05:59.99,0:06:02.15,TL,,0,0,0,,最后借了德约科维奇的球拍
Dialogue: 0,0:06:02.15,0:06:05.16,TL,,0,0,0,,穆雷的袜子 上场打了费德勒
Dialogue: 0,0:06:09.31,0:06:12.35,TL,,0,0,0,,所以真正值得吵的 是另一个问题
Dialogue: 0,0:06:12.35,0:06:14.71,TL,,0,0,0,,半路顶上 只打一两场的人
Dialogue: 0,0:06:14.71,0:06:16.82,TL,,0,0,0,,该不该有出线的资格？
Dialogue: 0,0:06:16.82,0:06:18.11,TL,,0,0,0,,说 该 的理据是
Dialogue: 0,0:06:18.11,0:06:20.90,TL,,0,0,0,,替补是规则预先点名的正式角色
Dialogue: 0,0:06:20.90,0:06:23.69,TL,,0,0,0,,她赢下的每一分都是真打出来的
Dialogue: 0,0:06:23.69,0:06:25.12,TL,,0,0,0,,说 不该 的理据是
Dialogue: 0,0:06:25.12,0:06:27.52,TL,,0,0,0,,出线名额属于从头打满的人
Dialogue: 0,0:06:27.52,0:06:30.18,TL,,0,0,0,,只打一场就挤掉打满{\fs78}3{\fs68}场的人
Dialogue: 0,0:06:30.18,0:06:31.79,TL,,0,0,0,,对正选不公平
Dialogue: 0,0:06:31.79,0:06:34.51,TL,,0,0,0,,而现行规则给出的答案很微妙
Dialogue: 0,0:06:34.51,0:06:37.16,TL,,0,0,0,,资格 给 但用出线数学
Dialogue: 0,0:06:37.16,0:06:39.73,TL,,0,0,0,,把这条路压到几乎走不通
Dialogue: 0,0:06:39.73,0:06:40.94,TL,,0,0,0,,等于规则自己
Dialogue: 0,0:06:40.94,0:06:43.63,TL,,0,0,0,,把这场争论判了个折中
Dialogue: 0,0:06:47.31,0:06:49.04,TL,,0,0,0,,回到科斯秋克
Dialogue: 0,0:06:49.04,0:06:50.98,TL,,0,0,0,,她不属于 半路 的那一种
Dialogue: 0,0:06:50.98,0:06:52.38,TL,,0,0,0,,她是满格入场
Dialogue: 0,0:06:52.38,0:06:55.15,TL,,0,0,0,,和正选站在同一条起跑线上
Dialogue: 0,0:06:55.15,0:06:58.54,TL,,0,0,0,,{\fs78}3{\fs68}天前 她被总决赛的门槛挡在门外
Dialogue: 0,0:06:58.54,0:07:00.91,TL,,0,0,0,,{\fs78}3{\fs68}天后 她替世界第{\fs78}1{\fs68}的位置
Dialogue: 0,0:07:00.91,0:07:03.05,TL,,0,0,0,,站上了揭幕战的赛场
Dialogue: 0,0:07:03.05,0:07:05.03,TL,,0,0,0,,替补席从来不是观众席
Dialogue: 0,0:07:05.03,0:07:07.36,TL,,0,0,0,,它离冠军 只隔着一次退赛
Dialogue: 0,0:07:07.36,0:07:09.58,TL,,0,0,0,,和一条写在规则里的路
Dialogue: 0,0:07:09.58,0:07:11.27,TL,,0,0,0,,最后把问题留给你们
Dialogue: 0,0:07:11.27,0:07:13.11,TL,,0,0,0,,如果她真的一路赢下去
Dialogue: 0,0:07:13.11,0:07:14.52,TL,,0,0,0,,捧起这座奖杯
Dialogue: 0,0:07:14.52,0:07:16.93,TL,,0,0,0,,这座冠军 你认不认？
Dialogue: 0,0:07:16.93,0:07:18.84,TL,,0,0,0,,评论区站个队
