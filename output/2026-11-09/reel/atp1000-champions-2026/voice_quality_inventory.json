        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "他从零比四开始，一口气连拿七分。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_09.mp3",
      "audio_sha256": "8eb05333c34b0528571e218a10f87c922292c6d1173f903f495da48bf2bc5af7",
      "words_sha256": "27ea03858aea9490436aba9aeb068cf7c5c262c03e02423d4b29e5808457c4d1",
