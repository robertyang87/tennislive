        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "前五站的奖杯，全是同一个人举起来的。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_03.mp3",
      "audio_sha256": "bc00fc87eeb3c382e05dbd589c51453bc5d657d3263224161187613a371c8b7a",
      "words_sha256": "77651c6270dbafd5669c98e7f6716c82bbb6f49d4ea73ddc2e4d0438bbe1874d",
