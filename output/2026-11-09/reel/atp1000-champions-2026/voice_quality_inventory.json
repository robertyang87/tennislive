        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "一盘不丢的阳光双冠，男子第一人。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_13.mp3",
      "audio_sha256": "16fa97420769ce635db56af3ee4435bbc2fcb07cf20fd216620dbd76791ef91f",
      "words_sha256": "d877c2d3d01c3084c360f0d45fffe5b14cb15ffddf96f184465a369982043059",
