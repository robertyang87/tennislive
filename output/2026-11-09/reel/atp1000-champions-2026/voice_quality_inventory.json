        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "两周后，迈阿密。决赛中途两次雨停，每次都等了一个半小时。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_11.mp3",
      "audio_sha256": "db82f5bed6a7fe2adcaafbd4cb02e9c53369edb19c8f30f7fe02612b486230a4",
      "words_sha256": "37d05e2cf035755c79b5bb6bc22d0ef859a0101cbfa3470426fe679ccb2e0190",
