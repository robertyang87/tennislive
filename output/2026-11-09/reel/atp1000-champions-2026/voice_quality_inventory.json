      "audio_sha256": "1930cc6d10cf66afabb3b72def5c6500fb61740801285380f7914af6ae0bca22",
      "words_sha256": "53e6177e01e3c09b378e1e5fa5ddfd45b38a952e3e6e69b30167a1295a110c86",
      "words_path": "voice_04.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "1a5087ec0408c9d069f75c0ff9025102",
        "lead_pause": 0.0,
        "pitch": "+10Hz",
        "rate": "+18%",
        "style": "",
        "styledegree": "",
        "text": "第二盘又进抢七，梅德韦德夫一度四比零领先。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_05.mp3",
      "audio_sha256": "47114fa314901f43cb3f54bf48231da2b8b344ebb65e187c5aaf7db953f91a65",
      "words_sha256": "2effd6f77c25517003eb2620167bb066c47a4833a1273c671d095f151979eedb",
