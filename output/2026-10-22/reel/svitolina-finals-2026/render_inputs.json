    "segments": [
      {
        "seconds": 8.32,
        "narration": "从开年捧杯，到温网首轮失利，斯维托丽娜的这一季，最终走回了阔别七年的年终舞台。",
        "voice": {
          "pitch": "+0Hz"
        },
        "kicker": "01 · 年终之路",
        "title_card": "7年之后\n再回年终"
      },
      {
        "seconds": 10.56,
        "narration": "她的二〇二六年，从奥克兰冠军开始。决赛两盘战胜王欣瑜，先把上一季末的四连败，换成了开年的五连胜。",
        "voice": {
          "pitch": "+0Hz"
        },
        "kicker": "01 · 一月出发",
        "title_card": "奥克兰开年捧杯\n重新出发"
      },
      {
        "start": 258.68,
        "end": 275.12,
        "frame": "court",
