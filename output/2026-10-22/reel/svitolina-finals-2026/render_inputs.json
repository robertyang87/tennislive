        "narration": "",
        "voice": {
          "pitch": "+0Hz"
        },
        "fit": "crop",
        "track": false,
        "quote": [
          {
            "at": 5.16,
            "end": 9.06,
            "text": "Elina Svitolina is the champion in Auckland.\n斯维托丽娜赢下奥克兰冠军"
          },
          {
            "at": 10.68,
            "end": 13.22,
            "text": "Her 19th career title,\n她职业生涯的第19冠"
          },
          {
            "at": 13.22,
            "end": 16.16,
            "text": "and she had to work hard for it in this final.\n这场决赛她赢得很艰难"
          }
        ],
