      "words_sha256": "355ed25c101f4018fe24f6a58a0c979d725ecad3aed441eaa6634c1e278dfde7",
      "words_path": "voice_02.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "f8755460497876fa93b3d578c0a8947c",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "二月来到多哈。她上一次拿到巡回赛单打冠军，还是二零一九年。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_03.mp3",
      "audio_sha256": "6e3993717d96cac3acbbc8610b802aed6a0e8d465909be4d10da03b289a8a21a",
      "words_sha256": "92944f682e4867bd718f7a545cfbcc0369785442293d9b4578b11374f54698a2",
      "words_path": "voice_03.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "fafcece7a285236d051fff9800cf5ca9",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "现在，她又走到决赛。对面，是姆博科。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_07.mp3",
      "audio_sha256": "1a2390722c5c91ab4560a961f99ebffcc5ad9515d5bc4435d32ac158ce063ab3",
      "words_sha256": "d3ac7a6782cb1b9b6cbeceded11a7ae2eb483a66c7fe3d305ef8e34cd156ba32",
      "words_path": "voice_07.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "b79e5d52868badb24f44d3623a65d71d",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "六年多后再次捧杯，第一座千分冠。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_08.mp3",
      "audio_sha256": "074b7f7d26f36f02cac7f7b073c2b61363ba5ad30350817a7caba9fdfe4a8cc5",
      "words_sha256": "9c7842b83e4f839fe91a5265b2d00b3b8b860757a6ce5062e5f91dc9c0782acd",
      "words_path": "voice_08.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "36e28439cf34a731ca001dfc5f9ae6d4",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "印第安韦尔斯止步第四轮后，来到迈阿密四分之一决赛，对面又是姆博科。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_10.mp3",
      "audio_sha256": "7e7ce942d0b734aff4a14fbc7f738a86bf4cb829bb82be41fc055e666f3d9f4d",
      "words_sha256": "a29fb85740d570861e000de855ed02e955d7d6a94d28b98d4c0f6c9c4412ce1d",
      "words_path": "voice_10.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "34b4646fde02aaf2f7457a6fa7e5fe8d",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "半决赛，又是高芙。她再次止步。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_11.mp3",
      "audio_sha256": "69fc587a3da1839da22cebf16dbe2f6ca8e6d86481dce71defe340105d00efec",
      "words_sha256": "2a6bcaf19a5267410c76ba3b3b602d1c3e5fcad6c48a89f00973282f975fccc2",
      "words_path": "voice_11.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "f342725720934c4da711cfe006f40439",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "斯图加特，她先在四分之一决赛首次击败高芙，最终收获亚军。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_13.mp3",
      "audio_sha256": "11f1f115ffd62567d1dcf3e2451490003c1506dc543c6d448fbf352b1e581170",
      "words_sha256": "77b15c076e48af4c23b5bac78290d6af085fd220b016b08d3747cbf0c92f7962",
      "words_path": "voice_13.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "870b709b995e9442659aa4bbb8e12c67",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "罗马首战出局，法网又在第三轮负于泰希曼。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_14.mp3",
      "audio_sha256": "0dc2c0751858674b14ae10d906b44ebb2bd55dd99aa6291eba9a3ec8c4e3affc",
      "words_sha256": "6c5c3fded49dc17ecb41bdab6536f8713c5d71763f9f7500fb3d2053413ab26b",
      "words_path": "voice_14.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "fa132c83d0c6a3d50842889254d60dd0",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "草地赛季，伯林第二轮出局。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_15.mp3",
      "audio_sha256": "257c56a4e9b45396a2d3dcdfde44217d6a4f9e6ab9973c52604a1efb2a9800f8",
      "words_sha256": "ab84671c1a3488605e2afda6f79b3f1383b8c2a811d8a7743f27c2c443877940",
      "words_path": "voice_15.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "993cfaf962e2cf05123c2d2cbc736ec2",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "来到巴特洪堡，大坂因脚伤退赛，她收获首个草地单打冠军。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_19.mp3",
      "audio_sha256": "4aa66a6100bf57b4adab66db0843802ad04ecd41846f6563df05439bf1157df4",
      "words_sha256": "e726f04971997d7d672f62a16aa72217072c17c3e5a482f8dd78c4b18e6e8fb0",
      "words_path": "voice_19.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "9baf7fd2dc3d3dee87c0e8ef839b82f1",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "温网半决赛，又是高芙挡在决赛门前。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_22.mp3",
      "audio_sha256": "5e0ed0c889351c063f575fa1a42ff3f9529475cef0cf8e07c9989707049f4810",
      "words_sha256": "3e7bdd2644288ac57b18b1ade525a5d44f6a9a7a22c9deb34a858b82ced7005e",
      "words_path": "voice_22.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "e526ca9adba617f5e6e55f218e357ec7",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "温网决赛三盘不敌诺斯科娃。一千三百分，仍是她全年最大的单站收获。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_25.mp3",
      "audio_sha256": "14b2e92910865f75f7840f1b4ea416eab6a005fbaafccfdbe095cb1045bea17f",
      "words_sha256": "db7863ef7e471e3e5ed715bc79d91fd022295f27aaf4bc875f9e9bfb49c4f21c",
      "words_path": "voice_25.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "cc6d8bdabd8ace4f48f95c09328be54a",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "温网之后，她的赛季出现了停顿。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_26.mp3",
      "audio_sha256": "d3a311bb660aca68f4001aeccea2e91ffc797684b4b2ff4f2322b2c9af18f70a",
      "words_sha256": "db37a42ea687875b284a3d53cc70fb846a8aa53313955091808137407a5951eb",
      "words_path": "voice_26.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "8273911fc5e8142713dd8d0f7328fb4c",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "她接受了一次小手术。恢复期间，缺席了整个北美硬帝热身赛季。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_27.mp3",
      "audio_sha256": "c7cc000ed5417d50c52a5939e15995a69aacbe145850bc5cd85839aec688932c",
      "words_sha256": "5a8116a66bc01ec919fa9d64caec07716f96a06ef02eeb3467f76b7564701c7d",
      "words_path": "voice_27.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "6b55f5e18687695bbb7aa64410349e5e",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "随后的美网单打，她在第三轮输给纳瓦罗。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_29.mp3",
      "audio_sha256": "acbfe5b9356b7b8cf70b3a7ee918c77fea19bc2740557a539899e4db9b86d7f1",
      "words_sha256": "8fe90acec7d7c68573b1364f455c0f1e028646fcbfe3cad6726b2d4bf06ecce5",
      "words_path": "voice_29.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "760a840009df9b26ebc1ff29c23cc18b",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "九月，她又帮助捷克队赢下金杯。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_30.mp3",
      "audio_sha256": "9442e183bf8decba68d7c695f5913d8a9800b85b24d929ae87e4ddbc248d09f7",
      "words_sha256": "daaf25b5bf87053c0f3abbeec8dd26753069c2c2afa052fd12a3025596ac841f",
      "words_path": "voice_30.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "715addcce12d3be73fde7064445861cf",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "在北京打进8强，在武汉止步第三轮。温网之后的三站单打，只增加四百六十五分，最后的资格还没有确定。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_31.mp3",
      "audio_sha256": "115c9c476ee89d085c4d62006c7bcb5c5c52d9fb53a6d94520fd87b021d77f1c",
      "words_sha256": "d43c5c3d1608b651626e05b4f05b27643308e8a7793a415288bba368d0cb2ef9",
      "words_path": "voice_31.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "1c9e21e9480e2223349ae560c183564c",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "十月二十日，斯瓦泰克结束赛季。科斯秋克必须打进宁波决赛，才能保留争夺资格的机会。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_32.mp3",
      "audio_sha256": "f482b2416110e65886a4a34fc7098ce9eee25298d96935c5575cb257b6d1999a",
      "words_sha256": "58fbc47dff8b60adc04f9f446fb4d7e7c87be99e2044cbd3cf896b3d9eea38f8",
      "words_path": "voice_32.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "e87b7014ddf61c5a3585c95804df8eba",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "一天后，她在宁波首盘结束后退赛。穆霍娃，就此锁定最后一个席位。",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_33.mp3",
      "audio_sha256": "57b7fb3cf5cfc5358a1156d01cb5f9a788b4fc31277547e482c43e03889dd155",
      "words_sha256": "ae809e3a1a7e0b75831a07e84118c21cdf604e591e8aaab9feb77eb39064a9dc",
      "words_path": "voice_33.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "9f246be84ca0b6528e2e86422ccccb25",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "四千七百三十五分，她把这个起伏的赛季，带到了总决赛。你最期待她打出怎样的网球？",
        "voice": "zh-CN-YunjianNeural"
      }
    },
    {
      "id": "voice_outro.mp3",
      "audio_sha256": "7d1dbe2cf1d20b006d1b0e1de01f3fc616b46359e6262b29b483d7cb0af3d1d8",
      "words_sha256": "bb371455942874977b3cf9931ffff5c7dc8edb8ad37adc407760e65dfcb2a596",
      "words_path": "voice_outro.words.json",
      "request": {
        "backend": "edge",
        "cache_key": "20da8f5468902afbbecb78daefb15d83",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "关注网球时插，时插归我，好球归你。",
        "voice": "zh-CN-YunjianNeural"
      }
    }
  ]
}
