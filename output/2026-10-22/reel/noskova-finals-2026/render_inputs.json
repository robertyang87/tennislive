      {
        "title_card": "冠军之前",
        "kicker": "诺斯科娃 · 2026年终之路",
        "seconds": 7.23,
        "narration": "七月十一日，诺斯科娃在温网登顶。但她的年终之路，还要从一月讲起。",
        "voice": {
          "rate": "+6%",
