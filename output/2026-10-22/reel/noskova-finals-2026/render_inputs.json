        }
      },
      {
        "title_card": "开局仍在寻找突破",
        "kicker": "澳网 · 第三轮",
        "seconds": 8.55,
        "narration": "布里斯班、澳网，都止步第三轮；澳网两盘负于王欣瑜。多哈、迪拜，都是第二轮。",
        "voice": {
          "rate": "+6%",
          "pitch": "+0Hz"
        }
      },
      {
        "source": "ao-r3",
        "start": 158.76,
        "end": 183.0,
        "cx": 0.5,
        "frame": "court",
        "track": false,
        "fit": "crop",
        "narration": "",
        "voice": {
          "rate": "+6%",
          "pitch": "+0Hz"
        },
        "quote": [
          {
            "at": 15.8,
            "end": 21.22,
            "text": "It was tricky circumstances for her today.\n她今天面对的局面相当棘手。"
          },
          {
            "at": 21.22,
            "end": 23.96,
            "text": "Challenging conditions.\n条件充满挑战。"
          }
        ],
        "inset": {
