        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "多伦多负亚历山德罗娃，辛辛那提负贝莱克。两站第四轮出局之后，她来到纽约。",
        "voice": "zh-CN-YunjianNeural"
      },
