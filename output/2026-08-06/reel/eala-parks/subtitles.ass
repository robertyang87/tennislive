Dialogue: 0,0:00:01.25,0:00:02.67,TL,,0,0,0,,华盛顿夺冠后
Dialogue: 0,0:00:02.67,0:00:05.10,TL,,0,0,0,,伊埃拉把热度带到多伦多
Dialogue: 0,0:00:05.10,0:00:07.99,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}6{\fs68}日早上{\fs78}8{\fs68}点{\fs78}10{\fs68}分左右
Dialogue: 0,0:00:07.99,0:00:11.41,TL,,0,0,0,,门票秒光 菲律宾球迷坐满看台
Dialogue: 0,0:00:11.41,0:00:12.65,TL,,0,0,0,,领先{\fs78}6{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:12.65,0:00:13.78,TL,,0,0,0,,她却被扳平
Dialogue: 0,0:00:13.78,0:00:15.60,TL,,0,0,0,,决胜盘怎么赢？
Dialogue: 0,0:00:15.85,0:00:18.45,TL,,0,0,0,,第一盘她一上来就把主动权拿走
Dialogue: 0,0:00:18.45,0:00:19.76,TL,,0,0,0,,连续两次破发
Dialogue: 0,0:00:19.76,0:00:22.36,TL,,0,0,0,,帕克斯的发球始终没能稳定下来
Dialogue: 0,0:00:22.36,0:00:24.75,TL,,0,0,0,,伊埃拉{\fs78}6{\fs68}比{\fs78}1{\fs68}先下一盘
Dialogue: 0,0:00:27.75,0:00:29.34,TL,,0,0,0,,她先把球打深推远
Dialogue: 0,0:00:29.34,0:00:31.00,TL,,0,0,0,,再用下一拍找空档
Dialogue: 0,0:00:31.00,0:00:33.27,TL,,0,0,0,,帕克斯很难连续进攻
Dialogue: 0,0:00:37.15,0:00:39.28,TL,,0,0,0,,先别只看比分 这一晚
Dialogue: 0,0:00:39.28,0:00:40.93,TL,,0,0,0,,伊埃拉抵达球场时
Dialogue: 0,0:00:40.93,0:00:43.70,TL,,0,0,0,,数{\fs78}100{\fs68}名菲律宾球迷等着签名
Dialogue: 0,0:00:43.70,0:00:46.51,TL,,0,0,0,,她确实有点‘带票女王’的味道了
Dialogue: 0,0:00:50.15,0:00:52.60,TL,,0,0,0,,第二盘 帕克斯先动了
Dialogue: 0,0:00:52.60,0:00:54.46,TL,,0,0,0,,她不再等伊埃拉把球送过来
Dialogue: 0,0:00:54.46,0:00:56.41,TL,,0,0,0,,而是更早抢第一拍
Dialogue: 0,0:00:57.55,0:00:59.39,TL,,0,0,0,,伊埃拉不是突然不会打了
Dialogue: 0,0:00:59.39,0:01:01.21,TL,,0,0,0,,只是每一分都打得更贵
Dialogue: 0,0:01:01.21,0:01:03.07,TL,,0,0,0,,发球局也不再轻松
Dialogue: 0,0:01:06.15,0:01:07.14,TL,,0,0,0,,第二盘最后
Dialogue: 0,0:01:07.14,0:01:09.84,TL,,0,0,0,,帕克斯把抢先手坚持到了关键分
Dialogue: 0,0:01:09.84,0:01:11.97,TL,,0,0,0,,伊埃拉发球局被破 {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:11.97,0:01:13.66,TL,,0,0,0,,比赛进入决胜盘
Dialogue: 0,0:01:13.66,0:01:15.06,TL,,0,0,0,,刚才的主动权
Dialogue: 0,0:01:15.06,0:01:16.56,TL,,0,0,0,,已经换了人
Dialogue: 0,0:01:19.55,0:01:22.47,TL,,0,0,0,,决胜盘她没有和帕克斯比谁更猛
Dialogue: 0,0:01:22.47,0:01:24.68,TL,,0,0,0,,而是把第一拍打深 先破发
Dialogue: 0,0:01:24.68,0:01:26.92,TL,,0,0,0,,把主动权重新拿回来
Dialogue: 0,0:01:30.45,0:01:31.72,TL,,0,0,0,,帕克斯还在追
Dialogue: 0,0:01:31.72,0:01:34.20,TL,,0,0,0,,但伊埃拉没有给她连续施压的机会
Dialogue: 0,0:01:34.20,0:01:35.07,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}2{\fs68}之后
Dialogue: 0,0:01:35.07,0:01:36.52,TL,,0,0,0,,她先拿到赛点
Dialogue: 0,0:01:36.52,0:01:38.18,TL,,0,0,0,,她开始稳住了
Dialogue: 0,0:01:41.85,0:01:44.43,TL,,0,0,0,,所以这场不是比分表能讲完的
Dialogue: 0,0:01:44.43,0:01:46.08,TL,,0,0,0,,看台把她喊成主场
Dialogue: 0,0:01:46.08,0:01:47.80,TL,,0,0,0,,帕克斯逼进决胜盘
Dialogue: 0,0:01:47.80,0:01:50.51,TL,,0,0,0,,伊埃拉用落点和节奏赢回来了
Dialogue: 0,0:01:50.51,0:01:52.86,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}2{\fs68} 晋级第三轮
