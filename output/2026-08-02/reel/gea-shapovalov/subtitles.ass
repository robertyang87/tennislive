Dialogue: 0,0:00:01.30,0:00:04.15,TL,,0,0,0,,热亚 {\fs78}6{\fs68}比{\fs78}3{\fs68} {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:00:05.20,0:00:07.72,TL,,0,0,0,,他的第一个 {\fs78}ATP{\fs68} 冠军
Dialogue: 0,0:00:09.30,0:00:12.02,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}2{\fs68}号上午{\fs78}11{\fs68}点{\fs78}10{\fs68}分
Dialogue: 0,0:00:12.02,0:00:15.44,TL,,0,0,0,,洛斯卡沃斯 {\fs78}ATP250{\fs68} 男单决赛
Dialogue: 0,0:00:15.44,0:00:18.21,TL,,0,0,0,,{\fs78}21{\fs68}岁 世界第{\fs78}127{\fs68}的热亚
Dialogue: 0,0:00:18.21,0:00:21.01,TL,,0,0,0,,对卫冕冠军沙波瓦洛夫
Dialogue: 0,0:00:27.80,0:00:29.80,TL,,0,0,0,,先把时间往回拨
Dialogue: 0,0:00:29.80,0:00:31.90,TL,,0,0,0,,{\fs78}2023{\fs68}年他转职业
Dialogue: 0,0:00:31.90,0:00:33.55,TL,,0,0,0,,那一年{\fs78}18{\fs68}岁
Dialogue: 0,0:00:33.55,0:00:34.67,TL,,0,0,0,,年底在希腊
Dialogue: 0,0:00:34.67,0:00:36.25,TL,,0,0,0,,连着四站打进决赛
Dialogue: 0,0:00:36.25,0:00:37.48,TL,,0,0,0,,拿下{\fs78}3{\fs68}个冠军
Dialogue: 0,0:00:37.48,0:00:39.09,TL,,0,0,0,,第一次进世界前{\fs78}500{\fs68}
Dialogue: 0,0:00:39.09,0:00:41.60,TL,,0,0,0,,一年之内上升了{\fs78}1000{\fs68}位
Dialogue: 0,0:00:47.60,0:00:49.28,TL,,0,0,0,,今年一月 努美阿
Dialogue: 0,0:00:49.28,0:00:51.56,TL,,0,0,0,,他拿下生涯第一个挑战赛冠军
Dialogue: 0,0:00:51.56,0:00:53.54,TL,,0,0,0,,第一次进世界前{\fs78}200{\fs68}
Dialogue: 0,0:00:53.54,0:00:55.07,TL,,0,0,0,,下一周就是澳网
Dialogue: 0,0:00:55.07,0:00:56.89,TL,,0,0,0,,他从资格赛打进正赛
Dialogue: 0,0:00:56.89,0:00:59.89,TL,,0,0,0,,首轮把{\fs78}17{\fs68}号种子莱赫奇卡赢了下来
Dialogue: 0,0:00:59.89,0:01:02.32,TL,,0,0,0,,那时他世界第{\fs78}198{\fs68}
Dialogue: 0,0:01:02.32,0:01:05.07,TL,,0,0,0,,次轮{\fs78}5{\fs68}盘输给瓦林卡
Dialogue: 0,0:01:10.80,0:01:11.92,TL,,0,0,0,,{\fs78}2{\fs68}月蒙彼利埃
Dialogue: 0,0:01:11.92,0:01:12.97,TL,,0,0,0,,外卡进正赛
Dialogue: 0,0:01:12.97,0:01:15.48,TL,,0,0,0,,第一个巡回赛四分之一决赛
Dialogue: 0,0:01:15.48,0:01:17.04,TL,,0,0,0,,{\fs78}5{\fs68}月法网也是外卡
Dialogue: 0,0:01:17.04,0:01:18.86,TL,,0,0,0,,首轮输给哈恰诺夫
Dialogue: 0,0:01:18.86,0:01:20.95,TL,,0,0,0,,那场球他打到一半病了
Dialogue: 0,0:01:20.95,0:01:22.81,TL,,0,0,0,,{\fs78}7{\fs68}月{\fs78}27{\fs68}号 生涯新高
Dialogue: 0,0:01:22.81,0:01:25.10,TL,,0,0,0,,世界第{\fs78}127{\fs68}
Dialogue: 0,0:01:32.10,0:01:34.49,TL,,0,0,0,,这一周他从第一轮打起
Dialogue: 0,0:01:34.49,0:01:37.61,TL,,0,0,0,,对手是资格赛上来的权纯雨 {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:37.61,0:01:39.13,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}7{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:39.13,0:01:40.66,TL,,0,0,0,,两小时{\fs78}41{\fs68}分钟
Dialogue: 0,0:01:40.66,0:01:43.18,TL,,0,0,0,,{\fs78}11{\fs68}个破发点他救下{\fs78}8{\fs68}个
Dialogue: 0,0:01:47.00,0:01:48.85,TL,,0,0,0,,第二轮开局更糟
Dialogue: 0,0:01:48.85,0:01:50.12,TL,,0,0,0,,首盘{\fs78}0{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:01:50.12,0:01:52.84,TL,,0,0,0,,{\fs78}30{\fs68}分钟一个鸭蛋 他没散
Dialogue: 0,0:01:52.84,0:01:54.53,TL,,0,0,0,,把比赛拖进决胜盘
Dialogue: 0,0:01:54.53,0:01:57.08,TL,,0,0,0,,第三盘{\fs78}6{\fs68}比{\fs78}0{\fs68} {\fs78}24{\fs68}分钟
Dialogue: 0,0:01:57.08,0:01:59.00,TL,,0,0,0,,原样还了回去
Dialogue: 0,0:02:02.80,0:02:04.07,TL,,0,0,0,,四分之一决赛
Dialogue: 0,0:02:04.07,0:02:05.78,TL,,0,0,0,,{\fs78}3{\fs68}号种子塞伦多洛
Dialogue: 0,0:02:05.78,0:02:07.31,TL,,0,0,0,,世界前{\fs78}20{\fs68}
Dialogue: 0,0:02:07.31,0:02:10.11,TL,,0,0,0,,首盘抢七打了一个多小时 他输掉
Dialogue: 0,0:02:10.11,0:02:11.91,TL,,0,0,0,,第二盘{\fs78}6{\fs68}比{\fs78}4{\fs68}扳平
Dialogue: 0,0:02:11.91,0:02:13.23,TL,,0,0,0,,第三盘{\fs78}6{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:02:13.23,0:02:14.95,TL,,0,0,0,,{\fs78}30{\fs68}分钟收工
Dialogue: 0,0:02:14.95,0:02:17.10,TL,,0,0,0,,两小时{\fs78}42{\fs68}分
Dialogue: 0,0:02:24.00,0:02:25.97,TL,,0,0,0,,半决赛{\fs78}7{\fs68}比{\fs78}6{\fs68} {\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:02:25.97,0:02:27.38,TL,,0,0,0,,他挡住了黄泽林
Dialogue: 0,0:02:27.38,0:02:30.61,TL,,0,0,0,,那是黄泽林第一次打进巡回赛半决赛
Dialogue: 0,0:02:30.61,0:02:32.12,TL,,0,0,0,,走到决赛之前
Dialogue: 0,0:02:32.12,0:02:33.91,TL,,0,0,0,,这一周他在场上已经待了
Dialogue: 0,0:02:33.91,0:02:35.95,TL,,0,0,0,,{\fs78}9{\fs68}个小时零八分
Dialogue: 0,0:02:42.50,0:02:43.94,TL,,0,0,0,,决赛第一盘{\fs78}2{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:02:43.94,0:02:45.27,TL,,0,0,0,,他自己的发球局
Dialogue: 0,0:02:45.27,0:02:46.88,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}40{\fs68}开局
Dialogue: 0,0:02:46.88,0:02:48.46,TL,,0,0,0,,{\fs78}3{\fs68}个破发点救回来
Dialogue: 0,0:02:48.46,0:02:50.68,TL,,0,0,0,,平分之后又是一个 {\fs78}4{\fs68}个
Dialogue: 0,0:02:50.68,0:02:52.07,TL,,0,0,0,,一个都没给
Dialogue: 0,0:02:52.07,0:02:54.72,TL,,0,0,0,,这一盘唯一一次破发在两局之后
Dialogue: 0,0:02:54.72,0:02:56.08,TL,,0,0,0,,{\fs78}6{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:03:02.60,0:03:03.87,TL,,0,0,0,,第二盘{\fs78}3{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:03:03.87,0:03:05.24,TL,,0,0,0,,还是他发球
Dialogue: 0,0:03:05.24,0:03:07.43,TL,,0,0,0,,这一次对手拿到了破发点
Dialogue: 0,0:03:07.43,0:03:10.19,TL,,0,0,0,,全场他一共面对{\fs78}7{\fs68}个 救下{\fs78}6{\fs68}个
Dialogue: 0,0:03:10.19,0:03:13.01,TL,,0,0,0,,只有这一个没救住 {\fs78}3{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:03:13.01,0:03:14.91,TL,,0,0,0,,比分回到原点
Dialogue: 0,0:03:20.70,0:03:23.12,TL,,0,0,0,,下一局他立刻打了回去
Dialogue: 0,0:03:23.12,0:03:24.28,TL,,0,0,0,,两个破发点
Dialogue: 0,0:03:24.28,0:03:27.97,TL,,0,0,0,,第二个成了 {\fs78}4{\fs68}比{\fs78}3{\fs68} 重新领先
Dialogue: 0,0:03:31.60,0:03:33.69,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} {\fs78}40{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:03:33.69,0:03:35.21,TL,,0,0,0,,{\fs78}3{\fs68}个冠军点
Dialogue: 0,0:03:35.21,0:03:36.24,TL,,0,0,0,,第一个球落地
Dialogue: 0,0:03:36.24,0:03:38.12,TL,,0,0,0,,比赛就结束了
Dialogue: 0,0:03:41.10,0:03:43.64,TL,,0,0,0,,{\fs78}5{\fs68}场球 {\fs78}10{\fs68}个多小时
Dialogue: 0,0:03:46.60,0:03:48.92,TL,,0,0,0,,他生涯只赢过{\fs78}3{\fs68}场巡回赛
Dialogue: 0,0:03:48.92,0:03:51.32,TL,,0,0,0,,这一周赢了{\fs78}5{\fs68}场 周一
Dialogue: 0,0:03:51.32,0:03:54.37,TL,,0,0,0,,排名升到生涯新高第{\fs78}81{\fs68}位
Dialogue: 0,0:04:00.20,0:04:03.19,TL,,0,0,0,,他说 我不知道这一周要怎么赢
Dialogue: 0,0:04:03.19,0:04:04.90,TL,,0,0,0,,现在他知道了
Dialogue: 0,0:04:04.90,0:04:06.53,TL,,0,0,0,,下一个呢？
