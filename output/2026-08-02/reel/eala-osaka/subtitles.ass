Dialogue: 0,0:00:01.30,0:00:04.55,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}2{\fs68}号凌晨{\fs78}3{\fs68}点{\fs78}50{\fs68}分前后
Dialogue: 0,0:00:04.55,0:00:07.69,TL,,0,0,0,,华盛顿 {\fs78}WTA500{\fs68} 女单四强
Dialogue: 0,0:00:07.69,0:00:09.17,TL,,0,0,0,,{\fs78}21{\fs68}岁的伊埃拉
Dialogue: 0,0:00:09.17,0:00:12.50,TL,,0,0,0,,对{\fs78}4{\fs68}届大满贯冠军大坂直美
Dialogue: 0,0:00:15.60,0:00:17.85,TL,,0,0,0,,第三局 大坂发球
Dialogue: 0,0:00:17.85,0:00:19.13,TL,,0,0,0,,{\fs78}30{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:19.13,0:00:20.84,TL,,0,0,0,,伊埃拉全场第一个破发点
Dialogue: 0,0:00:20.84,0:00:23.00,TL,,0,0,0,,一次就兑现 {\fs78}2{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:23.00,0:00:24.84,TL,,0,0,0,,先手在她这儿
Dialogue: 0,0:00:27.70,0:00:29.63,TL,,0,0,0,,大坂立刻还了回来
Dialogue: 0,0:00:29.63,0:00:31.82,TL,,0,0,0,,伊埃拉的发球局{\fs78}0{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:31.82,0:00:34.55,TL,,0,0,0,,{\fs78}3{\fs68}个破发点她全救了 追到平分
Dialogue: 0,0:00:34.55,0:00:38.64,TL,,0,0,0,,第四个没救住 {\fs78}2{\fs68}比{\fs78}2{\fs68} 回到原点
Dialogue: 0,0:00:41.80,0:00:42.89,TL,,0,0,0,,接下来{\fs78}4{\fs68}局
Dialogue: 0,0:00:42.89,0:00:46.98,TL,,0,0,0,,谁也没再丢发球局 {\fs78}4{\fs68}比{\fs78}4{\fs68} 大坂发球
Dialogue: 0,0:00:46.98,0:00:49.53,TL,,0,0,0,,{\fs78}0{\fs68}比{\fs78}40{\fs68} 伊埃拉{\fs78}3{\fs68}个破发点
Dialogue: 0,0:00:49.53,0:00:51.78,TL,,0,0,0,,大坂全救了 平分
Dialogue: 0,0:00:51.78,0:00:52.97,TL,,0,0,0,,然后是占先
Dialogue: 0,0:00:52.97,0:00:56.82,TL,,0,0,0,,第四个破发点 这一个 她拿住了
Dialogue: 0,0:00:56.82,0:00:58.36,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:00.90,0:01:04.67,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} 她发球 {\fs78}40{\fs68}比{\fs78}0{\fs68} {\fs78}3{\fs68}个盘点
Dialogue: 0,0:01:04.67,0:01:06.93,TL,,0,0,0,,第一个就收下 {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:06.93,0:01:08.91,TL,,0,0,0,,第一盘{\fs78}39{\fs68}分钟
Dialogue: 0,0:01:08.91,0:01:11.91,TL,,0,0,0,,她此前从没打进过硬地决赛
Dialogue: 0,0:01:14.50,0:01:17.81,TL,,0,0,0,,第二盘她上来又破一局 {\fs78}3{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:17.81,0:01:20.54,TL,,0,0,0,,大坂发球 {\fs78}15{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:01:20.54,0:01:22.10,TL,,0,0,0,,伊埃拉两个破发点
Dialogue: 0,0:01:22.10,0:01:25.31,TL,,0,0,0,,两个都被救掉 再占先 第三个
Dialogue: 0,0:01:25.31,0:01:27.55,TL,,0,0,0,,第四个 一样救掉
Dialogue: 0,0:01:27.55,0:01:29.03,TL,,0,0,0,,这一局打了{\fs78}14{\fs68}分
Dialogue: 0,0:01:29.03,0:01:30.94,TL,,0,0,0,,伊埃拉四次拿到破发点
Dialogue: 0,0:01:30.94,0:01:35.42,TL,,0,0,0,,一次都没兑现 {\fs78}3{\fs68}比{\fs78}2{\fs68} 大坂还在
Dialogue: 0,0:01:38.90,0:01:41.01,TL,,0,0,0,,可她的机会就到这儿了
Dialogue: 0,0:01:41.01,0:01:43.00,TL,,0,0,0,,伊埃拉守住自己的发球局
Dialogue: 0,0:01:43.00,0:01:45.56,TL,,0,0,0,,紧接着再破一局 {\fs78}5{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:01:45.56,0:01:46.54,TL,,0,0,0,,轮到她发球
Dialogue: 0,0:01:46.54,0:01:47.64,TL,,0,0,0,,赢下这一局
Dialogue: 0,0:01:47.64,0:01:50.42,TL,,0,0,0,,就是她的第一个{\fs78}500{\fs68}级决赛
Dialogue: 0,0:01:54.60,0:01:59.74,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}0{\fs68} {\fs78}3{\fs68}个赛点 第一个 大坂救了
Dialogue: 0,0:01:59.74,0:02:02.17,TL,,0,0,0,,第二个 大坂又救了
Dialogue: 0,0:02:02.17,0:02:03.77,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68}
Dialogue: 0,0:02:03.77,0:02:06.04,TL,,0,0,0,,全场她只兑现过一个破发点
Dialogue: 0,0:02:06.04,0:02:09.43,TL,,0,0,0,,可这最后一局在一分一分地往回顶
Dialogue: 0,0:02:11.30,0:02:13.69,TL,,0,0,0,,第三个赛点 她收下了
Dialogue: 0,0:02:13.69,0:02:17.10,TL,,0,0,0,,一小时{\fs78}18{\fs68}分钟 {\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:02:17.10,0:02:20.37,TL,,0,0,0,,{\fs78}106{\fs68}分 她拿到{\fs78}62{\fs68}分
Dialogue: 0,0:02:22.90,0:02:26.08,TL,,0,0,0,,网前握手 她转身冲看台挥手
Dialogue: 0,0:02:26.08,0:02:28.05,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}3{\fs68}号{\fs78}0{\fs68}点
Dialogue: 0,0:02:28.05,0:02:30.79,TL,,0,0,0,,就是她的第一个{\fs78}500{\fs68}级决赛
Dialogue: 0,0:02:34.40,0:02:35.71,TL,,0,0,0,,最后这一场
Dialogue: 0,0:02:35.71,0:02:37.44,TL,,0,0,0,,她拿得下吗？
