Dialogue: 0,0:00:01.30,0:00:04.70,TL,,0,0,0,,一小时{\fs78}18{\fs68}分钟 {\fs78}6{\fs68}比{\fs78}4{\fs68} {\fs78}6{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:00:04.70,0:00:07.13,TL,,0,0,0,,伊埃拉赢了大坂直美
Dialogue: 0,0:00:08.90,0:00:11.94,TL,,0,0,0,,{\fs78}21{\fs68}岁 她双手捂住了脸
Dialogue: 0,0:00:13.30,0:00:15.64,TL,,0,0,0,,北京时间{\fs78}8{\fs68}月{\fs78}2{\fs68}号{\fs78}3{\fs68}点{\fs78}50{\fs68}分
Dialogue: 0,0:00:15.64,0:00:17.64,TL,,0,0,0,,华盛顿 {\fs78}WTA500{\fs68}
Dialogue: 0,0:00:17.64,0:00:20.10,TL,,0,0,0,,女单半决赛 {\fs78}3{\fs68}号种子
Dialogue: 0,0:00:20.10,0:00:22.49,TL,,0,0,0,,{\fs78}4{\fs68}届大满贯冠军大坂直美
Dialogue: 0,0:00:22.49,0:00:24.84,TL,,0,0,0,,对{\fs78}21{\fs68}岁的伊埃拉
Dialogue: 0,0:00:27.60,0:00:29.85,TL,,0,0,0,,第三局 大坂发球
Dialogue: 0,0:00:29.85,0:00:31.13,TL,,0,0,0,,{\fs78}30{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:31.13,0:00:32.84,TL,,0,0,0,,伊埃拉全场第一个破发点
Dialogue: 0,0:00:32.84,0:00:35.00,TL,,0,0,0,,一次就兑现 {\fs78}2{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:00:35.00,0:00:36.84,TL,,0,0,0,,先手在她这儿
Dialogue: 0,0:00:41.40,0:00:43.33,TL,,0,0,0,,大坂立刻还了回来
Dialogue: 0,0:00:43.33,0:00:45.71,TL,,0,0,0,,伊埃拉的发球局 {\fs78}0{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:00:45.71,0:00:47.55,TL,,0,0,0,,大坂{\fs78}3{\fs68}个破发点
Dialogue: 0,0:00:47.55,0:00:49.98,TL,,0,0,0,,她一个一个救回来 追到平分
Dialogue: 0,0:00:49.98,0:00:54.14,TL,,0,0,0,,第四个没救住 {\fs78}2{\fs68}比{\fs78}2{\fs68} 回到原点
Dialogue: 0,0:00:59.90,0:01:00.99,TL,,0,0,0,,接下来{\fs78}4{\fs68}局
Dialogue: 0,0:01:00.99,0:01:03.23,TL,,0,0,0,,谁也没再丢发球局
Dialogue: 0,0:01:10.80,0:01:13.75,TL,,0,0,0,,发球局是伊埃拉这场球最硬的一环
Dialogue: 0,0:01:13.75,0:01:16.23,TL,,0,0,0,,全场{\fs78}9{\fs68}个 她守住{\fs78}8{\fs68}个
Dialogue: 0,0:01:16.23,0:01:17.88,TL,,0,0,0,,二发得分率七成九
Dialogue: 0,0:01:17.88,0:01:19.92,TL,,0,0,0,,大坂只有四成八
Dialogue: 0,0:01:24.10,0:01:27.33,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68} 轮到她发球 {\fs78}40{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:27.33,0:01:30.22,TL,,0,0,0,,一分没丢 {\fs78}4{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:36.20,0:01:39.38,TL,,0,0,0,,第九局 大坂发球 {\fs78}0{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:01:39.38,0:01:40.92,TL,,0,0,0,,伊埃拉{\fs78}3{\fs68}个破发点
Dialogue: 0,0:01:40.92,0:01:43.18,TL,,0,0,0,,大坂全救了 平分
Dialogue: 0,0:01:43.18,0:01:44.37,TL,,0,0,0,,然后是占先
Dialogue: 0,0:01:44.37,0:01:48.21,TL,,0,0,0,,第四个破发点 这一个 她拿住了
Dialogue: 0,0:01:48.21,0:01:49.73,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:01:55.30,0:01:59.07,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}4{\fs68} 她发球 {\fs78}40{\fs68}比{\fs78}0{\fs68} {\fs78}3{\fs68}个盘点
Dialogue: 0,0:01:59.07,0:02:01.33,TL,,0,0,0,,第一个就收下 {\fs78}6{\fs68}比{\fs78}4{\fs68}
Dialogue: 0,0:02:01.33,0:02:03.31,TL,,0,0,0,,第一盘{\fs78}39{\fs68}分钟
Dialogue: 0,0:02:03.31,0:02:06.31,TL,,0,0,0,,她此前从没打进过硬地决赛
Dialogue: 0,0:02:08.90,0:02:12.95,TL,,0,0,0,,第二盘一上来她又破一局 {\fs78}3{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:02:21.30,0:02:23.38,TL,,0,0,0,,{\fs78}3{\fs68}比{\fs78}1{\fs68} 大坂发球
Dialogue: 0,0:02:23.38,0:02:24.80,TL,,0,0,0,,{\fs78}15{\fs68}比{\fs78}40{\fs68}
Dialogue: 0,0:02:24.80,0:02:26.35,TL,,0,0,0,,伊埃拉两个破发点
Dialogue: 0,0:02:26.35,0:02:30.57,TL,,0,0,0,,两个都被救掉 占先 第三个 救掉
Dialogue: 0,0:02:30.57,0:02:33.77,TL,,0,0,0,,再占先 第四个 还是救掉
Dialogue: 0,0:02:33.77,0:02:35.26,TL,,0,0,0,,这一局打了{\fs78}14{\fs68}分
Dialogue: 0,0:02:35.26,0:02:37.17,TL,,0,0,0,,伊埃拉四次拿到破发点
Dialogue: 0,0:02:37.17,0:02:41.41,TL,,0,0,0,,一次都没兑现 {\fs78}3{\fs68}比{\fs78}2{\fs68} 大坂还在
Dialogue: 0,0:02:50.30,0:02:52.41,TL,,0,0,0,,可她的机会就到这儿了
Dialogue: 0,0:02:52.41,0:02:54.40,TL,,0,0,0,,伊埃拉守住自己的发球局
Dialogue: 0,0:02:54.40,0:02:57.76,TL,,0,0,0,,紧接着再破一局 {\fs78}5{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:03:06.00,0:03:07.00,TL,,0,0,0,,轮到她发球
Dialogue: 0,0:03:07.00,0:03:10.50,TL,,0,0,0,,赢下这一局就是决赛 {\fs78}40{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:03:10.50,0:03:14.91,TL,,0,0,0,,{\fs78}3{\fs68}个赛点 第一个 大坂救了 第二个
Dialogue: 0,0:03:14.91,0:03:16.51,TL,,0,0,0,,大坂又救了
Dialogue: 0,0:03:16.51,0:03:18.40,TL,,0,0,0,,{\fs78}40{\fs68}比{\fs78}30{\fs68}
Dialogue: 0,0:03:30.80,0:03:32.27,TL,,0,0,0,,第三个赛点
Dialogue: 0,0:03:32.27,0:03:34.83,TL,,0,0,0,,{\fs78}106{\fs68}分里她拿到{\fs78}62{\fs68}分
Dialogue: 0,0:03:34.83,0:03:36.84,TL,,0,0,0,,局数{\fs78}12{\fs68}比{\fs78}6{\fs68}
Dialogue: 0,0:03:41.00,0:03:44.33,TL,,0,0,0,,网前握手 北京时间{\fs78}8{\fs68}月{\fs78}3{\fs68}号{\fs78}0{\fs68}点
Dialogue: 0,0:03:44.33,0:03:46.97,TL,,0,0,0,,是她的第一个{\fs78}500{\fs68}级决赛
Dialogue: 0,0:03:49.30,0:03:50.61,TL,,0,0,0,,最后这一场
Dialogue: 0,0:03:50.61,0:03:52.34,TL,,0,0,0,,她拿得下吗？
