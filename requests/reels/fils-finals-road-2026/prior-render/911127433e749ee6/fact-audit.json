    "scope": "Actual native ASS compared with all 16 frozen TTS texts. Only punctuation, Chinese/digit typography and 1/4 display normalization.",
    "segments": [
      {
        "native_segment_index": 0,
        "start": 3.898,
        "end": 11.906,
        "status": "PASS",
        "actual_ass_text": "今年四站大满贯菲斯只赢了一场比赛可今年的年终名单里第一次出现了他的名字",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 1,
        "start": 11.906,
        "end": 20.97,
        "status": "PASS",
        "actual_ass_text": "去年法网后背伤让他只又打了两场巡回赛单打今年又缺席澳网直到2月才开始新赛季",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 2,
        "start": 20.97,
        "end": 28.954,
        "status": "PASS",
        "actual_ass_text": "复出第三站 多哈 他一路打到决赛却以2比6 1比6输给阿尔卡拉斯",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 3,
        "start": 28.954,
        "end": 38.666,
        "status": "PASS",
        "actual_ass_text": "印第安维尔斯打进8强接着是迈阿密 对保罗那场1/4决赛他救回4个赛点3盘抢七翻了回来",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 5,
        "start": 78.666,
        "end": 87.73,
        "status": "PASS",
        "actual_ass_text": "迈阿密止步4强之后他在巴塞罗那两盘击败卢布列夫复出后的第一座奖杯 到手了",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 7,
        "start": 120.43,
        "end": 127.934,
        "status": "PASS",
        "actual_ass_text": "马德里 他又进了大师赛4强复出之后已经连续在大赛中走到后半程",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 8,
        "start": 127.934,
        "end": 137.91,
        "status": "PASS",
        "actual_ass_text": "可伤病再次打断了他罗马首战伤退随后因为髋伤退出法网两个大满贯 他都没能出场",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 9,
        "start": 137.91,
        "end": 145.942,
        "status": "PASS",
        "actual_ass_text": "温网先赢一轮 第二轮输给贝雷蒂尼这一胜也是他今年全部的大满贯胜场",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 11,
        "start": 172.442,
        "end": 181.698,
        "status": "PASS",
        "actual_ass_text": "辛辛那提决赛 他与蒂亚福各拿一盘决胜盘 菲斯送出6比0拿到生涯第一座大师赛冠军",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 13,
        "start": 209.998,
        "end": 218.846,
        "status": "PASS",
        "actual_ass_text": "美网 却又在首轮被西西帕斯挡住辛辛那提的冠军并没有让大满贯的难题自动消失",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 15,
        "start": 240.146,
        "end": 249.018,
        "status": "PASS",
        "actual_ass_text": "秋天 东京打进8强 上海第三轮布鲁塞尔又进4强一站一站 把积分往上加",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 16,
        "start": 249.018,
        "end": 258.322,
        "status": "PASS",
        "actual_ass_text": "巴塞尔 面对弗里茨第二盘0比2时 菲斯再次伤退年终门票还没拿到他又没能打完比赛",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 17,
        "start": 258.322,
        "end": 265.994,
        "status": "PASS",
        "actual_ass_text": "11月4日 转折来自另一场比赛阿利斯击败蒂亚福菲斯的年终资格提前锁定",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 18,
        "start": 265.994,
        "end": 275.514,
        "status": "PASS",
        "actual_ass_text": "截至11月5日菲斯3625分排在赛季积分榜第七高亮的6个人 都已拿到年终门票",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 19,
        "start": 275.514,
        "end": 284.986,
        "status": "PASS",
        "actual_ass_text": "资格到手之后 他又两盘击败马哈奇继续巴黎的征程法国男网时隔10年终于又有人入围年终",
        "normalized_match_to_frozen_tts_text": true
      },
      {
        "native_segment_index": 21,
        "start": 300.466,
        "end": 308.858,
        "status": "PASS",
        "actual_ass_text": "大满贯只有一胜却拼出了第一张年终门票第一次到都灵你看好菲斯拿下几场胜利？",
        "normalized_match_to_frozen_tts_text": true
      }
    ]
  },
  "source_translations": {
    "status": "PASS",
    "cue_count": 19,
    "cues": [
      {
        "source": "miami-qf",
        "start": 56.81,
        "end": 58.03,
        "actual_ass_text": "He's done it!\n他做到了！",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "miami-qf",
        "start": 59.03,
        "end": 60.27,
        "actual_ass_text": "What a conclusion!\n多么精彩的结局！",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "miami-qf",
        "start": 60.63,
        "end": 65.05,
        "actual_ass_text": "Arthur Fils is a Miami semi-finalist.\n菲斯晋级迈阿密半决赛",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "miami-qf",
        "start": 65.07,
        "end": 66.99,
        "actual_ass_text": "Can you believe it?\n你敢相信吗？",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "miami-qf",
        "start": 67.49,
        "end": 69.89,
        "actual_ass_text": "Six-two down in the breaker.\n抢七一度2比6落后",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "miami-qf",
        "start": 71.47,
        "end": 78.41,
        "actual_ass_text": "And somehow he's found a way.\n可他竟然找到了出路",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "barcelona-final",
        "start": 106.63,
        "end": 110.25,
        "actual_ass_text": "Arthur Fils conquers Barcelona in style.\n菲斯在巴塞罗那精彩夺冠",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "barcelona-final",
        "start": 112.03,
        "end": 114.97,
        "actual_ass_text": "After six months out with a back injury,\n背伤让他休战6个月",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "barcelona-final",
        "start": 115.17,
        "end": 118.07,
        "actual_ass_text": "he stormed back onto the ATP Tour,\n他强势重返ATP巡回赛",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "barcelona-final",
        "start": 118.67,
        "end": 120.31,
        "actual_ass_text": "playing some of his best tennis.\n打出个人顶尖水准",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "wimbledon-r2",
        "start": 160.02,
        "end": 165.42000000000002,
        "actual_ass_text": "Matteo Berrettini punches his ticket to round three.\n贝雷蒂尼晋级第三轮",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "cincinnati-final",
        "start": 191.76,
        "end": 192.56,
        "actual_ass_text": "Arthur Fils.\n菲斯",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "cincinnati-final",
        "start": 194.1,
        "end": 196.26,
        "actual_ass_text": "Quite scintillating in Cincinnati.\n在辛辛那提大放异彩",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "cincinnati-final",
        "start": 200.12,
        "end": 204.12,
        "actual_ass_text": "It is the biggest title of his young career.\n他年轻生涯分量最重的冠军",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "us-open-r1",
        "start": 222.09,
        "end": 223.67000000000002,
        "actual_ass_text": "Does it in style.\n漂亮收官",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "us-open-r1",
        "start": 223.97,
        "end": 230.12,
        "actual_ass_text": "Stefanos Tsitsipas, through to the second round here of the US Open.\n西西帕斯晋级美网第二轮",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "us-open-r1",
        "start": 233.25,
        "end": 235.73,
        "actual_ass_text": "A four-set winner over the number ten seed.\n四盘击败10号种子",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "us-open-r1",
        "start": 237.35,
        "end": 239.43,
        "actual_ass_text": "And that was as good as it gets.\n这表现无可挑剔",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      },
      {
        "source": "paris-r2",
        "start": 292.40999999999997,
        "end": 297.03,
        "actual_ass_text": "Arthur Fils caps off what has been a fabulous French day.\n菲斯为法国球员的精彩一天收官",
        "translation_fact_status": "PASS",
        "meaning_note": "Faithful translation; factual result/person/round direction preserved."
      }
    ],
    "context_note": "Barcelona source says six months out: consistent with the final uninterrupted absence after 2025 Toronto until February 2026. It is a faithful rendering of the authentic English source, distinct from the approximate eight-month injury period beginning at Roland-Garros."
  },
