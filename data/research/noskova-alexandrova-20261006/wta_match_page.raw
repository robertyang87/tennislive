<script type="text/javascript">
// Generic consent-ready gate: invokes `callback` once, as soon as OneTrust consent
// is established - immediately if it was already decided on a previous visit,
// as soon as the user acts on the banner (OnConsentChanged), or via onetrustLoaded
// as a fallback. Pass fallbackMs to also fire after a fixed delay in case OneTrust
// never calls back at all (e.g. blocked by network or an adblocker). Shared by any
// widget that must defer initialisation until consent is established (Google
// Publisher Tag: Init, Google Tag Manager: Init, etc).
function onConsentReady(callback, fallbackMs) {
    var called = false;
    function fire() {
        if (called) return;
        called = true;
        callback();
    }

    if (window.OneTrust?.IsAlertBoxClosed?.()) {
        fire();
        return;
    }

    if (window.OneTrust?.OnConsentChanged) {
        window.OneTrust.OnConsentChanged(fire);
    }

    document.addEventListener('onetrustLoaded', fire, { once: true });

    if (typeof fallbackMs === 'number') {
        setTimeout(fire, fallbackMs);
    }
}

function OptanonWrapper() {
    document.dispatchEvent(new Event('onetrustLoaded'));
}
</script>
