<script>
(function () {
    const MINUTELY_SCRIPT_SRC = '//apv-launcher.minute-ly.com/api/launcher/MIN-903070.js';
    const MINUTELY_CONSENT_GROUP = 'C0004'; // targeting/advertising
    const AD_RENDER_TIMEOUT_MS = 5000;
    const WAIT_FOR_AD_RENDER = true;

    let consentGranted = false;
    // When the widget hasn't opted in to WAIT_FOR_AD_RENDER, the ad-render
    // gate is pre-satisfied so load only depends on consent, preserving the
    // original consent-only behaviour.
    let firstAdRendered = !WAIT_FOR_AD_RENDER;

    function hasConsent() {
        return Boolean(window.OnetrustActiveGroups?.includes(MINUTELY_CONSENT_GROUP));
    }

    function consentDecided() {
        return Boolean(window.OneTrust?.IsAlertBoxClosed?.());
    }

    function injectScript() {
        if (document.querySelector('script[src="' + MINUTELY_SCRIPT_SRC + '"]')) {
            return;
        }
        const script = document.createElement('script');
        script.src = MINUTELY_SCRIPT_SRC;
        script.async = true;
        document.head.appendChild(script);
    }

    // Only load once both consent has been granted AND the first ad has
    // rendered (or the fallback timeout has elapsed) - see markFirstAdRendered
    // and checkConsentAndLoad. Whichever condition resolves last triggers
    // the load; injectScript() itself is idempotent.
    function checkAndLoad() {
        if (consentGranted && firstAdRendered) {
            console.info('[Minutely] Consent granted, loading script');
            injectScript();
        }
    }

    // Gated on OneTrust consent for the targeting/advertising category (C0004):
    // resolves immediately if consent is already granted, never resolves if it's
    // already been declined, and otherwise waits for the user's consent
    // decision before acting on it.
    function checkConsentAndLoad() {
        if (hasConsent()) {
            console.info('[Minutely] Consent already granted');
            consentGranted = true;
            checkAndLoad();
        } else if (consentDecided()) {
            console.info('[Minutely] Consent already declined, not loading script');
        } else if (window.OneTrust?.OnConsentChanged) {
            console.info('[Minutely] Consent not yet decided, waiting for OnConsentChanged');
            window.OneTrust.OnConsentChanged((event) => {
                if (event?.detail?.includes(MINUTELY_CONSENT_GROUP)) {
                    console.info('[Minutely] Consent granted via OnConsentChanged');
                    consentGranted = true;
                    checkAndLoad();
                } else {
                    console.info('[Minutely] Consent declined via OnConsentChanged, not loading script');
                }
            });
        } else {
            console.info('[Minutely] OneTrust not yet loaded, waiting for onetrustLoaded');
            document.addEventListener('onetrustLoaded', checkConsentAndLoad, { once: true });
        }
    }

    // Gated on the first GAM ad render (any fill outcome) so Minute.ly's own
    // network/CPU usage doesn't compete with initial ad bidding. Falls back to
    // a timeout so pages with no ads, or ads not yet scrolled into view, aren't
    // blocked from ever loading Minute.ly.
    function markFirstAdRendered() {
        if (firstAdRendered) {
            return;
        }
        firstAdRendered = true;
        console.info('[Minutely] First ad rendered, ad-render gate satisfied');
        checkAndLoad();
    }

    if (WAIT_FOR_AD_RENDER) {
        window.googletag = window.googletag || { cmd: [] };
        window.googletag.cmd.push(function () {
            googletag.pubads().addEventListener('slotRenderEnded', markFirstAdRendered);
        });
        setTimeout(markFirstAdRendered, AD_RENDER_TIMEOUT_MS);
    }

    checkConsentAndLoad();
})();
</script>

