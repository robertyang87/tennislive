                <div class="article-header">
                    <div class="heading">
                        <h2>Medvedev fends off Paul for Shanghai SF berth</h2>
                    </div>
                    <div class="tagline">World No. 6 will next meet Jodar</div>
                    <div class="timestamp-author">
                        <span>16 October 2026</span>
                        <span>By Sam Jacot</span>
                    </div>
                </div>
                <script src="https://players.brightcove.net/6057277721001/xO4H0ZXngd_default/index.min.js"></script>
