{
  "schema": "actual-cloud-speech-asr-input.v1",
  "source_cloud_run": "38305296490",
  "sha256": "ee28e552eaddefd1a99de733afc3bd996d49815c912e4df0c14dd290c4d48b23",
  "seconds": 68.244,
  "rows": [
    {
      "index": 1,
      "edit_id": "landing",
      "text": "帕奥利尼赢下两盘，过程却并不轻松。",
      "actual_cloud_mp3_sha256": "b04b12acc32fd905376c26707df257e9df843c6653800929ce49b41f84cc84b5",
      "concat_start": 0,
      "concat_end": 4.032
    },
    {
      "index": 2,
      "edit_id": "coordinate_and_rank",
      "text": "北京时间十月十二日下午，武汉首轮。帕奥利尼迎战贝莱克。",
      "actual_cloud_mp3_sha256": "dc32a92f31955b234115f2cb9726f01ff5c2b26d2d515b35079c860248c94a2b",
      "concat_start": 4.332,
      "concat_end": 10.620000000000001
    },
    {
      "index": 4,
      "edit_id": "first_set_pressure",
      "text": "帕奥利尼先冲到四比零。贝莱克在底线继续追击，把这一盘的悬念又拉了回来。",
      "actual_cloud_mp3_sha256": "5696af87d795cbbaa457c70d35f3af216194e93130e7288f7e14056d2ca1362d",
      "concat_start": 10.92,
      "concat_end": 18.408
    },
    {
      "index": 6,
      "edit_id": "first_set_payoff",
      "text": "贝莱克把比分追到三比五。帕奥利尼终于拿下盘点，六比三，先赢一盘。",
      "actual_cloud_mp3_sha256": "c07b6c47cd19a5ecd0459d07719e1237afb3a7aa280804cf74c79938aa7fae60",
      "concat_start": 18.708,
      "concat_end": 25.668
    },
    {
      "index": 8,
      "edit_id": "second_set_story",
      "text": "第二盘换了风向。贝莱克从底线不断压回球来，帕奥利尼还得重新稳住发球。",
      "actual_cloud_mp3_sha256": "e8d6ac9c866d9eec0730b2791b73cf1616295b3a4ebaeedecad3530d8f06e5a8",
      "concat_start": 25.967999999999996,
      "concat_end": 33.023999999999994
    },
    {
      "index": 10,
      "edit_id": "second_set_pressure",
      "text": "贝莱克拿到三比一。帕奥利尼又面对两次破发点，这一局必须守住。",
      "actual_cloud_mp3_sha256": "c46a0e7d8ae4266464cbd01b9579bc0b10d8063d7b15e93346ad9da2e40aacdd",
      "concat_start": 33.324,
      "concat_end": 39.876
    },
    {
      "index": 12,
      "edit_id": "second_set_return",
      "text": "帕奥利尼没有退。她先回破，再救回自己的发球局。从一比三追到三比三，反扑还没有结束。",
      "actual_cloud_mp3_sha256": "e630d02ad60938643a31919b20129916a4745df01410ef36d3a5423ebdbfa78b",
      "concat_start": 40.176,
      "concat_end": 48.816
    },
    {
      "index": 14,
      "edit_id": "closing_break",
      "text": "四比三又被追回四比四。帕奥利尼再次破发，把机会带进自己的发球局。",
      "actual_cloud_mp3_sha256": "e37b5d97de0bc7cfe1d9d520d9845902a700319dad8f3a2f9b5937c6c81be8fd",
      "concat_start": 49.116,
      "concat_end": 56.172
    },
    {
      "index": 16,
      "edit_id": "stats_and_question",
      "text": "制胜分，帕奥利尼二十六，贝莱克十七。一发得分率，百分之六十五对百分之五十六。武汉这一胜，能让帕奥利尼找回节奏吗？",
      "actual_cloud_mp3_sha256": "71955ec083fdd945a0daf94311a076f68bd652c25fcf77e831f6aa4cf586c1cb",
      "concat_start": 56.472,
      "concat_end": 67.944
    }
  ],
  "human_listening_claimed": false,
  "asr_proves_tones": false
}
