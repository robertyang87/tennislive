{
  "schema": "actual-current-speech-concat.v1",
  "sha256": "38fe64f7abd7d533acdbd5288727d5c1b745621b9b7e26e737931e59b222c230",
  "rows": [
    {
      "edit_id": "landing",
      "text": "帕奥利尼赢下两盘，过程却并不轻松。",
      "actual_mp3_sha256": "291e293fc3a28b245ed883e3daa6a7f5a8e73a7b170c44d5b14ff1ec1473a157",
      "concat_start": 0,
      "concat_end": 4.032
    },
    {
      "edit_id": "coordinate_and_rank",
      "text": "北京时间十月十二日下午，武汉首轮。帕奥利尼迎战贝莱克。",
      "actual_mp3_sha256": "a12797bf59b6ba8d8bbf0b6c236a169b96c8219a123c970f50f6fae983b506c9",
      "concat_start": 4.332,
      "concat_end": 10.620000000000001
    },
    {
      "edit_id": "first_set_pressure",
      "text": "帕奥利尼先冲到四比零。贝莱克继续追击，把这一盘的悬念又拉了回来。",
      "actual_mp3_sha256": "63f6a5d6f995e2825990ec21eb1a401792664903dbc1b03159dc8f418c99033b",
      "concat_start": 10.92,
      "concat_end": 17.759999999999998
    },
    {
      "edit_id": "first_set_payoff",
      "text": "贝莱克把比分追到三比五。帕奥利尼终于拿下盘点，六比三，先赢一盘。",
      "actual_mp3_sha256": "5600c183cc8429b7f19362dc3f27cbdc574f8abdd8bf9f86d7cc17d4be0ba61b",
      "concat_start": 18.06,
      "concat_end": 25.02
    },
    {
      "edit_id": "second_set_story",
      "text": "第二盘换了风向。贝莱克不断压回球来，帕奥利尼还得重新稳住发球。",
      "actual_mp3_sha256": "3741c4b53a5fdd986d97c0ab7d2d33cb9383143162ebacb7fed2100787975732",
      "concat_start": 25.32,
      "concat_end": 31.632
    },
    {
      "edit_id": "second_set_pressure",
      "text": "贝莱克拿到三比一。帕奥利尼又面对两次破发点，这一局必须守住。",
      "actual_mp3_sha256": "d39d2b650e5a00c04e02f0e2b465038274df286196faea1325f737ea3275b0f7",
      "concat_start": 31.932000000000002,
      "concat_end": 38.508
    },
    {
      "edit_id": "second_set_return",
      "text": "帕奥利尼没有退。她先回破，再救回自己的发球局。从一比三追到三比三，反扑还没有结束。",
      "actual_mp3_sha256": "06150ee907c49331606feee39d1e86eb6601604c38ef6b22fc1af4f41c6475a8",
      "concat_start": 38.808,
      "concat_end": 47.448
    },
    {
      "edit_id": "closing_break",
      "text": "四比三又被追回四比四。帕奥利尼再次破发，把机会带进自己的发球局。",
      "actual_mp3_sha256": "e431743922c333de2154f68aa10673d9ea8ab5b5660bb3963eab901f5c411931",
      "concat_start": 47.748,
      "concat_end": 54.803999999999995
    },
    {
      "edit_id": "stats_and_question",
      "text": "制胜分，帕奥利尼二十六，贝莱克十七。一发得分率，百分之六十五对百分之五十六。武汉这一胜，能让帕奥利尼找回节奏吗？",
      "actual_mp3_sha256": "6dc408c4ab91005810193604301a29dda7a0f752fb930bfc0ed9b976490cc510",
      "concat_start": 55.104,
      "concat_end": 66.816
    }
  ],
  "human_listening_claimed": false,
  "asr_proves_tones": false
}
