  {
    "edit_id": "deciding_set",
    "audio": {
      "ORIG": "/workspace/scratch/moon-qf-pronunciation/native-audio/deciding_set-184689d963d572f2.mp3",
      "A1": "/workspace/scratch/moon-qf-pronunciation/reference-audio/5bdb705cdb4988ba1469666c.mp3",
