  {
    "edit_id": "first_set_card",
    "audio": {
      "ORIG": "/workspace/scratch/moon-qf-pronunciation/native-audio/first_set_card-6823923842fde9f1.mp3",
      "A1": "/workspace/scratch/moon-qf-pronunciation/reference-audio/53be874b1eecd286a1b1e6ab.mp3",
      "A2": "/workspace/scratch/moon-qf-pronunciation/reference-audio/2d93b4a6cc23b22773d1db6b.mp3",
