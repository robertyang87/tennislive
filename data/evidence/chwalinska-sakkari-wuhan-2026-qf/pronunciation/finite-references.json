  {
    "edit_id": "second_set_card",
    "audio": {
      "ORIG": "/workspace/scratch/moon-qf-pronunciation/native-audio/second_set_card-e258bec14d4a55b4.mp3",
      "A1": "/workspace/scratch/moon-qf-pronunciation/reference-audio/83f93a00baf2a61bb2188e71.mp3",
      "A2": "/workspace/scratch/moon-qf-pronunciation/reference-audio/d54f8f9d319ae4781de0850e.mp3",
      "B1": "/workspace/scratch/moon-qf-pronunciation/reference-audio/ef3b386882f6a83d297cccf8.mp3",
      "B2": "/workspace/scratch/moon-qf-pronunciation/reference-audio/4bc3e2380ac10624621ff09a.mp3"
    },
    "texts": {
      "ORIG": "第二盘，萨卡里没有放手。零比一，月亮姐发球面对破发点。萨卡里从底线把球连续打向两侧，再跟进到场内，拿下这局。",
      "A1": "第二盘，卅咔礼枚有放手。零比一，岳谅姐發球面对破發点。卅咔礼从底线靶球连续打向两侧，再跟进到厂内，拿下这局。",
      "A2": "第二盘，飒佧理梅有放手。零比一，粤晾解发球面对破发点。飒佧理从底线钯球连续打向两侧，再跟进到昶内，拿下这局。",
      "B1": "第二盘，撒恰利沫有放手。零比一，约梁杰髮球面对破髮点。撒恰利从底线爸球连续达向两侧，再跟进到偿内，拿下这局。",
      "B2": "第二盘，洒洽力墨有放手。零比一，曰良洁珐球面对破珐点。洒洽力从底线霸球连续笪向两侧，再跟进到尝内，拿下这局。"
    },
