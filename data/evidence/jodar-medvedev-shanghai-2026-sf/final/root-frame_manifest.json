  "assigned_ass_cues": [
    {
      "cue_global_index": 4,
      "start": 10.45,
      "end": 13.01,
      "text": "{\\an2}北京时间{\\fs78}2026{\\fs68}年{\\fs78}10{\\fs68}月{\\fs78}17{\\fs68}日晚",
      "segment": 1
    },
    {
      "cue_global_index": 5,
      "start": 13.01,
      "end": 15.36,
      "text": "{\\an2}上海大师赛男单半决赛",
      "segment": 1
    },
    {
      "cue_global_index": 6,
      "start": 15.36,
      "end": 17.88,
      "text": "{\\an2}梅德韦杰夫迎战霍达尔",
      "segment": 1
    },
    {
      "cue_global_index": 7,
      "start": 17.88,
      "end": 20.26,
      "text": "{\\an2}对手前{\\fs78}4{\\fs68}轮全部逆转过关",
      "segment": 1
    },
    {
      "cue_global_index": 8,
      "start": 20.26,
      "end": 22.93,
      "text": "{\\an2}这次却先抢到了主动",
      "segment": 1
    },
    {
      "cue_global_index": 10,
      "start": 40.29,
      "end": 41.05,
      "text": "{\\an2}首盘",
      "segment": 3
    },
    {
      "cue_global_index": 11,
      "start": 41.05,
      "end": 43.82,
      "text": "{\\an2}梅德韦杰夫被破发后回破到{\\fs78}2{\\fs68}比{\\fs78}3{\\fs68}",
      "segment": 3
    },
    {
      "cue_global_index": 12,
      "start": 43.82,
      "end": 45.83,
      "text": "{\\an2}可随后又丢了发球局",
      "segment": 3
    },
    {
      "cue_global_index": 13,
      "start": 45.83,
      "end": 47.74,
      "text": "{\\an2}{\\fs78}5{\\fs68}比{\\fs78}3{\\fs68}的发球胜盘局",
      "segment": 3
    },
    {
      "cue_global_index": 14,
      "start": 47.74,
      "end": 50.46,
      "text": "{\\an2}霍达尔用了{\\fs78}5{\\fs68}个盘点才拿下",
      "segment": 3
    },
    {
      "cue_global_index": 15,
      "start": 50.46,
      "end": 53.68,
      "text": "{\\an2}梅总没放手 对手也没让步",
      "segment": 3
    },
    {
      "cue_global_index": 17,
      "start": 64.49,
      "end": 65.27,
      "text": "{\\an2}第二盘",
      "segment": 5
    },
    {
      "cue_global_index": 18,
      "start": 65.27,
      "end": 67.85,
      "text": "{\\an2}梅德韦杰夫从{\\fs78}0{\\fs68}比{\\fs78}2{\\fs68}追到{\\fs78}3{\\fs68}比{\\fs78}2{\\fs68}",
      "segment": 5
    },
    {
      "cue_global_index": 19,
      "start": 67.85,
      "end": 69.53,
      "text": "{\\an2}又被连拿{\\fs78}3{\\fs68}局",
      "segment": 5
    },
    {
      "cue_global_index": 20,
      "start": 69.53,
      "end": 72.16,
      "text": "{\\an2}{\\fs78}3{\\fs68}比{\\fs78}5{\\fs68} 他连救{\\fs78}3{\\fs68}个赛点",
      "segment": 5
    },
    {
      "cue_global_index": 21,
      "start": 72.16,
      "end": 74.22,
      "text": "{\\an2}第三次 梅总上网截击",
      "segment": 5
    },
    {
      "cue_global_index": 22,
      "start": 74.22,
      "end": 77.69,
      "text": "{\\an2}霍达尔追球摔坐在地 悬念还没结束",
      "segment": 5
    },
    {
      "cue_global_index": 28,
      "start": 124.21,
      "end": 127.51,
      "text": "{\\an2}第四个赛点 霍达尔正手穿越得分",
      "segment": 7
    },
    {
      "cue_global_index": 29,
      "start": 127.51,
      "end": 130.56,
      "text": "{\\an2}制胜分 梅德韦杰夫{\\fs78}15{\\fs68}比{\\fs78}22{\\fs68}",
      "segment": 7
    },
    {
      "cue_global_index": 30,
      "start": 130.56,
      "end": 133.38,
      "text": "{\\an2}非受迫失误 {\\fs78}21{\\fs68}比{\\fs78}22{\\fs68}",
      "segment": 7
    },
    {
      "cue_global_index": 31,
      "start": 133.38,
      "end": 135.52,
      "text": "{\\an2}{\\fs78}6{\\fs68}个破发点只兑现两个",
      "segment": 7
    },
    {
      "cue_global_index": 32,
      "start": 135.52,
      "end": 137.79,
      "text": "{\\an2}坚持没能变成逆转",
      "segment": 7
    },
    {
      "cue_global_index": 33,
      "start": 139.41,
      "end": 142.32,
      "text": "{\\an2}这一站先放下 下一站再来",
      "segment": 8
    },
    {
      "cue_global_index": 34,
      "start": 142.32,
      "end": 143.37,
      "text": "{\\an2}上海决赛",
      "segment": 8
    },
    {
      "cue_global_index": 35,
      "start": 143.37,
      "end": 145.93,
      "text": "{\\an2}霍达尔对阵达维多维奇 福基纳",
      "segment": 8
    },
    {
      "cue_global_index": 36,
      "start": 145.93,
      "end": 147.8,
      "text": "{\\an2}两位西班牙球员会师",
      "segment": 8
    },
    {
      "cue_global_index": 37,
      "start": 147.8,
      "end": 150.38,
      "text": "{\\an2}谁能把这一周走到最后？",
      "segment": 8
    }
  ],
