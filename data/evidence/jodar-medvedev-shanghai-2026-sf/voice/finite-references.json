  {
    "edit_id": "first_set_context",
    "audio": {
      "ORIG": "/workspace/scratch/jodar-medvedev-sf-voice/native-audio/first_set_context-164f45bc159bac81.mp3",
      "A1": "/workspace/scratch/jodar-medvedev-sf-voice/reference-audio/a8823aafe1a6fb079316f926.mp3",
      "A2": "/workspace/scratch/jodar-medvedev-sf-voice/reference-audio/5bdfafe670e9ea8a5fee4fdf.mp3",
      "B1": "/workspace/scratch/jodar-medvedev-sf-voice/reference-audio/bbf7dd2131fab8c57d403aef.mp3",
      "B2": "/workspace/scratch/jodar-medvedev-sf-voice/reference-audio/edde3f46575edc4c8566952f.mp3"
    },
    "texts": {
      "ORIG": "首盘，梅德韦杰夫被破发后回破到二比三，可随后又丢了发球局。五比三的发球胜盘局，霍达尔用了五个盘点才拿下。梅总没放手，对手也没让步。",
      "A1": "首盘，嵋锝围劫呋备破彂后回破到二比三，可随后又丢餎彂球局。五比三𠵨彂球胜盘局，惑妲洱用餎五个盘点才拿下。嵋㢔嵋放手，对手也嵋让步。",
      "A2": "首盘，枚㤫帏卩孵惫破沷后回破到二比三，可随后又丢了沷球局。五比三的沷球胜盘局，祸笪珥用了五个盘点才拿下。枚㷓枚放手，对手也枚让步。",
      "B1": "首盘，妹的卫借俘哔破珐后回破到二比三，可随后又丢㝋珐球局。五比三低珐球胜盘局，褐剃二用㝋五个盘点才拿下。妹粽寞放手，对手也寞让步。",
      "B2": "首盘，媚地喂届凫壁破㛲后回破到二比三，可随后又丢㶫㛲球局。五比三滴㛲球胜盘局，贺嚏贰用㶫五个盘点才拿下。媚纵沫放手，对手也沫让步。"
    },
