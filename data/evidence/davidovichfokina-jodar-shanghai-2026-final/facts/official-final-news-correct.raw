                <div class="article-header">
                    <div class="heading">
                        <h2>Davidovich Fokina stops Jodar for Shanghai title</h2>
                    </div>
                    <div class="tagline">Spaniard recovered from a set and a break down against his countryman</div>
                    <div class="timestamp-author">
                        <span>18 October 2026</span>
                        <span>By Andy West</span>
                    </div>
                </div>
                <script src="https://players.brightcove.net/6057277721001/xO4H0ZXngd_default/index.min.js"></script>
                <div class="article-hero-video">
                    <div class="atp_feature-article-video">
                        <div class="video-player">
                            <div class="video">
                                <video-js id="articleVideoJSPlayer"
                                    data-video-id="6407045465112"
                                    data-account="6057277721001"
                                    data-player="xO4H0ZXngd_default"
                                    data-video-tags="match-report,shanghai-5014,2026,next-gen-atp-finals,alejandro-davidovich-fokina-dh50,rafael-jodar-j0dz,story-of-the-season,premium"
                                    data-embed="default"
                                    data-application-id
                                    controls
                                    width="100%"
                                    height="100%">
                                </video-js>
                            </div>
                        </div>
                    </div>
                    <div class="video-captions">
                            <span> &copy; Hector Retamal/AFP via Getty Images</span>
                        <span>Alejandro Davidovich Fokina overcomes Rafael Jodar on Sunday to triumph at the Rolex Shanghai Masters.</span>
                    </div>
                </div>
                <div class="article-content">

                    
<div class="article-share">
    <h4 class="atp_heading-4">Share</h4>
    <ul>
        <li>
            <a href="https://www.facebook.com/sharer/sharer.php?u=http%3a%2f%2fen.rolexshanghaimasters.com%2fen%2fmedia%2fnews%2fjodar-davidovich-fokina-shanghai-2026-final">
