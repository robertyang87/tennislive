                <span class="icon-x"><i>Twitter</i></span>
            </a>
        </li>
        <li>
            <a href="https://www.linkedin.com/shareArticle?mini=true&amp;url=http%3a%2f%2fen.rolexshanghaimasters.com%2fen%2fmedia%2fnews%2fjodar-davidovich-fokina-shanghai-2026-final&amp;title=Jodar+Davidovich+Fokina+Shanghai+2026+Final+%7c+Rolex+Shanghai+Masters">
                <span class="icon-linkedin2"><i>Linked In</i></span>
            </a>
        </li>
