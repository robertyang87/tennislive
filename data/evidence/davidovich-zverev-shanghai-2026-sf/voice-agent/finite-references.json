  {
    "edit_id": "deciding_set_context",
    "audio": {
      "ORIG": "/workspace/scratch/zverev-sf-voice/native-audio/deciding_set_context-1a300545001e5c37.mp3",
      "A1": "/workspace/scratch/zverev-sf-voice/reference-audio/ee2f78e96548117c382fc044.mp3",
      "A2": "/workspace/scratch/zverev-sf-voice/reference-audio/08cdcf3642de1f41bbefc64b.mp3",
      "B1": "/workspace/scratch/zverev-sf-voice/reference-audio/177faa4d3d9c06f10d503bd8.mp3",
      "B2": "/workspace/scratch/zverev-sf-voice/reference-audio/494ee3b2cd0c9bfc0faf24a9.mp3"
    },
    "texts": {
      "ORIG": "决胜盘开局，一次双误，让兹维列夫先丢发球局。二比五落后，他扛过两个赛点，追到三比五。可接下来，轮到对手发球。",
      "A1": "决胜盘开局，一次双误，让咨围冽呋先丢彂球局。二比五摞后，他摃㳀两个赛点，追到三比五。可接下来，轮到对手彂球。",
      "A2": "决胜盘开局，一次双误，让孜帏劣孵先丢沷球局。二比五洛后，他𢴦𠋜两个赛点，追到三比五。可接下来，轮到对手沷球。",
      "B1": "决胜盘开局，一次双误，让慈卫俐俘先丢珐球局。二比五瘌后，他冈呙两个赛点，追到三比五。可接下来，轮到对手珐球。",
      "B2": "决胜盘开局，一次双误，让瓷喂俪凫先丢㛲球局。二比五辣后，他刚埚两个赛点，追到三比五。可接下来，轮到对手㛲球。"
    },
