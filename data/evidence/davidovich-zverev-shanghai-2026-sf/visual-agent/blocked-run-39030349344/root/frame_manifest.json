  "assigned_ass_cues": [
    {
      "cue_global_index": 4,
      "start": 11.89,
      "end": 14.63,
      "text": "{\\an2}北京时间{\\fs78}2026{\\fs68}年{\\fs78}10{\\fs68}月{\\fs78}17{\\fs68}日下午",
      "segment": 1
    },
    {
      "cue_global_index": 5,
      "start": 14.63,
      "end": 16.96,
      "text": "{\\an2}上海大师赛男单半决赛",
      "segment": 1
    },
    {
      "cue_global_index": 6,
      "start": 16.96,
      "end": 19.22,
      "text": "{\\an2}提前锁定年终第一的兹维列夫",
      "segment": 1
    },
    {
      "cue_global_index": 7,
      "start": 19.22,
      "end": 21.51,
      "text": "{\\an2}对阵达维多维奇 福基纳",
      "segment": 1
    },
    {
      "cue_global_index": 8,
      "start": 21.51,
      "end": 22.97,
      "text": "{\\an2}首盘{\\fs78}9{\\fs68}记{\\fs78}ACE{\\fs68}",
      "segment": 1
    },
    {
      "cue_global_index": 9,
      "start": 22.97,
      "end": 25.13,
      "text": "{\\an2}没给对手一个破发点",
      "segment": 1
    },
    {
      "cue_global_index": 10,
      "start": 25.13,
      "end": 27.03,
      "text": "{\\an2}{\\fs78}5{\\fs68}比{\\fs78}5{\\fs68}之后率先破发",
      "segment": 1
    },
    {
      "cue_global_index": 11,
      "start": 27.03,
      "end": 29.62,
      "text": "{\\an2}他拿到先赢一盘的机会",
      "segment": 1
    },
    {
      "cue_global_index": 14,
      "start": 38.85,
      "end": 40.37,
      "text": "{\\an2}首盘{\\fs78}7{\\fs68}比{\\fs78}5{\\fs68}之后",
      "segment": 3
    },
    {
      "cue_global_index": 15,
      "start": 40.37,
      "end": 42.4,
      "text": "{\\an2}第二盘的压力换边了",
      "segment": 3
    },
    {
      "cue_global_index": 16,
      "start": 42.4,
      "end": 44.25,
      "text": "{\\an2}兹维列夫的一发得分率",
      "segment": 3
    },
    {
      "cue_global_index": 17,
      "start": 44.25,
      "end": 47.55,
      "text": "{\\an2}从{\\fs78}79{\\fs68}%降到{\\fs78}65{\\fs68}%",
      "segment": 3
    },
    {
      "cue_global_index": 18,
      "start": 47.55,
      "end": 48.36,
      "text": "{\\an2}{\\fs78}4{\\fs68}比{\\fs78}5{\\fs68}",
      "segment": 3
    },
    {
      "cue_global_index": 19,
      "start": 48.36,
      "end": 52.36,
      "text": "{\\an2}对手在盘点上打出奔跑中的反手穿越",
      "segment": 3
    },
    {
      "cue_global_index": 21,
      "start": 74.31,
      "end": 76.36,
      "text": "{\\an2}决胜盘开局 一次双误",
      "segment": 5
    },
    {
      "cue_global_index": 22,
      "start": 76.36,
      "end": 78.85,
      "text": "{\\an2}让兹维列夫先丢发球局",
      "segment": 5
    },
    {
      "cue_global_index": 23,
      "start": 78.85,
      "end": 81.45,
      "text": "{\\an2}{\\fs78}2{\\fs68}比{\\fs78}5{\\fs68}落后 他扛过两个赛点",
      "segment": 5
    },
    {
      "cue_global_index": 24,
      "start": 81.45,
      "end": 83.02,
      "text": "{\\an2}追到{\\fs78}3{\\fs68}比{\\fs78}5{\\fs68}",
      "segment": 5
    },
    {
      "cue_global_index": 25,
      "start": 83.02,
      "end": 85.8,
      "text": "{\\an2}可接下来 轮到对手发球",
      "segment": 5
    },
    {
      "cue_global_index": 34,
      "start": 130.07,
      "end": 133.0,
      "text": "{\\an2}全场{\\fs78}18{\\fs68}记{\\fs78}ACE{\\fs68} 没能换来胜利",
      "segment": 7
    },
    {
      "cue_global_index": 35,
      "start": 133.0,
      "end": 135.0,
      "text": "{\\an2}制胜分{\\fs78}28{\\fs68}比{\\fs78}36{\\fs68}",
      "segment": 7
    },
    {
      "cue_global_index": 36,
      "start": 135.0,
      "end": 137.52,
      "text": "{\\an2}非受迫失误{\\fs78}20{\\fs68}比{\\fs78}21{\\fs68}",
      "segment": 7
    },
    {
      "cue_global_index": 37,
      "start": 137.52,
      "end": 139.24,
      "text": "{\\an2}兹维列夫的发球有威力",
      "segment": 7
    },
    {
      "cue_global_index": 38,
      "start": 139.24,
      "end": 141.56,
      "text": "{\\an2}进攻得分却少了{\\fs78}8{\\fs68}个",
      "segment": 7
    },
    {
      "cue_global_index": 39,
      "start": 143.07,
      "end": 144.31,
      "text": "{\\an2}另一场半决赛",
      "segment": 8
    },
    {
      "cue_global_index": 40,
      "start": 144.31,
      "end": 147.32,
      "text": "{\\an2}梅德韦杰夫对阵霍达尔 胜者",
      "segment": 8
    },
    {
      "cue_global_index": 41,
      "start": 147.32,
      "end": 150.05,
      "text": "{\\an2}将与达维多维奇 福基纳争冠",
      "segment": 8
    },
    {
      "cue_global_index": 42,
      "start": 150.05,
      "end": 152.47,
      "text": "{\\an2}兹维列夫 这一站先放下",
      "segment": 8
    },
    {
      "cue_global_index": 43,
      "start": 152.47,
      "end": 154.06,
      "text": "{\\an2}下一站再来",
      "segment": 8
    },
    {
      "cue_global_index": 44,
      "start": 154.06,
      "end": 157.68,
      "text": "{\\an2}接下来 你最期待他做出什么改变？",
      "segment": 8
    }
  ],
