    "edit_id": "first_set_close_card",
    "audio": {
      "ORIG": "/workspace/scratch/iga-qf-pronunciation/native-audio/first_set_close_card-631592ffbd394fef.mp3",
      "A1": "/workspace/scratch/iga-qf-pronunciation/reference-audio/fc246d919878479282e0a571.mp3",
