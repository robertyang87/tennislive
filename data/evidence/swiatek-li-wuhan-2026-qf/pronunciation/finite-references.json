  {
    "edit_id": "tactic2",
    "audio": {
      "ORIG": "/workspace/scratch/iga-qf-pronunciation/native-audio/tactic2-9dd313b7ec0e29e9.mp3",
      "A1": "/workspace/scratch/iga-qf-pronunciation/reference-audio/51ebe7a96defa5801b73d6d8.mp3",
      "A2": "/workspace/scratch/iga-qf-pronunciation/reference-audio/6e2c5964fc57e4729b2c2845.mp3",
      "B1": "/workspace/scratch/iga-qf-pronunciation/reference-audio/4b88a4d39bcbe5e53eb2c3f8.mp3",
      "B2": "/workspace/scratch/iga-qf-pronunciation/reference-audio/ca330a25915ca7ce0483eab7.mp3"
    },
    "texts": {
      "ORIG": "二比一，这次看远端。她沿着底线来回移动，又把球连续打向两侧，让对手一趟趟左右奔跑。这个常回合，最后以对手回球出界结束。",
      "A1": "二比一，这次瞰远端。她沿着底线来回移动，又靶球连续打向两侧，让对手一趟趟左右奔跑。这个常回合，最后以对手回球出界杰束。",
      "A2": "二比一，这次磡远端。她沿著底线来回移动，又钯球连续打向两侧，让对手一趟趟左右锛跑。这个常回合，最后以对手回球出界洁束。",
      "B1": "二比一，这次刊远端。她沿灼底线来回移动，又爸球连续达向两侧，让对手一趟趟左右笨跑。这个常回合，最后以对手回球出界街束。",
      "B2": "二比一，这次堪远端。她沿酌底线来回移动，又霸球连续笪向两侧，让对手一趟趟左右坌跑。这个常回合，最后以对手回球出界阶束。"
    },
