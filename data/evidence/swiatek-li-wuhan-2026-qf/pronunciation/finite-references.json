  {
    "edit_id": "intro",
    "audio": {
      "ORIG": "/workspace/scratch/iga-qf-pronunciation/native-audio/intro-bfeb155a047ec5ee.mp3",
      "A1": "/workspace/scratch/iga-qf-pronunciation/reference-audio/dfa357ca5e102fa17471abde.mp3",
