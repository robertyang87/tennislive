  "assigned_ass_cues": [
    {
      "cue_global_index": 5,
      "start": 14.11,
      "end": 16.95,
      "text": "{\\an2}北京时间{\\fs78}2026{\\fs68}年{\\fs78}10{\\fs68}月{\\fs78}16{\\fs68}日晚上",
      "segment": 1
    },
    {
      "cue_global_index": 6,
      "start": 16.95,
      "end": 19.27,
      "text": "{\\an2}武汉{\\fs78}1000{\\fs68}赛女单{\\fs78}1{\\fs68}/{\\fs78}4{\\fs68}决赛",
      "segment": 1
    },
    {
      "cue_global_index": 7,
      "start": 19.27,
      "end": 21.12,
      "text": "{\\an2}斯瓦泰克对阵安李",
      "segment": 1
    },
    {
      "cue_global_index": 8,
      "start": 21.12,
      "end": 22.76,
      "text": "{\\an2}开场连赢两局之后",
      "segment": 1
    },
    {
      "cue_global_index": 9,
      "start": 22.76,
      "end": 25.75,
      "text": "{\\an2}比赛来到{\\fs78}4{\\fs68}比{\\fs78}3{\\fs68} 她的发球局",
      "segment": 1
    },
    {
      "cue_global_index": 14,
      "start": 40.31,
      "end": 43.34,
      "text": "{\\an2}{\\fs78}5{\\fs68}比{\\fs78}4{\\fs68}的发球胜盘局 {\\fs78}15{\\fs68}比{\\fs78}40{\\fs68}",
      "segment": 3
    },
    {
      "cue_global_index": 15,
      "start": 43.34,
      "end": 45.33,
      "text": "{\\an2}她先救下两个破发点",
      "segment": 3
    },
    {
      "cue_global_index": 16,
      "start": 45.33,
      "end": 48.17,
      "text": "{\\an2}回到平分后 又化解第三个",
      "segment": 3
    },
    {
      "cue_global_index": 17,
      "start": 48.17,
      "end": 51.56,
      "text": "{\\an2}接下来 才是她自己的第一个盘点",
      "segment": 3
    },
    {
      "cue_global_index": 51,
      "start": 183.64,
      "end": 185.46,
      "text": "{\\an2}{\\fs78}8{\\fs68}个发球局全部保住",
      "segment": 8
    },
    {
      "cue_global_index": 52,
      "start": 185.46,
      "end": 188.39,
      "text": "{\\an2}面对{\\fs78}3{\\fs68}个破发点 她全部化解",
      "segment": 8
    },
    {
      "cue_global_index": 53,
      "start": 188.39,
      "end": 189.95,
      "text": "{\\an2}制胜分{\\fs78}10{\\fs68}比{\\fs78}13{\\fs68}",
      "segment": 8
    },
    {
      "cue_global_index": 54,
      "start": 189.95,
      "end": 193.05,
      "text": "{\\an2}非受迫失误{\\fs78}28{\\fs68}比{\\fs78}49{\\fs68}",
      "segment": 8
    },
    {
      "cue_global_index": 55,
      "start": 194.64,
      "end": 197.09,
      "text": "{\\an2}下一场 就是月亮姐",
      "segment": 9
    },
    {
      "cue_global_index": 56,
      "start": 197.09,
      "end": 199.12,
      "text": "{\\an2}曾经的青少年双打搭档",
      "segment": 9
    },
    {
      "cue_global_index": 57,
      "start": 199.12,
      "end": 201.1,
      "text": "{\\an2}如今要在武汉隔网相对",
      "segment": 9
    },
    {
      "cue_global_index": 58,
      "start": 201.1,
      "end": 203.01,
      "text": "{\\an2}争一张决赛门票",
      "segment": 9
    },
    {
      "cue_global_index": 59,
      "start": 203.01,
      "end": 204.89,
      "text": "{\\an2}你更看好谁？",
      "segment": 9
    }
  ],
