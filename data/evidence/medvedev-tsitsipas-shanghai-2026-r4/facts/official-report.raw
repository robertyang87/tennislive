                <div class="article-header">
                    <div class="heading">
                        <h2>Medvedev continues Shanghai love affair, defeats Tsitsipas to reach QFs</h2>
                    </div>
                    <div class="tagline">Medvedev is the only former champion left in the draw</div>
                    <div class="timestamp-author">
                        <span>14 October 2026</span>
                        <span>By Sam Jacot</span>
                    </div>
                </div>
                <script src="https://players.brightcove.net/6057277721001/xO4H0ZXngd_default/index.min.js"></script>
