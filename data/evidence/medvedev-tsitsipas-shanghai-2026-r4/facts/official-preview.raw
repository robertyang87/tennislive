                <div class="article-header">
                    <div class="heading">
                        <h2>Wednesday preview: Medvedev, Tsitsipas renew rivalry</h2>
                    </div>
                    <div class="tagline">Auger-Aliassime and Ruud meet during the day session</div>
                    <div class="timestamp-author">
                        <span>13 October 2026</span>
                        <span>By Rolex Shanghai Masters</span>
                    </div>
                </div>
                <div class="article-hero-image">
                    <div class="image-container">
                        <div class="image">
                            <img src="/-/media/images/tournaments-news/shanghai/2026-week-2/medvedev-day-8-preview-2026.jpg" alt="Tokyo Take-Off! Shapovalov Serves Past Johnson">
                        </div>
                    </div>
                    <div class="image-captions">
                            <span> &copy; Rolex Shanghai Masters</span>
                        <span>Daniil Medvedev continues his quest for a second Rolex Shanghai Masters title Wednesday.</span>
                    </div>
                </div>
                <div class="article-content">

                    
<div class="article-share">
    <h4 class="atp_heading-4">Share</h4>
    <ul>
        <li>
            <a href="https://www.facebook.com/sharer/sharer.php?u=http%3a%2f%2fen.rolexshanghaimasters.com%2fen%2fmedia%2fnews%2fwednesday-preview-medvedev-zverev">
                <span class="icon-facebook"><i>Facebook</i></span>
            </a>
        </li>
