    },
    {
      "id": "bundle:a23591a9142bfdb41e41b889c697992633fa1ae70e6149150b9f107459dd3db1",
      "request_id": "a23591a9142bfdb41e41b889c697992633fa1ae70e6149150b9f107459dd3db1",
      "request": {
        "backend": "edge",
        "cache_key": "0b3ae50eda46879ade5e57bf080a5760",
        "lead_pause": 0.0,
        "pitch": "+0Hz",
        "rate": "+6%",
        "style": "",
        "styledegree": "",
        "text": "机会还没完。七比六，王欣瑜第三次握住盘点。只要再赢这一分，就有第三盘。帕克斯又一次顶住，继续往网前逼近。",
        "voice": "zh-CN-YunjianNeural"
      },
      "audio_sha256": "59664b67592c741c4144e5b82897c633b627c7143fedf275106c4a1317a0700e",
      "words_sha256": "5e7ba444eaeabfb5eac0669a922e0e7fa751ebf0f51478466c9d7f14b6350617"
    },
    {
      "id": "bundle:b80ad40cf03e2a1bf0849f74b5dd89f9591e3dfac6354816bf5cd093c739d31d",
      "request_id": "b80ad40cf03e2a1bf0849f74b5dd89f9591e3dfac6354816bf5cd093c739d31d",
