        {
          "at": 5.07,
          "end": 7.25,
          "en": "It's amazing to play in front of you,",
          "zh": "能在你们面前打球，感觉特别好，",
          "source_start": 535.22,
          "source_end": 537.4
        },
        {
          "at": 7.35,
          "end": 8.93,
          "en": "always gives a lot of motivation,",
          "zh": "总能给我很多动力，",
          "source_start": 537.5,
          "source_end": 539.08
        },
