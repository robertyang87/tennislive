Dialogue: 0,0:00:01.30,0:00:03.98,TL,,0,0,0,,{\fs78}4{\fs68}比{\fs78}3{\fs68} 纳达尔队赢了
Dialogue: 0,0:00:06.10,0:00:07.69,TL,,0,0,0,,{\fs78}6{\fs68}场打成{\fs78}3{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:07.69,0:00:10.27,TL,,0,0,0,,纳达尔队拿下加赛 {\fs78}4{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:00:10.27,0:00:14.02,TL,,0,0,0,,{\fs78}10{\fs68}周年 老朋友又站上同一片球场
Dialogue: 0,0:00:18.40,0:00:20.48,TL,,0,0,0,,首场就打到九平
Dialogue: 0,0:00:20.48,0:00:23.15,TL,,0,0,0,,莫亚和加斯奎特拿下最后一分
Dialogue: 0,0:00:23.15,0:00:25.73,TL,,0,0,0,,{\fs78}10{\fs68}比{\fs78}9{\fs68} 纳达尔队先拿一分
Dialogue: 0,0:00:25.73,0:00:27.45,TL,,0,0,0,,学院{\fs78}10{\fs68}周年表演赛
Dialogue: 0,0:00:27.45,0:00:30.52,TL,,0,0,0,,{\fs78}8{\fs68}位老朋友在马纳科尔重聚
Dialogue: 0,0:00:40.40,0:00:42.87,TL,,0,0,0,,第二场 纳达尔搭档费雷尔
Dialogue: 0,0:00:42.87,0:00:44.62,TL,,0,0,0,,他们一度{\fs78}5{\fs68}比{\fs78}1{\fs68}领先
Dialogue: 0,0:00:44.62,0:00:46.99,TL,,0,0,0,,穆雷和蒂姆追到九平
Dialogue: 0,0:00:46.99,0:00:49.99,TL,,0,0,0,,最后这一分 底线和网前连续交锋
Dialogue: 0,0:00:49.99,0:00:51.72,TL,,0,0,0,,直到穆雷队{\fs78}10{\fs68}比{\fs78}9{\fs68}拿下
Dialogue: 0,0:00:51.72,0:00:53.84,TL,,0,0,0,,团体比分{\fs78}1{\fs68}比{\fs78}1{\fs68}
Dialogue: 0,0:01:16.40,0:01:19.04,TL,,0,0,0,,费雷尔和加斯奎特追到{\fs78}8{\fs68}比{\fs78}9{\fs68}
Dialogue: 0,0:01:19.04,0:01:21.54,TL,,0,0,0,,蒂姆和弗格尼尼守住最后一分
Dialogue: 0,0:01:21.54,0:01:23.68,TL,,0,0,0,,{\fs78}8{\fs68}比{\fs78}10{\fs68} 穆雷队连赢两场
Dialogue: 0,0:01:23.68,0:01:25.92,TL,,0,0,0,,团体{\fs78}2{\fs68}比{\fs78}1{\fs68}反超
Dialogue: 0,0:01:43.90,0:01:46.10,TL,,0,0,0,,纳达尔换上搭档加斯奎特
Dialogue: 0,0:01:46.10,0:01:47.80,TL,,0,0,0,,第四场{\fs78}10{\fs68}比{\fs78}0{\fs68}
Dialogue: 0,0:01:47.80,0:01:49.65,TL,,0,0,0,,双打看的是前后配合
Dialogue: 0,0:01:49.65,0:01:51.09,TL,,0,0,0,,底线负责来回球
Dialogue: 0,0:01:51.09,0:01:53.35,TL,,0,0,0,,网前搭档横移保护中路
Dialogue: 0,0:01:53.35,0:01:56.86,TL,,0,0,0,,纳达尔队把团体比分扳成{\fs78}2{\fs68}比{\fs78}2{\fs68}
Dialogue: 0,0:02:05.90,0:02:07.06,TL,,0,0,0,,{\fs78}10{\fs68}比{\fs78}0{\fs68}结束
Dialogue: 0,0:02:07.06,0:02:09.93,TL,,0,0,0,,纳达尔队把局势重新扳平
Dialogue: 0,0:02:12.90,0:02:15.00,TL,,0,0,0,,莫亚和费雷尔{\fs78}9{\fs68}比{\fs78}5{\fs68}领先
Dialogue: 0,0:02:15.00,0:02:17.43,TL,,0,0,0,,却还没能结束这一场
Dialogue: 0,0:02:21.90,0:02:24.68,TL,,0,0,0,,蒂姆和萨芬一路追到{\fs78}9{\fs68}比{\fs78}8{\fs68}
Dialogue: 0,0:02:24.68,0:02:27.43,TL,,0,0,0,,最后这一分 莫亚和费雷尔守住了
Dialogue: 0,0:02:27.43,0:02:30.44,TL,,0,0,0,,{\fs78}10{\fs68}比{\fs78}8{\fs68} 纳达尔队{\fs78}3{\fs68}比{\fs78}2{\fs68}领先
Dialogue: 0,0:02:40.90,0:02:44.09,TL,,0,0,0,,第六场 纳达尔和莫亚曾{\fs78}7{\fs68}比{\fs78}4{\fs68}领先
Dialogue: 0,0:02:44.09,0:02:46.85,TL,,0,0,0,,穆雷和弗格尼尼却追到七平
Dialogue: 0,0:02:46.85,0:02:49.08,TL,,0,0,0,,这一分 纳达尔右侧接发
Dialogue: 0,0:02:49.08,0:02:52.49,TL,,0,0,0,,被带到双打边线外 莫亚留在网前
Dialogue: 0,0:02:52.49,0:02:56.06,TL,,0,0,0,,{\fs78}7{\fs68}比{\fs78}10{\fs68} {\fs78}6{\fs68}场结束 双方{\fs78}3{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:03:06.90,0:03:09.92,TL,,0,0,0,,胜负交给加赛 还是纳达尔和莫亚
Dialogue: 0,0:03:09.92,0:03:11.91,TL,,0,0,0,,对穆雷和弗格尼尼
Dialogue: 0,0:03:11.91,0:03:14.67,TL,,0,0,0,,纳达尔队一度{\fs78}5{\fs68}比{\fs78}3{\fs68}领先
Dialogue: 0,0:03:17.90,0:03:19.27,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}3{\fs68}没能收住
Dialogue: 0,0:03:19.27,0:03:21.33,TL,,0,0,0,,穆雷队追到了{\fs78}5{\fs68}比{\fs78}5{\fs68}
Dialogue: 0,0:03:21.33,0:03:24.52,TL,,0,0,0,,最后两分 才真正分出胜负
Dialogue: 0,0:03:27.30,0:03:30.68,TL,,0,0,0,,{\fs78}5{\fs68}比{\fs78}5{\fs68}之后 纳达尔队再次领先
Dialogue: 0,0:03:46.10,0:03:48.84,TL,,0,0,0,,加赛{\fs78}7{\fs68}比{\fs78}5{\fs68} 总比分{\fs78}4{\fs68}比{\fs78}3{\fs68}
Dialogue: 0,0:03:48.84,0:03:52.26,TL,,0,0,0,,大家走到网前 握手 笑着重聚
Dialogue: 0,0:03:52.26,0:03:53.13,TL,,0,0,0,,下一次
Dialogue: 0,0:03:53.13,0:03:56.34,TL,,0,0,0,,他们还会一起站上这片球场吗？
