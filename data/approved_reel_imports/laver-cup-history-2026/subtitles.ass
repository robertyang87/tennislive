Dialogue: 0,0:00:03.84,0:00:06.10,TL,,0,0,0,,拉沃尔杯诞生于费德勒的一个构想
Dialogue: 0,0:00:06.10,0:00:08.31,TL,,0,0,0,,让平时隔网相争的顶尖球员
Dialogue: 0,0:00:08.31,0:00:09.73,TL,,0,0,0,,像高尔夫莱德杯那样
Dialogue: 0,0:00:09.73,0:00:11.39,TL,,0,0,0,,为同一支队伍而战
Dialogue: 0,0:00:11.39,0:00:14.14,TL,,0,0,0,,他和团队 合作伙伴推动赛事落地
Dialogue: 0,0:00:14.14,0:00:15.98,TL,,0,0,0,,组成欧洲队与世界队
Dialogue: 0,0:00:15.98,0:00:18.11,TL,,0,0,0,,这项比赛没有用费德勒的名字
Dialogue: 0,0:00:18.11,0:00:19.98,TL,,0,0,0,,而是以罗德 拉沃尔命名
Dialogue: 0,0:00:19.98,0:00:21.67,TL,,0,0,0,,向网球前辈致敬
Dialogue: 0,0:00:21.79,0:00:24.44,TL,,0,0,0,,拉沃尔在{\fs78}1962{\fs68}年和{\fs78}1969{\fs68}年
Dialogue: 0,0:00:24.44,0:00:27.79,TL,,0,0,0,,两次在同一年赢下四大满贯男单冠军
Dialogue: 0,0:00:27.79,0:00:29.98,TL,,0,0,0,,拉沃尔杯把他的名字留在奖杯上
Dialogue: 0,0:00:29.98,0:00:32.44,TL,,0,0,0,,也把网球的过去 现在和下一代
Dialogue: 0,0:00:32.44,0:00:33.83,TL,,0,0,0,,放进同一个周末
Dialogue: 0,0:00:33.96,0:00:34.89,TL,,0,0,0,,{\fs78}2017{\fs68}年
Dialogue: 0,0:00:34.89,0:00:37.50,TL,,0,0,0,,首届拉沃尔杯在捷克布拉格举行
Dialogue: 0,0:00:37.50,0:00:39.13,TL,,0,0,0,,从那一年到{\fs78}2025{\fs68}年
Dialogue: 0,0:00:39.13,0:00:40.69,TL,,0,0,0,,赛事一共办了{\fs78}8{\fs68}届
Dialogue: 0,0:00:40.69,0:00:42.49,TL,,0,0,0,,{\fs78}2020{\fs68}年没有举办
Dialogue: 0,0:00:42.49,0:00:44.01,TL,,0,0,0,,欧洲队包揽最初{\fs78}4{\fs68}届
Dialogue: 0,0:00:44.01,0:00:45.96,TL,,0,0,0,,但后来世界队开始反击
Dialogue: 0,0:00:45.96,0:00:47.95,TL,,0,0,0,,前{\fs78}8{\fs68}届打完 欧洲队五冠
Dialogue: 0,0:00:47.95,0:00:49.12,TL,,0,0,0,,世界队三冠
Dialogue: 0,0:00:49.30,0:00:51.69,TL,,0,0,0,,首届比赛最让球迷兴奋的画面
Dialogue: 0,0:00:51.69,0:00:54.35,TL,,0,0,0,,就是费德勒和纳达尔联手打双打
Dialogue: 0,0:00:54.35,0:00:56.19,TL,,0,0,0,,他们击败奎里和索克
Dialogue: 0,0:00:56.19,0:00:57.93,TL,,0,0,0,,平时研究怎样打败对方
Dialogue: 0,0:00:57.93,0:01:00.46,TL,,0,0,0,,这一次 他们要研究怎样一起赢
Dialogue: 0,0:01:00.59,0:01:02.54,TL,,0,0,0,,连默契不足都成了名场面
Dialogue: 0,0:01:02.54,0:01:05.14,TL,,0,0,0,,对手挑起高球 两个人一起冲过去
Dialogue: 0,0:01:05.14,0:01:06.68,TL,,0,0,0,,费德勒最后赶紧低头
Dialogue: 0,0:01:06.68,0:01:08.34,TL,,0,0,0,,给纳达尔让出扣杀
Dialogue: 0,0:01:08.34,0:01:10.90,TL,,0,0,0,,你看见的 不再只是冠军的技术
Dialogue: 0,0:01:10.90,0:01:12.71,TL,,0,0,0,,还有他们当队友时的另一面
Dialogue: 0,0:01:12.84,0:01:14.07,TL,,0,0,0,,{\fs78}2022{\fs68}年伦敦
Dialogue: 0,0:01:14.07,0:01:16.38,TL,,0,0,0,,费德勒把职业生涯的最后一场比赛
Dialogue: 0,0:01:16.38,0:01:17.77,TL,,0,0,0,,留给了拉沃尔杯
Dialogue: 0,0:01:17.77,0:01:19.18,TL,,0,0,0,,隔网争了那么多年
Dialogue: 0,0:01:19.18,0:01:21.65,TL,,0,0,0,,那一晚 纳达尔站在他身边
Dialogue: 0,0:01:21.65,0:01:23.34,TL,,0,0,0,,这项比赛最特别的地方
Dialogue: 0,0:01:23.34,0:01:25.04,TL,,0,0,0,,就是让宿敌成为队友
Dialogue: 0,0:01:25.21,0:01:27.03,TL,,0,0,0,,比赛由欧洲队对阵世界队
Dialogue: 0,0:01:27.03,0:01:29.93,TL,,0,0,0,,每队六名球员 打{\fs78}3{\fs68}天单打和双打
Dialogue: 0,0:01:29.93,0:01:31.69,TL,,0,0,0,,世界队指欧洲以外的球员
Dialogue: 0,0:01:31.69,0:01:33.71,TL,,0,0,0,,不是全世界对欧洲的字面重复
Dialogue: 0,0:01:33.71,0:01:36.05,TL,,0,0,0,,也不是按国家报名的戴维斯杯
Dialogue: 0,0:01:36.05,0:01:39.13,TL,,0,0,0,,标志性的黑色硬地 就是它的舞台
Dialogue: 0,0:01:39.30,0:01:40.74,TL,,0,0,0,,它没有世界排名积分
Dialogue: 0,0:01:40.74,0:01:43.86,TL,,0,0,0,,却不能简单理解成随便打打的表演赛
Dialogue: 0,0:01:43.86,0:01:44.97,TL,,0,0,0,,{\fs78}2019{\fs68}年起
Dialogue: 0,0:01:44.97,0:01:47.51,TL,,0,0,0,,它成为{\fs78}ATP{\fs68}赛历的正式组成部分
Dialogue: 0,0:01:47.51,0:01:49.82,TL,,0,0,0,,个人比赛结果计入官方战绩
Dialogue: 0,0:01:49.82,0:01:52.29,TL,,0,0,0,,{\fs78}2024{\fs68}年 双方又续约{\fs78}5{\fs68}年
Dialogue: 0,0:01:52.46,0:01:54.92,TL,,0,0,0,,每队{\fs78}3{\fs68}个名额按法网结束后周一的
Dialogue: 0,0:01:54.92,0:01:56.45,TL,,0,0,0,,单打排名发出邀请
Dialogue: 0,0:01:56.45,0:01:58.38,TL,,0,0,0,,另外{\fs78}3{\fs68}个由队长选择
Dialogue: 0,0:01:58.38,0:02:00.81,TL,,0,0,0,,有人不参加 邀请可以顺延
Dialogue: 0,0:02:00.81,0:02:03.25,TL,,0,0,0,,所以它并不保证世界排名最高的
Dialogue: 0,0:02:03.25,0:02:05.04,TL,,0,0,0,,{\fs78}12{\fs68}个人全部到场
Dialogue: 0,0:02:05.04,0:02:07.18,TL,,0,0,0,,阵容最后还要看球员是否接受
Dialogue: 0,0:02:07.18,0:02:08.04,TL,,0,0,0,,能否出赛
Dialogue: 0,0:02:08.17,0:02:10.87,TL,,0,0,0,,真正让它有戏的是计分 周五赢一场
Dialogue: 0,0:02:10.87,0:02:14.13,TL,,0,0,0,,一分 周六 两分 周日 三分
Dialogue: 0,0:02:14.13,0:02:16.37,TL,,0,0,0,,每天安排{\fs78}3{\fs68}场单打 一场双打
Dialogue: 0,0:02:16.37,0:02:18.98,TL,,0,0,0,,常规{\fs78}12{\fs68}场 总共{\fs78}24{\fs68}分
Dialogue: 0,0:02:18.98,0:02:21.42,TL,,0,0,0,,先达到至少{\fs78}13{\fs68}分的队伍夺冠
Dialogue: 0,0:02:21.54,0:02:22.72,TL,,0,0,0,,算一笔就懂了
Dialogue: 0,0:02:22.72,0:02:25.16,TL,,0,0,0,,前两天{\fs78}8{\fs68}场全赢 也只有{\fs78}12{\fs68}分
Dialogue: 0,0:02:25.16,0:02:27.71,TL,,0,0,0,,冠军仍然得等到周日才能产生
Dialogue: 0,0:02:27.71,0:02:29.03,TL,,0,0,0,,而周日一场胜利
Dialogue: 0,0:02:29.03,0:02:30.87,TL,,0,0,0,,就相当于周五三场
Dialogue: 0,0:02:30.87,0:02:33.79,TL,,0,0,0,,领先有价值 但还没有资格提前庆祝
Dialogue: 0,0:02:33.92,0:02:34.83,TL,,0,0,0,,{\fs78}2022{\fs68}年
Dialogue: 0,0:02:34.83,0:02:37.09,TL,,0,0,0,,世界队带着{\fs78}4{\fs68}比{\fs78}8{\fs68}进入最后一天
Dialogue: 0,0:02:37.09,0:02:39.61,TL,,0,0,0,,结果连赢{\fs78}3{\fs68}场 一口气拿下九分
Dialogue: 0,0:02:39.61,0:02:41.44,TL,,0,0,0,,以{\fs78}13{\fs68}比{\fs78}8{\fs68}首次夺冠
Dialogue: 0,0:02:41.44,0:02:42.94,TL,,0,0,0,,所谓最后一天翻盘
Dialogue: 0,0:02:42.94,0:02:45.33,TL,,0,0,0,,不是宣传话术 它真的发生过
Dialogue: 0,0:02:45.50,0:02:47.24,TL,,0,0,0,,单场比赛前两盘照常打
Dialogue: 0,0:02:47.24,0:02:49.47,TL,,0,0,0,,如果各赢一盘 就用抢{\fs78}10{\fs68}决胜
Dialogue: 0,0:02:49.47,0:02:51.03,TL,,0,0,0,,并且要净胜两分
Dialogue: 0,0:02:51.03,0:02:53.93,TL,,0,0,0,,另一种情况是全队积分打成{\fs78}12{\fs68}比{\fs78}12{\fs68}
Dialogue: 0,0:02:53.93,0:02:56.50,TL,,0,0,0,,按官网现行规则 加赛一盘双打
Dialogue: 0,0:02:56.50,0:02:59.20,TL,,0,0,0,,局内有占先 盘内可以抢七
Dialogue: 0,0:02:59.20,0:03:01.04,TL,,0,0,0,,两个决胜 不是一回事
Dialogue: 0,0:03:01.21,0:03:02.90,TL,,0,0,0,,队长还得排兵布阵
Dialogue: 0,0:03:02.90,0:03:05.50,TL,,0,0,0,,{\fs78}6{\fs68}个人前两天都必须至少打一场单打
Dialogue: 0,0:03:05.50,0:03:07.92,TL,,0,0,0,,每人整个周末最多打两场单打
Dialogue: 0,0:03:07.92,0:03:09.34,TL,,0,0,0,,至少四人要打双打
Dialogue: 0,0:03:09.34,0:03:11.36,TL,,0,0,0,,同一组合通常不能重复
Dialogue: 0,0:03:11.36,0:03:12.80,TL,,0,0,0,,你既要争眼前的分
Dialogue: 0,0:03:12.80,0:03:15.08,TL,,0,0,0,,也得为最后一天留好搭配
Dialogue: 0,0:03:15.25,0:03:17.29,TL,,0,0,0,,当然 不能只讲情怀
Dialogue: 0,0:03:17.29,0:03:19.50,TL,,0,0,0,,球员有按排名确定的出场费
Dialogue: 0,0:03:19.50,0:03:20.91,TL,,0,0,0,,冠军队六名球员
Dialogue: 0,0:03:20.91,0:03:22.90,TL,,0,0,0,,每人另拿{\fs78}25{\fs68}万美元
Dialogue: 0,0:03:22.90,0:03:25.08,TL,,0,0,0,,输的一队没有这笔冠军奖金
Dialogue: 0,0:03:25.08,0:03:26.73,TL,,0,0,0,,但不等于没有出场费
Dialogue: 0,0:03:26.73,0:03:28.77,TL,,0,0,0,,明星 奖金和团队荣誉
Dialogue: 0,0:03:28.77,0:03:30.54,TL,,0,0,0,,一起构成了它的吸引力
Dialogue: 0,0:03:30.71,0:03:31.97,TL,,0,0,0,,{\fs78}2022{\fs68}年的故事
Dialogue: 0,0:03:31.97,0:03:34.20,TL,,0,0,0,,也不该只记住费德勒的告别
Dialogue: 0,0:03:34.20,0:03:36.19,TL,,0,0,0,,阿利亚西姆在周日赢下双打
Dialogue: 0,0:03:36.19,0:03:37.65,TL,,0,0,0,,又击败德约科维奇
Dialogue: 0,0:03:37.65,0:03:39.41,TL,,0,0,0,,蒂亚福随后挽救{\fs78}4{\fs68}个赛点
Dialogue: 0,0:03:39.41,0:03:40.66,TL,,0,0,0,,战胜西西帕斯
Dialogue: 0,0:03:40.66,0:03:42.58,TL,,0,0,0,,为世界队锁定第一次冠军
Dialogue: 0,0:03:42.71,0:03:45.38,TL,,0,0,0,,{\fs78}2024{\fs68}年柏林 剧情又反过来
Dialogue: 0,0:03:45.38,0:03:47.25,TL,,0,0,0,,欧洲队带着{\fs78}4{\fs68}比{\fs78}8{\fs68}进入周日
Dialogue: 0,0:03:47.25,0:03:48.67,TL,,0,0,0,,阿尔卡拉斯先赢双打
Dialogue: 0,0:03:48.67,0:03:50.90,TL,,0,0,0,,再在最后一场单打击败弗里茨
Dialogue: 0,0:03:50.90,0:03:53.15,TL,,0,0,0,,帮助欧洲队{\fs78}13{\fs68}比{\fs78}11{\fs68}夺冠
Dialogue: 0,0:03:53.15,0:03:54.27,TL,,0,0,0,,规则制造机会
Dialogue: 0,0:03:54.27,0:03:56.58,TL,,0,0,0,,球员必须自己把机会赢下来
Dialogue: 0,0:03:56.71,0:03:58.08,TL,,0,0,0,,{\fs78}2025{\fs68}年旧金山
Dialogue: 0,0:03:58.08,0:03:59.98,TL,,0,0,0,,世界队又以{\fs78}15{\fs68}比{\fs78}9{\fs68}夺冠
Dialogue: 0,0:03:59.98,0:04:02.65,TL,,0,0,0,,弗里茨击败兹维列夫拿下最后一场
Dialogue: 0,0:04:02.65,0:04:04.99,TL,,0,0,0,,过去{\fs78}4{\fs68}届 世界队赢了{\fs78}3{\fs68}届
Dialogue: 0,0:04:04.99,0:04:06.81,TL,,0,0,0,,今天再把它当作欧洲明星队的
Dialogue: 0,0:04:06.81,0:04:09.25,TL,,0,0,0,,单方面展示 就跟不上故事了
Dialogue: 0,0:04:09.42,0:04:11.15,TL,,0,0,0,,连场边也换了主角
Dialogue: 0,0:04:11.15,0:04:13.12,TL,,0,0,0,,长期带队的博格和麦肯罗
Dialogue: 0,0:04:13.12,0:04:15.04,TL,,0,0,0,,在{\fs78}2024{\fs68}年后交棒
Dialogue: 0,0:04:15.04,0:04:16.80,TL,,0,0,0,,现在欧洲队由诺阿带领
Dialogue: 0,0:04:16.80,0:04:18.50,TL,,0,0,0,,世界队由阿加西带领
Dialogue: 0,0:04:18.50,0:04:20.73,TL,,0,0,0,,球迷看的既是年轻球员对抗
Dialogue: 0,0:04:20.73,0:04:23.33,TL,,0,0,0,,也是老冠军如何把经验传下去
Dialogue: 0,0:04:23.46,0:04:25.62,TL,,0,0,0,,{\fs78}2026{\fs68}年{\fs78}9{\fs68}月{\fs78}25{\fs68}到{\fs78}27{\fs68}日
Dialogue: 0,0:04:25.62,0:04:27.71,TL,,0,0,0,,第九届比赛回到伦敦{\fs78}O2{\fs68}
Dialogue: 0,0:04:27.71,0:04:29.37,TL,,0,0,0,,欧洲队目前公布的六人
Dialogue: 0,0:04:29.37,0:04:31.93,TL,,0,0,0,,是阿尔卡拉斯 兹维列夫 门西克
Dialogue: 0,0:04:31.93,0:04:34.15,TL,,0,0,0,,科博利 霍达尔和鲁德
Dialogue: 0,0:04:34.15,0:04:35.97,TL,,0,0,0,,强手不少 怎样搭双打
Dialogue: 0,0:04:35.97,0:04:37.46,TL,,0,0,0,,仍要看队长安排
Dialogue: 0,0:04:37.58,0:04:39.72,TL,,0,0,0,,世界队目前是弗里茨 德米纳尔
Dialogue: 0,0:04:39.72,0:04:41.48,TL,,0,0,0,,中岛布兰登 布勃利克
Dialogue: 0,0:04:41.48,0:04:44.35,TL,,0,0,0,,勒纳 钱和弗朗西斯科 塞伦多洛
Dialogue: 0,0:04:44.35,0:04:45.91,TL,,0,0,0,,这里要更新一个细节
Dialogue: 0,0:04:45.91,0:04:47.15,TL,,0,0,0,,谢尔顿已经退出
Dialogue: 0,0:04:47.15,0:04:48.71,TL,,0,0,0,,中岛布兰登替补入选
Dialogue: 0,0:04:48.71,0:04:51.46,TL,,0,0,0,,不能再照着早先的宣传名单介绍
Dialogue: 0,0:04:51.63,0:04:52.98,TL,,0,0,0,,今年真正值得追的
Dialogue: 0,0:04:52.98,0:04:54.72,TL,,0,0,0,,是欧洲能不能夺回奖杯
Dialogue: 0,0:04:54.72,0:04:57.28,TL,,0,0,0,,世界队能不能继续最近几年的势头
Dialogue: 0,0:04:57.28,0:04:59.03,TL,,0,0,0,,还有一个更有趣的问题
Dialogue: 0,0:04:59.03,0:05:01.67,TL,,0,0,0,,谁能把单打实力变成双打默契？
Dialogue: 0,0:05:01.67,0:05:03.17,TL,,0,0,0,,请多看一眼板凳席
Dialogue: 0,0:05:03.17,0:05:05.54,TL,,0,0,0,,那里常常藏着比分之外的故事
Dialogue: 0,0:05:05.71,0:05:08.84,TL,,0,0,0,,北京时间 {\fs78}9{\fs68}月{\fs78}25{\fs68} {\fs78}26{\fs68}日晚{\fs78}8{\fs68}点
Dialogue: 0,0:05:08.84,0:05:10.15,TL,,0,0,0,,是前两天的日场
Dialogue: 0,0:05:10.15,0:05:12.23,TL,,0,0,0,,对应夜场在次日凌晨两点
Dialogue: 0,0:05:12.23,0:05:15.38,TL,,0,0,0,,{\fs78}9{\fs68}月{\fs78}27{\fs68}日晚{\fs78}7{\fs68}点 周日决战开始
Dialogue: 0,0:05:15.38,0:05:17.97,TL,,0,0,0,,官网列出的中国转播方包括爱奇艺
Dialogue: 0,0:05:17.97,0:05:19.67,TL,,0,0,0,,上海地区还有五星体育
Dialogue: 0,0:05:19.67,0:05:21.21,TL,,0,0,0,,具体以节目表为准
Dialogue: 0,0:05:21.34,0:05:22.55,TL,,0,0,0,,拉沃尔杯的特别
Dialogue: 0,0:05:22.55,0:05:24.78,TL,,0,0,0,,不只是把明星请进同一座球馆
Dialogue: 0,0:05:24.78,0:05:27.64,TL,,0,0,0,,而是让他们暂时放下独自赢球的习惯
Dialogue: 0,0:05:27.64,0:05:29.27,TL,,0,0,0,,昨天最了解你弱点的人
Dialogue: 0,0:05:29.27,0:05:31.71,TL,,0,0,0,,今天可能最懂怎样帮你赢
