        "file": "work/shanghai-masters-history-2026/voice-split/voice_00.mp3"
      },
      {
        "index": 1,
        "seconds": 10.2,
        "audio_sha256": "a9f7fc329f450d2203eaf5cd9e0065e7de2151b55a2a830eb0daae601df7c0ee",
        "narration": "白玉兰形的屋顶之下，新的大师赛正赛即将开始。可这座球场的故事，早在“大师赛”这个名字之前，就已经写下了。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_01.mp3"
      },
      {
        "index": 2,
        "seconds": 2.304,
        "audio_sha256": "c6581fe6c6b096f1bd06fe713fa51293b50f9f311a28a9567c4a49de48f643de",
        "narration": "01 世界来到上海",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_02.mp3"
      },
      {
        "index": 3,
        "seconds": 4.392,
        "audio_sha256": "6df81db2187884a248cbbdb8511771669b7d48b5f5c9d9d2d1bb675413be52d5",
        "narration": "一九九六年，上海有了自己的ATP巡回赛。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_03.mp3"
      },
      {
        "index": 4,
        "seconds": 9.336,
        "audio_sha256": "c901bbe13a7e39bdc606e006d1ed89adff7db8c0250b2cff1e3f8e2172c989f2",
        "narration": "两年后，张德培在这里击败伊万尼塞维奇夺冠。那时的上海，还在一步步，让更多人走近职业网球。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_04.mp3"
      },
      {
        "index": 5,
        "seconds": 14.064,
        "audio_sha256": "f5301280b2b1f22ba3888912a0148e0874a3d1b0ac7a86a931ed1611f0636a4b",
        "narration": "二零零二年，世界来到浦东。\n年终大师杯首次落户上海，新国际博览中心成了顶尖球员的赛场。决赛里，休伊特先赢两盘，费雷罗又把比赛追回起点。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_05.mp3"
      },
      {
        "index": 6,
        "seconds": 8.376,
        "audio_sha256": "77986e7b1c1cc5174cd2effd15f2d70b2695f0bf1c1cadb50507737e471ba3b5",
        "narration": "打到第五盘，休伊特以六比四守住冠军。上海的第一届大师杯，就留下了一场五盘决赛。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_06.mp3"
      },
      {
        "index": 7,
        "seconds": 3.912,
        "audio_sha256": "93a79214636722543c71512ceec0e123f4ddc8b0c6038ff8a8d5aff24bc4eb2e",
        "narration": "二零零五年，旗忠打开了白玉兰形的屋顶。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_07.mp3"
      },
      {
        "index": 8,
        "seconds": 9.288,
        "audio_sha256": "41b99de678a4f7f0647a3ee09c4d77cb8d26801fbdeb71f15fbda4179631611e",
        "narration": "大师杯回到上海，随后连续四年在这里举行。一场顶尖赛事，也有了一座可以长久留下故事的舞台。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_08.mp3"
      },
      {
        "index": 9,
        "seconds": 4.488,
        "audio_sha256": "1ebcea7d931a51ac44449129112f7850c86f8efb251a95238395799225e4b6e2",
        "narration": "这一年的决赛，纳尔班迪安原本只是替补入围。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_09.mp3"
      },
      {
        "index": 10,
        "seconds": 4.368,
        "audio_sha256": "b8815c91e1dedce34e7ac6f05e854dc2279620f6a9063bc28fb1685710816d8d",
        "narration": "面对费德勒，他先输掉两盘，却连扳两盘。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_10.mp3"
      },
      {
        "index": 11,
        "seconds": 9.456,
        "audio_sha256": "5bb3dfe6b12368c578a6cb2352fd1c68d3475d10f2ac88c8800aacad60509d17",
        "narration": "第五盘，他一度四比零领先，费德勒又追回来。甚至带着六比五、三十比零，站上自己的发球胜赛局。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_11.mp3"
      },
      {
        "index": 12,
        "seconds": 5.496,
        "audio_sha256": "9c1b4e7d7e465aea3117710f008261108c89f7a2af64eee0f2424e6ceac2e2d3",
        "narration": "冠军只差两分。纳尔班迪安却再次把结局拉了回来。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_12.mp3"
      },
      {
        "index": 14,
        "seconds": 9.384,
        "audio_sha256": "4da31eae955322e5a973de6f60f7d80c01ff4f6eda7a720efb98152a78b2bc47",
        "narration": "四小时三十三分钟后，他赢下决胜盘抢七。一个临时得到的参赛机会，成了上海至今难忘的一场决赛。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_14.mp3"
      },
      {
        "index": 15,
        "seconds": 2.256,
        "audio_sha256": "70118fab137c50cec9e07dbee1c3d28b5d4b955f27db3ce9d929df86e1a0577b",
        "narration": "02 大师的主场",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_15.mp3"
      },
      {
        "index": 16,
        "seconds": 7.944,
        "audio_sha256": "022fb8fe6a0e4a3121b1ec77ae28ab5bc5f050eed1713efae19fc807551520bd",
        "narration": "二零零九年，上海有了新的身份：ATP大师一千赛，全球九站之一，也是亚洲唯一的一站。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_16.mp3"
      },
      {
        "index": 17,
        "seconds": 9.312,
        "audio_sha256": "616498b5debc76907621601cf6dbe3ef397383eca8a043402cb103b8cd1a8e45",
        "narration": "达维登科在决赛击败纳达尔，成为首届冠军。从这一年起，顶尖网球有了一个固定的上海之约。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_17.mp3"
      },
      {
        "index": 18,
        "seconds": 6.84,
        "audio_sha256": "3b6cb481e7c29c248e7894c141ab4a8c8869490fd1eab4fa0bc7dd1d80149c46",
        "narration": "二零一二年的决赛，穆雷先拿一盘，第二盘又以五比四领先，准备发球结束比赛。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_18.mp3"
      },
      {
        "index": 20,
        "seconds": 11.232,
        "audio_sha256": "1ee26e86b9b390413a6e2820ea1525aec296fc22acaae963f9292d1e27c1d236",
        "narration": "德约科维奇救下一个冠军点，把比赛拖进抢七。可危险没有过去。在那场打了约二十分钟的抢七里，他又救下四个冠军点。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_20.mp3"
      },
      {
        "index": 21,
        "seconds": 5.352,
        "audio_sha256": "ec1b90b28a75f1e8956091cc456d24d32bcbd1d280e7e6097306f96661c73f48",
        "narration": "五次，离结束都只差一分。五次，比赛都没有结束。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_21.mp3"
      },
      {
        "index": 23,
        "seconds": 8.52,
        "audio_sha256": "d6cf0eb0b41f6a2d5cd5e1cd7dd7235399346ace59d7b1c752e51ce54d514e69",
        "narration": "第二盘抢七，德约以十三比十一拿下。到了决胜盘，他两次破发，终于把这场决赛赢了下来。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_23.mp3"
      },
      {
        "index": 25,
        "seconds": 8.16,
        "audio_sha256": "fa151f69eebf624ae840f0ef0bc3836e0bcef7549de3aae7a93f9416235af31a",
        "narration": "上海留下的，不只是一个冠军名字。还有那些明明快到终点，却仍然继续的回合。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_25.mp3"
      },
      {
        "index": 26,
        "seconds": 5.448,
        "audio_sha256": "77e431d53c0fe82394944f886616f230d120dd122a48227550799f4015aefe6f",
        "narration": "两年后，费德勒的上海大师赛首冠，也从一次险境开始。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_26.mp3"
      },
      {
        "index": 27,
        "seconds": 8.76,
        "audio_sha256": "bc456e54224e1c2face04a2db3f67cf62c4da2cda17adcf6474e9db95355510b",
        "narration": "本届首战，他在第三盘四比五、十五比四十时，救下两个赛点。进了抢七，又救下三个。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_27.mp3"
      },
      {
        "index": 29,
        "seconds": 8.592,
        "audio_sha256": "14b4a32a83dcfe4c20e74eb7f70bae778fcb9a3d76beb4ace6415cef4e6f2088",
        "narration": "五次躲过出局，他才继续向前。半决赛击败德约科维奇，决赛再用两盘抢七战胜西蒙。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_29.mp3"
      },
      {
        "index": 30,
        "seconds": 6.72,
        "audio_sha256": "17ef37d1e100370601452565bfa47fa7cb493693a1ce3be2e5964e4985393c53",
        "narration": "从差一点离开，到第一次捧起上海大师赛的奖杯，这一周，结局被改写了。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_30.mp3"
      },
      {
        "index": 31,
        "seconds": 4.704,
        "audio_sha256": "537d20e2b6e55fd83b0867f628130ea869dd126265dda528c2ccc2cd1b982a13",
        "narration": "二零一七年，费德勒与纳达尔在上海决赛相遇。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_31.mp3"
      },
      {
        "index": 32,
        "seconds": 4.752,
        "audio_sha256": "5f0638852080667b63aa5da64648b47dd8e7aa884443a0a7555607b8202077ce",
        "narration": "六比四、六比三，费德勒第二次在上海大师赛夺冠。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_32.mp3"
      },
      {
        "index": 33,
        "seconds": 8.832,
        "audio_sha256": "570e43aa099e54627faf76d011910e52f443c309d652e5d19d7def3fba9d9ef6",
        "narration": "两个熟悉的名字，把多年的对抗又带到同一张球网两边。而上海，记住了他们共同留下的这一场。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_33.mp3"
      },
      {
        "index": 35,
        "seconds": 2.424,
        "audio_sha256": "79c85ce93991dbd851d791b9799c8d96bf73b1bc1b6903d162138bc1bcaab19f",
        "narration": "03 白玉兰再绽放",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_35.mp3"
      },
      {
        "index": 36,
        "seconds": 3.888,
        "audio_sha256": "b5600e9063c38bf1b13fbf0b5b953a87eaf516acb0add35f656ba712e1cd5a2e",
        "narration": "但这个上海之约，也曾被按下暂停。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_36.mp3"
      },
      {
        "index": 37,
        "seconds": 6.024,
        "audio_sha256": "c771b0906ee6b24271bba423bd9add0a56131e486e1e102c49804541e1dfcf8e",
        "narration": "二零二零年、二零二一年、二零二二年，赛事连续三个秋天取消。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_37.mp3"
      },
      {
        "index": 38,
        "seconds": 6.912,
        "audio_sha256": "2cd63ef3b61909aaa783cede4eaa63f7d46c839b226d5d040cefd39e033322ab",
        "narration": "直到二零二三年，上海大师赛才重新回到赛历，也重新等到球员和观众。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_38.mp3"
      },
      {
        "index": 39,
        "seconds": 6.216,
        "audio_sha256": "753f78e696b0966908c228ea37640118ad8a3645aa47b959fbf8968b742ace64",
        "narration": "回归后的单打签表，扩展到九十六人；正赛，也延长到十二天。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_39.mp3"
      },
      {
        "index": 40,
        "seconds": 7.8,
        "audio_sha256": "fdc3dbb14c4262a8d2e843a2a89679083cecfae327ddeab8e7964049ce84b33e",
        "narration": "更多球员来到这里，更多比赛留在这个秋天。上海的舞台，又向新的故事打开了一次。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_40.mp3"
      },
      {
        "index": 41,
        "seconds": 5.424,
        "audio_sha256": "fae8bfc8dd0ab45d9be7264edeb66d3dd19fdff124703636a5df304ae77a4c5c",
        "narration": "二零二四年，辛纳的对手，是上海四冠王德约科维奇。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_41.mp3"
      },
      {
        "index": 42,
        "seconds": 10.32,
        "audio_sha256": "622f18b600c4d2f22e5ee76cb12885bb368ce78cfecf6cb6ca54d6fd595a9741",
        "narration": "他以七比六、六比三赢下决赛，第一次捧起这里的奖杯。德约此前在上海大师赛决赛四战全胜，纪录在这一晚改变。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_42.mp3"
      },
      {
        "index": 43,
        "seconds": 3.984,
        "audio_sha256": "e00c6745806ae9f3bc9e5edcc8afb50f0bc709aca269c16bdcabb4c0ac52311d",
        "narration": "同一座球场，开始写下新的冠军名字。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_43.mp3"
      },
      {
        "index": 45,
        "seconds": 4.032,
        "audio_sha256": "2f144cd0854da0dc0bb0e33d10c3301702c5a297405808963c89f6e10a0de1d5",
        "narration": "二零二五年，更意外的名字走到了最后。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_45.mp3"
      },
      {
        "index": 46,
        "seconds": 8.88,
        "audio_sha256": "f58427325cade0518e8996a081d51f04e78faa859e63539d4f3b2b9eef3ab45d",
        "narration": "赛前世界排名第二百零四的瓦舍罗，从资格赛一路来到决赛。球网对面，竟是他的表兄林德克内希。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_46.mp3"
      },
      {
        "index": 47,
        "seconds": 7.392,
        "audio_sha256": "3b4492fb547e95d06d7e4899c9d5a1ae39069b562c92c919d185f6faf3f12b7f",
        "narration": "先输一盘，再连赢两盘。瓦舍罗成为大师一千赛史上，排名最低的冠军。",
        "backend": "edge",
        "voice": "zh-CN-YunjianNeural",
        "rate": "+6%",
        "file": "work/shanghai-masters-history-2026/voice-split/voice_47.mp3"
      },
      {
        "index": 48,
