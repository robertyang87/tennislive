  "speech_from": 58.039,
  "speech_to": 61.058,
  "late": 0.0,
  "text": "国际网联给场地评速度，首先看的就是摩擦。",
  "phrases": [
   {
    "t0": 58.039,
    "t1": 59.522,
    "text": "国际网联给场地评速度"
   },
   {
    "t0": 59.745,
    "t1": 61.058,
    "text": "首先看的就是摩擦。"
   }
  ]
 },
 {
