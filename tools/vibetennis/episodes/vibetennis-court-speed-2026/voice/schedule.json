[
 {
  "i": 0,
  "start": 0.708,
  "speech_from": 0.8,
  "speech_to": 4.54,
  "late": 0.0,
  "text": "同一颗球，同样的速度，砸向红土、草地和硬地。",
  "phrases": [
   {
    "t0": 0.8,
    "t1": 3.459,
    "text": "同一颗球，同样的速度，砸向红土"
   },
   {
    "t0": 3.597,
    "t1": 4.54,
    "text": "草地和硬地。"
   }
  ]
 },
 {
  "i": 1,
  "start": 4.797,
  "speech_from": 4.889,
  "speech_to": 7.368,
  "late": 0.0,
  "text": "飞出来的，却是三个完全不同的球。",
  "phrases": [
   {
    "t0": 4.889,
    "t1": 7.368,
    "text": "飞出来的，却是三个完全不同的球。"
   }
  ]
 },
 {
