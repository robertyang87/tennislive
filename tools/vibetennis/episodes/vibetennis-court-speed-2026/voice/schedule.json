  "speech_to": 148.216,
  "late": 0.0,
  "text": "美网的面层厂家说：颗粒大、有棱角的沙子会抓住球的绒毛，球就慢；换成更细、更圆的沙子，球就快。",
  "phrases": [
   {
    "t0": 140.525,
    "t1": 141.744,
    "text": "美网的面层厂家说"
   },
   {
    "t0": 141.977,
    "t1": 144.847,
    "text": "颗粒大、有棱角的沙子会抓住球的绒毛"
   },
   {
    "t0": 145.017,
    "t1": 147.485,
    "text": "球就慢；换成更细、更圆的沙子"
   },
   {
    "t0": 147.623,
    "t1": 148.216,
    "text": "球就快。"
   }
  ]
 },
