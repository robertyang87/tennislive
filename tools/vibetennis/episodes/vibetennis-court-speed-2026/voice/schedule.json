[
 {
  "i": 0,
  "start": 0.708,
  "speech_from": 0.8,
  "speech_to": 4.54,
  "late": 0.0,
  "text": "同一颗球，同样的速度，砸向红土、草地和硬地。",
  "phrases": [
   {
    "t0": 0.8,
    "t1": 3.459,
    "text": "同一颗球，同样的速度，砸向红土"
   },
   {
    "t0": 3.597,
    "t1": 4.54,
    "text": "草地和硬地。"
   }
  ]
 },
 {
  "i": 1,
  "start": 4.797,
  "speech_from": 4.889,
  "speech_to": 7.368,
  "late": 0.0,
  "text": "飞出来的，却是三个完全不同的球。",
  "phrases": [
   {
    "t0": 4.889,
    "t1": 7.368,
    "text": "飞出来的，却是三个完全不同的球。"
   }
  ]
 },
 {
  "i": 2,
  "start": 7.626,
  "speech_from": 7.718,
  "speech_to": 11.373,
  "late": 0.0,
  "text": "这就是为什么，一年四个大满贯，打起来像四种比赛。",
  "phrases": [
   {
    "t0": 7.718,
    "t1": 9.911,
    "text": "这就是为什么，一年四个大满贯"
   },
   {
    "t0": 10.165,
    "t1": 11.373,
    "text": "打起来像四种比赛。"
   }
  ]
 },
 {
  "i": 3,
  "start": 17.176,
  "speech_from": 17.268,
  "speech_to": 20.968,
  "late": 0.0,
  "text": "法网的红土。纳达尔在这里，拿了14个冠军。",
  "phrases": [
   {
    "t0": 17.268,
    "t1": 19.464,
    "text": "法网的红土。纳达尔在这里"
   },
   {
    "t0": 19.75,
    "t1": 20.968,
    "text": "拿了14个冠军。"
   }
  ]
 },
 {
  "i": 4,
  "start": 23.676,
  "speech_from": 23.768,
  "speech_to": 24.658,
  "late": 0.0,
  "text": "温网的草地。",
  "phrases": [
   {
    "t0": 23.768,
    "t1": 24.658,
    "text": "温网的草地。"
   }
  ]
 },
 {
  "i": 5,
  "start": 29.676,
  "speech_from": 29.768,
  "speech_to": 33.084,
  "late": 0.0,
  "text": "澳网和美网，都是硬地，却不是同一种硬地。",
  "phrases": [
   {
    "t0": 29.768,
    "t1": 31.474,
    "text": "澳网和美网，都是硬地"
   },
   {
    "t0": 31.718,
    "t1": 33.084,
    "text": "却不是同一种硬地。"
   }
  ]
 },
 {
  "i": 6,
  "start": 38.676,
  "speech_from": 38.768,
  "speech_to": 41.629,
  "late": 0.0,
  "text": "同一群球员，换一块地，打法就要跟着变。",
  "phrases": [
   {
    "t0": 38.768,
    "t1": 40.4,
    "text": "同一群球员，换一块地"
   },
   {
    "t0": 40.601,
    "t1": 41.629,
    "text": "打法就要跟着变。"
   }
  ]
 },
 {
  "i": 7,
  "start": 43.426,
  "speech_from": 43.518,
  "speech_to": 45.722,
  "late": 0.0,
  "text": "地面，凭什么能左右一场比赛？",
  "phrases": [
   {
    "t0": 43.518,
    "t1": 45.722,
    "text": "地面，凭什么能左右一场比赛？"
   }
  ]
 },
 {
  "i": 8,
  "start": 47.376,
  "speech_from": 47.468,
  "speech_to": 49.958,
  "late": 0.0,
  "text": "秘密，藏在球落地的那几毫秒里。",
  "phrases": [
   {
    "t0": 47.468,
    "t1": 49.958,
    "text": "秘密，藏在球落地的那几毫秒里。"
   }
  ]
 },
 {
  "i": 9,
  "start": 50.215,
  "speech_from": 50.307,
  "speech_to": 52.373,
  "late": 0.0,
  "text": "球一碰地，底部先往前滑；",
  "phrases": [
   {
    "t0": 50.307,
    "t1": 52.373,
    "text": "球一碰地，底部先往前滑"
   }
  ]
 },
 {
  "i": 10,
  "start": 53.415,
  "speech_from": 53.507,
  "speech_to": 59.556,
  "late": 0.0,
  "text": "摩擦往回拖它：够大，底部就被地面咬住、不再打滑；不够大，就一路滑过去。",
  "phrases": [
   {
    "t0": 53.507,
    "t1": 54.471,
    "text": "摩擦往回拖它"
   },
   {
    "t0": 54.694,
    "t1": 57.639,
    "text": "够大，底部就被地面咬住、不再打滑"
   },
   {
    "t0": 57.914,
    "t1": 59.556,
    "text": "不够大，就一路滑过去。"
   }
  ]
 },
 {
  "i": 11,
  "start": 59.814,
  "speech_from": 59.906,
  "speech_to": 63.137,
  "late": 0.0,
  "text": "这一下，决定球离地时，还剩多少水平速度。",
  "phrases": [
   {
    "t0": 59.906,
    "t1": 61.591,
    "text": "这一下，决定球离地时"
   },
   {
    "t0": 61.803,
    "t1": 63.137,
    "text": "还剩多少水平速度。"
   }
  ]
 },
 {
  "i": 12,
  "start": 63.395,
  "speech_from": 63.487,
  "speech_to": 66.358,
  "late": 0.0,
  "text": "另一半是弹性：地面把球往上顶回去多少。",
  "phrases": [
   {
    "t0": 63.487,
    "t1": 64.409,
    "text": "另一半是弹性"
   },
   {
    "t0": 64.706,
    "t1": 66.358,
    "text": "地面把球往上顶回去多少。"
   }
  ]
 },
 {
  "i": 13,
  "start": 66.616,
  "speech_from": 66.708,
  "speech_to": 70.797,
  "late": 0.0,
  "text": "所以一块场地快不快，主要看两个数：摩擦，和弹性。",
  "phrases": [
   {
    "t0": 66.708,
    "t1": 69.484,
    "text": "所以一块场地快不快，主要看两个数"
   },
   {
    "t0": 69.696,
    "t1": 70.797,
    "text": "摩擦，和弹性。"
   }
  ]
 },
 {
  "i": 14,
  "start": 71.055,
  "speech_from": 71.147,
  "speech_to": 77.747,
  "late": 0.0,
  "text": "国际网联给场地测速度，摩擦和弹性都算：摩擦越大、弹得越高，评分越低，场地越慢。",
  "phrases": [
   {
    "t0": 71.147,
    "t1": 72.567,
    "text": "国际网联给场地测速度"
   },
   {
    "t0": 72.768,
    "t1": 74.686,
    "text": "摩擦和弹性都算：摩擦越大"
   },
   {
    "t0": 74.866,
    "t1": 77.366,
    "text": "弹得越高，评分越低，场地越慢。"
   }
  ]
 },
 {
  "i": 15,
  "start": 78.554,
  "speech_from": 78.646,
  "speech_to": 82.746,
  "late": 0.0,
  "text": "红土最慢：球斜着落地时，摩擦系数最高能到0.9。",
  "phrases": [
   {
    "t0": 78.646,
    "t1": 80.627,
    "text": "红土最慢：球斜着落地时"
   },
   {
    "t0": 80.871,
    "t1": 82.746,
    "text": "摩擦系数最高能到0.9。"
   }
  ]
 },
 {
  "i": 16,
  "start": 83.004,
  "speech_from": 83.096,
  "speech_to": 86.783,
  "late": 0.0,
  "text": "表面那层细沙，对球员的鞋，像滚珠，能滑步；",
