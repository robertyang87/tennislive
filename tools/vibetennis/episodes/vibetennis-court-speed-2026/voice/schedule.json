  ]
 },
 {
  "i": 10,
  "start": 42.107,
  "speech_from": 42.199,
  "speech_to": 46.034,
  "late": 0.0,
  "text": "摩擦把它拖住，很快，底部就被地面咬住，不再打滑。",
  "phrases": [
   {
    "t0": 42.199,
    "t1": 43.079,
    "text": "摩擦把它拖住"
