    "text": "最高能到0.9。"
   }
  ]
 },
 {
  "i": 16,
  "start": 66.066,
  "speech_from": 66.158,
  "speech_to": 69.845,
  "late": 0.0,
  "text": "表面那层细沙，对球员的鞋，像滚珠，能滑步；",
  "phrases": [
   {
    "t0": 66.158,
    "t1": 68.256,
    "text": "表面那层细沙，对球员的鞋"
