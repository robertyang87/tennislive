  "start": 7.626,
  "speech_from": 7.718,
  "speech_to": 11.373,
  "late": 0.0,
  "text": "这就是为什么，一年四个大满贯，打起来像四种比赛。",
  "phrases": [
   {
    "t0": 7.718,
    "t1": 9.911,
    "text": "这就是为什么，一年四个大满贯"
   },
   {
    "t0": 10.165,
    "t1": 11.373,
    "text": "打起来像四种比赛。"
   }
  ]
 },
 {
