  "speech_to": 148.36,
  "late": 0.0,
  "text": "2021年澳网，德约科维奇说，场地比他在这里打的十五年里任何时候都快；赛事方却说，赛前检测和上一年差不多。",
  "phrases": [
   {
    "t0": 140.394,
    "t1": 142.206,
    "text": "2021年澳网，德约科维奇说"
   },
   {
    "t0": 142.471,
    "t1": 145.447,
    "text": "场地比他在这里打的十五年里任何时候都快"
   },
   {
    "t0": 145.744,
