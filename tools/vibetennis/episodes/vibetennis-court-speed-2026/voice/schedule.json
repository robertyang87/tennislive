   }
  ]
 },
 {
  "i": 11,
  "start": 46.707,
  "speech_from": 46.799,
  "speech_to": 50.03,
  "late": 0.0,
  "text": "这一下，决定球离地时，还剩多少水平速度。",
  "phrases": [
   {
    "t0": 46.799,
    "t1": 48.484,
    "text": "这一下，决定球离地时"
   },
   {
    "t0": 48.696,
    "t1": 50.03,
    "text": "还剩多少水平速度。"
   }
  ]
 },
 {
  "i": 12,
  "start": 50.288,
  "speech_from": 50.38,
  "speech_to": 53.251,
  "late": 0.0,
  "text": "另一半是弹性：地面把球往上顶回去多少。",
  "phrases": [
   {
    "t0": 50.38,
    "t1": 51.302,
    "text": "另一半是弹性"
   },
   {
    "t0": 51.599,
    "t1": 53.251,
    "text": "地面把球往上顶回去多少。"
   }
  ]
 },
 {
  "i": 13,
  "start": 53.508,
  "speech_from": 53.6,
  "speech_to": 57.689,
  "late": 0.0,
  "text": "所以一块场地快不快，主要看两个数：摩擦，和弹性。",
  "phrases": [
   {
    "t0": 53.6,
    "t1": 56.376,
    "text": "所以一块场地快不快，主要看两个数"
   },
   {
    "t0": 56.588,
    "t1": 57.689,
    "text": "摩擦，和弹性。"
   }
  ]
 },
 {
  "i": 14,
