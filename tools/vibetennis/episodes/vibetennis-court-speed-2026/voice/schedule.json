  "speech_to": 79.768,
  "late": 0.0,
  "text": "球还会在土里砸出一个小坑，被顶得更高。",
  "phrases": [
   {
    "t0": 76.886,
    "t1": 78.677,
    "text": "球还会在土里砸出一个小坑"
   },
   {
    "t0": 78.92,
