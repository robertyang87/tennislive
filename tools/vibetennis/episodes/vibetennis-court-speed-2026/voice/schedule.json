  "speech_from": 127.756,
  "speech_to": 135.447,
  "late": 0.0,
  "text": "美网的面层厂家说：颗粒大、有棱角的沙子会抓住球的绒毛，球就慢；换成更细、更圆的沙子，球就快。",
  "phrases": [
   {
    "t0": 127.756,
    "t1": 128.975,
    "text": "美网的面层厂家说"
   },
   {
    "t0": 129.208,
    "t1": 132.078,
    "text": "颗粒大、有棱角的沙子会抓住球的绒毛"
   },
   {
    "t0": 132.248,
    "t1": 134.716,
    "text": "球就慢；换成更细、更圆的沙子"
   },
   {
    "t0": 134.854,
    "t1": 135.447,
    "text": "球就快。"
   }
  ]
 },
