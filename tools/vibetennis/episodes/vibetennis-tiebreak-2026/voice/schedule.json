  "start": 153.237,
  "speech_from": 153.329,
  "speech_to": 161.2,
  "late": 0.0,
  "text": "要谁都不一直追，就轮流当先手：「甲乙」接上它的反面「乙甲」，得到甲乙乙甲；再接上反面，甲乙乙甲乙甲甲乙。",
  "phrases": [
   {
    "t0": 153.329,
    "t1": 155.565,
    "text": "要谁都不一直追，就轮流当先手"
   },
   {
    "t0": 155.861,
    "t1": 158.435,
    "text": "「甲乙」接上它的反面「乙甲」"
   },
   {
    "t0": 157.789,
    "t1": 161.2,
    "text": "得到甲乙乙甲；再接上反面"
   },
   {
    "t0": 159.643,
