    "text": "甲乙乙甲乙甲甲乙。"
   }
  ]
 },
 {
  "i": 23,
  "start": 161.637,
  "speech_from": 161.729,
  "speech_to": 169.674,
  "late": 0.0,
  "text": "一直接下去，就是Thue–Morse序列：1851年普鲁埃的论文里就藏着它，后来图厄、莫尔斯又各自发现。",
  "phrases": [
   {
    "t0": 161.729,
    "t1": 162.524,
    "text": "一直接下去"
   },
   {
    "t0": 162.715,
    "t1": 165.109,
    "text": "就是Thue–Morse序列"
   },
   {
    "t0": 165.193,
    "t1": 168.636,
    "text": "1851年普鲁埃的论文里就藏着它"
   },
   {
    "t0": 168.149,
    "t1": 169.674,
    "text": "后来图厄、莫尔斯又各自发现。"
