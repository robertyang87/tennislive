   {
    "t0": 140.729,
    "t1": 142.943,
    "text": "那一、二、二、二图什么？"
   },
   {
    "t0": 143.412,
    "t1": 145.129,
    "text": "一是少换手：12分里"
   },
   {
    "t0": 145.393,
    "t1": 147.194,
    "text": "一人一分要换11次发球"
   },
   {
    "t0": 147.459,
    "t1": 148.306,
    "text": "它只换6次。"
   }
  ]
 },
 {
