  "speech_to": 177.09,
  "late": 0.0,
  "text": "它每一层都在轮流当先手。经济学家就用它回答：两人轮流比赛，顺序怎么排才公平。",
  "phrases": [
   {
    "t0": 170.529,
    "t1": 172.542,
    "text": "它每一层都在轮流当先手。"
   },
