  "speech_from": 128.15,
  "speech_to": 132.366,
  "late": 0.0,
  "text": "另一项实验让人脱水接近5%，抽筋也没有变得更容易。",
  "phrases": [
   {
    "t0": 128.15,
    "t1": 130.65,
    "text": "另一项实验让人脱水接近5%"
   },
   {
