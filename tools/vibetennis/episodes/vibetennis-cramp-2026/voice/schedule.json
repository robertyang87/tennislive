  "start": 153.108,
  "speech_from": 153.2,
  "speech_to": 155.584,
  "late": 0.0,
  "text": "给他多加盐以后，他不再抽筋了。",
  "phrases": [
   {
    "t0": 153.2,
    "t1": 155.584,
    "text": "给他多加盐以后，他不再抽筋了。"
   }
  ]
 },
