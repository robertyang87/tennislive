  "speech_to": 160.964,
  "late": 0.0,
  "text": "所以又湿又热、出汗特别多特别咸的时候，盐确实要紧。",
  "phrases": [
   {
    "t0": 156.8,
    "t1": 157.944,
    "text": "所以又湿又热"
   },
   {
    "t0": 158.156,
