  "speech_from": 143.8,
  "speech_to": 151.872,
  "late": 0.0,
  "text": "研究记录过一名17岁的网球选手：每小时出汗2.5升，打一小时，汗里丢的钠就有他一天饮食的一半甚至更多。",
  "phrases": [
   {
    "t0": 143.8,
    "t1": 146.014,
    "text": "研究记录过一名17岁的网球选手"
   },
   {
    "t0": 146.311,
    "t1": 148.451,
    "text": "每小时出汗2.5升，打一小时"
   },
   {
    "t0": 148.737,
    "t1": 151.872,
    "text": "汗里丢的钠就有他一天饮食的一半甚至更多。"
   }
  ]
 },
 {
