   {
    "t0": 81.601,
    "t1": 82.745,
    "text": "两端高、中间低"
   },
   {
    "t0": 82.904,
    "t1": 85.534,
    "text": "也不是一开始就这样。1874年"
   },
   {
    "t0": 85.81,
