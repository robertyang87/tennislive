  "start": 41.502,
  "speech_from": 41.594,
  "speech_to": 48.438,
  "late": 0.0,
  "text": "场上的做法是：先松开中间的带子，把网绳绷到中间大约99厘米，比两端低8厘米左右。",
  "phrases": [
   {
    "t0": 41.594,
    "t1": 44.084,
    "text": "场上的做法是：先松开中间的带子"
   },
   {
    "t0": 44.264,
    "t1": 46.711,
    "text": "把网绳绷到中间大约99厘米"
   },
   {
