[
 {
  "i": 0,
  "start": 0.3,
  "speech_from": 0.392,
  "speech_to": 4.216,
  "late": 0.0,
  "text": "费德勒一共打了一千五百二十六场单打，赢了百分之八十二。",
  "phrases": [
   {
    "t0": 0.392,
    "t1": 2.903,
    "text": "费德勒一共打了一千五百二十六场单打"
   },
   {
    "t0": 3.189,
    "t1": 4.216,
    "text": "赢了百分之八十二。"
   }
  ]
 },
 {
  "i": 1,
  "start": 4.95,
  "speech_from": 5.042,
  "speech_to": 7.415,
  "late": 0.0,
  "text": "可每一分，他只赢了百分之五十四。",
  "phrases": [
   {
    "t0": 5.042,
    "t1": 7.415,
    "text": "可每一分，他只赢了百分之五十四。"
   }
  ]
 },
 {
  "i": 2,
  "start": 8.4,
  "speech_from": 8.492,
  "speech_to": 11.522,
  "late": 0.0,
  "text": "只比一半多一点，凭什么赢下这么多比赛？",
  "phrases": [
   {
    "t0": 8.492,
    "t1": 9.711,
    "text": "只比一半多一点"
   },
   {
    "t0": 9.944,
    "t1": 11.522,
    "text": "凭什么赢下这么多比赛？"
   }
  ]
 },
 {
  "i": 3,
  "start": 12.2,
  "speech_from": 12.292,
  "speech_to": 13.807,
  "late": 0.0,
  "text": "答案，是马尔可夫链。",
  "phrases": [
   {
    "t0": 12.292,
    "t1": 13.807,
    "text": "答案，是马尔可夫链。"
   }
  ]
 },
 {
  "i": 4,
  "start": 16.0,
  "speech_from": 16.092,
  "speech_to": 20.753,
  "late": 0.0,
  "text": "把他打过的分，按每一百分来看：五十四分他赢，四十六分他输。",
  "phrases": [
   {
    "t0": 16.092,
    "t1": 18.147,
    "text": "把他打过的分，按每一百分来看"
   },
   {
    "t0": 18.465,
    "t1": 20.753,
    "text": "五十四分他赢，四十六分他输。"
   }
  ]
 },
 {
  "i": 5,
  "start": 22.8,
  "speech_from": 22.892,
  "speech_to": 25.774,
  "late": 0.0,
  "text": "天平只歪了两度多，几乎就是抛硬币。",
  "phrases": [
   {
    "t0": 22.892,
    "t1": 25.774,
    "text": "天平只歪了两度多，几乎就是抛硬币。"
   }
  ]
 },
 {
  "i": 6,
  "start": 27.0,
  "speech_from": 27.092,
  "speech_to": 30.302,
  "late": 0.0,
  "text": "费德勒自己说过：平均每两分，就要输掉一分。",
  "phrases": [
   {
    "t0": 27.092,
    "t1": 29.243,
    "text": "费德勒自己说过：平均每两分"
   },
   {
    "t0": 29.402,
    "t1": 30.302,
    "text": "就要输掉一分。"
   }
  ]
 },
 {
  "i": 7,
  "start": 31.0,
  "speech_from": 31.092,
  "speech_to": 34.207,
  "late": 0.0,
  "text": "那多出来的这一点点，是怎么变成大优势的？",
  "phrases": [
   {
    "t0": 31.092,
    "t1": 32.417,
    "text": "那多出来的这一点点"
   },
   {
    "t0": 32.713,
    "t1": 34.207,
    "text": "是怎么变成大优势的？"
   }
  ]
 },
 {
  "i": 8,
  "start": 35.0,
  "speech_from": 35.092,
  "speech_to": 37.889,
  "late": 0.0,
  "text": "先看一局：先拿四分，还要领先两分。",
  "phrases": [
   {
    "t0": 35.092,
    "t1": 37.889,
    "text": "先看一局：先拿四分，还要领先两分。"
   }
  ]
 },
 {
  "i": 9,
  "start": 38.3,
  "speech_from": 38.392,
  "speech_to": 42.46,
  "late": 0.0,
  "text": "每一个比分，都是一个状态；每一分，只决定下一步往哪走。",
  "phrases": [
   {
    "t0": 38.392,
    "t1": 40.161,
    "text": "每一个比分，都是一个状态"
   },
   {
    "t0": 40.447,
    "t1": 42.46,
    "text": "每一分，只决定下一步往哪走。"
   }
  ]
 },
 {
  "i": 10,
  "start": 44.4,
  "speech_from": 44.492,
  "speech_to": 48.422,
  "late": 0.0,
  "text": "现在，让一千二百局，都按每分百分之五十四打一遍。",
  "phrases": [
   {
    "t0": 44.492,
    "t1": 46.166,
    "text": "现在，让一千二百局"
   },
   {
    "t0": 46.357,
    "t1": 48.422,
    "text": "都按每分百分之五十四打一遍。"
   }
  ]
 },
 {
  "i": 11,
  "start": 49.0,
  "speech_from": 49.092,
  "speech_to": 55.335,
  "late": 0.0,
  "text": "河道越宽，走这条路的局就越多。到了四十平，就在平分和占先之间来回打转。",
  "phrases": [
   {
    "t0": 49.092,
    "t1": 51.614,
    "text": "河道越宽，走这条路的局就越多。"
   },
   {
    "t0": 52.083,
    "t1": 52.845,
    "text": "到了四十平"
   },
   {
    "t0": 53.036,
    "t1": 55.335,
    "text": "就在平分和占先之间来回打转。"
   }
  ]
 },
 {
  "i": 12,
  "start": 55.492,
  "speech_from": 55.585,
  "speech_to": 58.784,
  "late": 0.092,
  "text": "下一步只看现在的比分，这就是马尔可夫链。",
  "phrases": [
   {
    "t0": 55.585,
    "t1": 57.301,
    "text": "下一步只看现在的比分"
   },
   {
    "t0": 57.534,
    "t1": 58.784,
    "text": "这就是马尔可夫链。"
   }
  ]
 },
 {
  "i": 13,
  "start": 59.0,
  "speech_from": 59.092,
  "speech_to": 64.177,
  "late": 0.0,
  "text": "局数越多，比例越稳：百分之五十四的一分，变成了百分之六十的一局。",
  "phrases": [
   {
    "t0": 59.092,
    "t1": 60.66,
    "text": "局数越多，比例越稳"
   },
   {
    "t0": 60.936,
    "t1": 62.302,
    "text": "百分之五十四的一分"
   },
   {
    "t0": 62.472,
    "t1": 64.177,
    "text": "变成了百分之六十的一局。"
   }
  ]
 },
 {
  "i": 14,
  "start": 65.0,
  "speech_from": 65.092,
  "speech_to": 66.861,
  "late": 0.0,
  "text": "把整整一局，缩成一步。",
  "phrases": [
   {
    "t0": 65.092,
    "t1": 66.861,
    "text": "把整整一局，缩成一步。"
   }
  ]
 },
 {
  "i": 15,
  "start": 68.0,
  "speech_from": 68.092,
  "speech_to": 74.727,
  "late": 0.0,
  "text": "一盘要先拿六局，还要领先两局，六平打抢七。现在每一步，都是百分之六十的一局。",
  "phrases": [
   {
    "t0": 68.092,
    "t1": 70.529,
    "text": "一盘要先拿六局，还要领先两局"
   },
   {
    "t0": 70.751,
    "t1": 72.979,
    "text": "六平打抢七。现在每一步"
   },
   {
    "t0": 73.138,
    "t1": 74.727,
    "text": "都是百分之六十的一局。"
   }
  ]
 },
 {
  "i": 16,
  "start": 76.6,
  "speech_from": 76.692,
  "speech_to": 80.22,
  "late": 0.0,
  "text": "同一个规律，再放大一次：百分之七十六的一盘。",
  "phrases": [
   {
    "t0": 76.692,
    "t1": 78.43,
    "text": "同一个规律，再放大一次"
   },
   {
    "t0": 78.631,
    "t1": 80.22,
    "text": "百分之七十六的一盘。"
   }
  ]
 },
 {
  "i": 17,
  "start": 83.0,
  "speech_from": 83.092,
  "speech_to": 84.819,
  "late": 0.0,
  "text": "再缩一层，五盘三胜。",
  "phrases": [
   {
    "t0": 83.092,
    "t1": 84.819,
    "text": "再缩一层，五盘三胜。"
   }
  ]
 },
 {
  "i": 18,
  "start": 86.5,
  "speech_from": 86.592,
  "speech_to": 94.297,
  "late": 0.0,
  "text": "每一步是百分之七十六的一盘。结果是：五盘三胜，百分之九十一；三盘两胜，也有百分之八十六。",
  "phrases": [
   {
    "t0": 86.592,
    "t1": 88.753,
    "text": "每一步是百分之七十六的一盘。"
   },
   {
    "t0": 89.222,
    "t1": 91.871,
    "text": "结果是：五盘三胜，百分之九十一"
   },
   {
    "t0": 92.167,
    "t1": 94.297,
    "text": "三盘两胜，也有百分之八十六。"
   }
  ]
 },
 {
