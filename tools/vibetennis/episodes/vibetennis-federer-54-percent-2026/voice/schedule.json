[
 {
  "i": 0,
  "start": 0.3,
  "speech_from": 0.392,
  "speech_to": 4.216,
  "late": 0.0,
  "text": "费德勒一共打了一千五百二十六场单打，赢了百分之八十二。",
  "phrases": [
   {
    "t0": 0.392,
    "t1": 2.903,
    "text": "费德勒一共打了一千五百二十六场单打"
   },
   {
    "t0": 3.189,
    "t1": 4.216,
    "text": "赢了百分之八十二。"
   }
  ]
 },
 {
  "i": 1,
  "start": 4.95,
  "speech_from": 5.042,
  "speech_to": 7.415,
  "late": 0.0,
  "text": "可每一分，他只赢了百分之五十四。",
  "phrases": [
   {
    "t0": 5.042,
    "t1": 7.415,
    "text": "可每一分，他只赢了百分之五十四。"
   }
  ]
 },
 {
  "i": 2,
  "start": 8.4,
  "speech_from": 8.492,
  "speech_to": 11.522,
  "late": 0.0,
  "text": "只比一半多一点，凭什么赢下这么多比赛？",
  "phrases": [
   {
    "t0": 8.492,
    "t1": 9.711,
    "text": "只比一半多一点"
   },
   {
    "t0": 9.944,
    "t1": 11.522,
    "text": "凭什么赢下这么多比赛？"
   }
  ]
 },
 {
  "i": 3,
  "start": 12.2,
  "speech_from": 12.292,
  "speech_to": 13.807,
  "late": 0.0,
  "text": "答案，是马尔可夫链。",
  "phrases": [
   {
    "t0": 12.292,
    "t1": 13.807,
    "text": "答案，是马尔可夫链。"
   }
  ]
 },
 {
  "i": 4,
  "start": 16.0,
  "speech_from": 16.092,
  "speech_to": 21.389,
  "late": 0.0,
  "text": "一九〇六年，有人断言：只有互不相干的事件，长期平均才会稳定。",
  "phrases": [
   {
    "t0": 16.092,
    "t1": 17.936,
    "text": "一九〇六年，有人断言"
   },
   {
    "t0": 18.137,
    "t1": 19.567,
    "text": "只有互不相干的事件"
   },
   {
    "t0": 19.747,
    "t1": 21.389,
    "text": "长期平均才会稳定。"
   }
  ]
 },
 {
  "i": 5,
  "start": 21.6,
  "speech_from": 21.692,
  "speech_to": 25.209,
  "late": 0.0,
  "text": "马尔可夫偏要证明：一环扣一环的事件，也可以。",
  "phrases": [
   {
    "t0": 21.692,
    "t1": 22.942,
    "text": "马尔可夫偏要证明"
   },
   {
    "t0": 23.186,
    "t1": 25.209,
    "text": "一环扣一环的事件，也可以。"
   }
  ]
 },
 {
  "i": 6,
  "start": 25.9,
  "speech_from": 25.992,
  "speech_to": 32.2,
  "late": 0.0,
  "text": "一九一三年，他把普希金《叶甫盖尼·奥涅金》的前两万个字母，逐个分成元音和辅音。",
  "phrases": [
   {
    "t0": 25.992,
    "t1": 26.797,
    "text": "一九一三年"
   },
   {
    "t0": 27.009,
    "t1": 31.405,
    "text": "他把普希金《叶甫盖尼·奥涅金》的前两万个字母"
   },
   {
    "t0": 31.077,
    "t1": 32.2,
    "text": "逐个分成元音和辅音。"
   }
  ]
 },
 {
  "i": 7,
  "start": 33.1,
  "speech_from": 33.192,
  "speech_to": 38.161,
  "late": 0.0,
  "text": "元音后面再跟元音，只有八分之一左右；辅音后面跟元音，接近三分之二。",
  "phrases": [
   {
    "t0": 33.192,
    "t1": 34.379,
    "text": "元音后面再跟元音"
   },
   {
    "t0": 34.527,
    "t1": 37.069,
    "text": "只有八分之一左右；辅音后面跟元音"
   },
   {
    "t0": 37.25,
    "t1": 38.161,
    "text": "接近三分之二。"
   }
  ]
 },
 {
  "i": 8,
  "start": 38.7,
  "speech_from": 38.792,
  "speech_to": 40.678,
  "late": 0.0,
  "text": "马尔可夫链，就三样东西。",
  "phrases": [
   {
    "t0": 38.792,
    "t1": 40.678,
    "text": "马尔可夫链，就三样东西。"
   }
  ]
 },
 {
  "i": 9,
  "start": 40.836,
  "speech_from": 40.928,
  "speech_to": 42.972,
  "late": 0.036,
  "text": "第一，状态：现在在哪。",
  "phrases": [
   {
    "t0": 40.928,
    "t1": 42.972,
    "text": "第一，状态：现在在哪。"
   }
  ]
 },
 {
  "i": 10,
  "start": 43.13,
  "speech_from": 43.222,
  "speech_to": 46.739,
  "late": 0.03,
  "text": "第二，转移概率：下一步去哪，各有多大可能。",
  "phrases": [
   {
    "t0": 43.222,
    "t1": 45.521,
    "text": "第二，转移概率：下一步去哪"
   },
   {
    "t0": 45.691,
    "t1": 46.739,
    "text": "各有多大可能。"
   }
  ]
 },
 {
  "i": 11,
  "start": 47.0,
  "speech_from": 47.092,
  "speech_to": 50.864,
  "late": 0.0,
  "text": "第三，只看现在：之前怎么走到这儿的，一概不管。",
  "phrases": [
   {
    "t0": 47.092,
    "t1": 48.385,
    "text": "第三，只看现在"
   },
   {
    "t0": 48.597,
    "t1": 50.864,
    "text": "之前怎么走到这儿的，一概不管。"
   }
  ]
 },
 {
  "i": 12,
  "start": 51.3,
  "speech_from": 51.392,
  "speech_to": 56.202,
  "late": 0.0,
  "text": "网球的比分，正是这样一条链：比分是状态，每一分，就是一次转移。",
  "phrases": [
   {
    "t0": 51.392,
    "t1": 53.267,
    "text": "网球的比分，正是这样一条链"
   },
   {
    "t0": 53.553,
    "t1": 56.202,
    "text": "比分是状态，每一分，就是一次转移。"
   }
  ]
 },
 {
  "i": 13,
  "start": 58.02,
  "speech_from": 58.112,
  "speech_to": 62.773,
  "late": 0.0,
  "text": "把他打过的分，按每一百分来看：五十四分他赢，四十六分他输。",
  "phrases": [
   {
    "t0": 58.112,
    "t1": 60.167,
    "text": "把他打过的分，按每一百分来看"
   },
   {
    "t0": 60.485,
    "t1": 62.773,
    "text": "五十四分他赢，四十六分他输。"
   }
  ]
 },
 {
  "i": 14,
  "start": 64.82,
  "speech_from": 64.912,
  "speech_to": 67.794,
  "late": 0.0,
  "text": "天平只歪了两度多，几乎就是抛硬币。",
  "phrases": [
   {
    "t0": 64.912,
    "t1": 67.794,
    "text": "天平只歪了两度多，几乎就是抛硬币。"
   }
  ]
 },
 {
  "i": 15,
  "start": 69.02,
  "speech_from": 69.112,
  "speech_to": 72.322,
  "late": 0.0,
  "text": "费德勒自己说过：平均每两分，就要输掉一分。",
  "phrases": [
   {
    "t0": 69.112,
    "t1": 71.263,
    "text": "费德勒自己说过：平均每两分"
   },
   {
    "t0": 71.422,
    "t1": 72.322,
    "text": "就要输掉一分。"
   }
  ]
 },
 {
  "i": 16,
  "start": 73.02,
  "speech_from": 73.112,
  "speech_to": 76.227,
  "late": 0.0,
  "text": "那多出来的这一点点，是怎么变成大优势的？",
  "phrases": [
   {
    "t0": 73.112,
    "t1": 74.437,
    "text": "那多出来的这一点点"
   },
   {
    "t0": 74.733,
    "t1": 76.227,
    "text": "是怎么变成大优势的？"
   }
  ]
 },
 {
  "i": 17,
  "start": 77.02,
  "speech_from": 77.112,
  "speech_to": 79.909,
  "late": 0.0,
  "text": "先看一局：先拿四分，还要领先两分。",
  "phrases": [
   {
    "t0": 77.112,
    "t1": 79.909,
    "text": "先看一局：先拿四分，还要领先两分。"
   }
  ]
 },
 {
  "i": 18,
  "start": 80.32,
  "speech_from": 80.412,
  "speech_to": 84.48,
  "late": 0.0,
  "text": "每一个比分，都是一个状态；每一分，只决定下一步往哪走。",
  "phrases": [
   {
    "t0": 80.412,
    "t1": 82.181,
    "text": "每一个比分，都是一个状态"
   },
   {
    "t0": 82.467,
    "t1": 84.48,
    "text": "每一分，只决定下一步往哪走。"
   }
  ]
 },
 {
  "i": 19,
  "start": 86.42,
  "speech_from": 86.512,
  "speech_to": 90.442,
  "late": 0.0,
  "text": "现在，让一千二百局，都按每分百分之五十四打一遍。",
  "phrases": [
   {
    "t0": 86.512,
    "t1": 88.186,
    "text": "现在，让一千二百局"
   },
   {
    "t0": 88.377,
    "t1": 90.442,
    "text": "都按每分百分之五十四打一遍。"
   }
  ]
 },
 {
  "i": 20,
  "start": 91.02,
  "speech_from": 91.112,
  "speech_to": 97.355,
  "late": 0.0,
  "text": "河道越宽，走这条路的局就越多。到了四十平，就在平分和占先之间来回打转。",
  "phrases": [
   {
    "t0": 91.112,
    "t1": 93.634,
    "text": "河道越宽，走这条路的局就越多。"
   },
   {
    "t0": 94.103,
    "t1": 94.865,
    "text": "到了四十平"
   },
   {
    "t0": 95.056,
    "t1": 97.355,
    "text": "就在平分和占先之间来回打转。"
   }
  ]
 },
 {
  "i": 21,
  "start": 97.512,
  "speech_from": 97.605,
  "speech_to": 100.804,
  "late": 0.092,
  "text": "下一步只看现在的比分，这就是马尔可夫链。",
  "phrases": [
   {
    "t0": 97.605,
    "t1": 99.321,
    "text": "下一步只看现在的比分"
   },
   {
    "t0": 99.554,
    "t1": 100.804,
    "text": "这就是马尔可夫链。"
   }
  ]
 },
 {
  "i": 22,
  "start": 101.02,
  "speech_from": 101.112,
  "speech_to": 106.197,
  "late": 0.0,
  "text": "局数越多，比例越稳：百分之五十四的一分，变成了百分之六十的一局。",
  "phrases": [
   {
    "t0": 101.112,
    "t1": 102.68,
    "text": "局数越多，比例越稳"
   },
   {
    "t0": 102.956,
    "t1": 104.322,
    "text": "百分之五十四的一分"
   },
   {
    "t0": 104.492,
    "t1": 106.197,
    "text": "变成了百分之六十的一局。"
   }
  ]
 },
 {
  "i": 23,
  "start": 107.02,
  "speech_from": 107.112,
  "speech_to": 108.881,
  "late": 0.0,
  "text": "把整整一局，缩成一步。",
  "phrases": [
   {
    "t0": 107.112,
    "t1": 108.881,
    "text": "把整整一局，缩成一步。"
   }
  ]
 },
 {
  "i": 24,
  "start": 110.02,
  "speech_from": 110.112,
  "speech_to": 116.747,
  "late": 0.0,
  "text": "一盘要先拿六局，还要领先两局，六平打抢七。现在每一步，都是百分之六十的一局。",
  "phrases": [
   {
    "t0": 110.112,
    "t1": 112.549,
    "text": "一盘要先拿六局，还要领先两局"
   },
   {
    "t0": 112.771,
    "t1": 114.999,
    "text": "六平打抢七。现在每一步"
   },
   {
    "t0": 115.158,
    "t1": 116.747,
    "text": "都是百分之六十的一局。"
   }
  ]
 },
 {
  "i": 25,
  "start": 118.62,
  "speech_from": 118.712,
  "speech_to": 122.24,
  "late": 0.0,
  "text": "同一个规律，再放大一次：百分之七十六的一盘。",
  "phrases": [
   {
    "t0": 118.712,
    "t1": 120.45,
    "text": "同一个规律，再放大一次"
   },
   {
    "t0": 120.651,
    "t1": 122.24,
    "text": "百分之七十六的一盘。"
   }
  ]
 },
 {
  "i": 26,
  "start": 125.02,
  "speech_from": 125.112,
  "speech_to": 126.839,
  "late": 0.0,
  "text": "再缩一层，五盘三胜。",
  "phrases": [
   {
    "t0": 125.112,
    "t1": 126.839,
    "text": "再缩一层，五盘三胜。"
   }
  ]
 },
 {
  "i": 27,
  "start": 128.52,
  "speech_from": 128.612,
  "speech_to": 136.317,
  "late": 0.0,
  "text": "每一步是百分之七十六的一盘。结果是：五盘三胜，百分之九十一；三盘两胜，也有百分之八十六。",
  "phrases": [
   {
    "t0": 128.612,
    "t1": 130.773,
    "text": "每一步是百分之七十六的一盘。"
   },
   {
    "t0": 131.242,
    "t1": 133.891,
    "text": "结果是：五盘三胜，百分之九十一"
   },
   {
    "t0": 134.187,
    "t1": 136.317,
    "text": "三盘两胜，也有百分之八十六。"
   }
  ]
 },
 {
  "i": 28,
  "start": 137.62,
  "speech_from": 137.712,
  "speech_to": 143.075,
  "late": 0.0,
  "text": "把三次放大画在一张图上。横轴是每一分的胜率，纵轴是赢下来的概率。",
  "phrases": [
   {
    "t0": 137.712,
    "t1": 139.661,
    "text": "把三次放大画在一张图上。"
   },
   {
    "t0": 140.12,
    "t1": 141.497,
    "text": "横轴是每一分的胜率"
   },
   {
    "t0": 141.72,
    "t1": 143.075,
    "text": "纵轴是赢下来的概率。"
   }
  ]
 },
 {
  "i": 29,
  "start": 143.42,
  "speech_from": 143.512,
  "speech_to": 145.695,
  "late": 0.0,
  "text": "每多套一层，曲线就更陡。",
  "phrases": [
   {
    "t0": 143.512,
    "t1": 145.695,
    "text": "每多套一层，曲线就更陡。"
   }
  ]
 },
 {
