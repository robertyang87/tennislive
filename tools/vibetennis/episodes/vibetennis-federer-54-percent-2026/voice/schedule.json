  "speech_to": 117.035,
  "late": 0.0,
  "text": "每一分只多赢百分之一，五盘三胜就从百分之五十，跳到百分之六十三。",
  "phrases": [
   {
    "t0": 111.992,
    "t1": 113.475,
    "text": "每一分只多赢百分之一"
   },
   {
    "t0": 113.73,
