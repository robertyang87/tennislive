[
 {
  "i": 0,
  "start": 0.3,
  "speech_from": 0.392,
  "speech_to": 4.216,
  "late": 0.0,
  "text": "费德勒一共打了一千五百二十六场单打，赢了百分之八十二。",
  "phrases": [
   {
    "t0": 0.392,
    "t1": 2.903,
    "text": "费德勒一共打了一千五百二十六场单打"
   },
   {
    "t0": 3.189,
    "t1": 4.216,
    "text": "赢了百分之八十二。"
   }
  ]
 },
 {
  "i": 1,
  "start": 4.95,
  "speech_from": 5.042,
  "speech_to": 7.415,
  "late": 0.0,
  "text": "可每一分，他只赢了百分之五十四。",
  "phrases": [
   {
    "t0": 5.042,
    "t1": 7.415,
    "text": "可每一分，他只赢了百分之五十四。"
   }
  ]
 },
 {
  "i": 2,
  "start": 8.4,
  "speech_from": 8.492,
  "speech_to": 11.522,
  "late": 0.0,
  "text": "只比一半多一点，凭什么赢下这么多比赛？",
  "phrases": [
   {
    "t0": 8.492,
    "t1": 9.711,
    "text": "只比一半多一点"
   },
   {
    "t0": 9.944,
    "t1": 11.522,
    "text": "凭什么赢下这么多比赛？"
   }
  ]
 },
 {
  "i": 3,
  "start": 12.2,
  "speech_from": 12.292,
  "speech_to": 13.807,
  "late": 0.0,
  "text": "答案，是马尔可夫链。",
  "phrases": [
   {
    "t0": 12.292,
    "t1": 13.807,
    "text": "答案，是马尔可夫链。"
   }
  ]
 },
 {
  "i": 4,
  "start": 16.0,
  "speech_from": 16.092,
  "speech_to": 21.389,
  "late": 0.0,
  "text": "一九〇六年，有人断言：只有互不相干的事件，长期平均才会稳定。",
  "phrases": [
   {
    "t0": 16.092,
    "t1": 17.936,
    "text": "一九〇六年，有人断言"
   },
   {
    "t0": 18.137,
    "t1": 19.567,
    "text": "只有互不相干的事件"
   },
   {
    "t0": 19.747,
    "t1": 21.389,
    "text": "长期平均才会稳定。"
   }
  ]
 },
 {
  "i": 5,
  "start": 21.6,
  "speech_from": 21.692,
  "speech_to": 25.209,
  "late": 0.0,
  "text": "马尔可夫偏要证明：一环扣一环的事件，也可以。",
  "phrases": [
   {
    "t0": 21.692,
    "t1": 22.942,
    "text": "马尔可夫偏要证明"
   },
   {
    "t0": 23.186,
    "t1": 25.209,
    "text": "一环扣一环的事件，也可以。"
   }
  ]
 },
 {
  "i": 6,
  "start": 25.9,
  "speech_from": 25.992,
  "speech_to": 32.2,
  "late": 0.0,
  "text": "一九一三年，他把普希金《叶甫盖尼·奥涅金》的前两万个字母，逐个分成元音和辅音。",
  "phrases": [
   {
    "t0": 25.992,
    "t1": 26.797,
    "text": "一九一三年"
   },
   {
    "t0": 27.009,
    "t1": 31.405,
    "text": "他把普希金《叶甫盖尼·奥涅金》的前两万个字母"
   },
   {
    "t0": 31.077,
    "t1": 32.2,
    "text": "逐个分成元音和辅音。"
   }
  ]
 },
 {
  "i": 7,
  "start": 33.1,
  "speech_from": 33.192,
  "speech_to": 38.161,
  "late": 0.0,
  "text": "元音后面再跟元音，只有八分之一左右；辅音后面跟元音，接近三分之二。",
  "phrases": [
   {
    "t0": 33.192,
    "t1": 34.379,
    "text": "元音后面再跟元音"
   },
   {
    "t0": 34.527,
    "t1": 37.069,
    "text": "只有八分之一左右；辅音后面跟元音"
   },
   {
    "t0": 37.25,
    "t1": 38.161,
    "text": "接近三分之二。"
   }
  ]
 },
 {
  "i": 8,
  "start": 39.4,
  "speech_from": 39.492,
  "speech_to": 44.315,
  "late": 0.0,
  "text": "下一个字母是什么，只看眼前这一个。这，就是马尔可夫链。",
  "phrases": [
   {
    "t0": 39.492,
    "t1": 42.225,
    "text": "下一个字母是什么，只看眼前这一个。"
   },
   {
    "t0": 42.694,
    "t1": 44.315,
    "text": "这，就是马尔可夫链。"
   }
  ]
 },
 {
  "i": 9,
  "start": 44.6,
  "speech_from": 44.692,
  "speech_to": 46.779,
  "late": 0.0,
  "text": "网球的比分，正是这样一条链。",
  "phrases": [
   {
    "t0": 44.692,
    "t1": 46.779,
    "text": "网球的比分，正是这样一条链。"
   }
  ]
 },
 {
  "i": 10,
  "start": 48.32,
  "speech_from": 48.412,
  "speech_to": 53.073,
  "late": 0.0,
  "text": "把他打过的分，按每一百分来看：五十四分他赢，四十六分他输。",
  "phrases": [
   {
    "t0": 48.412,
    "t1": 50.467,
    "text": "把他打过的分，按每一百分来看"
   },
   {
    "t0": 50.785,
    "t1": 53.073,
    "text": "五十四分他赢，四十六分他输。"
   }
  ]
 },
 {
  "i": 11,
  "start": 55.12,
  "speech_from": 55.212,
  "speech_to": 58.094,
  "late": 0.0,
  "text": "天平只歪了两度多，几乎就是抛硬币。",
  "phrases": [
   {
    "t0": 55.212,
    "t1": 58.094,
    "text": "天平只歪了两度多，几乎就是抛硬币。"
   }
  ]
 },
 {
  "i": 12,
  "start": 59.32,
  "speech_from": 59.412,
  "speech_to": 62.622,
  "late": 0.0,
  "text": "费德勒自己说过：平均每两分，就要输掉一分。",
  "phrases": [
   {
    "t0": 59.412,
    "t1": 61.563,
    "text": "费德勒自己说过：平均每两分"
   },
   {
    "t0": 61.722,
    "t1": 62.622,
    "text": "就要输掉一分。"
   }
  ]
 },
 {
  "i": 13,
  "start": 63.32,
  "speech_from": 63.412,
  "speech_to": 66.527,
  "late": 0.0,
  "text": "那多出来的这一点点，是怎么变成大优势的？",
  "phrases": [
   {
    "t0": 63.412,
    "t1": 64.737,
    "text": "那多出来的这一点点"
   },
   {
    "t0": 65.033,
    "t1": 66.527,
    "text": "是怎么变成大优势的？"
   }
  ]
 },
 {
  "i": 14,
  "start": 67.32,
  "speech_from": 67.412,
  "speech_to": 70.209,
  "late": 0.0,
  "text": "先看一局：先拿四分，还要领先两分。",
  "phrases": [
   {
    "t0": 67.412,
    "t1": 70.209,
    "text": "先看一局：先拿四分，还要领先两分。"
   }
  ]
 },
 {
  "i": 15,
  "start": 70.62,
  "speech_from": 70.712,
  "speech_to": 74.78,
  "late": 0.0,
  "text": "每一个比分，都是一个状态；每一分，只决定下一步往哪走。",
  "phrases": [
   {
    "t0": 70.712,
    "t1": 72.481,
    "text": "每一个比分，都是一个状态"
   },
   {
    "t0": 72.767,
    "t1": 74.78,
    "text": "每一分，只决定下一步往哪走。"
   }
  ]
 },
 {
  "i": 16,
  "start": 76.72,
  "speech_from": 76.812,
  "speech_to": 80.742,
  "late": 0.0,
  "text": "现在，让一千二百局，都按每分百分之五十四打一遍。",
  "phrases": [
   {
    "t0": 76.812,
    "t1": 78.486,
    "text": "现在，让一千二百局"
   },
   {
    "t0": 78.677,
    "t1": 80.742,
    "text": "都按每分百分之五十四打一遍。"
   }
  ]
 },
 {
  "i": 17,
  "start": 81.32,
  "speech_from": 81.412,
  "speech_to": 87.655,
  "late": 0.0,
  "text": "河道越宽，走这条路的局就越多。到了四十平，就在平分和占先之间来回打转。",
  "phrases": [
   {
    "t0": 81.412,
    "t1": 83.934,
    "text": "河道越宽，走这条路的局就越多。"
   },
   {
    "t0": 84.403,
    "t1": 85.165,
    "text": "到了四十平"
   },
   {
    "t0": 85.356,
    "t1": 87.655,
    "text": "就在平分和占先之间来回打转。"
   }
  ]
 },
 {
  "i": 18,
  "start": 87.812,
  "speech_from": 87.905,
  "speech_to": 91.104,
  "late": 0.092,
  "text": "下一步只看现在的比分，这就是马尔可夫链。",
  "phrases": [
   {
    "t0": 87.905,
    "t1": 89.621,
    "text": "下一步只看现在的比分"
   },
   {
    "t0": 89.854,
    "t1": 91.104,
    "text": "这就是马尔可夫链。"
   }
  ]
 },
 {
  "i": 19,
  "start": 91.32,
  "speech_from": 91.412,
  "speech_to": 96.497,
  "late": 0.0,
  "text": "局数越多，比例越稳：百分之五十四的一分，变成了百分之六十的一局。",
  "phrases": [
   {
    "t0": 91.412,
    "t1": 92.98,
    "text": "局数越多，比例越稳"
   },
   {
    "t0": 93.256,
    "t1": 94.622,
    "text": "百分之五十四的一分"
   },
   {
    "t0": 94.792,
    "t1": 96.497,
    "text": "变成了百分之六十的一局。"
   }
  ]
 },
 {
  "i": 20,
  "start": 97.32,
  "speech_from": 97.412,
  "speech_to": 99.181,
  "late": 0.0,
  "text": "把整整一局，缩成一步。",
  "phrases": [
   {
    "t0": 97.412,
    "t1": 99.181,
    "text": "把整整一局，缩成一步。"
   }
  ]
 },
 {
  "i": 21,
  "start": 100.32,
  "speech_from": 100.412,
  "speech_to": 107.047,
  "late": 0.0,
  "text": "一盘要先拿六局，还要领先两局，六平打抢七。现在每一步，都是百分之六十的一局。",
  "phrases": [
   {
    "t0": 100.412,
    "t1": 102.849,
    "text": "一盘要先拿六局，还要领先两局"
   },
   {
    "t0": 103.071,
    "t1": 105.299,
    "text": "六平打抢七。现在每一步"
   },
   {
    "t0": 105.458,
    "t1": 107.047,
    "text": "都是百分之六十的一局。"
   }
  ]
 },
 {
  "i": 22,
  "start": 108.92,
  "speech_from": 109.012,
  "speech_to": 112.54,
  "late": 0.0,
  "text": "同一个规律，再放大一次：百分之七十六的一盘。",
  "phrases": [
   {
    "t0": 109.012,
    "t1": 110.75,
    "text": "同一个规律，再放大一次"
   },
   {
    "t0": 110.951,
    "t1": 112.54,
    "text": "百分之七十六的一盘。"
   }
  ]
 },
 {
  "i": 23,
  "start": 115.32,
  "speech_from": 115.412,
  "speech_to": 117.139,
  "late": 0.0,
  "text": "再缩一层，五盘三胜。",
  "phrases": [
   {
    "t0": 115.412,
    "t1": 117.139,
    "text": "再缩一层，五盘三胜。"
   }
  ]
 },
 {
  "i": 24,
  "start": 118.82,
  "speech_from": 118.912,
  "speech_to": 126.617,
  "late": 0.0,
  "text": "每一步是百分之七十六的一盘。结果是：五盘三胜，百分之九十一；三盘两胜，也有百分之八十六。",
  "phrases": [
   {
    "t0": 118.912,
    "t1": 121.073,
    "text": "每一步是百分之七十六的一盘。"
   },
   {
    "t0": 121.542,
    "t1": 124.191,
    "text": "结果是：五盘三胜，百分之九十一"
   },
   {
    "t0": 124.487,
    "t1": 126.617,
    "text": "三盘两胜，也有百分之八十六。"
   }
  ]
 },
 {
  "i": 25,
  "start": 127.92,
  "speech_from": 128.012,
  "speech_to": 133.375,
  "late": 0.0,
  "text": "把三次放大画在一张图上。横轴是每一分的胜率，纵轴是赢下来的概率。",
  "phrases": [
   {
    "t0": 128.012,
    "t1": 129.961,
    "text": "把三次放大画在一张图上。"
   },
   {
    "t0": 130.42,
    "t1": 131.797,
    "text": "横轴是每一分的胜率"
   },
   {
    "t0": 132.02,
    "t1": 133.375,
    "text": "纵轴是赢下来的概率。"
   }
  ]
 },
 {
  "i": 26,
  "start": 133.72,
  "speech_from": 133.812,
  "speech_to": 135.995,
  "late": 0.0,
  "text": "每多套一层，曲线就更陡。",
  "phrases": [
   {
    "t0": 133.812,
    "t1": 135.995,
    "text": "每多套一层，曲线就更陡。"
   }
  ]
 },
 {
  "i": 27,
  "start": 137.32,
  "speech_from": 137.412,
  "speech_to": 141.173,
  "late": 0.0,
  "text": "在百分之五十四这里，读出六十、七十六、九十一。",
  "phrases": [
   {
    "t0": 137.412,
    "t1": 139.764,
    "text": "在百分之五十四这里，读出六十"
   },
   {
    "t0": 139.944,
    "t1": 141.173,
    "text": "七十六、九十一。"
   }
  ]
 },
 {
  "i": 28,
  "start": 141.52,
  "speech_from": 141.612,
  "speech_to": 143.858,
  "late": 0.0,
  "text": "退回百分之五十，谁也没有优势。",
  "phrases": [
   {
    "t0": 141.612,
    "t1": 143.858,
    "text": "退回百分之五十，谁也没有优势。"
   }
  ]
 },
 {
  "i": 29,
  "start": 144.22,
  "speech_from": 144.312,
  "speech_to": 149.355,
  "late": 0.0,
  "text": "每一分只多赢百分之一，五盘三胜就从百分之五十，跳到百分之六十三。",
  "phrases": [
   {
    "t0": 144.312,
    "t1": 145.795,
    "text": "每一分只多赢百分之一"
   },
   {
    "t0": 146.05,
    "t1": 147.956,
    "text": "五盘三胜就从百分之五十"
   },
   {
    "t0": 148.158,
    "t1": 149.355,
    "text": "跳到百分之六十三。"
   }
  ]
 },
 {
  "i": 30,
  "start": 149.92,
  "speech_from": 150.012,
  "speech_to": 152.547,
  "late": 0.0,
  "text": "这是推导。真实比赛也这样吗？",
  "phrases": [
   {
    "t0": 150.012,
    "t1": 152.547,
    "text": "这是推导。真实比赛也这样吗？"
   }
  ]
 },
 {
  "i": 31,
  "start": 152.705,
  "speech_from": 152.797,
  "speech_to": 158.221,
  "late": 0.185,
  "text": "代入他真实的数据：发球时每分赢大约百分之七十，接发时大约百分之四十。",
  "phrases": [
   {
    "t0": 152.797,
    "t1": 153.962,
    "text": "代入他真实的数据"
   },
   {
    "t0": 154.227,
    "t1": 156.293,
    "text": "发球时每分赢大约百分之七十"
   },
   {
    "t0": 156.526,
    "t1": 158.221,
    "text": "接发时大约百分之四十。"
   }
  ]
 },
 {
  "i": 32,
  "start": 158.92,
  "speech_from": 159.012,
  "speech_to": 161.968,
  "late": 0.0,
  "text": "虚线是模型的预测，实心是真实统计。",
  "phrases": [
   {
    "t0": 159.012,
    "t1": 161.968,
    "text": "虚线是模型的预测，实心是真实统计。"
   }
  ]
 },
 {
  "i": 33,
  "start": 163.32,
  "speech_from": 163.412,
  "speech_to": 167.438,
  "late": 0.0,
  "text": "保发率、破发率、赢局率，每一项都差不到两个百分点。",
