  "start": 161.9,
  "speech_from": 161.992,
  "speech_to": 164.803,
  "late": 0.0,
  "text": "两个都没拿下。分，并不平等。",
  "phrases": [
   {
    "t0": 161.992,
    "t1": 164.803,
    "text": "两个都没拿下。分，并不平等。"
   }
  ]
 },
