  "start": 151.22,
  "speech_from": 151.312,
  "speech_to": 153.558,
  "late": 0.0,
  "text": "退回百分之五十，谁也没有优势。",
  "phrases": [
   {
    "t0": 151.312,
    "t1": 153.558,
    "text": "退回百分之五十，谁也没有优势。"
   }
  ]
 },
