    "t0": 163.412,
    "t1": 164.609,
    "text": "保发率、破发率"
   },
   {
    "t0": 164.842,
    "t1": 167.438,
    "text": "赢局率，每一项都差不到两个百分点。"
   }
  ]
 },
 {
  "i": 34,
  "start": 167.92,
  "speech_from": 168.012,
  "speech_to": 170.163,
  "late": 0.0,
  "text": "层层放大，在真实比赛里成立。",
  "phrases": [
   {
