  "speech_from": 162.497,
  "speech_to": 167.921,
  "late": 0.185,
  "text": "代入他真实的数据：发球时每分赢大约百分之七十，接发时大约百分之四十。",
  "phrases": [
   {
    "t0": 162.497,
    "t1": 163.662,
    "text": "代入他真实的数据"
   },
   {
    "t0": 163.927,
