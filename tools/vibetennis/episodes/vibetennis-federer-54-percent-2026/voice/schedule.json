   }
  ]
 },
 {
  "i": 31,
  "start": 149.343,
  "speech_from": 149.435,
  "speech_to": 154.499,
  "late": 0.343,
  "text": "二零一九年温网决赛，费德勒全场赢了二百一十八分，德约科维奇二百零四分。",
  "phrases": [
   {
    "t0": 149.435,
    "t1": 150.664,
    "text": "二零一九年温网决赛"
   },
   {
    "t0": 150.971,
    "t1": 152.783,
    "text": "费德勒全场赢了二百一十八分"
   },
   {
    "t0": 153.058,
    "t1": 154.499,
    "text": "德约科维奇二百零四分。"
   }
  ]
 },
 {
