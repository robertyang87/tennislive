  "start": 120.385,
  "speech_from": 120.477,
  "speech_to": 125.901,
  "late": 0.185,
  "text": "代入他真实的数据：发球时每分赢大约百分之七十，接发时大约百分之四十。",
  "phrases": [
   {
    "t0": 120.477,
    "t1": 121.642,
