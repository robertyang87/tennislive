  "start": 109.2,
  "speech_from": 109.292,
  "speech_to": 111.538,
  "late": 0.0,
  "text": "退回百分之五十，谁也没有优势。",
  "phrases": [
   {
    "t0": 109.292,
    "t1": 111.538,
    "text": "退回百分之五十，谁也没有优势。"
   }
  ]
 },
 {
