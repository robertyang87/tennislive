  "start": 95.6,
  "speech_from": 95.692,
  "speech_to": 101.055,
  "late": 0.0,
  "text": "把三次放大画在一张图上。横轴是每一分的胜率，纵轴是赢下来的概率。",
  "phrases": [
   {
    "t0": 95.692,
    "t1": 97.641,
    "text": "把三次放大画在一张图上。"
   },
   {
    "t0": 98.1,
    "t1": 99.477,
    "text": "横轴是每一分的胜率"
   },
   {
    "t0": 99.7,
    "t1": 101.055,
    "text": "纵轴是赢下来的概率。"
   }
  ]
 },
 {
  "i": 20,
  "start": 101.4,
  "speech_from": 101.492,
  "speech_to": 103.675,
  "late": 0.0,
  "text": "每多套一层，曲线就更陡。",
  "phrases": [
   {
    "t0": 101.492,
    "t1": 103.675,
    "text": "每多套一层，曲线就更陡。"
   }
  ]
 },
 {
  "i": 21,
  "start": 105.0,
  "speech_from": 105.092,
  "speech_to": 108.853,
  "late": 0.0,
  "text": "在百分之五十四这里，读出六十、七十六、九十一。",
  "phrases": [
   {
    "t0": 105.092,
    "t1": 107.444,
    "text": "在百分之五十四这里，读出六十"
   },
   {
    "t0": 107.624,
    "t1": 108.853,
    "text": "七十六、九十一。"
   }
  ]
 },
 {
