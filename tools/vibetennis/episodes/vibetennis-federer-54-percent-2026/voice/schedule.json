  "speech_from": 144.789,
  "speech_to": 149.185,
  "late": 0.697,
  "text": "研究发现，每一分并不完全独立：关键分上，发球方更难拿分。",
  "phrases": [
   {
    "t0": 144.789,
    "t1": 146.982,
