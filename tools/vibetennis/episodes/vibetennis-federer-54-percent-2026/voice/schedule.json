  "start": 147.02,
  "speech_from": 147.112,
  "speech_to": 150.873,
  "late": 0.0,
  "text": "在百分之五十四这里，读出六十、七十六、九十一。",
  "phrases": [
   {
    "t0": 147.112,
    "t1": 149.464,
    "text": "在百分之五十四这里，读出六十"
   },
   {
