[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 1.847,
  "late": 0.0,
  "text": "一颗网球，不到60克。",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 1.847,
    "text": "一颗网球，不到60克。"
   }
  ]
 },
 {
  "i": 1,
  "start": 4.008,
  "speech_from": 4.1,
  "speech_to": 9.397,
  "late": 0.0,
  "text": "规则给它写了六项数字：重量、直径、弹跳、两种形变，还有耐久。",
  "phrases": [
   {
    "t0": 4.1,
    "t1": 6.833,
    "text": "规则给它写了六项数字：重量、直径"
   },
   {
    "t0": 7.024,
    "t1": 9.397,
    "text": "弹跳、两种形变，还有耐久。"
   }
  ]
 },
 {
  "i": 2,
  "start": 10.408,
  "speech_from": 10.5,
  "speech_to": 12.269,
  "late": 0.0,
  "text": "对球拍，规则只管尺寸。",
  "phrases": [
   {
    "t0": 10.5,
    "t1": 12.269,
    "text": "对球拍，规则只管尺寸。"
   }
  ]
 },
 {
  "i": 3,
  "start": 13.808,
  "speech_from": 13.9,
  "speech_to": 15.828,
  "late": 0.0,
  "text": "一颗球，凭什么管得这么严？",
  "phrases": [
   {
    "t0": 13.9,
    "t1": 15.828,
    "text": "一颗球，凭什么管得这么严？"
   }
  ]
 },
 {
  "i": 4,
  "start": 18.458,
  "speech_from": 18.55,
  "speech_to": 22.216,
  "late": 0.0,
  "text": "最早的网球，是皮子或布，里面塞着碎布、马毛。",
  "phrases": [
   {
    "t0": 18.55,
    "t1": 20.404,
    "text": "最早的网球，是皮子或布"
   },
   {
    "t0": 20.605,
    "t1": 22.216,
    "text": "里面塞着碎布、马毛。"
   }
  ]
 },
 {
  "i": 5,
  "start": 23.458,
  "speech_from": 23.55,
  "speech_to": 26.188,
  "late": 0.0,
  "text": "1870年代起，网球改用橡胶做。",
  "phrases": [
   {
    "t0": 23.55,
    "t1": 26.188,
    "text": "1870年代起，网球改用橡胶做。"
   }
  ]
 },
 {
  "i": 6,
  "start": 27.458,
  "speech_from": 27.55,
  "speech_to": 29.913,
  "late": 0.0,
  "text": "后来，橡胶球外面裹上了一层布。",
  "phrases": [
   {
    "t0": 27.55,
    "t1": 29.913,
    "text": "后来，橡胶球外面裹上了一层布。"
   }
  ]
 },
 {
  "i": 7,
  "start": 31.458,
  "speech_from": 31.55,
  "speech_to": 35.12,
  "late": 0.0,
  "text": "布从法兰绒换成麦尔登呢，针脚换成了硫化的胶缝。",
  "phrases": [
   {
    "t0": 31.55,
    "t1": 33.161,
    "text": "布从法兰绒换成麦尔登呢"
   },
   {
    "t0": 33.394,
    "t1": 35.12,
    "text": "针脚换成了硫化的胶缝。"
   }
  ]
 },
 {
  "i": 8,
  "start": 35.378,
  "speech_from": 35.47,
  "speech_to": 37.6,
  "late": 0.0,
  "text": "球心也变成空心，再充进气。",
  "phrases": [
   {
    "t0": 35.47,
    "t1": 37.6,
    "text": "球心也变成空心，再充进气。"
   }
  ]
 },
 {
  "i": 9,
  "start": 40.228,
  "speech_from": 40.32,
  "speech_to": 44.282,
  "late": 0.0,
  "text": "今天的球，先压出两个半壳：150度，压2分半钟。",
  "phrases": [
   {
    "t0": 40.32,
    "t1": 42.206,
    "text": "今天的球，先压出两个半壳"
   },
   {
    "t0": 42.45,
    "t1": 44.282,
    "text": "150度，压2分半钟。"
   }
  ]
 },
 {
  "i": 10,
  "start": 46.428,
  "speech_from": 46.52,
  "speech_to": 49.052,
  "late": 0.0,
  "text": "两半合上的那一刻，同时充进气。",
  "phrases": [
   {
    "t0": 46.52,
    "t1": 49.052,
    "text": "两半合上的那一刻，同时充进气。"
   }
  ]
 },
 {
  "i": 11,
  "start": 50.628,
  "speech_from": 50.72,
  "speech_to": 53.644,
  "late": 0.0,
  "text": "里面的气，比外面多压进去将近一个大气压。",
  "phrases": [
   {
    "t0": 50.72,
    "t1": 51.292,
    "text": "里面的气"
   },
   {
    "t0": 51.472,
    "t1": 53.644,
    "text": "比外面多压进去将近一个大气压。"
   }
  ]
 },
 {
  "i": 12,
  "start": 55.228,
  "speech_from": 55.32,
  "speech_to": 58.339,
  "late": 0.0,
  "text": "再裹上两片哑铃形的毛毡，错开90度。",
  "phrases": [
   {
    "t0": 55.32,
    "t1": 57.164,
    "text": "再裹上两片哑铃形的毛毡"
   },
   {
    "t0": 57.365,
    "t1": 58.339,
    "text": "错开90度。"
   }
  ]
 },
 {
  "i": 13,
  "start": 60.428,
  "speech_from": 60.52,
  "speech_to": 62.745,
  "late": 0.0,
  "text": "最后过一遍蒸汽，毛绒蓬起来。",
  "phrases": [
   {
    "t0": 60.52,
    "t1": 62.745,
    "text": "最后过一遍蒸汽，毛绒蓬起来。"
   }
  ]
 },
 {
  "i": 14,
  "start": 64.628,
  "speech_from": 64.72,
  "speech_to": 68.227,
  "late": 0.0,
  "text": "还有一种无压球：里外气压一样，靠更厚的壁弹起来。",
  "phrases": [
   {
    "t0": 64.72,
    "t1": 66.818,
    "text": "还有一种无压球：里外气压一样"
   },
   {
    "t0": 66.977,
    "t1": 68.227,
    "text": "靠更厚的壁弹起来。"
   }
  ]
 },
 {
  "i": 15,
  "start": 68.484,
  "speech_from": 68.576,
  "speech_to": 72.856,
  "late": 0.0,
  "text": "所以，一颗网球，是一只充了气的橡胶壳，外面穿一件毛衣。",
  "phrases": [
   {
    "t0": 68.576,
    "t1": 69.858,
    "text": "所以，一颗网球"
   },
   {
    "t0": 70.017,
    "t1": 71.564,
    "text": "是一只充了气的橡胶壳"
   },
   {
    "t0": 71.754,
    "t1": 72.856,
    "text": "外面穿一件毛衣。"
   }
  ]
 },
 {
  "i": 16,
  "start": 75.134,
  "speech_from": 75.226,
  "speech_to": 78.044,
  "late": 0.0,
  "text": "它原本是白的或黑的，看场地的颜色。",
  "phrases": [
   {
    "t0": 75.226,
    "t1": 78.044,
    "text": "它原本是白的或黑的，看场地的颜色。"
   }
  ]
 },
 {
  "i": 17,
  "start": 78.302,
  "speech_from": 78.394,
  "speech_to": 82.261,
  "late": 0.0,
  "text": "1972年，规则里加进了黄色，为了电视上看得清。",
  "phrases": [
   {
    "t0": 78.394,
    "t1": 80.852,
    "text": "1972年，规则里加进了黄色"
   },
   {
    "t0": 81.085,
    "t1": 82.261,
    "text": "为了电视上看得清。"
   }
  ]
 },
 {
  "i": 18,
  "start": 83.502,
  "speech_from": 83.594,
  "speech_to": 86.37,
  "late": 0.0,
  "text": "温网，直到1986年才换成黄球。",
  "phrases": [
   {
    "t0": 83.594,
    "t1": 86.37,
    "text": "温网，直到1986年才换成黄球。"
   }
  ]
 },
 {
  "i": 19,
  "start": 88.552,
  "speech_from": 88.644,
  "speech_to": 92.066,
  "late": 0.0,
  "text": "击球那一下，球在线床上只停留4到5毫秒。",
  "phrases": [
   {
    "t0": 88.644,
    "t1": 89.386,
    "text": "击球那一下"
   },
   {
    "t0": 89.587,
    "t1": 92.066,
    "text": "球在线床上只停留4到5毫秒。"
   }
  ]
 },
 {
  "i": 20,
  "start": 93.352,
  "speech_from": 93.444,
  "speech_to": 96.983,
  "late": 0.0,
  "text": "以每秒30米撞上硬墙，它会被压扁到差不多一半。",
  "phrases": [
   {
    "t0": 93.444,
    "t1": 95.065,
    "text": "以每秒30米撞上硬墙"
   },
   {
    "t0": 95.341,
    "t1": 96.983,
    "text": "它会被压扁到差不多一半。"
   }
  ]
 },
 {
  "i": 21,
  "start": 98.752,
  "speech_from": 98.844,
  "speech_to": 105.952,
  "late": 0.0,
  "text": "最开始的0.2毫秒，毛毡和橡胶被压紧；接着贴墙那面的壳往里一翻，翻成一个小泡，再弹回来。",
  "phrases": [
   {
    "t0": 98.844,
    "t1": 100.338,
    "text": "最开始的0.2毫秒"
   },
   {
    "t0": 100.592,
    "t1": 101.927,
    "text": "毛毡和橡胶被压紧"
   },
   {
    "t0": 102.181,
    "t1": 103.876,
    "text": "接着贴墙那面的壳往里一翻"
   },
   {
    "t0": 104.077,
    "t1": 105.952,
    "text": "翻成一个小泡，再弹回来。"
   }
  ]
 },
 {
  "i": 22,
  "start": 106.552,
  "speech_from": 106.644,
  "speech_to": 113.565,
  "late": 0.0,
  "text": "飞在空中，那层毛绒是一道气闸。一记发球落地时，只剩出手速度的大约四分之三。",
  "phrases": [
   {
    "t0": 106.644,
    "t1": 109.324,
    "text": "飞在空中，那层毛绒是一道气闸。"
   },
   {
    "t0": 109.794,
    "t1": 111.054,
    "text": "一记发球落地时"
   },
   {
    "t0": 111.319,
    "t1": 113.565,
    "text": "只剩出手速度的大约四分之三。"
   }
  ]
 },
 {
  "i": 23,
  "start": 113.822,
  "speech_from": 113.914,
  "speech_to": 119.052,
  "late": 0.0,
  "text": "打了几局，毛绒蓬起来，阻力更大，球更慢；磨秃了，阻力又变小。",
  "phrases": [
   {
    "t0": 113.914,
    "t1": 116.361,
    "text": "打了几局，毛绒蓬起来，阻力更大"
   },
   {
    "t0": 116.541,
    "t1": 119.052,
    "text": "球更慢；磨秃了，阻力又变小。"
   }
  ]
 },
 {
  "i": 24,
  "start": 120.022,
  "speech_from": 120.114,
  "speech_to": 126.28,
  "late": 0.0,
  "text": "天冷，球也会变死：同样落下，0度时弹起的高度，比20度时低20%以上。",
  "phrases": [
   {
    "t0": 120.114,
    "t1": 122.498,
    "text": "天冷，球也会变死：同样落下"
   },
   {
    "t0": 122.72,
    "t1": 123.96,
    "text": "0度时弹起的高度"
   },
   {
    "t0": 124.182,
    "t1": 126.004,
    "text": "比20度时低20%以上。"
   }
  ]
 },
 {
  "i": 25,
  "start": 126.537,
  "speech_from": 126.629,
  "speech_to": 130.104,
  "late": 0.0,
  "text": "高海拔反过来，球太活，规则专门给它另定了一种球。",
  "phrases": [
   {
    "t0": 126.629,
    "t1": 127.466,
    "text": "高海拔反过来"
   },
   {
    "t0": 127.657,
    "t1": 130.104,
    "text": "球太活，规则专门给它另定了一种球。"
   }
  ]
 },
 {
  "i": 26,
  "start": 131.987,
  "speech_from": 132.079,
  "speech_to": 135.734,
  "late": 0.0,
  "text": "每一种比赛用球，都要送到伦敦的国际网联技术中心。",
  "phrases": [
   {
    "t0": 132.079,
    "t1": 133.202,
    "text": "每一种比赛用球"
   },
   {
    "t0": 133.393,
    "t1": 135.734,
    "text": "都要送到伦敦的国际网联技术中心。"
   }
  ]
 },
 {
  "i": 27,
  "start": 135.992,
  "speech_from": 136.084,
  "speech_to": 142.451,
  "late": 0.0,
  "text": "从254厘米高处落下，标准球要弹回135到147厘米——只有一半多。",
  "phrases": [
   {
    "t0": 136.084,
    "t1": 137.673,
    "text": "从254厘米高处落下"
   },
   {
    "t0": 137.684,
    "t1": 141.879,
    "text": "标准球要弹回135到147厘米——只有一半多。"
   }
  ]
 },
 {
  "i": 28,
  "start": 143.592,
  "speech_from": 143.684,
  "speech_to": 147.731,
  "late": 0.0,
  "text": "再压上一个固定的重量，量它被压下去多少、又弹回多少。",
  "phrases": [
   {
    "t0": 143.684,
    "t1": 145.125,
    "text": "再压上一个固定的重量"
   },
   {
    "t0": 145.326,
    "t1": 147.731,
    "text": "量它被压下去多少、又弹回多少。"
   }
  ]
 },
 {
  "i": 29,
  "start": 148.792,
  "speech_from": 148.884,
  "speech_to": 151.893,
  "late": 0.0,
  "text": "最后，模拟九局比赛的磨损，看它变了多少。",
  "phrases": [
   {
    "t0": 148.884,
    "t1": 150.781,
    "text": "最后，模拟九局比赛的磨损"
   },
   {
    "t0": 150.929,
    "t1": 151.893,
    "text": "看它变了多少。"
   }
  ]
 },
 {
  "i": 30,
  "start": 153.192,
  "speech_from": 153.284,
  "speech_to": 159.929,
  "late": 0.0,
  "text": "九局，正是比赛里换一次球的间隔。温网是：热身加前7局用第一批，之后每9局一换。",
  "phrases": [
   {
    "t0": 153.284,
    "t1": 155.742,
    "text": "九局，正是比赛里换一次球的间隔。"
   },
   {
    "t0": 156.222,
    "t1": 158.573,
    "text": "温网是：热身加前7局用第一批"
   },
   {
    "t0": 158.743,
    "t1": 159.929,
    "text": "之后每9局一换。"
   }
  ]
 },
 {
  "i": 31,
  "start": 161.792,
  "speech_from": 161.884,
  "speech_to": 166.464,
  "late": 0.0,
  "text": "规则还写着：第一次换球提前两局——热身，也在磨它。",
  "phrases": [
   {
    "t0": 161.884,
    "t1": 162.647,
    "text": "规则还写着"
   },
   {
    "t0": 162.88,
    "t1": 166.072,
    "text": "第一次换球提前两局——热身"
   },
   {
    "t0": 166.082,
    "t1": 166.464,
    "text": "也在磨它。"
   }
  ]
 },
 {
  "i": 32,
  "start": 167.371,
  "speech_from": 167.463,
  "speech_to": 172.389,
  "late": 0.0,
  "text": "世纪之交，研究者和国际网联一起，设计一颗更大的球，让比赛慢下来。",
  "phrases": [
   {
    "t0": 167.463,
    "t1": 169.857,
    "text": "世纪之交，研究者和国际网联一起"
   },
   {
    "t0": 170.101,
    "t1": 172.389,
    "text": "设计一颗更大的球，让比赛慢下来。"
   }
  ]
 },
 {
  "i": 33,
  "start": 172.647,
  "speech_from": 172.739,
  "speech_to": 176.871,
  "late": 0.0,
  "text": "2001年，国际网联投票：比赛用球分成三种速度。",
  "phrases": [
   {
    "t0": 172.739,
    "t1": 174.625,
    "text": "2001年，国际网联投票"
   },
   {
    "t0": 174.932,
    "t1": 176.871,
    "text": "比赛用球分成三种速度。"
   }
  ]
 },
 {
  "i": 34,
  "start": 177.128,
  "speech_from": 177.22,
  "speech_to": 182.581,
  "late": 0.0,
  "text": "快的1号球给慢场，2号球给中速场；慢的3号球，直径大6%，给快场。",
  "phrases": [
   {
    "t0": 177.22,
    "t1": 179.699,
    "text": "快的1号球给慢场，2号球给中速场"
   },
   {
    "t0": 179.996,
    "t1": 182.21,
    "text": "慢的3号球，直径大6%，给快场。"
   }
  ]
 },
 {
  "i": 35,
  "start": 184.728,
  "speech_from": 184.82,
  "speech_to": 190.986,
  "late": 0.0,
  "text": "一项模拟算过：换成大球，一发飞到底线多出约10毫秒，二发最多多出16毫秒。",
  "phrases": [
   {
    "t0": 184.82,
    "t1": 186.695,
    "text": "一项模拟算过：换成大球"
   },
   {
    "t0": 186.928,
    "t1": 189.609,
    "text": "一发飞到底线多出约10毫秒"
   },
   {
    "t0": 189.227,
    "t1": 190.986,
    "text": "二发最多多出16毫秒。"
   }
  ]
 },
 {
  "i": 36,
  "start": 192.528,
  "speech_from": 192.62,
  "speech_to": 195.968,
  "late": 0.0,
  "text": "另一项实测：大球发出去的初速，并没有变慢。",
  "phrases": [
   {
    "t0": 192.62,
    "t1": 194.93,
    "text": "另一项实测：大球发出去的初速"
   },
   {
    "t0": 195.099,
    "t1": 195.968,
    "text": "并没有变慢。"
   }
  ]
 },
 {
  "i": 37,
  "start": 196.226,
  "speech_from": 196.318,
  "speech_to": 201.329,
  "late": 0.0,
  "text": "反过来，国际网联给球场测速，也是拿一颗网球，以每秒30米射向地面。",
  "phrases": [
