[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 2.334,
  "late": 0.0,
  "text": "打偏了，拍子被扭歪一大截。",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 2.334,
    "text": "打偏了，拍子被扭歪一大截。"
   }
  ]
 },
 {
  "i": 1,
  "start": 4.808,
  "speech_from": 4.9,
  "speech_to": 7.814,
  "late": 0.0,
  "text": "一次实验里，球的左右方向，却几乎没变。",
  "phrases": [
   {
    "t0": 4.9,
    "t1": 6.775,
    "text": "一次实验里，球的左右方向"
   },
   {
    "t0": 6.977,
    "t1": 7.814,
    "text": "却几乎没变。"
   }
  ]
 },
 {
  "i": 2,
  "start": 9.408,
  "speech_from": 9.5,
  "speech_to": 12.445,
  "late": 0.0,
  "text": "最近五十年，球拍变大、变轻、变硬。",
  "phrases": [
   {
    "t0": 9.5,
    "t1": 12.445,
    "text": "最近五十年，球拍变大、变轻、变硬。"
   }
  ]
 },
 {
  "i": 3,
  "start": 13.608,
  "speech_from": 13.7,
  "speech_to": 15.321,
  "late": 0.0,
  "text": "是球拍，改写了网球吗？",
  "phrases": [
   {
    "t0": 13.7,
    "t1": 15.321,
    "text": "是球拍，改写了网球吗？"
   }
  ]
 },
 {
  "i": 4,
  "start": 18.558,
  "speech_from": 18.65,
  "speech_to": 21.585,
  "late": 0.0,
  "text": "1870年代起，球拍是用白蜡木弯出来的。",
  "phrases": [
   {
    "t0": 18.65,
    "t1": 19.752,
    "text": "1870年代起"
   },
   {
    "t0": 19.922,
    "t1": 21.585,
    "text": "球拍是用白蜡木弯出来的。"
   }
  ]
 },
 {
  "i": 5,
  "start": 24.558,
  "speech_from": 24.65,
  "speech_to": 27.585,
  "late": 0.0,
  "text": "此后近一百年，尺寸和形状基本定型。",
  "phrases": [
   {
    "t0": 24.65,
    "t1": 27.585,
    "text": "此后近一百年，尺寸和形状基本定型。"
   }
  ]
 },
 {
  "i": 6,
  "start": 29.158,
  "speech_from": 29.25,
  "speech_to": 31.676,
  "late": 0.0,
  "text": "拍面，一直只有约70平方英寸。",
  "phrases": [
   {
    "t0": 29.25,
    "t1": 31.676,
    "text": "拍面，一直只有约70平方英寸。"
   }
  ]
 },
 {
  "i": 7,
  "start": 33.358,
  "speech_from": 33.45,
  "speech_to": 36.226,
  "late": 0.0,
  "text": "这个尺寸，是木头为了耐用做的妥协。",
  "phrases": [
   {
    "t0": 33.45,
    "t1": 36.226,
    "text": "这个尺寸，是木头为了耐用做的妥协。"
   }
  ]
 },
 {
  "i": 8,
  "start": 39.008,
  "speech_from": 39.1,
  "speech_to": 44.8,
  "late": 0.0,
  "text": "金属拍早有人试过，可线要穿过金属上的孔，孔边太锋利，和绷紧的线合不来。",
  "phrases": [
   {
    "t0": 39.1,
    "t1": 40.403,
    "text": "金属拍早有人试过"
   },
   {
    "t0": 40.626,
    "t1": 43.369,
    "text": "可线要穿过金属上的孔，孔边太锋利"
   },
   {
    "t0": 43.528,
    "t1": 44.8,
    "text": "和绷紧的线合不来。"
   }
  ]
 },
 {
  "i": 9,
  "start": 45.808,
  "speech_from": 45.9,
  "speech_to": 51.515,
  "late": 0.0,
  "text": "1963年，拉科斯特拿到一项钢拍专利：钢框做成两道梁，中间连一层薄壁。",
  "phrases": [
   {
    "t0": 45.9,
    "t1": 46.695,
    "text": "1963年"
   },
   {
    "t0": 46.981,
    "t1": 48.761,
    "text": "拉科斯特拿到一项钢拍专利"
   },
   {
    "t0": 49.078,
    "t1": 51.515,
    "text": "钢框做成两道梁，中间连一层薄壁。"
   }
  ]
 },
 {
  "i": 10,
  "start": 53.208,
  "speech_from": 53.3,
  "speech_to": 57.771,
  "late": 0.0,
  "text": "这项设计授权给威尔逊，就是后来康纳斯用了很多年的T2000。",
  "phrases": [
   {
    "t0": 53.3,
    "t1": 54.879,
    "text": "这项设计授权给威尔逊"
   },
   {
    "t0": 55.175,
    "t1": 57.771,
    "text": "就是后来康纳斯用了很多年的T2000。"
   }
  ]
 },
 {
  "i": 11,
  "start": 58.408,
  "speech_from": 58.5,
  "speech_to": 61.255,
  "late": 0.0,
  "text": "接着，又有了中间分成三格的铝框。",
  "phrases": [
   {
    "t0": 58.5,
    "t1": 61.255,
    "text": "接着，又有了中间分成三格的铝框。"
   }
  ]
 },
 {
  "i": 12,
  "start": 62.408,
  "speech_from": 62.5,
  "speech_to": 65.202,
  "late": 0.0,
  "text": "框换成了金属，拍面却还是那么大。",
  "phrases": [
   {
    "t0": 62.5,
    "t1": 65.202,
    "text": "框换成了金属，拍面却还是那么大。"
   }
  ]
 },
 {
  "i": 13,
  "start": 66.658,
  "speech_from": 66.75,
  "speech_to": 69.897,
  "late": 0.0,
  "text": "1976年，霍华德·黑德拿到大拍面专利。",
  "phrases": [
   {
    "t0": 66.75,
    "t1": 67.63,
    "text": "1976年"
   },
   {
    "t0": 67.905,
    "t1": 69.897,
    "text": "霍华德·黑德拿到大拍面专利。"
   }
  ]
 },
 {
  "i": 14,
  "start": 70.658,
  "speech_from": 70.75,
  "speech_to": 74.405,
  "late": 0.0,
  "text": "他在专利里写：旧拍子不震手的那个点，靠近拍喉。",
  "phrases": [
   {
    "t0": 70.75,
    "t1": 71.598,
    "text": "他在专利里写"
   },
   {
    "t0": 71.873,
    "t1": 74.405,
    "text": "旧拍子不震手的那个点，靠近拍喉。"
   }
  ]
 },
 {
  "i": 15,
  "start": 75.458,
  "speech_from": 75.55,
  "speech_to": 78.103,
  "late": 0.0,
  "text": "可大多数人，习惯打在拍面正中。",
  "phrases": [
   {
    "t0": 75.55,
    "t1": 78.103,
    "text": "可大多数人，习惯打在拍面正中。"
   }
  ]
 },
 {
  "i": 16,
  "start": 79.658,
  "speech_from": 79.75,
  "speech_to": 84.538,
  "late": 0.0,
  "text": "他没有把那个点挪到中间，而是把拍面往手柄方向拉长，把它包了进来。",
  "phrases": [
   {
    "t0": 79.75,
    "t1": 81.233,
    "text": "他没有把那个点挪到中间"
   },
   {
    "t0": 81.519,
    "t1": 83.532,
    "text": "而是把拍面往手柄方向拉长"
   },
   {
    "t0": 83.765,
    "t1": 84.538,
    "text": "把它包了进来。"
   }
  ]
 },
 {
  "i": 17,
  "start": 86.858,
  "speech_from": 86.95,
  "speech_to": 89.376,
  "late": 0.0,
  "text": "拍面，一下子大了40%以上。",
  "phrases": [
   {
    "t0": 86.95,
    "t1": 89.08,
    "text": "拍面，一下子大了40%以上。"
   }
  ]
 },
 {
  "i": 18,
  "start": 91.708,
  "speech_from": 91.8,
  "speech_to": 94.004,
  "late": 0.0,
  "text": "人们常说的「甜点」，其实是三个点。",
  "phrases": [
   {
    "t0": 91.8,
    "t1": 94.004,
    "text": "人们常说的「甜点」，其实是三个点。"
   }
  ]
 },
 {
  "i": 19,
  "start": 95.708,
  "speech_from": 95.8,
  "speech_to": 100.25,
  "late": 0.0,
  "text": "回弹最快的点；振动最小的节点；还有不震手的打击中心。",
  "phrases": [
   {
    "t0": 95.8,
    "t1": 98.449,
    "text": "回弹最快的点；振动最小的节点"
   },
   {
    "t0": 98.777,
    "t1": 100.25,
    "text": "还有不震手的打击中心。"
   }
  ]
 },
 {
  "i": 20,
  "start": 105.208,
  "speech_from": 105.3,
  "speech_to": 107.366,
  "late": 0.0,
  "text": "手感最好的，通常是节点。",
  "phrases": [
   {
    "t0": 105.3,
    "t1": 107.366,
    "text": "手感最好的，通常是节点。"
   }
  ]
 },
 {
  "i": 21,
  "start": 108.808,
  "speech_from": 108.9,
  "speech_to": 112.237,
  "late": 0.0,
  "text": "而真握在手里的时候，打击中心并没有那么重要。",
  "phrases": [
   {
    "t0": 108.9,
    "t1": 110.235,
    "text": "而真握在手里的时候"
   },
   {
    "t0": 110.489,
    "t1": 112.237,
    "text": "打击中心并没有那么重要。"
   }
  ]
 },
 {
  "i": 22,
  "start": 114.258,
  "speech_from": 114.35,
  "speech_to": 119.403,
  "late": 0.0,
  "text": "拍头变宽，绕着长轴转动的惯性就变大，打偏时，拍子扭得更少。",
  "phrases": [
   {
    "t0": 114.35,
    "t1": 115.081,
    "text": "拍头变宽"
   },
   {
    "t0": 115.336,
    "t1": 117.401,
    "text": "绕着长轴转动的惯性就变大"
   },
   {
    "t0": 117.666,
    "t1": 119.403,
    "text": "打偏时，拍子扭得更少。"
   }
  ]
 },
 {
  "i": 23,
  "start": 121.658,
  "speech_from": 121.75,
  "speech_to": 125.352,
  "late": 0.0,
  "text": "实验里，打偏的球左右几乎不偏，却会明显变慢。",
  "phrases": [
   {
    "t0": 121.75,
    "t1": 124.081,
    "text": "实验里，打偏的球左右几乎不偏"
   },
   {
    "t0": 124.261,
    "t1": 125.352,
    "text": "却会明显变慢。"
   }
  ]
 },
 {
  "i": 24,
  "start": 127.058,
  "speech_from": 127.15,
  "speech_to": 130.943,
  "late": 0.0,
  "text": "模型显示，真实挥拍时，它还会飞得更高、更远。",
  "phrases": [
   {
    "t0": 127.15,
    "t1": 128.951,
    "text": "模型显示，真实挥拍时"
   },
   {
    "t0": 129.142,
    "t1": 130.943,
    "text": "它还会飞得更高、更远。"
   }
  ]
 },
 {
  "i": 25,
  "start": 132.858,
  "speech_from": 132.95,
  "speech_to": 135.26,
  "late": 0.0,
  "text": "所以，打偏的球容易飞长。",
  "phrases": [
   {
    "t0": 132.95,
    "t1": 134.815,
    "text": "所以，打偏的球容易飞长。"
   }
  ]
 },
 {
  "i": 26,
  "start": 136.908,
  "speech_from": 137.0,
  "speech_to": 141.322,
  "late": 0.0,
  "text": "按同样的重量算，碳纤维的强度和刚度是钢的好几倍。",
  "phrases": [
   {
    "t0": 137.0,
    "t1": 138.219,
    "text": "按同样的重量算"
   },
   {
    "t0": 138.505,
    "t1": 141.322,
    "text": "碳纤维的强度和刚度是钢的好几倍。"
   }
  ]
 },
 {
  "i": 27,
  "start": 142.308,
  "speech_from": 142.4,
  "speech_to": 145.398,
  "late": 0.0,
  "text": "1980年前后，复合材料球拍成了主流。",
  "phrases": [
   {
    "t0": 142.4,
    "t1": 143.47,
    "text": "1980年前后"
   },
   {
    "t0": 143.703,
    "t1": 145.398,
    "text": "复合材料球拍成了主流。"
   }
  ]
 },
 {
  "i": 28,
  "start": 146.708,
  "speech_from": 146.8,
  "speech_to": 151.705,
  "late": 0.0,
  "text": "1983年法网，诺阿被普遍认为是最后一个用木拍赢下大满贯的人。",
  "phrases": [
   {
    "t0": 146.8,
    "t1": 147.828,
    "text": "1983年法网"
   },
   {
    "t0": 148.072,
    "t1": 151.705,
    "text": "诺阿被普遍认为是最后一个用木拍赢下大满贯的人。"
   }
  ]
 },
 {
  "i": 29,
  "start": 152.508,
  "speech_from": 152.6,
  "speech_to": 159.761,
  "late": 0.0,
  "text": "拍子更大、更轻，也更硬：拍框的振动频率，从100赫兹上下，升到最高180赫兹左右。",
  "phrases": [
   {
    "t0": 152.6,
    "t1": 154.592,
    "text": "拍子更大、更轻，也更硬"
   },
   {
    "t0": 154.772,
    "t1": 157.876,
    "text": "拍框的振动频率，从100赫兹上下"
   },
   {
    "t0": 157.876,
    "t1": 159.761,
    "text": "升到最高180赫兹左右。"
   }
  ]
 },
 {
  "i": 30,
  "start": 162.108,
  "speech_from": 162.2,
  "speech_to": 167.243,
  "late": 0.0,
  "text": "可更硬，对打在节点附近的球几乎没影响；它帮的是打不准的人，和发球。",
  "phrases": [
   {
    "t0": 162.2,
    "t1": 165.177,
    "text": "可更硬，对打在节点附近的球几乎没影响"
   },
   {
    "t0": 165.442,
    "t1": 167.243,
    "text": "它帮的是打不准的人，和发球。"
   }
  ]
 },
 {
  "i": 31,
  "start": 168.708,
  "speech_from": 168.8,
  "speech_to": 173.38,
  "late": 0.0,
  "text": "那更轻呢？挥拍重量减10%，挥速只快约3%。",
  "phrases": [
   {
    "t0": 168.8,
    "t1": 171.695,
    "text": "那更轻呢？挥拍重量减10%"
   },
   {
    "t0": 171.091,
    "t1": 173.38,
    "text": "挥速只快约3%。"
   }
  ]
 },
 {
  "i": 32,
  "start": 174.958,
  "speech_from": 175.05,
  "speech_to": 178.302,
  "late": 0.0,
  "text": "大拍面出来以后，国际网联才第一次给球拍定上限。",
  "phrases": [
   {
    "t0": 175.05,
    "t1": 175.993,
    "text": "大拍面出来以后"
   },
   {
    "t0": 176.226,
    "t1": 178.302,
    "text": "国际网联才第一次给球拍定上限。"
   }
  ]
 },
 {
  "i": 33,
  "start": 179.558,
  "speech_from": 179.65,
  "speech_to": 185.869,
  "late": 0.0,
  "text": "长度从32英寸收到29英寸；今天的规则只管尺寸，不管多重、用什么材料。",
  "phrases": [
   {
    "t0": 179.65,
    "t1": 182.066,
    "text": "长度从32英寸收到29英寸"
   },
   {
    "t0": 182.076,
    "t1": 184.629,
    "text": "今天的规则只管尺寸，不管多重"
   },
   {
    "t0": 184.64,
    "t1": 185.466,
    "text": "用什么材料。"
   }
  ]
 },
 {
  "i": 34,
  "start": 188.408,
  "speech_from": 188.5,
  "speech_to": 194.125,
  "late": 0.0,
  "text": "国际网联的研究者在论文里写：现代球拍让比赛从「技术」，转向了「力量和旋转」。",
  "phrases": [
   {
    "t0": 188.5,
    "t1": 190.566,
    "text": "国际网联的研究者在论文里写"
   },
   {
    "t0": 190.873,
    "t1": 193.14,
    "text": "现代球拍让比赛从「技术」"
   },
   {
    "t0": 193.14,
    "t1": 194.125,
    "text": "转向了「力量和旋转」。"
   }
  ]
 },
 {
  "i": 35,
  "start": 196.008,
  "speech_from": 196.1,
  "speech_to": 199.946,
  "late": 0.0,
  "text": "模拟研究说，换上今天的拍和球，同一个人能发得更快。",
  "phrases": [
   {
    "t0": 196.1,
    "t1": 198.304,
    "text": "模拟研究说，换上今天的拍和球"
   },
   {
    "t0": 198.484,
    "t1": 199.946,
    "text": "同一个人能发得更快。"
   }
  ]
 },
 {
  "i": 36,
  "start": 201.008,
  "speech_from": 201.1,
  "speech_to": 204.469,
  "late": 0.0,
  "text": "可实测发现，用老木拍发球，几乎和现代拍一样快。",
  "phrases": [
   {
    "t0": 201.1,
    "t1": 202.88,
    "text": "可实测发现，用老木拍发球"
   },
   {
    "t0": 203.039,
    "t1": 204.469,
    "text": "几乎和现代拍一样快。"
   }
  ]
 },
 {
  "i": 37,
  "start": 206.008,
  "speech_from": 206.1,
  "speech_to": 211.312,
  "late": 0.0,
  "text": "和上一集的线一样：时间对得上，却没有研究能把球拍的作用单独算出来。",
  "phrases": [
   {
    "t0": 206.1,
    "t1": 208.251,
    "text": "和上一集的线一样：时间对得上"
   },
   {
    "t0": 208.41,
    "t1": 211.312,
    "text": "却没有研究能把球拍的作用单独算出来。"
   }
  ]
 },
 {
  "i": 38,
  "start": 213.058,
  "speech_from": 213.15,
  "speech_to": 216.776,
  "late": 0.0,
  "text": "球拍改写了打法吗？它至少改写了打偏的代价。",
  "phrases": [
   {
    "t0": 213.15,
    "t1": 214.517,
    "text": "球拍改写了打法吗？"
   },
   {
    "t0": 214.986,
