  "start": 58.287,
  "speech_from": 58.379,
  "speech_to": 61.706,
  "late": 0.0,
  "text": "混到发外角和发中路，赢下这一分的机会一样大。",
  "phrases": [
   {
    "t0": 58.379,
    "t1": 59.831,
    "text": "混到发外角和发中路"
   },
   {
    "t0": 60.021,
    "t1": 61.706,
    "text": "赢下这一分的机会一样大。"
   }
  ]
 },
 {
