[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 1.667,
  "late": 0.0,
  "text": "发球，该往哪边发？",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 1.667,
    "text": "发球，该往哪边发？"
   }
  ]
 },
 {
  "i": 1,
  "start": 1.924,
  "speech_from": 2.016,
  "speech_to": 5.438,
  "late": 0.0,
  "text": "答案，是一个拿过诺贝尔奖的理论——纳什均衡。",
  "phrases": [
   {
    "t0": 2.016,
    "t1": 5.438,
    "text": "答案，是一个拿过诺贝尔奖的理论——纳什均衡。"
   }
  ]
 },
 {
  "i": 2,
  "start": 9.881,
  "speech_from": 9.973,
  "speech_to": 12.579,
  "late": 0.0,
  "text": "一发从出手到落地，平均不到半秒。",
  "phrases": [
   {
    "t0": 9.973,
    "t1": 12.579,
    "text": "一发从出手到落地，平均不到半秒。"
   }
  ]
 },
 {
  "i": 3,
  "start": 14.668,
  "speech_from": 14.76,
  "speech_to": 16.561,
  "late": 0.0,
  "text": "接发的人，只能先猜。",
  "phrases": [
   {
    "t0": 14.76,
    "t1": 16.561,
    "text": "接发的人，只能先猜。"
   }
  ]
 },
 {
  "i": 4,
  "start": 19.988,
  "speech_from": 20.08,
  "speech_to": 21.733,
  "late": 0.0,
  "text": "总发一边，就会被猜中。",
  "phrases": [
   {
    "t0": 20.08,
    "t1": 21.733,
    "text": "总发一边，就会被猜中。"
   }
  ]
 },
 {
  "i": 5,
  "start": 34.35,
  "speech_from": 34.442,
  "speech_to": 38.309,
  "late": 0.0,
  "text": "1928 年的冯·诺依曼、1950 年的纳什，给出了答案。",
  "phrases": [
   {
    "t0": 34.442,
    "t1": 37.038,
    "text": "1928 年的冯·诺依曼"
   },
   {
    "t0": 36.19,
    "t1": 38.309,
    "text": "1950 年的纳什，给出了答案。"
   }
  ]
 },
 {
  "i": 6,
  "start": 42.329,
  "speech_from": 42.421,
  "speech_to": 45.621,
  "late": 0.0,
  "text": "就像石头剪刀布：总出一样，一定会输。",
  "phrases": [
   {
    "t0": 42.421,
    "t1": 44.529,
    "text": "就像石头剪刀布：总出一样"
   },
   {
    "t0": 44.731,
    "t1": 45.621,
    "text": "一定会输。"
   }
  ]
 },
 {
  "i": 7,
  "start": 51.372,
  "speech_from": 51.464,
  "speech_to": 53.371,
  "late": 0.0,
  "text": "最好的办法，是混着发——",
  "phrases": [
   {
    "t0": 51.464,
    "t1": 53.371,
    "text": "最好的办法，是混着发——"
   }
  ]
 },
 {
