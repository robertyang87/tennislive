[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 1.667,
  "late": 0.0,
  "text": "发球，该往哪边发？",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 1.667,
    "text": "发球，该往哪边发？"
   }
  ]
 },
 {
  "i": 1,
  "start": 1.924,
  "speech_from": 2.016,
  "speech_to": 5.438,
  "late": 0.0,
  "text": "答案，是一个拿过诺贝尔奖的理论——纳什均衡。",
  "phrases": [
   {
    "t0": 2.016,
    "t1": 5.438,
    "text": "答案，是一个拿过诺贝尔奖的理论——纳什均衡。"
   }
  ]
 },
 {
  "i": 2,
  "start": 9.458,
  "speech_from": 9.55,
  "speech_to": 12.156,
  "late": 0.0,
  "text": "一发从出手到落地，平均不到半秒。",
  "phrases": [
   {
    "t0": 9.55,
    "t1": 12.156,
    "text": "一发从出手到落地，平均不到半秒。"
   }
  ]
 },
 {
  "i": 3,
  "start": 14.058,
  "speech_from": 14.15,
  "speech_to": 15.951,
  "late": 0.0,
  "text": "接发的人，只能先猜。",
  "phrases": [
   {
    "t0": 14.15,
    "t1": 15.951,
    "text": "接发的人，只能先猜。"
   }
  ]
 },
 {
  "i": 4,
  "start": 19.208,
  "speech_from": 19.3,
  "speech_to": 20.953,
  "late": 0.0,
  "text": "总发一边，就会被猜中。",
  "phrases": [
   {
    "t0": 19.3,
    "t1": 20.953,
    "text": "总发一边，就会被猜中。"
   }
  ]
 },
 {
  "i": 5,
  "start": 33.358,
  "speech_from": 33.45,
  "speech_to": 37.317,
  "late": 0.0,
  "text": "1928 年的冯·诺依曼、1950 年的纳什，给出了答案。",
  "phrases": [
   {
    "t0": 33.45,
    "t1": 36.046,
    "text": "1928 年的冯·诺依曼"
   },
   {
    "t0": 35.198,
    "t1": 37.317,
    "text": "1950 年的纳什，给出了答案。"
   }
  ]
 },
 {
  "i": 6,
  "start": 40.858,
  "speech_from": 40.95,
  "speech_to": 44.15,
  "late": 0.0,
  "text": "就像石头剪刀布：总出一样，一定会输。",
  "phrases": [
   {
    "t0": 40.95,
    "t1": 43.058,
    "text": "就像石头剪刀布：总出一样"
   },
   {
    "t0": 43.26,
    "t1": 44.15,
    "text": "一定会输。"
   }
  ]
 },
 {
  "i": 7,
  "start": 48.858,
  "speech_from": 48.95,
  "speech_to": 50.857,
  "late": 0.0,
  "text": "最好的办法，是混着发——",
  "phrases": [
   {
    "t0": 48.95,
    "t1": 50.857,
    "text": "最好的办法，是混着发——"
   }
  ]
 },
 {
  "i": 8,
  "start": 55.458,
  "speech_from": 55.55,
  "speech_to": 58.877,
  "late": 0.0,
  "text": "混到发外角和发中路，赢下这一分的机会一样大。",
  "phrases": [
   {
    "t0": 55.55,
    "t1": 57.002,
    "text": "混到发外角和发中路"
   },
   {
    "t0": 57.192,
    "t1": 58.877,
    "text": "赢下这一分的机会一样大。"
   }
  ]
 },
 {
  "i": 9,
  "start": 62.808,
  "speech_from": 62.9,
  "speech_to": 64.775,
  "late": 0.0,
  "text": "混着发，不等于一半一半。",
  "phrases": [
   {
    "t0": 62.9,
    "t1": 64.775,
    "text": "混着发，不等于一半一半。"
   }
  ]
 },
 {
  "i": 10,
  "start": 69.008,
  "speech_from": 69.1,
  "speech_to": 73.486,
  "late": 0.0,
  "text": "辛纳在占先区，外角发得多得多，两边的得分率却几乎一样。",
  "phrases": [
   {
    "t0": 69.1,
    "t1": 71.484,
    "text": "辛纳在占先区，外角发得多得多"
