  "start": 66.267,
  "speech_from": 66.359,
  "speech_to": 68.234,
  "late": 0.0,
  "text": "混着发，不等于一半一半。",
  "phrases": [
   {
    "t0": 66.359,
    "t1": 68.234,
    "text": "混着发，不等于一半一半。"
   }
  ]
 },
 {
