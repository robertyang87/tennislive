  "start": 30.858,
  "speech_from": 30.95,
  "speech_to": 34.838,
  "late": 0.0,
  "text": "而人看到一个信号再做反应，最快也要0.2秒左右。",
  "phrases": [
   {
    "t0": 30.95,
    "t1": 32.772,
