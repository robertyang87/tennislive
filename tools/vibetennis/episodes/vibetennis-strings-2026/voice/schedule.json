  "start": 152.268,
  "speech_from": 152.36,
  "speech_to": 157.318,
  "late": 0.0,
  "text": "聚酯线掉得最快，所以职业球员每换一次新球，就换一支刚穿好的拍子。",
  "phrases": [
   {
    "t0": 152.36,
    "t1": 153.557,
    "text": "聚酯线掉得最快"
   },
   {
    "t0": 153.854,
    "t1": 155.612,
    "text": "所以职业球员每换一次新球"
   },
   {
    "t0": 155.782,
