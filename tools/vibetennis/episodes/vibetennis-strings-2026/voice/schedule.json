[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 3.468,
  "late": 0.0,
  "text": "1874年到今天，网球拍上的线换了四代。",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 1.572,
    "text": "1874年到今天"
   },
   {
    "t0": 1.815,
    "t1": 3.468,
    "text": "网球拍上的线换了四代。"
   }
  ]
 },
 {
  "i": 1,
  "start": 5.208,
  "speech_from": 5.3,
  "speech_to": 8.341,
  "late": 0.0,
  "text": "发球上网，却在短短十来年里近乎消失。",
  "phrases": [
   {
    "t0": 5.3,
    "t1": 5.978,
    "text": "发球上网"
   },
   {
    "t0": 6.201,
    "t1": 8.341,
    "text": "却在短短十来年里近乎消失。"
   }
  ]
 },
 {
  "i": 2,
  "start": 9.708,
  "speech_from": 9.8,
  "speech_to": 11.474,
  "late": 0.0,
  "text": "是线，改变了网球吗？",
  "phrases": [
   {
    "t0": 9.8,
    "t1": 11.474,
    "text": "是线，改变了网球吗？"
   }
  ]
 },
 {
  "i": 3,
  "start": 14.558,
  "speech_from": 14.65,
  "speech_to": 16.833,
  "late": 0.0,
  "text": "最早的网球线，是羊的肠衣。",
  "phrases": [
   {
    "t0": 14.65,
    "t1": 16.833,
    "text": "最早的网球线，是羊的肠衣。"
   }
  ]
 },
 {
  "i": 4,
  "start": 17.09,
  "speech_from": 17.182,
  "speech_to": 21.271,
  "late": 0.0,
  "text": "球撞上线床再弹开，前后的速度之比，牛顿最早测过。",
  "phrases": [
   {
    "t0": 17.182,
    "t1": 19.894,
    "text": "球撞上线床再弹开，前后的速度之比"
   },
   {
    "t0": 20.138,
    "t1": 21.271,
    "text": "牛顿最早测过。"
   }
  ]
 },
 {
  "i": 5,
  "start": 23.09,
  "speech_from": 23.182,
  "speech_to": 24.846,
  "late": 0.0,
  "text": "今天叫它，恢复系数。",
  "phrases": [
   {
    "t0": 23.182,
    "t1": 24.846,
    "text": "今天叫它，恢复系数。"
   }
  ]
 },
 {
  "i": 6,
  "start": 29.708,
  "speech_from": 29.8,
  "speech_to": 32.152,
  "late": 0.0,
  "text": "羊肠线贵，又不耐磨、怕潮。",
  "phrases": [
   {
    "t0": 29.8,
    "t1": 32.152,
    "text": "羊肠线贵，又不耐磨、怕潮。"
   }
  ]
 },
 {
  "i": 7,
  "start": 32.409,
  "speech_from": 32.501,
  "speech_to": 34.461,
  "late": 0.0,
  "text": "于是有了尼龙这样的合成线。",
  "phrases": [
   {
    "t0": 32.501,
    "t1": 34.461,
    "text": "于是有了尼龙这样的合成线。"
   }
  ]
 },
 {
  "i": 8,
  "start": 38.858,
  "speech_from": 38.95,
  "speech_to": 43.336,
  "late": 0.0,
  "text": "1977年，德国人菲舍尔申请专利：主线和横线不再编织。",
  "phrases": [
   {
    "t0": 38.95,
    "t1": 41.461,
    "text": "1977年，德国人菲舍尔申请专利"
   },
   {
    "t0": 41.758,
    "t1": 43.336,
    "text": "主线和横线不再编织。"
   }
  ]
 },
 {
  "i": 9,
  "start": 44.858,
  "speech_from": 44.95,
  "speech_to": 49.177,
  "late": 0.0,
  "text": "线能滑开、再弹回，实验室里转速接近普通球拍的两倍。",
  "phrases": [
   {
    "t0": 44.95,
    "t1": 45.681,
    "text": "线能滑开"
   },
   {
    "t0": 45.84,
    "t1": 49.177,
    "text": "再弹回，实验室里转速接近普通球拍的两倍。"
   }
  ]
 },
 {
  "i": 10,
  "start": 51.358,
  "speech_from": 51.45,
  "speech_to": 54.628,
  "late": 0.0,
  "text": "1978年，国际网联把它写进规则：禁了。",
  "phrases": [
   {
    "t0": 51.45,
    "t1": 54.025,
    "text": "1978年，国际网联把它写进规则"
   },
   {
    "t0": 54.247,
    "t1": 54.628,
    "text": "禁了。"
   }
  ]
 },
 {
  "i": 11,
  "start": 54.886,
  "speech_from": 54.978,
  "speech_to": 59.353,
  "late": 0.0,
  "text": "球在线上先滑，再被摩擦力带着滚起来，这是库仑摩擦定律。",
  "phrases": [
   {
    "t0": 54.978,
    "t1": 56.08,
    "text": "球在线上先滑"
   },
   {
    "t0": 56.303,
    "t1": 57.839,
    "text": "再被摩擦力带着滚起来"
   },
   {
    "t0": 58.04,
    "t1": 59.353,
    "text": "这是库仑摩擦定律。"
   }
  ]
 },
 {
  "i": 12,
  "start": 65.008,
  "speech_from": 65.1,
  "speech_to": 68.268,
  "late": 0.0,
  "text": "1997年，库尔滕用聚酯线拿下法网。",
  "phrases": [
   {
    "t0": 65.1,
    "t1": 66.001,
    "text": "1997年"
   },
   {
    "t0": 66.244,
    "t1": 68.268,
    "text": "库尔滕用聚酯线拿下法网。"
   }
  ]
 },
 {
  "i": 13,
  "start": 69.508,
  "speech_from": 69.6,
  "speech_to": 72.725,
  "late": 0.0,
  "text": "到2010年，温网的男选手都换上了它。",
  "phrases": [
   {
    "t0": 69.6,
    "t1": 70.533,
    "text": "到2010年"
   },
   {
    "t0": 70.797,
    "t1": 72.725,
    "text": "温网的男选手都换上了它。"
   }
  ]
 },
 {
  "i": 14,
  "start": 73.508,
  "speech_from": 73.6,
  "speech_to": 77.014,
  "late": 0.0,
  "text": "它真的让球转得更多吗？有实验说多两成，",
  "phrases": [
   {
    "t0": 73.6,
    "t1": 75.285,
    "text": "它真的让球转得更多吗？"
   },
   {
    "t0": 75.764,
    "t1": 77.014,
    "text": "有实验说多两成"
   }
  ]
 },
 {
  "i": 15,
  "start": 77.272,
  "speech_from": 77.364,
  "speech_to": 80.648,
  "late": 0.0,
  "text": "同行评审的实验，却测不出材料本身的区别。",
  "phrases": [
   {
    "t0": 77.364,
    "t1": 78.508,
    "text": "同行评审的实验"
   },
   {
    "t0": 78.773,
    "t1": 80.648,
    "text": "却测不出材料本身的区别。"
   }
  ]
 },
 {
  "i": 16,
  "start": 80.905,
  "speech_from": 80.997,
  "speech_to": 84.355,
  "late": 0.0,
  "text": "大家都认的只有一点：线能不能滑开、再弹回。",
  "phrases": [
   {
    "t0": 80.997,
    "t1": 83.572,
    "text": "大家都认的只有一点：线能不能滑开"
   },
   {
    "t0": 83.73,
    "t1": 84.355,
    "text": "再弹回。"
   }
  ]
 },
 {
  "i": 17,
  "start": 89.158,
  "speech_from": 89.25,
  "speech_to": 93.289,
  "late": 0.0,
  "text": "那力量呢？实验室里，换一种线，球速变化很小。",
  "phrases": [
   {
    "t0": 89.25,
    "t1": 91.902,
    "text": "那力量呢？实验室里，换一种线"
   },
   {
    "t0": 92.092,
    "t1": 93.289,
    "text": "球速变化很小。"
   }
  ]
 },
 {
  "i": 18,
  "start": 97.308,
  "speech_from": 97.4,
  "speech_to": 99.095,
  "late": 0.0,
  "text": "真正的代价，是掉磅。",
  "phrases": [
   {
    "t0": 97.4,
    "t1": 99.095,
    "text": "真正的代价，是掉磅。"
   }
  ]
 },
 {
  "i": 19,
  "start": 99.353,
  "speech_from": 99.445,
  "speech_to": 103.534,
  "late": 0.0,
  "text": "线一拉紧就开始应力松弛，刚穿好就比设定低了约三成。",
  "phrases": [
   {
    "t0": 99.445,
    "t1": 101.299,
    "text": "线一拉紧就开始应力松弛"
   },
   {
    "t0": 101.458,
    "t1": 103.534,
    "text": "刚穿好就比设定低了约三成。"
   }
  ]
 },
 {
  "i": 20,
  "start": 105.353,
  "speech_from": 105.445,
  "speech_to": 108.687,
  "late": 0.0,
  "text": "聚酯线掉得最快，磅数一掉，球就往界外飞。",
  "phrases": [
   {
    "t0": 105.445,
    "t1": 107.532,
    "text": "聚酯线掉得最快，磅数一掉"
   },
   {
    "t0": 107.744,
    "t1": 108.687,
    "text": "球就往界外飞。"
   }
  ]
 },
 {
  "i": 21,
  "start": 110.353,
  "speech_from": 110.445,
  "speech_to": 114.238,
  "late": 0.0,
  "text": "所以职业球员每换一次新球，就换一支刚穿好的拍子。",
  "phrases": [
   {
    "t0": 110.445,
    "t1": 112.5,
    "text": "所以职业球员每换一次新球"
   },
   {
    "t0": 112.659,
    "t1": 114.238,
    "text": "就换一支刚穿好的拍子。"
   }
  ]
 },
 {
