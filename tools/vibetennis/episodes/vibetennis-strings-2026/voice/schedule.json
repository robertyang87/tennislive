[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 3.468,
  "late": 0.0,
  "text": "1874年到今天，网球拍上的线换了四代。",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 1.572,
    "text": "1874年到今天"
   },
   {
    "t0": 1.815,
    "t1": 3.468,
    "text": "网球拍上的线换了四代。"
   }
  ]
 },
 {
  "i": 1,
  "start": 5.208,
  "speech_from": 5.3,
  "speech_to": 10.311,
  "late": 0.0,
  "text": "发球上网——发完球直接冲到网前截击，却在短短十来年里近乎消失。",
  "phrases": [
   {
    "t0": 5.3,
    "t1": 8.521,
    "text": "发球上网——发完球直接冲到网前截击"
   },
   {
    "t0": 8.531,
    "t1": 10.311,
    "text": "却在短短十来年里近乎消失。"
   }
  ]
 },
 {
  "i": 2,
  "start": 10.568,
  "speech_from": 10.66,
  "speech_to": 12.334,
  "late": 0.0,
  "text": "是线，改变了网球吗？",
  "phrases": [
   {
    "t0": 10.66,
    "t1": 12.334,
    "text": "是线，改变了网球吗？"
   }
  ]
 },
 {
  "i": 3,
  "start": 14.558,
  "speech_from": 14.65,
  "speech_to": 16.833,
  "late": 0.0,
  "text": "最早的网球线，是羊的肠衣。",
  "phrases": [
   {
    "t0": 14.65,
    "t1": 16.833,
    "text": "最早的网球线，是羊的肠衣。"
   }
  ]
 },
 {
  "i": 4,
  "start": 17.09,
  "speech_from": 17.182,
  "speech_to": 21.79,
  "late": 0.0,
  "text": "羊肠线贵，又不耐磨、怕潮，于是有了尼龙这样的合成线。",
  "phrases": [
   {
    "t0": 17.182,
    "t1": 18.92,
    "text": "羊肠线贵，又不耐磨"
   },
   {
    "t0": 19.068,
    "t1": 21.79,
    "text": "怕潮，于是有了尼龙这样的合成线。"
   }
  ]
 },
 {
  "i": 5,
  "start": 24.708,
  "speech_from": 24.8,
  "speech_to": 31.665,
  "late": 0.0,
  "text": "放大来看：天然肠线是一条条牛肠衣绞成的；多股线是很多根尼龙细丝；单丝线是实心的一根。",
  "phrases": [
   {
    "t0": 24.8,
    "t1": 25.404,
    "text": "放大来看"
   },
   {
    "t0": 25.711,
    "t1": 27.947,
    "text": "天然肠线是一条条牛肠衣绞成的"
   },
   {
    "t0": 28.233,
    "t1": 30.023,
    "text": "多股线是很多根尼龙细丝"
   },
   {
    "t0": 30.288,
    "t1": 31.665,
    "text": "单丝线是实心的一根。"
   }
  ]
 },
 {
  "i": 6,
  "start": 32.708,
  "speech_from": 32.8,
  "speech_to": 35.894,
  "late": 0.0,
  "text": "打久了，线和线交叉的地方会磨出凹槽。",
  "phrases": [
   {
    "t0": 32.8,
    "t1": 35.894,
    "text": "打久了，线和线交叉的地方会磨出凹槽。"
   }
  ]
 },
 {
  "i": 7,
  "start": 40.858,
  "speech_from": 40.95,
  "speech_to": 50.664,
  "late": 0.0,
  "text": "1997年，库尔滕用聚酯线拿下法网；到2010年，温网的男选手都换上了它；再后来，又流行主线、横线各用一种线的混搭。",
  "phrases": [
   {
    "t0": 40.95,
    "t1": 41.851,
    "text": "1997年"
   },
   {
    "t0": 42.094,
    "t1": 43.874,
    "text": "库尔滕用聚酯线拿下法网"
   },
   {
    "t0": 44.16,
    "t1": 45.039,
    "text": "到2010年"
   },
   {
    "t0": 45.325,
    "t1": 46.957,
    "text": "温网的男选手都换上了它"
   },
   {
    "t0": 47.222,
    "t1": 48.662,
    "text": "再后来，又流行主线"
   },
   {
    "t0": 48.874,
    "t1": 50.664,
    "text": "横线各用一种线的混搭。"
   }
  ]
 },
 {
  "i": 8,
  "start": 50.922,
  "speech_from": 51.014,
  "speech_to": 55.029,
  "late": 0.0,
  "text": "一根线能改变网球的，只有三样：力量、旋转、磅数。",
  "phrases": [
   {
    "t0": 51.014,
    "t1": 53.271,
    "text": "一根线能改变网球的，只有三样"
   },
   {
    "t0": 53.536,
    "t1": 55.029,
    "text": "力量、旋转、磅数。"
   }
  ]
 },
 {
  "i": 9,
  "start": 58.072,
  "speech_from": 58.164,
  "speech_to": 65.265,
  "late": 0.0,
  "text": "先看力量。球撞上线床再弹开，弹开和撞进来的速度之比，叫恢复系数，牛顿最早测过。",
  "phrases": [
   {
    "t0": 58.164,
    "t1": 60.858,
    "text": "先看力量。球撞上线床再弹开"
   },
   {
    "t0": 61.07,
    "t1": 62.744,
    "text": "弹开和撞进来的速度之比"
   },
   {
    "t0": 62.924,
    "t1": 65.265,
    "text": "叫恢复系数，牛顿最早测过。"
   }
  ]
 },
 {
  "i": 10,
  "start": 66.072,
  "speech_from": 66.164,
  "speech_to": 69.713,
  "late": 0.0,
  "text": "这个比值越大，线还给球的能量越多，球飞得越快。",
  "phrases": [
   {
    "t0": 66.164,
    "t1": 68.664,
    "text": "这个比值越大，线还给球的能量越多"
   },
   {
    "t0": 68.834,
    "t1": 69.713,
    "text": "球飞得越快。"
   }
  ]
 },
 {
  "i": 11,
  "start": 70.572,
  "speech_from": 70.664,
  "speech_to": 76.385,
  "late": 0.0,
  "text": "可实验室里，各种线都能还回约95%的能量，换一种线，球速变化很小；",
  "phrases": [
   {
    "t0": 70.664,
    "t1": 71.395,
    "text": "可实验室里"
   },
   {
    "t0": 71.607,
    "t1": 73.959,
    "text": "各种线都能还回约95%的能量"
   },
   {
    "t0": 73.959,
    "t1": 75.94,
    "text": "换一种线，球速变化很小"
   }
  ]
 },
 {
  "i": 12,
  "start": 77.072,
  "speech_from": 77.164,
  "speech_to": 80.014,
  "late": 0.0,
  "text": "线穿松一些，底线球也只快2%到3%。",
  "phrases": [
   {
    "t0": 77.164,
    "t1": 77.927,
    "text": "线穿松一些"
   },
   {
    "t0": 78.171,
    "t1": 79.813,
    "text": "底线球也只快2%到3%。"
   }
  ]
 },
 {
  "i": 13,
  "start": 81.072,
  "speech_from": 81.164,
  "speech_to": 82.986,
  "late": 0.0,
  "text": "所以，线没有让球变快。",
  "phrases": [
   {
    "t0": 81.164,
    "t1": 82.986,
    "text": "所以，线没有让球变快。"
   }
  ]
 },
 {
  "i": 14,
  "start": 85.222,
  "speech_from": 85.314,
  "speech_to": 89.11,
  "late": 0.0,
  "text": "再看旋转。拍面斜着刷过去，球先在线上滑。",
  "phrases": [
   {
    "t0": 85.314,
    "t1": 87.817,
    "text": "再看旋转。拍面斜着刷过去"
   },
   {
    "t0": 87.997,
    "t1": 89.11,
    "text": "球先在线上滑。"
   }
  ]
 },
 {
  "i": 15,
  "start": 89.367,
  "speech_from": 89.459,
  "speech_to": 94.883,
  "late": 0.0,
  "text": "摩擦力和压力成正比，这是库仑摩擦定律；正是这股摩擦，拖着球转起来。",
  "phrases": [
   {
    "t0": 89.459,
    "t1": 90.879,
    "text": "摩擦力和压力成正比"
   },
   {
    "t0": 91.059,
    "t1": 93.686,
    "text": "这是库仑摩擦定律；正是这股摩擦"
   },
   {
    "t0": 93.834,
    "t1": 94.883,
    "text": "拖着球转起来。"
   }
  ]
 },
 {
  "i": 16,
  "start": 95.367,
  "speech_from": 95.459,
  "speech_to": 103.934,
  "late": 0.0,
  "text": "可实验发现，几乎每种线的摩擦都够大，球还没离开线就滚起来了；一滚起来，接触点不再打滑，摩擦就不再往球上加转。",
  "phrases": [
   {
    "t0": 95.459,
    "t1": 96.159,
    "text": "可实验发现"
   },
   {
    "t0": 96.423,
    "t1": 98.086,
    "text": "几乎每种线的摩擦都够大"
   },
   {
    "t0": 98.309,
    "t1": 100.788,
    "text": "球还没离开线就滚起来了；一滚起来"
   },
   {
    "t0": 101.0,
    "t1": 102.144,
    "text": "接触点不再打滑"
   },
   {
    "t0": 102.356,
    "t1": 103.934,
    "text": "摩擦就不再往球上加转。"
   }
  ]
 },
 {
  "i": 17,
  "start": 104.192,
  "speech_from": 104.284,
  "speech_to": 112.155,
  "late": 0.0,
  "text": "真正能加转的，是竖着的主线：球刷过去，把主线拨歪；主线弹回来的那一下，又把球往上拨，球就多转一些。",
  "phrases": [
   {
    "t0": 104.284,
    "t1": 106.424,
    "text": "真正能加转的，是竖着的主线"
   },
   {
    "t0": 106.657,
    "t1": 108.342,
    "text": "球刷过去，把主线拨歪"
   },
   {
    "t0": 108.606,
    "t1": 111.053,
    "text": "主线弹回来的那一下，又把球往上拨"
   },
   {
    "t0": 111.202,
    "t1": 112.155,
    "text": "球就多转一些。"
   }
  ]
 },
 {
  "i": 18,
  "start": 112.412,
  "speech_from": 112.504,
  "speech_to": 121.074,
  "late": 0.0,
  "text": "1977年，德国人菲舍尔申请专利：主线和横着的横线不再上下编织，线更能滑开再弹回，转速接近普通球拍的两倍。",
  "phrases": [
   {
    "t0": 112.504,
    "t1": 114.93,
    "text": "1977年，德国人菲舍尔申请专利"
   },
   {
    "t0": 115.237,
    "t1": 117.494,
    "text": "主线和横着的横线不再上下编织"
   },
   {
    "t0": 117.737,
    "t1": 119.093,
    "text": "线更能滑开再弹回"
   },
   {
    "t0": 119.284,
    "t1": 121.074,
    "text": "转速接近普通球拍的两倍。"
   }
  ]
 },
 {
  "i": 19,
  "start": 121.332,
  "speech_from": 121.424,
  "speech_to": 128.514,
  "late": 0.0,
  "text": "1978年，国际网联把它禁了。原因之一：排名不高的球员，靠它的超强旋转赢了顶尖选手。",
  "phrases": [
   {
    "t0": 121.424,
    "t1": 123.755,
    "text": "1978年，国际网联把它禁了。"
   },
   {
    "t0": 124.224,
    "t1": 126.088,
    "text": "原因之一：排名不高的球员"
   },
   {
    "t0": 126.237,
    "t1": 128.514,
    "text": "靠它的超强旋转赢了顶尖选手。"
   }
  ]
 },
 {
  "i": 20,
  "start": 128.772,
  "speech_from": 128.864,
  "speech_to": 140.308,
  "late": 0.0,
  "text": "聚酯线呢？零售商的实验说，它比尼龙多转两成；同行评审的实验，却测不出材料本身的区别。两边都同意：关键是线能不能滑开、再弹回。",
  "phrases": [
   {
    "t0": 128.864,
    "t1": 131.272,
    "text": "聚酯线呢？零售商的实验说"
   },
   {
    "t0": 131.516,
    "t1": 134.249,
    "text": "它比尼龙多转两成；同行评审的实验"
   },
   {
    "t0": 134.45,
    "t1": 136.283,
    "text": "却测不出材料本身的区别。"
   },
   {
    "t0": 136.77,
    "t1": 139.513,
    "text": "两边都同意：关键是线能不能滑开"
   },
   {
    "t0": 139.662,
    "t1": 140.308,
    "text": "再弹回。"
   }
  ]
 },
 {
  "i": 21,
  "start": 141.216,
  "speech_from": 141.308,
  "speech_to": 147.01,
  "late": 0.0,
  "text": "第三样，磅数。线一拉紧就开始应力松弛，刚穿好就比设定低了约三成。",
  "phrases": [
   {
    "t0": 141.308,
    "t1": 142.463,
    "text": "第三样，磅数。"
   },
   {
    "t0": 142.922,
    "t1": 144.775,
    "text": "线一拉紧就开始应力松弛"
   },
   {
    "t0": 144.934,
    "t1": 147.01,
    "text": "刚穿好就比设定低了约三成。"
   }
  ]
 },
 {
  "i": 22,
  "start": 147.268,
  "speech_from": 147.36,
  "speech_to": 151.799,
  "late": 0.0,
  "text": "磅数一掉，球在线上停得更久，出球角度变高，就往界外飞。",
  "phrases": [
   {
    "t0": 147.36,
    "t1": 149.574,
    "text": "磅数一掉，球在线上停得更久"
   },
   {
    "t0": 149.776,
    "t1": 151.799,
    "text": "出球角度变高，就往界外飞。"
   }
  ]
 },
 {
