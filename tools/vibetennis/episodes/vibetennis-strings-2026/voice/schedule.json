[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 3.468,
  "late": 0.0,
  "text": "1874年到今天，网球拍上的线换了四代。",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 1.572,
    "text": "1874年到今天"
   },
   {
    "t0": 1.815,
    "t1": 3.468,
    "text": "网球拍上的线换了四代。"
   }
  ]
 },
 {
  "i": 1,
  "start": 5.208,
  "speech_from": 5.3,
  "speech_to": 8.341,
  "late": 0.0,
  "text": "发球上网，却在短短十来年里近乎消失。",
  "phrases": [
   {
    "t0": 5.3,
    "t1": 5.978,
    "text": "发球上网"
   },
   {
    "t0": 6.201,
    "t1": 8.341,
    "text": "却在短短十来年里近乎消失。"
   }
  ]
 },
 {
  "i": 2,
  "start": 9.708,
  "speech_from": 9.8,
  "speech_to": 11.474,
  "late": 0.0,
  "text": "是线，改变了网球吗？",
  "phrases": [
   {
    "t0": 9.8,
    "t1": 11.474,
    "text": "是线，改变了网球吗？"
   }
  ]
 },
 {
  "i": 3,
  "start": 14.558,
  "speech_from": 14.65,
  "speech_to": 16.833,
  "late": 0.0,
  "text": "最早的网球线，是羊的肠衣。",
  "phrases": [
   {
    "t0": 14.65,
    "t1": 16.833,
    "text": "最早的网球线，是羊的肠衣。"
   }
  ]
 },
 {
  "i": 4,
  "start": 17.09,
  "speech_from": 17.182,
  "speech_to": 21.271,
  "late": 0.0,
  "text": "球撞上线床再弹开，前后的速度之比，牛顿最早测过。",
  "phrases": [
   {
    "t0": 17.182,
    "t1": 19.894,
    "text": "球撞上线床再弹开，前后的速度之比"
   },
   {
    "t0": 20.138,
    "t1": 21.271,
    "text": "牛顿最早测过。"
   }
  ]
 },
 {
  "i": 5,
  "start": 23.09,
  "speech_from": 23.182,
  "speech_to": 24.846,
  "late": 0.0,
  "text": "今天叫它，恢复系数。",
  "phrases": [
   {
    "t0": 23.182,
    "t1": 24.846,
    "text": "今天叫它，恢复系数。"
   }
  ]
 },
 {
  "i": 6,
  "start": 29.708,
  "speech_from": 29.8,
  "speech_to": 32.152,
  "late": 0.0,
  "text": "羊肠线贵，又不耐磨、怕潮。",
  "phrases": [
   {
    "t0": 29.8,
    "t1": 32.152,
    "text": "羊肠线贵，又不耐磨、怕潮。"
   }
  ]
 },
 {
  "i": 7,
  "start": 32.409,
  "speech_from": 32.501,
  "speech_to": 34.461,
  "late": 0.0,
  "text": "于是有了尼龙这样的合成线。",
  "phrases": [
   {
    "t0": 32.501,
    "t1": 34.461,
    "text": "于是有了尼龙这样的合成线。"
   }
  ]
 },
 {
  "i": 8,
  "start": 34.719,
  "speech_from": 34.811,
  "speech_to": 41.199,
  "late": 0.0,
  "text": "放大来看：羊肠线是一缕缕胶原纤维；多股线是很多根尼龙细丝；单丝线是实心的一根。",
  "phrases": [
   {
    "t0": 34.811,
    "t1": 37.481,
    "text": "放大来看：羊肠线是一缕缕胶原纤维"
   },
   {
    "t0": 37.703,
    "t1": 39.515,
    "text": "多股线是很多根尼龙细丝"
   },
   {
    "t0": 39.78,
    "t1": 41.199,
    "text": "单丝线是实心的一根。"
   }
  ]
 },
 {
  "i": 9,
  "start": 42.719,
  "speech_from": 42.811,
  "speech_to": 45.905,
  "late": 0.0,
  "text": "打久了，线和线交叉的地方会磨出凹槽。",
  "phrases": [
   {
    "t0": 42.811,
    "t1": 45.905,
    "text": "打久了，线和线交叉的地方会磨出凹槽。"
   }
  ]
 },
 {
  "i": 10,
  "start": 51.858,
  "speech_from": 51.95,
  "speech_to": 56.336,
  "late": 0.0,
  "text": "1977年，德国人菲舍尔申请专利：主线和横线不再编织。",
  "phrases": [
   {
    "t0": 51.95,
    "t1": 54.461,
    "text": "1977年，德国人菲舍尔申请专利"
   },
   {
    "t0": 54.758,
    "t1": 56.336,
    "text": "主线和横线不再编织。"
   }
  ]
 },
 {
  "i": 11,
  "start": 57.858,
  "speech_from": 57.95,
  "speech_to": 62.177,
  "late": 0.0,
  "text": "线能滑开、再弹回，实验室里转速接近普通球拍的两倍。",
  "phrases": [
   {
    "t0": 57.95,
    "t1": 58.681,
    "text": "线能滑开"
   },
   {
    "t0": 58.84,
    "t1": 62.177,
    "text": "再弹回，实验室里转速接近普通球拍的两倍。"
   }
  ]
 },
 {
  "i": 12,
  "start": 64.358,
  "speech_from": 64.45,
  "speech_to": 67.628,
  "late": 0.0,
  "text": "1978年，国际网联把它写进规则：禁了。",
  "phrases": [
   {
    "t0": 64.45,
    "t1": 67.025,
    "text": "1978年，国际网联把它写进规则"
   },
   {
    "t0": 67.247,
    "t1": 67.628,
    "text": "禁了。"
   }
  ]
 },
 {
  "i": 13,
  "start": 67.886,
  "speech_from": 67.978,
  "speech_to": 72.353,
  "late": 0.0,
  "text": "球在线上先滑，再被摩擦力带着滚起来，这是库仑摩擦定律。",
  "phrases": [
   {
    "t0": 67.978,
    "t1": 69.08,
    "text": "球在线上先滑"
   },
   {
    "t0": 69.303,
    "t1": 70.839,
    "text": "再被摩擦力带着滚起来"
   },
   {
    "t0": 71.04,
    "t1": 72.353,
    "text": "这是库仑摩擦定律。"
   }
  ]
 },
 {
  "i": 14,
  "start": 78.008,
  "speech_from": 78.1,
  "speech_to": 81.268,
  "late": 0.0,
  "text": "1997年，库尔滕用聚酯线拿下法网。",
  "phrases": [
   {
    "t0": 78.1,
    "t1": 79.001,
    "text": "1997年"
   },
   {
    "t0": 79.244,
    "t1": 81.268,
    "text": "库尔滕用聚酯线拿下法网。"
   }
  ]
 },
 {
  "i": 15,
  "start": 82.508,
  "speech_from": 82.6,
  "speech_to": 85.725,
  "late": 0.0,
  "text": "到2010年，温网的男选手都换上了它。",
  "phrases": [
   {
    "t0": 82.6,
    "t1": 83.533,
    "text": "到2010年"
   },
   {
    "t0": 83.797,
    "t1": 85.725,
    "text": "温网的男选手都换上了它。"
   }
  ]
 },
 {
  "i": 16,
  "start": 86.508,
  "speech_from": 86.6,
  "speech_to": 90.014,
  "late": 0.0,
  "text": "它真的让球转得更多吗？有实验说多两成，",
  "phrases": [
   {
    "t0": 86.6,
    "t1": 88.285,
    "text": "它真的让球转得更多吗？"
   },
   {
    "t0": 88.764,
    "t1": 90.014,
    "text": "有实验说多两成"
   }
  ]
 },
 {
  "i": 17,
  "start": 90.272,
  "speech_from": 90.364,
  "speech_to": 93.648,
  "late": 0.0,
  "text": "同行评审的实验，却测不出材料本身的区别。",
  "phrases": [
   {
    "t0": 90.364,
    "t1": 91.508,
    "text": "同行评审的实验"
   },
   {
    "t0": 91.773,
    "t1": 93.648,
    "text": "却测不出材料本身的区别。"
   }
  ]
 },
 {
  "i": 18,
  "start": 93.905,
  "speech_from": 93.997,
  "speech_to": 97.355,
  "late": 0.0,
  "text": "大家都认的只有一点：线能不能滑开、再弹回。",
  "phrases": [
   {
    "t0": 93.997,
    "t1": 96.572,
    "text": "大家都认的只有一点：线能不能滑开"
   },
   {
    "t0": 96.73,
    "t1": 97.355,
    "text": "再弹回。"
   }
  ]
 },
 {
  "i": 19,
  "start": 102.158,
  "speech_from": 102.25,
  "speech_to": 106.289,
  "late": 0.0,
  "text": "那力量呢？实验室里，换一种线，球速变化很小。",
  "phrases": [
   {
    "t0": 102.25,
    "t1": 104.902,
    "text": "那力量呢？实验室里，换一种线"
   },
   {
    "t0": 105.092,
    "t1": 106.289,
    "text": "球速变化很小。"
   }
  ]
 },
 {
  "i": 20,
  "start": 110.308,
  "speech_from": 110.4,
  "speech_to": 112.095,
  "late": 0.0,
  "text": "真正的代价，是掉磅。",
  "phrases": [
   {
    "t0": 110.4,
    "t1": 112.095,
    "text": "真正的代价，是掉磅。"
   }
  ]
 },
 {
  "i": 21,
  "start": 112.353,
  "speech_from": 112.445,
  "speech_to": 116.534,
  "late": 0.0,
  "text": "线一拉紧就开始应力松弛，刚穿好就比设定低了约三成。",
  "phrases": [
   {
    "t0": 112.445,
    "t1": 114.299,
    "text": "线一拉紧就开始应力松弛"
   },
   {
    "t0": 114.458,
    "t1": 116.534,
    "text": "刚穿好就比设定低了约三成。"
   }
  ]
 },
 {
  "i": 22,
  "start": 118.353,
  "speech_from": 118.445,
  "speech_to": 121.687,
  "late": 0.0,
  "text": "聚酯线掉得最快，磅数一掉，球就往界外飞。",
  "phrases": [
   {
    "t0": 118.445,
    "t1": 120.532,
    "text": "聚酯线掉得最快，磅数一掉"
   },
   {
    "t0": 120.744,
    "t1": 121.687,
    "text": "球就往界外飞。"
   }
  ]
 },
 {
  "i": 23,
  "start": 123.353,
  "speech_from": 123.445,
  "speech_to": 127.238,
  "late": 0.0,
  "text": "所以职业球员每换一次新球，就换一支刚穿好的拍子。",
  "phrases": [
   {
    "t0": 123.445,
    "t1": 125.5,
    "text": "所以职业球员每换一次新球"
   },
   {
    "t0": 125.659,
    "t1": 127.238,
    "text": "就换一支刚穿好的拍子。"
   }
  ]
 },
 {
  "i": 24,
  "start": 132.458,
  "speech_from": 132.55,
  "speech_to": 137.974,
  "late": 0.0,
  "text": "再看打法：发球上网，1990年代约占四成，2005年后不到一成。",
  "phrases": [
   {
    "t0": 132.55,
    "t1": 134.15,
    "text": "再看打法：发球上网"
   },
   {
    "t0": 134.341,
    "t1": 136.067,
    "text": "1990年代约占四成"
   },
   {
    "t0": 136.364,
    "t1": 137.974,
    "text": "2005年后不到一成。"
   }
  ]
 },
 {
  "i": 25,
  "start": 139.958,
  "speech_from": 140.05,
  "speech_to": 142.953,
  "late": 0.0,
  "text": "时间，正好落在聚酯线普及的那几年。",
  "phrases": [
   {
    "t0": 140.05,
    "t1": 142.953,
    "text": "时间，正好落在聚酯线普及的那几年。"
   }
  ]
 },
 {
  "i": 26,
  "start": 144.458,
  "speech_from": 144.55,
  "speech_to": 147.675,
  "late": 0.0,
  "text": "可同一时期，球拍、球和场地也都在变；",
  "phrases": [
   {
    "t0": 144.55,
    "t1": 145.377,
    "text": "可同一时期"
   },
   {
    "t0": 145.514,
    "t1": 147.675,
    "text": "球拍、球和场地也都在变"
   }
  ]
 },
 {
  "i": 27,
  "start": 149.458,
  "speech_from": 149.55,
  "speech_to": 152.739,
  "late": 0.0,
  "text": "至今没有一项研究，能把线的作用单独算出来。",
  "phrases": [
   {
    "t0": 149.55,
    "t1": 150.684,
    "text": "至今没有一项研究"
   },
   {
    "t0": 150.906,
    "t1": 152.739,
    "text": "能把线的作用单独算出来。"
   }
  ]
 },
 {
  "i": 28,
  "start": 156.608,
  "speech_from": 156.7,
  "speech_to": 162.092,
  "late": 0.0,
  "text": "线改变了手感、磅数和穿线的规矩；打法这笔账，要和球拍、球一起算。",
  "phrases": [
   {
    "t0": 156.7,
    "t1": 159.423,
    "text": "线改变了手感、磅数和穿线的规矩"
   },
   {
    "t0": 159.719,
    "t1": 162.092,
    "text": "打法这笔账，要和球拍、球一起算。"
   }
  ]
 },
 {
