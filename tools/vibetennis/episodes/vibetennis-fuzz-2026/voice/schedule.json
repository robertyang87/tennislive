[
 {
  "i": 0,
  "start": 0.208,
  "speech_from": 0.3,
  "speech_to": 2.175,
  "late": 0.0,
  "text": "网球为什么偏偏要长一层毛？",
  "phrases": [
   {
    "t0": 0.3,
    "t1": 2.175,
    "text": "网球为什么偏偏要长一层毛？"
   }
  ]
 },
 {
  "i": 1,
  "start": 3.408,
  "speech_from": 3.5,
  "speech_to": 10.566,
  "late": 0.0,
  "text": "把毛剃光，同一记200公里的发球，飞过一个场地长度：可能只剩约130，也可能还剩约180。",
  "phrases": [
   {
    "t0": 3.5,
    "t1": 6.318,
    "text": "把毛剃光，同一记200公里的发球"
   },
   {
    "t0": 6.032,
    "t1": 7.769,
    "text": "飞过一个场地长度"
   },
   {
    "t0": 7.558,
    "t1": 8.892,
    "text": "可能只剩约130"
   },
   {
    "t0": 9.062,
    "t1": 10.566,
    "text": "也可能还剩约180。"
   }
  ]
 },
 {
  "i": 2,
  "start": 13.008,
  "speech_from": 13.1,
  "speech_to": 15.071,
  "late": 0.0,
  "text": "忽快忽慢，没人接得住。",
  "phrases": [
   {
    "t0": 13.1,
    "t1": 15.071,
    "text": "忽快忽慢，没人接得住。"
   }
  ]
 },
 {
  "i": 3,
  "start": 16.608,
  "speech_from": 16.7,
  "speech_to": 19.878,
  "late": 0.0,
  "text": "有毛的网球，每一次都稳稳地剩下约120。",
  "phrases": [
   {
    "t0": 16.7,
    "t1": 17.569,
    "text": "有毛的网球"
   },
   {
    "t0": 17.834,
    "t1": 19.878,
    "text": "每一次都稳稳地剩下约120。"
   }
  ]
 },
 {
  "i": 4,
  "start": 21.208,
  "speech_from": 21.3,
  "speech_to": 26.505,
  "late": 0.0,
  "text": "这层毛，是一个刹车，更是一个稳定器。原因，要从一座铁塔说起。",
  "phrases": [
   {
    "t0": 21.3,
    "t1": 22.752,
    "text": "这层毛，是一个刹车"
   },
   {
    "t0": 22.942,
    "t1": 24.129,
    "text": "更是一个稳定器。"
   },
   {
    "t0": 24.608,
    "t1": 26.505,
    "text": "原因，要从一座铁塔说起。"
   }
  ]
 },
 {
  "i": 5,
  "start": 28.258,
  "speech_from": 28.35,
  "speech_to": 32.725,
  "late": 0.0,
  "text": "1912年，造铁塔的埃菲尔在风洞里吹球，发现了一件怪事。",
  "phrases": [
   {
    "t0": 28.35,
    "t1": 29.092,
    "text": "1912年"
   },
   {
    "t0": 29.261,
    "t1": 31.486,
    "text": "造铁塔的埃菲尔在风洞里吹球"
   },
   {
    "t0": 31.645,
    "t1": 32.725,
    "text": "发现了一件怪事。"
   }
  ]
 },
 {
  "i": 6,
  "start": 34.258,
  "speech_from": 34.35,
  "speech_to": 39.064,
  "late": 0.0,
  "text": "风越快，阻力本该越大；可过了某个速度，球的阻力突然掉了下去。",
  "phrases": [
   {
    "t0": 34.35,
    "t1": 36.077,
    "text": "风越快，阻力本该越大"
   },
   {
    "t0": 36.353,
    "t1": 37.338,
    "text": "可过了某个速度"
   },
   {
    "t0": 37.475,
    "t1": 39.064,
    "text": "球的阻力突然掉了下去。"
   }
  ]
 },
 {
  "i": 7,
  "start": 40.258,
  "speech_from": 40.35,
  "speech_to": 45.925,
  "late": 0.0,
  "text": "光滑的球，阻力系数从约0.5，一下掉到约0.1。这叫阻力危机。",
  "phrases": [
   {
    "t0": 40.35,
    "t1": 42.85,
    "text": "光滑的球，阻力系数从约0.5"
   },
   {
    "t0": 42.596,
    "t1": 45.576,
    "text": "一下掉到约0.1。这叫阻力危机。"
   }
  ]
 },
 {
  "i": 8,
  "start": 47.458,
  "speech_from": 47.55,
  "speech_to": 52.744,
  "late": 0.0,
  "text": "两年后，普朗特在球上绑了一圈细线，阻力也跟着掉了下来。为什么？",
  "phrases": [
   {
    "t0": 47.55,
    "t1": 50.093,
    "text": "两年后，普朗特在球上绑了一圈细线"
   },
   {
    "t0": 50.326,
    "t1": 52.744,
    "text": "阻力也跟着掉了下来。为什么？"
   }
  ]
 },
 {
  "i": 9,
  "start": 54.108,
  "speech_from": 54.2,
  "speech_to": 57.696,
  "late": 0.0,
  "text": "关键在贴着球面的那一薄层空气，叫边界层。",
  "phrases": [
   {
    "t0": 54.2,
    "t1": 56.255,
    "text": "关键在贴着球面的那一薄层空气"
   },
   {
    "t0": 56.266,
    "t1": 57.696,
    "text": "叫边界层。"
   }
  ]
 },
 {
  "i": 10,
  "start": 58.708,
  "speech_from": 58.8,
  "speech_to": 65.167,
  "late": 0.0,
  "text": "速度慢时，它是整齐的层流，绕到球的侧面就脱开了，身后拖出一大片乱流，把球往后拽。",
  "phrases": [
   {
    "t0": 58.8,
    "t1": 60.781,
    "text": "速度慢时，它是整齐的层流"
   },
   {
    "t0": 61.036,
    "t1": 62.582,
    "text": "绕到球的侧面就脱开了"
   },
   {
    "t0": 62.836,
    "t1": 65.167,
    "text": "身后拖出一大片乱流，把球往后拽。"
   }
  ]
 },
 {
  "i": 11,
  "start": 66.508,
  "speech_from": 66.6,
  "speech_to": 72.215,
  "late": 0.0,
  "text": "速度够快，或者表面够粗糙，边界层变成湍流，能贴着球面多走一段才脱开。",
  "phrases": [
   {
    "t0": 66.6,
    "t1": 68.698,
    "text": "速度够快，或者表面够粗糙"
   },
   {
    "t0": 68.878,
    "t1": 70.075,
    "text": "边界层变成湍流"
   },
   {
    "t0": 70.276,
    "t1": 72.215,
    "text": "能贴着球面多走一段才脱开。"
   }
  ]
 },
 {
  "i": 12,
  "start": 73.308,
  "speech_from": 73.4,
  "speech_to": 76.599,
  "late": 0.0,
  "text": "身后的乱流一下子变窄，往后拽的力就小了。",
  "phrases": [
   {
    "t0": 73.4,
    "t1": 75.095,
    "text": "身后的乱流一下子变窄"
   },
   {
    "t0": 75.35,
    "t1": 76.599,
    "text": "往后拽的力就小了。"
   }
  ]
 },
 {
  "i": 13,
  "start": 77.708,
  "speech_from": 77.8,
  "speech_to": 84.347,
  "late": 0.0,
  "text": "这个转变，大约发生在雷诺数30万：雷诺数，就是把速度和球的大小放在一起算的一个数。",
  "phrases": [
   {
    "t0": 77.8,
    "t1": 80.396,
    "text": "这个转变，大约发生在雷诺数30万"
   },
   {
    "t0": 80.724,
    "t1": 84.347,
    "text": "雷诺数，就是把速度和球的大小放在一起算的一个数。"
   }
  ]
 },
 {
  "i": 14,
  "start": 86.358,
  "speech_from": 86.45,
  "speech_to": 88.378,
  "late": 0.0,
  "text": "高尔夫球把这招用到了极致。",
  "phrases": [
   {
    "t0": 86.45,
    "t1": 88.378,
    "text": "高尔夫球把这招用到了极致。"
   }
  ]
 },
 {
  "i": 15,
  "start": 89.358,
  "speech_from": 89.45,
  "speech_to": 94.196,
  "late": 0.0,
  "text": "表面的凹坑把边界层提前搅乱，让阻力危机在更低的速度就发生。",
  "phrases": [
   {
    "t0": 89.45,
    "t1": 91.717,
    "text": "表面的凹坑把边界层提前搅乱"
   },
   {
    "t0": 91.929,
    "t1": 94.196,
    "text": "让阻力危机在更低的速度就发生。"
   }
  ]
 },
 {
  "i": 16,
  "start": 95.358,
  "speech_from": 95.45,
  "speech_to": 99.836,
  "late": 0.0,
  "text": "一记开球，从出手开始就在悬崖下面：阻力小，飞得远。",
  "phrases": [
   {
    "t0": 95.45,
    "t1": 98.3,
    "text": "一记开球，从出手开始就在悬崖下面"
   },
   {
    "t0": 98.554,
    "t1": 99.836,
    "text": "阻力小，飞得远。"
   }
  ]
 },
 {
  "i": 17,
  "start": 101.408,
  "speech_from": 101.5,
  "speech_to": 102.814,
  "late": 0.0,
  "text": "足球就没这么幸运。",
  "phrases": [
   {
    "t0": 101.5,
    "t1": 102.814,
    "text": "足球就没这么幸运。"
   }
  ]
 },
 {
  "i": 18,
  "start": 104.008,
  "speech_from": 104.1,
  "speech_to": 106.293,
  "late": 0.0,
  "text": "它的速度，正好落在悬崖附近。",
  "phrases": [
   {
    "t0": 104.1,
    "t1": 106.293,
    "text": "它的速度，正好落在悬崖附近。"
   }
  ]
 },
 {
  "i": 19,
  "start": 107.408,
  "speech_from": 107.5,
  "speech_to": 112.702,
  "late": 0.0,
  "text": "球不转的时候，身后的涡忽左忽右地甩，球就跟着乱飘：这就是电梯球。",
  "phrases": [
   {
    "t0": 107.5,
    "t1": 108.337,
    "text": "球不转的时候"
   },
   {
    "t0": 108.528,
    "t1": 110.297,
    "text": "身后的涡忽左忽右地甩"
   },
   {
    "t0": 110.456,
    "t1": 112.702,
    "text": "球就跟着乱飘：这就是电梯球。"
   }
  ]
 },
 {
  "i": 20,
  "start": 115.058,
  "speech_from": 115.15,
  "speech_to": 115.902,
  "late": 0.0,
  "text": "那网球呢？",
  "phrases": [
   {
    "t0": 115.15,
    "t1": 115.902,
    "text": "那网球呢？"
   }
  ]
 },
 {
  "i": 21,
  "start": 117.458,
  "speech_from": 117.55,
  "speech_to": 123.832,
  "late": 0.0,
  "text": "职业比赛的球速，从100到250公里，换算成雷诺数，正好落在光滑球的悬崖区。",
  "phrases": [
   {
    "t0": 117.55,
    "t1": 118.588,
    "text": "职业比赛的球速"
   },
   {
    "t0": 118.79,
    "t1": 120.368,
    "text": "从100到250公里"
   },
   {
    "t0": 120.601,
    "t1": 121.692,
    "text": "换算成雷诺数"
   },
   {
    "t0": 121.904,
    "t1": 123.832,
    "text": "正好落在光滑球的悬崖区。"
   }
  ]
 },
 {
  "i": 22,
  "start": 124.858,
  "speech_from": 124.95,
  "speech_to": 129.251,
  "late": 0.0,
  "text": "要是网球没有毛，同一记发球，就会时而在悬崖上，时而掉下去。",
  "phrases": [
   {
    "t0": 124.95,
    "t1": 126.942,
    "text": "要是网球没有毛，同一记发球"
   },
   {
    "t0": 127.111,
    "t1": 129.251,
    "text": "就会时而在悬崖上，时而掉下去。"
   }
  ]
 },
 {
  "i": 23,
  "start": 130.658,
  "speech_from": 130.75,
  "speech_to": 136.693,
  "late": 0.0,
  "text": "绒毛把这道悬崖抹平了：每根毛自己都在挡风，网球的阻力系数一直在0.6上下。",
  "phrases": [
   {
    "t0": 130.75,
    "t1": 132.233,
    "text": "绒毛把这道悬崖抹平了"
   },
   {
    "t0": 132.509,
    "t1": 133.918,
    "text": "每根毛自己都在挡风"
   },
   {
    "t0": 134.161,
    "t1": 136.693,
    "text": "网球的阻力系数一直在0.6上下。"
   }
  ]
 },
 {
  "i": 24,
  "start": 139.258,
  "speech_from": 139.35,
  "speech_to": 142.486,
  "late": 0.0,
  "text": "三个实验室测出来的结果都一样：没有悬崖。",
  "phrases": [
   {
    "t0": 139.35,
    "t1": 141.437,
    "text": "三个实验室测出来的结果都一样"
   },
   {
    "t0": 141.744,
    "t1": 142.486,
    "text": "没有悬崖。"
   }
  ]
 },
 {
  "i": 25,
  "start": 143.658,
  "speech_from": 143.75,
  "speech_to": 147.066,
  "late": 0.0,
  "text": "所以网球慢一点、稳一点，才打得出一来一回。",
  "phrases": [
   {
    "t0": 143.75,
    "t1": 144.979,
    "text": "所以网球慢一点"
   },
   {
    "t0": 145.191,
    "t1": 147.066,
    "text": "稳一点，才打得出一来一回。"
   }
  ]
 },
 {
  "i": 26,
  "start": 149.308,
  "speech_from": 149.4,
  "speech_to": 153.066,
  "late": 0.0,
  "text": "毛的状态，也在改变阻力：毛越蓬，阻力越大。",
  "phrases": [
   {
    "t0": 149.4,
    "t1": 151.328,
    "text": "毛的状态，也在改变阻力"
   },
   {
    "t0": 151.54,
    "t1": 153.066,
    "text": "毛越蓬，阻力越大。"
   }
  ]
 },
 {
  "i": 27,
  "start": 154.308,
  "speech_from": 154.4,
  "speech_to": 158.214,
  "late": 0.0,
  "text": "所以球员发球前，常常从几颗球里挑一颗毛不蓬的。",
  "phrases": [
   {
    "t0": 154.4,
    "t1": 155.64,
    "text": "所以球员发球前"
   },
   {
    "t0": 155.83,
    "t1": 158.214,
    "text": "常常从几颗球里挑一颗毛不蓬的。"
   }
  ]
 },
 {
  "i": 28,
  "start": 159.308,
  "speech_from": 159.4,
  "speech_to": 163.945,
  "late": 0.0,
  "text": "1987年温网冠军帕特·卡什说过：发球，你要一颗没起毛的球。",
  "phrases": [
   {
    "t0": 159.4,
    "t1": 162.419,
    "text": "1987年温网冠军帕特·卡什说过"
   },
   {
    "t0": 162.07,
    "t1": 163.945,
    "text": "发球，你要一颗没起毛的球。"
   }
  ]
 },
 {
  "i": 29,
  "start": 165.558,
  "speech_from": 165.65,
  "speech_to": 167.483,
  "late": 0.0,
  "text": "国际网联也用过这个刹车。",
  "phrases": [
   {
    "t0": 165.65,
    "t1": 167.483,
    "text": "国际网联也用过这个刹车。"
   }
  ]
 },
 {
  "i": 30,
  "start": 168.358,
  "speech_from": 168.45,
  "speech_to": 173.429,
  "late": 0.0,
  "text": "3号球比标准球大约6%，重量不变，专门给快场地和高海拔用。",
  "phrases": [
   {
    "t0": 168.45,
    "t1": 171.183,
    "text": "3号球比标准球大约6%，重量不变"
   },
   {
    "t0": 170.876,
    "t1": 173.122,
    "text": "专门给快场地和高海拔用。"
   }
  ]
 },
 {
  "i": 31,
  "start": 174.758,
  "speech_from": 174.85,
  "speech_to": 177.795,
  "late": 0.0,
  "text": "迎风面积大了，阻力就大，球就慢了下来。",
  "phrases": [
   {
    "t0": 174.85,
    "t1": 176.63,
    "text": "迎风面积大了，阻力就大"
   },
   {
    "t0": 176.853,
    "t1": 177.795,
    "text": "球就慢了下来。"
   }
  ]
 },
 {
  "i": 32,
  "start": 180.008,
  "speech_from": 180.1,
  "speech_to": 182.929,
  "late": 0.0,
  "text": "网球的毛，是一个刹车，也是一个稳定器。",
  "phrases": [
   {
    "t0": 180.1,
    "t1": 181.658,
    "text": "网球的毛，是一个刹车"
   },
   {
    "t0": 181.859,
    "t1": 182.929,
    "text": "也是一个稳定器。"
   }
  ]
 },
 {
  "i": 33,
  "start": 184.808,
  "speech_from": 184.9,
  "speech_to": 188.195,
  "late": 0.0,
  "text": "它让网球慢下来、稳下来，才有了一来一回的比赛。",
  "phrases": [
   {
    "t0": 184.9,
    "t1": 185.875,
    "text": "它让网球慢下来"
   },
   {
    "t0": 186.129,
    "t1": 188.195,
    "text": "稳下来，才有了一来一回的比赛。"
   }
  ]
 },
 {
  "i": 34,
  "start": 190.208,
  "speech_from": 190.3,
  "speech_to": 192.673,
  "late": 0.0,
  "text": "你发球前，会挑毛不蓬的那一颗吗？",
  "phrases": [
   {
    "t0": 190.3,
    "t1": 192.673,
    "text": "你发球前，会挑毛不蓬的那一颗吗？"
   }
  ]
 }
]