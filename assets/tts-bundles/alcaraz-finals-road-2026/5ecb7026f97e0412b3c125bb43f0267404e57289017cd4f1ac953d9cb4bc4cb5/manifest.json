6c2dbbaf3be93aee93477"},{"audio_sha256":"17a0c6df4d9e63aa2af32539d61d725ddf9fbc8ad6b4068977e1e60adda08c43","duration_seconds":8.76,"marks_sha256":"6528f48bd28e67109257fc4203a4f4186b6ff928b3fa30d09609b3ffb83eee1b","request":{"backend":"edge","cache_key":"f38f53363baeaa25553ec77e780cfdae","lead_pause":0.0,"pitch":"+0Hz","rate":"+6%","style":"","styledegree":"","text":"四个多月后，他在美网复出。打进8强之后，与谢尔顿拼满五盘，最后在决胜盘抢十落败。","voice":"zh-CN-YunjianNeural"},"request_id":"b427aec3758ef189babcf5e80cd537a2982e5d950510027c6ac9b5745069fe5d"},{"audio_sha256":"5e79e5655e47efc2c0d3cee79eaeb80b9ff840b05900c74b39a6b72a62d8d70e","duration_seconds":4.104,"marks_sha256":"ffd92401e4e51d044cd0ba811dd56c27dfa59f0de4734ee872348e09ba3401b8","request":{"backend":"edge","cache_key":"20da8f5468902afbbecb78daefb15d83","lead_pause":0.0,"pitch":"+0Hz","rate":"+6%","style":"","styledegree":"","text":"关注网球时插，时插归我，好球归你。","voice":"zh-CN-YunjianNeural"},"request_id":"b80ad40cf03e2a1bf0849f74b5dd89f9591e3dfac6354816bf5cd093c739d31d"},{"audio_sha256":"3f21b52e9b565522c36bd37ed72cac21cdc6960c522ca416a3a2b5232b0c07fe","duration_seconds":8.112,"marks_sha256":"1d0eb831c4430e854057abddcf9e4db977950a6bb6064da62efaede51f38e358","request":{"backend":"edge","cache_key":"7048ce43de1816d1a40f9b82519be06d","lead_pause":0.0,"pitch":"+0Hz","rate":"+6%","style":"","styledegree":"","text":"二月多哈，两盘击败菲斯，拿下赛季第二冠。开年的两站巡回赛，他都带着冠军离开。","voice":"zh-CN-YunjianNeural"},"request_id":"cfae72725e6cb6edf4f7fc2bf9c850b2f869754c49f4152327b4a1aa45e8043a"},{"audio_sha256":"da682e2f36bcfbeaab39e3afb5c52e26d8cacb1d9fa4482faf04c7d3acc0a80b","duration_seconds":7.296,"marks_sha256":"6c868b5ce6e2df4b203035c64536efacb050a7017890d41b6e3fc97a3f86189f","request":{"backend":"edge","cache_key":"497bf6762f11db314c69ed5b81db7ab6","lead_pause":0.0,"pitch":"+0Hz","rate":"+6%","style":"","styledegree":"","text":"去年在都灵收获亚军。今年带着巴黎大师赛冠军回来，你看好他走到哪一步？","voice":"zh-CN-YunjianNeural"},"request_id":"db126dcb17fc0a9e0969942c4e126e0cf8ef2e4a7b2fc079640d19653e30dca9"},{"audio_